# Web se ještě připravuje: vyhledávače nesmí nic indexovat, ani adresu,
# obrázky a PDF (hlavička platí pro všechny soubory, nejen stránky).
# Spolu s robots.txt (Disallow: /) zůstává, dokud se web nespustí.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

# Kresby patičky a stránek (src/pages/kresby): adresa nese otisk obsahu (?v=…),
# takže si je prohlížeč smí nechat napořád — po změně kresby má jinou adresu.
/kresby/*
  Cache-Control: public, max-age=31536000, immutable

# Písma (public/fonts/web): Hlava.astro k adrese přidá otisk obsahu (?v=…, lib/pisma.ts),
# takže si je prohlížeč taky smí nechat napořád — přegenerované písmo má jinou adresu.
# Maily (lib/rezervace/vzhled-mailu.ts) berou písma bez otisku; po změně písma
# můžou chvíli ukazovat staré, nevadí.
/fonts/web/*
  Cache-Control: public, max-age=31536000, immutable

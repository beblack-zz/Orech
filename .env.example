# Rezervace — klíče pro server. Zkopíruj do .env (ten do gitu nejde) a na
# hostingu je zadej jako proměnné prostředí. Dokud SUPABASE_* chybí, stránka
# /rezervace ukazuje ukázkovou obsazenost a jízdenka odchází mailem.

# Supabase → Project Settings → Data API (adresa) a API Keys (secret key)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Resend → API Keys. Odesílatel musí být z domény ověřené v Resendu.
RESEND_API_KEY=
REZERVACE_OD=JIRO saku <rezervace@jirosaku.cz>
# Nepovinné: kam chodí skrytá kopie potvrzení a zrušení
REZERVACE_KOPIE=

# Dlouhý náhodný text; stejný patří do tabulky `nastaveni` v Supabase
# (klic = tajemstvi). Databáze se jím prokazuje, když žádá o odeslání pozvánky.
POZVANKY_TAJEMSTVI=

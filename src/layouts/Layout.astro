---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Obrázek pro sdílení, absolutní cesta od kořene webu */
  image?: string;
}

const {
  title = "Ořechová hlína — keramická dílna, Ořech",
  description = "Malá dílna v Ořechu u Prahy. Kurzy keramiky pro začátečníky i pokročilé, dílny pro děti, open studio a prodej ručně dělané keramiky.",
  image = "/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ořechová hlína" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dílna Ořechová hlína" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Obsah se schovává jen tehdy, když ho JS umí zase odkrýt.
      document.documentElement.classList.add("js");
      // Poznámky pro klienta jsou vidět vždycky; schovat je jde přepínačem
      // (nebo ?poznamky=0) a prohlížeč si to pamatuje. Nastavuje se ještě
      // před vykreslením, aby poznámky neproblikly.
      try {
        var poznParam = new URL(window.location.href).searchParams.get("poznamky");
        if (poznParam !== null) {
          localStorage.setItem("poznamky", poznParam === "0" ? "off" : "on");
        }
        if (localStorage.getItem("poznamky") === "off") {
          document.documentElement.classList.add("poznamky-vyp");
        }
      } catch (e) {}
      // Pojistka: kdyby se hlavní skript nenačetl, po 3 s se obsah zobrazí tak jako tak.
      setTimeout(function () {
        if (!window.__fadeReady) document.documentElement.classList.remove("js");
      }, 3000);
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <button type="button" class="poznamky-panel" data-poznamky-prepinac aria-pressed="true">
      Poznámky zap.
    </button>

    <script>
      (window as any).__fadeReady = true;

      const revealAll = () => {
        for (const el of document.querySelectorAll(".fade-up:not(.in-view)")) {
          el.classList.add("in-view");
        }
      };

      const setupObserver = () => {
        if (!("IntersectionObserver" in window)) {
          revealAll();
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
        );
        for (const el of document.querySelectorAll(".fade-up:not(.in-view)")) {
          io.observe(el);
        }
      };

      setupObserver();
      document.addEventListener("astro:page-load", setupObserver);

      // ——— Poznámky pro klienta ———
      const html = document.documentElement;

      const syncPrepinac = () => {
        const zapnuto = !html.classList.contains("poznamky-vyp");
        for (const b of document.querySelectorAll("[data-poznamky-prepinac]")) {
          b.setAttribute("aria-pressed", String(zapnuto));
          b.textContent = zapnuto ? "Poznámky zap." : "Poznámky vyp.";
        }
      };

      const zavriPoznamky = () => {
        for (const p of document.querySelectorAll(".poznamka.otevreno")) {
          p.classList.remove("otevreno");
          p.querySelector(".poznamka-dot")?.setAttribute("aria-expanded", "false");
        }
      };

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;

        const prepinac = target.closest("[data-poznamky-prepinac]");
        if (prepinac) {
          const zapnuto = !html.classList.toggle("poznamky-vyp");
          try {
            localStorage.setItem("poznamky", zapnuto ? "on" : "off");
          } catch (err) {}
          if (!zapnuto) zavriPoznamky();
          syncPrepinac();
          return;
        }

        const dot = target.closest(".poznamka-dot");
        if (dot) {
          const poznamka = dot.closest(".poznamka")!;
          const otevrit = !poznamka.classList.contains("otevreno");
          zavriPoznamky();
          if (otevrit) {
            poznamka.classList.add("otevreno");
            dot.setAttribute("aria-expanded", "true");
          }
          return;
        }

        // Klik mimo bublinu ji zavře
        if (!target.closest(".poznamka-bublina")) zavriPoznamky();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") zavriPoznamky();
      });

      // Přechody mezi stránkami přepisují atributy <html>, tak si stav vracíme zpátky
      const obnovStav = () => {
        try {
          html.classList.toggle("poznamky-vyp", localStorage.getItem("poznamky") === "off");
        } catch (err) {}
        syncPrepinac();
      };

      obnovStav();
      document.addEventListener("astro:page-load", obnovStav);

      // ——— Paleta přebarvená na /dizajn ———
      // Stejný důvod jako výš: přechod mezi stránkami smaže inline styl
      // z <html>, takže si vybrané barvy po každém načtení naneseme znovu.
      const obnovPaletu = () => {
        try {
          const ulozene = JSON.parse(localStorage.getItem("paleta") || "{}");
          for (const [token, hex] of Object.entries(ulozene)) {
            html.style.setProperty(`--color-${token}`, String(hex));
          }
        } catch (err) {}
      };

      obnovPaletu();
      document.addEventListener("astro:page-load", obnovPaletu);
    </script>
  </body>
</html>

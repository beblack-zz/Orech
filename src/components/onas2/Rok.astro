---
/**
 * Rok dílny na O nás 2 — první rok měsíc po měsíci ve skutečné místnosti
 * (dřív na Domku 2, tady místo svitku emaki). Milníky jsou stejné jako
 * na Úvodu 2 (data/uvod2.ts — milniky), jen se dějí v suterénu zeleného
 * domu: v únoru je tu garáž s vytaženými sekčními vraty, prasklou trubkou
 * pod stropem, kaluží a příčkou; v březnu příčka padne, stěny dostanou
 * bílou a taupe a místo vrat přijdou okna; v dubnu kruhy a stoly
 * z kanceláře, v květnu linky s dřezem a kávovarem… Na konci fotka
 * zvenku: kde bývala vrata, jsou okna.
 *
 * Kresba je z Domku 2 (domek2/kresba/dilna.ts, režim „rok“). Scéna je na
 * jednu obrazovku a měsíce se přepínají kliknutím — tlačítky, šipkami po
 * stranách nebo na klávesnici; scroll s ní nehýbe (scripts/uvod2/rok.ts,
 * stejný skript jako na Úvodu 2).
 * Obloha nad rokem jde z noci do večera jako dřív nad svitkem (onas2.ts —
 * sceny).
 *
 * Od dubna, kdy přijdou stoly a židle, sedí na černém opěradle židle vedle
 * kruhu schovaná Kapka — černá na černém a nehybná. Patří do hry na hledání kami
 * (schovej v parta2/sber.ts, voláno z scripts/onas2/hlavni.ts).
 */
import { Image } from "astro:assets";
import Kami from "../parta2/Kami.astro";
import KapkaSchovka from "../characters/schovka/Kapka.astro";
import { dilna, DILNA_W, DILNA_H } from "../domek2/kresba/dilna";
import { milniky, sezonaMesice } from "../../data/uvod2";
import { sceny } from "../../data/onas2";
import { kurzy } from "../../data/rezervace";
import foto6673 from "../../../images/Dilna/6673.jpg";

const d = dilna("rok", "dr");
const W = DILNA_W;
const H = DILNA_H;
const postava = (id: string, nasobek = 1.45) => {
  const k = d.kami[id];
  const w = k.w * nasobek;
  return `left:${(((k.x - w / 2) / W) * 100).toFixed(3)}%;bottom:${(((H - k.pata - w * 0.12) / H) * 100).toFixed(3)}%;width:${((w / W) * 100).toFixed(3)}%`;
};

/* Kurzy jsou zvláštní vlaky z Rezervace: jezdí v sobotu, termíny jsou v jízdním řádu */
const ted = kurzy.length
  ? `v sobotu jezdí zvláštní vlaky — ${kurzy.map((k) => k.nazev).join(" a ")}`
  : "chystáme další termíny";

/* Kam se v každém měsíci dívá kamera: střed x, y a kolik ze scény (viewBox 1600 × 1000) */
const kamery = [
  "690,560,1200,620",
  "800,500,1300,640",
  "760,600,1000,420",
  "430,500,980,520",
  "800,520,860,440",
  "1150,620,820,480",
  "1180,560,760,520",
  "760,620,1420,700",
  d.kamery.prehled.join(","),
];
const kroky = [
  ...milniky.map((m) => ({ m: m.m, mesic: m.mesic, text: m.text, sezona: sezonaMesice(m.m) })),
  { m: 10, mesic: "Teď", text: ted, sezona: sezonaMesice(new Date().getMonth() + 1) },
];
const vsech = kroky.length + 1;
---
<section class="rok dm-rok" id="rok" aria-labelledby="rok-nadpis" style={`--kroku:${vsech}`}>
  {kroky.map((_, i) => (
    <span class="rok-kotva" data-hodina={sceny[i]?.hodina ?? 18.3} style={`top:${(((i + 0.5) / vsech) * 100).toFixed(2)}%`} aria-hidden="true"></span>
  ))}
  <span class="rok-kotva" data-hodina="18.6" style="top:96%" aria-hidden="true"></span>

  <div class="rok-scena" data-sezona={kroky[0].sezona}>
    <div class="rok-ram">
      <div class="rok-svet">
        <div class="rez rez-rok dm-rez" data-rez="rok">
          <svg class="rez-kresba" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" set:html={d.svg} />
          <div class="rez-parta">
            <span class="rok-kami" data-od="2" data-do="5"><Kami id="kapka" class="rez-kami" style={postava("kapka-kaluz", 1.6)} /></span>
            <span class="rok-kami" data-od="5"><Kami id="kapka" class="rez-kami" style={postava("kapka")} /></span>
            <span class="rok-kami" data-od="8"><Kami id="pecinka" class="rez-kami" style={postava("pecinka")} /></span>
            <span class="rok-kami" data-od="8"><Kami id="hlinka" class="rez-kami" style={postava("hlinka")} /></span>
            {/* Kapka na černém opěradle židle u kruhu: spodek kresby na spodní hraně opěradla (y 581) */}
            <span class="rok-kami" data-od="4">
              <button type="button" class="skryty rok-skryta-kapka" data-skryty="kapka" aria-label="Někdo se tu schovává" style={`left:${((575 / W) * 100).toFixed(3)}%;top:${((561 / H) * 100).toFixed(3)}%;width:${((30 / W) * 100).toFixed(3)}%;animation:none`}>
                <KapkaSchovka barva="cerna" poza="vykukuje" size={30} class="schovka-staticka" />
              </button>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="rok-hlava">
      <p class="stitek">2026 · tak jde čas</p>
      <h2 id="rok-nadpis" class="nadpis-2">Začalo to vodovodní havárií.</h2>
    </div>

    <ol class="rok-kroky">
      {kroky.map((k, i) => (
        <li class="rok-krok" data-krok={i} data-m={k.m} data-sezona={k.sezona} data-kamera={kamery[i] ?? kamery[kamery.length - 1]}>
          <button type="button" class="rok-mesic">{k.mesic}</button>
          <p class="rok-text"><b>{k.mesic}</b> {k.text}</p>
        </li>
      ))}
    </ol>

    {/* Šipky po stranách: o měsíc zpět a dál (scripts/uvod2/rok.ts) */}
    <button type="button" class="rok-sipka rok-sipka-zpet" aria-label="Předchozí měsíc" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19" /></svg>
    </button>
    <button type="button" class="rok-sipka rok-sipka-dal" aria-label="Další měsíc">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19" /></svg>
    </button>

    <figure class="rok-foto">
      <Image src={foto6673} alt="Okna dílny zvenku: prosklené dveře a dvě pole s nadsvětlíky pod balkonem, před nimi truhlíky s vřesem na šikmé desce a dlažba" width={1100} widths={[480, 760, 1100]} sizes="(min-width: 861px) 30vw, 72vw" format="webp" />
      <figcaption>Kde bývala vrata, jsou teď okna.</figcaption>
    </figure>
  </div>
</section>

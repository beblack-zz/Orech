---
/**
 * Filtry a přechody pro kresby tuší na /o-nas-2 — jednou, všude se na ně
 * jen odkazuje. #tus-hrana roztřepí okraj tahu, jako když se tuš vpije
 * do papíru, #tus-rozpit rozmaže skvrny, #zlato-plisek je plátek zlata.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <filter id="tus-hrana" x="-3%" y="-3%" width="106%" height="106%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="5" result="vlna" />
      <feDisplacementMap in="SourceGraphic" in2="vlna" scale="3.2" xChannelSelector="R" yChannelSelector="G" result="tah" />
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="2" result="zrno" />
      <feDisplacementMap in="tah" in2="zrno" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="tus-rozpit" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="5" />
    </filter>
    <linearGradient id="zlato-plisek" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFF0B0" />
      <stop offset="0.45" stop-color="#E8B440" />
      <stop offset="1" stop-color="#B5862A" />
    </linearGradient>
  </defs>
</svg>

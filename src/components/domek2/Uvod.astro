---
/**
 * První obrazovka Domku 2 — svítání nad Ořechem jako na Partě 2 (kopce,
 * pole, posvátný ořech, v trávě celá parta), jen na stráni stojí zelený
 * dům z Luční (Krajina s `dum="domek"`) a text je z Úvodu 2 (Brana.astro).
 * Pod ní začíná ulice: dojde se k bráně a rampou dolů do dílny.
 *
 * Styly jsou z parta2.css (.uvod…), tady přibyla jen tlačítka.
 */
import Krajina from "../parta2/Krajina.astro";
import Kami from "../parta2/Kami.astro";
import { kontakt } from "../../data/uvod2";
import { parta } from "../../data/parta";
import type { PostavaId } from "../../data/parta";

/** Kolik stupňů umí pec — číslo je jen v Pecinčině profilu, tak se vytáhne odtud (jako na Úvodu 2) */
const pecinka = parta.find((p) => p.id === "pecinka");
const stupne = pecinka?.bio.match(/(\d[\d\s]*\d)\s*stup/)?.[1]?.replace(/\s/g, " ");

/** Pořadí v trávě a o kolik je kdo větší — stejně jako na Partě 2 */
const skupina: { id: PostavaId; v: number; dole: number }[] = [
  { id: "kachlik", v: 0.92, dole: 10 },
  { id: "vazicka", v: 1.0, dole: 4 },
  { id: "kapka", v: 0.86, dole: 14 },
  { id: "pecinka", v: 1.16, dole: 2 },
  { id: "hlinka", v: 0.95, dole: 8 },
  { id: "stripek", v: 0.9, dole: 13 },
  { id: "cedulka", v: 0.98, dole: 5 },
  { id: "bublinka", v: 0.86, dole: 12 },
  { id: "samotka", v: 1.06, dole: 3 },
];
---
<section class="uvod dm-uvod" id="uvod" data-hodina="6.2" aria-labelledby="uvod-nadpis">
  <Krajina dum="domek" seed={4} id="dmu" />

  <div class="uvod-parta">
    {skupina.map((k) => (
      <Kami id={k.id} class="uvod-kami" style={`--v:${k.v};--dole:${k.dole}px`} />
    ))}
  </div>

  <div class="uvod-text">
    <p class="stitek stitek-svetly">Keramická dílna · {kontakt.obec} · od 2026</p>
    <h1 id="uvod-nadpis" class="uvod-nadpis">
      Tvoříme keramiku tam, kde má hlína
      <em>čas.</em>
    </h1>
    <p class="uvod-perex">
      Kurzy pro začátečníky i pokročilé, open studio a pec{stupne && <>, která umí až {stupne}&nbsp;°C</>}.
      Malá dílna v Ořechu — pojď dál.
    </p>
    <div class="dm-uvod-akce">
      <a class="tlacitko" href="/kurzy-2#hledac">Najít svůj kurz</a>
      <a class="tlacitko tlacitko-obrys" href="/#odjezdy">Nejbližší termíny</a>
    </div>
    <a class="uvod-dolu" href="#ulice">
      <span>Sejdi k zelenému domu</span>
      <svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 4 V32 M4 24 L12 34 L20 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <p class="uvod-tategaki" lang="ja" aria-hidden="true">土と時間</p>
</section>

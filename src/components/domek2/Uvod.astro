---
/**
 * První obrazovka webu (úvod Domku 2) — svítání nad Ořechem. Vpravo jako
 * rám stojí starý ořešák s veverkou v dutině, uprostřed na pahorku zelený
 * dům z Luční, za ním pole a vesnička v ranní mlze, vpředu louka. Strom,
 * pole i louka se mění s ročním obdobím (UvodKrajina, kresby v kresba/).
 * Text je z Úvodu 2 (Brana.astro). Nad loukou létá Vázička (01 Kami
 * z /marcel) a schovává se za dům, strom a do trávy
 * (scripts/domek2/let-kami.ts).
 * Pod ní začíná ulice: dojde se k bráně a rampou dolů do dílny.
 *
 * Styly jsou z parta2.css (.uvod…), rozložení krajiny, tlačítka a pořadí
 * vrstev pro schovávání jsou v domek2.css.
 */
import UvodKrajina from "./UvodKrajina.astro";
import VazickaGejsa from "../characters/kami-buh/VazickaGejsa.astro";
import { kontakt, sezonaMesice } from "../../data/uvod2";
import { parta } from "../../data/parta";

/** Roční období podle data buildu — skript ho v prohlížeči srovná podle dneška (hlavni.ts) */
const sezona = sezonaMesice(new Date().getMonth() + 1);

/** Kolik stupňů umí pec — číslo je jen v Pecinčině profilu, tak se vytáhne odtud (jako na Úvodu 2) */
const pecinka = parta.find((p) => p.id === "pecinka");
const stupne = pecinka?.bio.match(/(\d[\d\s]*\d)\s*stup/)?.[1]?.replace(/\s/g, " ");
---
<section class="uvod dm-uvod" id="uvod" data-hodina="6.2" data-sezona={sezona} aria-labelledby="uvod-nadpis">
  <UvodKrajina />

  <div class="let-kami"><VazickaGejsa varianta="let" /></div>

  <div class="uvod-text">
    <p class="stitek stitek-svetly">Keramická dílna · {kontakt.obec} · od 2026</p>
    <h1 id="uvod-nadpis" class="uvod-nadpis">
      Tvoříme keramiku tam, kde má hlína
      <em>čas.</em>
    </h1>
    <p class="uvod-perex">
      Kurzy pro začátečníky i pokročilé, open studio a pec{stupne && <>, která umí až {stupne}&nbsp;°C</>}.
      Malá dílna v Ořechu — pojď dál.
    </p>
    <div class="dm-uvod-akce">
      <a class="tlacitko" href="/kurzy-2#hledac">Najít svůj kurz</a>
      <a class="tlacitko tlacitko-obrys" href="/#odjezdy">Nejbližší termíny</a>
    </div>
    <a class="uvod-dolu" href="#ulice">
      <span>Sejdi k zelenému domu</span>
      <svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 4 V32 M4 24 L12 34 L20 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <p class="uvod-tategaki" lang="ja" aria-hidden="true">土と時間</p>
</section>

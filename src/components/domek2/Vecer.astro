---
/**
 * Večer v Luční. Tentýž dům jako ráno, jen se setmělo: kresba projde
 * barevnou maticí do modra a přes ni se rozsvítí, co doopravdy svítí —
 * lampa nad chodníkem, okna v podkroví, okna dílny dole za bránou. Po
 * chodníku jde průvod s lucerničkami — malá kami z party, každé s lucerničkou
 * na tyčce (jako na /marcel). Lehká verze: žádné motory scén, klik na kami
 * obsluhuje initKami, který na úvodu běží tak jako tak. Bohatý průvod
 * s podobami „Lampion“ je na KAMI partě. Kachlík a Šamotka zůstali u pece.
 * Vedle je kontakt.
 */
import Kami from "../parta2/Kami.astro";
import Lucernicka from "../parta2/Lucernicka.astro";
import { ulice, ULICE } from "./kresba/ulice";
import { kontakt, mapa, oDilne } from "../../data/uvod2";
import type { PostavaId } from "../../data/parta";
import type { Sezona } from "../../data/uvod2";

interface Props {
  /** Roční období jako ráno na ulici — stromy, hlohyně a sníh v kresbě */
  sezona: Sezona;
}
const { sezona } = Astro.props;
const V = ULICE.hero;
const kresba = ulice({ id: "uln", noc: true, pristavek: true });
/** Pořadí v průvodu */
const pruvod: PostavaId[] = ["vazicka", "kapka", "pecinka", "hlinka", "stripek", "cedulka", "bublinka"];
---
<section class="noc dm-vecer" id="kontakt" data-hodina="22.6" data-sezona={sezona} aria-labelledby="vecer-nadpis">
  <div class="noc-scena dm-vecer-scena">
    <div class="dm-vecer-dum">
      <svg class="dm-vecer-kresba" viewBox={`${V.x} ${V.y} ${V.w} ${V.h}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" set:html={kresba} />
    </div>

    <div class="pruvod" role="group" aria-label="Večerní průvod s lucerničkami — klikni na kohokoli">
      {pruvod.map((id, i) => (
        <div class="pruvod-clen" style={`--i:${i}`}>
          <Lucernicka />
          <Kami id={id} class="pruvod-kami" />
        </div>
      ))}
    </div>
  </div>

  <div class="noc-karta papir">
    <p class="stitek">{oDilne.vitani}</p>
    <h2 id="vecer-nadpis" class="nadpis-2">Dílna zhasíná, lampa svítí.</h2>
    <p class="noc-perex">Brána je na noc zavřená. Napiš nám nebo zavolej — domluvíme se.</p>
    <div class="noc-akce">
      <a class="tlacitko" href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      <a class="tlacitko tlacitko-obrys" href={`tel:${kontakt.telefonOdkaz}`}>{kontakt.telefon}</a>
    </div>
    <p class="noc-adresa">
      {kontakt.ulice} · {kontakt.psc} {kontakt.obec} ·
      <a href={mapa} target="_blank" rel="noopener">ukázat na mapě</a>
    </p>
    <p class="noc-parta">Ti s lucerničkami? Kami z dílny — sedm z devíti, Kachlík a Šamotka hlídají pec. <a href="/parta#pruvod">Celý průvod s lampiony je na KAMI partě <span aria-hidden="true">→</span></a></p>
  </div>
</section>

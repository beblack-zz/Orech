---
/**
 * Večer v Luční. Tentýž dům jako ráno, jen se setmělo: kresba projde
 * barevnou maticí do modra a přes ni se rozsvítí, co doopravdy svítí —
 * lampa nad chodníkem, okna v podkroví, okna dílny dole za bránou. Po
 * chodníku jde průvod s lampiony — přehnané podoby „Lampion“ z /marcel
 * (každá je kresba bez pozadí s vlastním skriptem a chodí na místě, dopředu
 * je posouvá CSS). Kachlík a Šamotka lampion nemají, zůstali u pece.
 * Vedle je kontakt.
 */
import VazickaGejsa from "../characters/kami-buh/VazickaGejsa.astro";
import KapkaHrom from "../characters/kami-buh/KapkaHrom.astro";
import StripekZlato from "../characters/kami-buh/StripekZlato.astro";
import PecinkaOhen from "../characters/kami-buh/PecinkaOhen.astro";
import BublinkaStrasidlo from "../characters/kami-buh/BublinkaStrasidlo.astro";
import HlinkaZeme from "../characters/kami-buh/HlinkaZeme.astro";
import CedulkaEma from "../characters/kami-buh/CedulkaEma.astro";
import { ulice, ULICE } from "./kresba/ulice";
import { kontakt, mapa, oDilne } from "../../data/uvod2";

const V = ULICE.hero;
const kresba = ulice({ id: "uln", noc: true });
/** Pořadí v průvodu; každá podoba má na stránce pevná id, smí tu být jen jednou */
const pruvod = [VazickaGejsa, KapkaHrom, PecinkaOhen, HlinkaZeme, StripekZlato, CedulkaEma, BublinkaStrasidlo];
---
<section class="noc dm-vecer" id="kontakt" data-hodina="22.6" aria-labelledby="vecer-nadpis">
  <div class="noc-scena dm-vecer-scena">
    <div class="dm-vecer-dum">
      <svg class="dm-vecer-kresba" viewBox={`${V.x} ${V.y} ${V.w} ${V.h}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" set:html={kresba} />
    </div>

    <div class="pruvod dm-pruvod" role="group" aria-label="Večerní průvod s lampiony" style={`--clenu:${pruvod.length}`}>
      {pruvod.map((Podoba, i) => (
        <div class="pruvod-clen dm-pruvod-clen" style={`--i:${i}`}>
          <Podoba varianta="lampion" class="dm-pruvod-kresba" />
        </div>
      ))}
    </div>
  </div>

  <div class="noc-karta papir">
    <p class="stitek">{oDilne.vitani}</p>
    <h2 id="vecer-nadpis" class="nadpis-2">Dílna zhasíná, lampa svítí.</h2>
    <p class="noc-perex">Brána je na noc zavřená. Napiš nám nebo zavolej — domluvíme se.</p>
    <div class="noc-akce">
      <a class="tlacitko" href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      <a class="tlacitko tlacitko-obrys" href={`tel:${kontakt.telefonOdkaz}`}>{kontakt.telefon}</a>
    </div>
    <p class="noc-adresa">
      {kontakt.ulice} · {kontakt.psc} {kontakt.obec} ·
      <a href={mapa} target="_blank" rel="noopener">ukázat na mapě</a>
    </p>
    <p class="noc-parta">Ti s lampiony? Kami z dílny — sedm z devíti, Kachlík a Šamotka hlídají pec. <a href="/parta-2">Seznam se s partou <span aria-hidden="true">→</span></a></p>
    <p class="noc-parta">Stejný dům, jen kreslený jinak: <a href="/uvod-2">Úvod 2</a> · <a href="/parta-2">Parta 2</a></p>
  </div>
</section>

---
/**
 * Krámek na úvodu (od 19. 11. 2026 přízemí krámku místo rozbitého talíře
 * se střepy). Vlevo text na papíru, vpravo přízemí nočního krámku z /obchod:
 * řada lampionů, levá výloha s kusy z naší dílny (zatím zabalené v novinách),
 * dveře a pravá výloha s keramikou z Japonska. Noren ジロ作 nad dveřmi
 * je od 19. 11. 2026 v kresbě krámku v barvách norenu z dílny.
 *
 * Žádný scroll ani těžká kresba: jeden obrázek a tři odkazy přes
 * výlohy a dveře; po najetí se výloha rozsvítí
 * (styles/uvod-ochutnavky.css, předpona uk-).
 *
 * Obrázek je fotka živého krámku (src/images/kramek-prizemi.webp, vyrábí
 * ho scripts/kramek-uvod-foto.mjs — kusy z Japonska při tom přestěhuje
 * do pravé výlohy; po změně krámku pustit znovu). Místa níž jsou
 * v procentech toho obrázku. Na telefonu je text nad krámkem.
 */
import { Image } from "astro:assets";
import TlacitkoNebe from "../parta2/TlacitkoNebe.astro";
import kramekPrizemi from "../../images/kramek-prizemi.webp";
import { zJaponska, zDilny } from "../../data/kramek";
import { pocetKusu } from "../../data/pocty";
import type { Sezona } from "../../data/uvod2";

interface Props {
  sezona: Sezona;
}
const { sezona } = Astro.props;

/** Obdélníky v % obrázku: [left, top, width, height] */
const misto = ([l, t, w, h]: number[]) => `left:${l}%;top:${t}%;width:${w}%;height:${h}%`;
const MISTA = {
  dilna: [7.5, 22.5, 25.8, 69.5],
  dvere: [38.8, 21, 22, 72],
  japonsko: [66.6, 22.5, 25.9, 69.5],
  /* cedulka „z naší dílny“ nakreslená v pravé výloze — přelepí ji „z Japonska“ */
  cedulka: [81, 50.2, 9.8, 4.8],
};

---
<section class="uo uo-kramek" id="kramek" data-hodina="19.4" data-sezona={sezona} aria-labelledby="uo-kramek-nadpis">
  <div class="uk-rozvrh">
    <div class="uk-text papir">
      <p class="stitek"><span lang="ja">うつわ屋</span> · krámek</p>
      <h2 id="uo-kramek-nadpis" class="uk-nadpis">Ne všechno přežije pec. <em>Co ano, je v krámku.</em></h2>
      <p class="uk-perex">Vlevo misky, hrnky a vázy z naší dílny, vpravo pár kusů z japonských pecí — Hagi, Shigaraki, Banko.</p>
      <TlacitkoNebe href="/obchod" nebe="noc">Do krámku</TlacitkoNebe>
    </div>

    <div class="uk-prizemi">
      <div class="uk-kramek">
        <Image class="uk-foto" src={kramekPrizemi} alt="" width={900} widths={[480, 720, 960, 1300, 1800]} sizes="(min-width: 861px) 60vw, 100vw" format="webp" quality={82} loading="lazy" />
        <a class="uk-zona uk-zona-dilna" href="/obchod#tvorba" style={misto(MISTA.dilna)} aria-label={`Výloha vlevo: z naší dílny, ${pocetKusu(zDilny.length)}`}></a>
        <a class="uk-zona uk-zona-japonsko" href="/obchod#japonsko" style={misto(MISTA.japonsko)} aria-label={`Výloha vpravo: z Japonska, ${pocetKusu(zJaponska.length)}`}></a>
        <a class="uk-zona uk-zona-dvere" href="/obchod" style={misto(MISTA.dvere)} aria-label="Vejít do krámku"></a>
        <span class="uk-cedulka" style={misto(MISTA.cedulka)} aria-hidden="true">z Japonska</span>
      </div>

      <div class="uk-popisky">
        <a class="uk-popisek" href="/obchod#tvorba"><span lang="ja">手作り</span> z naší dílny</a>
        <a class="uk-popisek" href="/obchod#japonsko"><span lang="ja">航空便</span> z Japonska</a>
      </div>
    </div>
  </div>
</section>

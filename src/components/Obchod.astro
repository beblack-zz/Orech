---
import SectionHead from "./SectionHead.astro";
import ProduktTvar from "./ProduktTvar.astro";
import { produkty } from "../data/obchod";
import { pocetKusu } from "../data/pocty";

// Homepage ukazuje ochutnávku, celý sortiment je na /obchod
const items = produkty.slice(0, 4);

---

<section class="py-14 relative fade-up">
  <div class="container-x">
    <SectionHead title="Z našich" italic="rukou" meta={`Obchod · ${pocetKusu(produkty.length)}`} metaLink="/obchod" metaLinkText="Zobrazit vše" />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {items.map((it) => (
        <a href="/obchod" class="bg-white rounded-xl border border-espresso/8 relative group">
          {it.tag && (
            <span class={`absolute -top-2 left-3 font-mono text-[12px] font-medium px-2.5 py-0.5 rounded-full tracking-wider uppercase z-10 ${
              it.tagKind === "new" ? "bg-mustard text-espresso" : "bg-sakura text-cream"
            }`}>
              {it.tag}
            </span>
          )}
          <div class="aspect-square bg-[#E8D7BF] flex items-center justify-center group-hover:bg-[#DFC8AA] transition-colors rounded-t-xl overflow-hidden">
            <ProduktTvar shape={it.shape} />
          </div>
          <div class="p-3">
            <p class="font-serif text-[16px] font-medium m-0 mb-0.5">{it.name}</p>
            <p class="font-mono text-[12px] text-stone">{it.price}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

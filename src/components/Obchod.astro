---
import SectionHead from "./SectionHead.astro";

const items = [
  { name: "Miska Jaro", price: "640 Kč", tag: "Novinka", tagKind: "new", shape: "bowl" },
  { name: "Váza úzká", price: "1 240 Kč", shape: "vase" },
  { name: "Hrnek Ranní", price: "480 Kč", shape: "mug" },
  { name: "Talíř plochý", price: "720 Kč", tag: "Poslední kus", tagKind: "last", shape: "plate" },
];
---

<section class="py-14 relative fade-up">
  <div class="container-x">
    <SectionHead title="Z našich" italic="rukou" meta="Obchod · 48 kusů" metaLink="/obchod" metaLinkText="Zobrazit vše" />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {items.map((it) => (
        <a href="/obchod" class="bg-white rounded-xl overflow-hidden border border-espresso/8 relative group">
          {it.tag && (
            <span class={`absolute top-2.5 left-2.5 font-mono text-[9px] font-medium px-2 py-0.5 rounded-full tracking-wider uppercase z-10 ${
              it.tagKind === "new" ? "bg-mustard text-espresso" : "bg-clay text-cream"
            }`}>
              {it.tag}
            </span>
          )}
          <div class="aspect-square bg-[#E8D7BF] flex items-center justify-center group-hover:bg-[#DFC8AA] transition-colors">
            {it.shape === "bowl" && (
              <svg width="80" height="80" viewBox="0 0 90 90" fill="none" aria-hidden="true">
                <path d="M15 40 Q15 30 45 30 Q75 30 75 40 L72 78 Q72 84 45 84 Q18 84 18 78 Z" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
                <ellipse cx="45" cy="32" rx="30" ry="4" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
              </svg>
            )}
            {it.shape === "vase" && (
              <svg width="80" height="80" viewBox="0 0 90 90" fill="none" aria-hidden="true">
                <path d="M30 30 Q30 20 45 20 Q60 20 60 30 Q65 55 55 75 Q50 85 45 85 Q40 85 35 75 Q25 55 30 30 Z" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
                <ellipse cx="45" cy="22" rx="15" ry="3" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
              </svg>
            )}
            {it.shape === "mug" && (
              <svg width="80" height="80" viewBox="0 0 90 90" fill="none" aria-hidden="true">
                <path d="M25 35 Q25 28 45 28 Q65 28 65 35 L63 78 Q63 84 45 84 Q27 84 27 78 Z" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
                <ellipse cx="45" cy="30" rx="20" ry="3" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
                <path d="M65 44 Q80 44 80 55 Q80 66 65 66" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
              </svg>
            )}
            {it.shape === "plate" && (
              <svg width="80" height="80" viewBox="0 0 90 90" fill="none" aria-hidden="true">
                <ellipse cx="45" cy="70" rx="35" ry="6" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
                <path d="M10 65 Q10 45 45 45 Q80 45 80 65 Q80 76 45 76 Q10 76 10 65 Z" fill="none" stroke="#3A2E28" stroke-width="1.5"/>
              </svg>
            )}
          </div>
          <div class="p-3">
            <p class="font-serif text-[14px] font-medium m-0 mb-0.5">{it.name}</p>
            <p class="font-mono text-[11px] text-stone">{it.price}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

---
/**
 * 二 Tvar — v ruce (mačkaná miska, válečky, pláty) jako tři vinětky
 * vedle textu a pod kapitolou šest snímků z kruhu: centrování,
 * otevření, vytažení, tvarování, odříznutí a obrábění druhý den.
 * Kreslí kresba/tvar.ts, popisky jsou z dilna.ts.
 *
 * Kresby jsou soubory (pages/kresby/_dilna.ts): dvě vinětky V ruce celé
 * v <img>, u plátů zůstane ve stránce popisek, u snímků z kruhu šipky
 * a stužka, které se hýbou.
 */
import Kapitola from "./Kapitola.astro";
import { kapitoly, naKruhu, vRuce } from "../../data/dilna";
import { odloz } from "../../scripts/parta2/pozdeji";
import { dilna } from "../../pages/kresby/_dilna";

const k = kapitoly.find((x) => x.id === "tvar")!;
const K = dilna().kresby;
const ruce = vRuce.map((v) => ({ ...v, ...K.vRuce[v.id] }));
const kroky = naKruhu.map((x, i) => ({ ...x, svg: K.kruh[i] }));
---
<Kapitola kapitola={k} strana="vlevo" trida="d-kap-tvar">
  <figure class="d-obraz d-vruce">
    <p class="d-obraz-nadpis"><span lang="ja">手びねり</span> V ruce</p>
    <ul class="d-vruce-seznam">
      {ruce.map((v) => (
        <li>
          {v.img ? (
            <span class="d-kresba"><img src={v.img.src} width={v.img.sirka} height={v.img.vyska} alt="" loading="lazy" decoding="async" /></span>
          ) : (
            <span class="d-kresba" set:html={odloz(v.svg ?? "")} />
          )}
          <b>{v.nazev}</b>
          <small>{v.text}</small>
        </li>
      ))}
    </ul>
  </figure>

  <div slot="pod" class="d-kruh">
    <p class="d-obraz-nadpis d-kruh-nadpis"><span lang="ja">轆轤</span> Na kruhu, krok za krokem</p>
    <ol class="d-kruh-kroky">
      {kroky.map((x, i) => (
        <li>
          <span class="d-kresba" set:html={odloz(x.svg)} />
          <b><span class="d-kruh-cislo" aria-hidden="true">{i + 1}</span>{x.nazev}</b>
          <small>{x.text}</small>
        </li>
      ))}
    </ol>
  </div>
</Kapitola>

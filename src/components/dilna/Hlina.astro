---
/**
 * 一 Hlína — kvádr z pytle, hrouda vyhnětená do chryzantémy (kiku-neri)
 * a rozříznutá hrouda s bublinou, ze které vykukuje Bublinka. Pod tím
 * tři vypálené destičky: hrnčířská hlína, kamenina, porcelán.
 *
 * Kresby jsou soubory (pages/kresby/_dilna.ts): destičky celé v <img>,
 * z hroudy zůstane ve stránce jen pochodující kroužek kolem bubliny.
 */
import Kapitola from "./Kapitola.astro";
import Kami from "../parta2/Kami.astro";
import { kapitoly, druhyHliny } from "../../data/dilna";
import { MISTA_HLINA } from "./kresba/hlina";
import { mista } from "./misto";
import { odloz } from "../../scripts/parta2/pozdeji";
import { dilna, HLINA_OREZ, HLINA_H } from "../../pages/kresby/_dilna";

const k = kapitoly.find((x) => x.id === "hlina")!;
/* Kresba je vinětka s prázdným papírem nad deskou — ten se ořízne (viewBox v _dilna.ts) */
const m = mista(900, HLINA_H);
const bublinka = { ...MISTA_HLINA.bublinka, y: MISTA_HLINA.bublinka.y - HLINA_OREZ };
const { hlina, hliny } = dilna().kresby;
---
<Kapitola kapitola={k} strana="vpravo" trida="d-kap-hlina">
  <figure class="d-obraz">
    <div class="d-obraz-kresba">
      <div class="d-kresba" set:html={odloz(hlina)} />
      <Kami id="bublinka" class="d-kami-nad" style={m.kami(bublinka)} />
    </div>
    <figcaption>Kvádr z pytle, hrouda vyhnětená do květu chryzantémy a rozříznutá hrouda. V té je bublina — v peci by bouchla.</figcaption>
  </figure>
  <figure class="d-obraz d-hliny">
    <div class="d-kresba"><img src={hliny.src} width={hliny.sirka} height={hliny.vyska} alt="" loading="lazy" decoding="async" /></div>
    <figcaption>
      <ul class="d-hliny-popis">
        {druhyHliny.map((d) => (
          <li><b>{d.nazev}</b> <span>{d.teplota}</span> <small>{d.text}</small></li>
        ))}
      </ul>
    </figcaption>
  </figure>
</Kapitola>

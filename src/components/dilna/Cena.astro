---
/**
 * Kolik to stojí a co je v ceně. Cena visí na dřevěné ceduli kanban jako
 * u japonského krámku; vedle papír s tím, co je v ceně, a vpravo lístek
 * s pravidly dílny připíchnutý na dveřích a kávovar z kuchyňky — kafe
 * je samozřejmost.
 *
 * Cena, dny a velikost skupiny jsou z rezervace.ts, seznamy z dilna.ts.
 * „Darovat hodinu“ vede na dárkové jízdenky na Rezervaci.
 */
import Kami from "../parta2/Kami.astro";
import { kdy, vCene, pravidla } from "../../data/dilna";
import { kontakt } from "../../data/uvod2";
---
<section class="d-sekce d-cena" id="cena" data-hodina="12.8" aria-labelledby="cena-nadpis">
  <div class="d-cena-mriz">
    <div class="d-kanban" aria-hidden="true">
      <span class="d-kanban-provaz"></span>
      <div class="d-kanban-deska">
        <span class="d-kanban-znak" lang="ja">一時間</span>
        <b class="d-kanban-cena">{kdy.cenaSam}</b>
        <span class="d-kanban-za">za hodinu<br />ve čtyřech {kdy.cenaOd}</span>
        <span class="d-kanban-minut">hodina = {kdy.minut} minut</span>
      </div>
    </div>

    <div class="d-cena-papir papir">
      <p class="stitek"><span lang="ja">値段</span> · cena</p>
      <h3 id="cena-nadpis" class="nadpis-2">{kdy.cena} za hodinu. <em>Kafe k tomu.</em></h3>
      <p class="d-cena-perex">
        Za člověka a hodinu, každé {kdy.dny} od {kdy.hodiny.replace("–", " do ")} hodin. Jen ta hodina je
        u nás delší, než bývá: tvoříme tam, kde má hlína čas, a ten v dílně plyne tak pomalu, že hodina
        trvá {kdy.minut} minut. Na hodinu jsou v dílně {kdy.mist} místa a čím víc lidí na ni nakonec přijde,
        tím míň platí každý: {kdy.tarif}; {kdy.deti}. Platí se na místě. S lektorem i bez něj stojí stejně.
      </p>
      <p class="d-mezititulek">V ceně je</p>
      <ul class="d-vcene">
        {vCene.map((v) => (
          <li><b>{v.co}</b> <span>{v.pozn}</span></li>
        ))}
      </ul>
      <div class="d-cta">
        <a class="tlacitko" href="/rezervace">Vybrat hodinu</a>
        <a class="tlacitko tlacitko-obrys" href="/rezervace#rz-darky">Darovat hodinu</a>
      </div>
      <p class="d-cena-pozn">
        Chceš v dílně víc času? Zamluv si dvě hodiny po sobě. A kdyby ti nic z toho nesedělo,
        <a href={`mailto:${kontakt.email}`}>napiš nám</a> — domluvíme se.
      </p>
    </div>

    <div class="d-cena-bok">
      <div class="d-pravidla">
        <span class="d-pravidla-pripinacek" aria-hidden="true"></span>
        <h3 class="d-pravidla-nadpis"><span lang="ja" aria-hidden="true">規則</span> Pravidla dílny</h3>
        <ol>
          {pravidla.map((p) => <li>{p}</li>)}
        </ol>
        <p class="d-pravidla-podpis" aria-hidden="true">— Jiřík &amp; Renča</p>
      </div>

      <div class="d-kafe" aria-hidden="true">
        <svg class="d-kafe-kresba" viewBox="0 0 260 220">
          <defs>
            <linearGradient id="dkf-telo" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#151515" />
              <stop offset="0.4" stop-color="#3A3A3A" />
              <stop offset="1" stop-color="#121212" />
            </linearGradient>
            <linearGradient id="dkf-hrnek" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#5E7C68" />
              <stop offset="0.35" stop-color="#C6DCC4" />
              <stop offset="0.6" stop-color="#93B39B" />
              <stop offset="1" stop-color="#5E7C68" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="260" height="190" fill="#E9DFCC" />
          <g stroke="#D6C9B0" stroke-width="1">
            <path d="M0 50 H260 M0 110 H260 M0 170 H260 M65 0 V190 M195 0 V190 M130 0 V50 M130 110 V170" />
          </g>
          <rect x="0" y="190" width="260" height="12" fill="#C49A6C" />
          <rect x="0" y="202" width="260" height="18" fill="#3D4246" />
          {/* Kávovar */}
          <rect x="72" y="14" width="116" height="176" rx="11" fill="url(#dkf-telo)" />
          <rect x="84" y="28" width="92" height="28" rx="4" fill="#0E1512" />
          <text x="130" y="47" text-anchor="middle" font-size="11" fill="#7CFFA0" font-family="ui-monospace, Consolas, monospace">PŘIPRAVENO</text>
          <g fill="#444"><circle cx="98" cy="72" r="5" /><circle cx="116" cy="72" r="5" /><circle cx="144" cy="72" r="5" /><circle cx="162" cy="72" r="5" /></g>
          <circle class="d-kafe-kontrolka" cx="130" cy="72" r="3.5" fill="#7CFFA0" />
          <rect x="104" y="90" width="52" height="20" rx="4" fill="#1C1C1C" />
          <rect x="118" y="108" width="24" height="8" rx="3" fill="#0C0C0C" />
          <rect x="88" y="178" width="84" height="8" rx="3" fill="#2A2A2A" />
          {/* Hrnek z dílny */}
          <path d="M152 146 C166 146 166 168 151 168" stroke="#93B39B" stroke-width="5" fill="none" stroke-linecap="round" />
          <path d="M108 146 L110 174 Q110 178 114 178 L146 178 Q150 178 150 174 L152 146 Z" fill="url(#dkf-hrnek)" />
          <ellipse cx="130" cy="146" rx="22" ry="5" fill="#4A2C18" />
          <ellipse cx="130" cy="146" rx="22" ry="5" fill="none" stroke="#C6DCC4" stroke-width="1.4" />
          <g class="d-kafe-para" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.85">
            <path d="M120 138 C114 126 126 120 120 106" />
            <path d="M130 136 C124 122 136 116 130 98" />
            <path d="M140 138 C134 126 146 120 140 106" />
          </g>
        </svg>
        <p class="d-kafe-text">Kafe je samozřejmost.</p>
      </div>
      <Kami id="kapka" class="d-kafe-kami" />
    </div>
  </div>
</section>

---
/**
 * Kolik to stojí a co je v ceně. Cena visí na dřevěné ceduli kanban jako
 * u japonského krámku; vedle papír s tím, co je v ceně, a kávovar
 * z kuchyňky — kafe je samozřejmost, tak se na něj dá postavit
 * (scripts/dilna/kafe.ts). O kávovar je opřená jedna ze zkoušek glazur.
 *
 * Cena, dny a velikost skupiny jsou z rezervace.ts, seznam z dilna.ts.
 */
import Kami from "../parta2/Kami.astro";
import Zkouska from "./Zkouska.astro";
import { kdy, vCene } from "../../data/dilna";
import { kontakt } from "../../data/uvod2";
---
<section class="d-sekce d-cena" id="cena" data-hodina="18" aria-labelledby="cena-nadpis">
  <div class="d-cena-mriz">
    <div class="d-kanban" aria-hidden="true">
      <span class="d-kanban-provaz"></span>
      <div class="d-kanban-deska">
        <span class="d-kanban-znak" lang="ja">一時間</span>
        <b class="d-kanban-cena">{kdy.cena}</b>
        <span class="d-kanban-za">za člověka<br />a hodinu</span>
      </div>
    </div>

    <div class="d-cena-papir papir">
      <p class="stitek"><span lang="ja">値段</span> · cena</p>
      <h2 id="cena-nadpis" class="nadpis-2">{kdy.cena} za hodinu. <em>Kafe k tomu.</em></h2>
      <p class="d-cena-perex">
        Za člověka a hodinu, každé {kdy.dny} od {kdy.hodiny.replace("–", " do ")} hodin. Hodina se zamlouvá
        celá — přijdeš {kdy.skupina} a dílna je ta hodina vaše.
      </p>
      <p class="d-vcene-nadpis">V ceně je</p>
      <ul class="d-vcene">
        {vCene.map((v) => (
          <li><b>{v.co}</b> <span>{v.pozn}</span></li>
        ))}
      </ul>
      <div class="d-cta">
        <a class="tlacitko" href="/rezervace">Vybrat hodinu</a>
        <a class="tlacitko tlacitko-obrys" href="/kurzy-2#poukaz">Darovat hodinu</a>
      </div>
      <p class="d-cena-pozn">
        Chceš v dílně víc času? Zamluv si dvě hodiny po sobě. A kdyby ti nic z toho nesedělo,
        <a href={`mailto:${kontakt.email}`}>napiš nám</a> — domluvíme se.
      </p>
    </div>

    <div class="d-kafe papir" data-kafe>
      <p class="stitek"><span lang="ja">茶</span> · kuchyňka</p>
      <div class="d-kafe-scena">
        <svg class="d-kafe-kresba" viewBox="0 0 260 280" aria-hidden="true">
          <defs>
            <linearGradient id="kf-telo" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#151515" />
              <stop offset="0.4" stop-color="#3A3A3A" />
              <stop offset="1" stop-color="#121212" />
            </linearGradient>
            <linearGradient id="kf-hrnek" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#5E7C68" />
              <stop offset="0.35" stop-color="#C6DCC4" />
              <stop offset="0.6" stop-color="#93B39B" />
              <stop offset="1" stop-color="#5E7C68" />
            </linearGradient>
            <clipPath id="kf-hrnek-vnitrek"><ellipse cx="130" cy="196" rx="25.5" ry="5.6" /></clipPath>
          </defs>
          {/* Deska linky a obklad */}
          <rect x="0" y="0" width="260" height="246" fill="#E9DFCC" />
          <g stroke="#D6C9B0" stroke-width="1">
            <path d="M0 60 H260 M0 120 H260 M0 180 H260 M65 0 V246 M130 0 V60 M195 0 V246 M130 120 V180" />
          </g>
          <rect x="0" y="246" width="260" height="14" fill="#C49A6C" />
          <rect x="0" y="260" width="260" height="20" fill="#3D4246" />
          {/* Kávovar */}
          <rect x="62" y="30" width="136" height="216" rx="12" fill="url(#kf-telo)" />
          <rect x="74" y="20" width="112" height="22" rx="6" fill="#262626" />
          <rect x="80" y="48" width="100" height="34" rx="4" fill="#0E1512" />
          <text class="d-kafe-displej" x="130" y="70" text-anchor="middle" font-size="12" fill="#7CFFA0" font-family="ui-monospace, Consolas, monospace">PŘIPRAVENO</text>
          <g fill="#444"><circle cx="92" cy="98" r="6" /><circle cx="114" cy="98" r="6" /><circle cx="146" cy="98" r="6" /><circle cx="168" cy="98" r="6" /></g>
          <circle class="d-kafe-kontrolka" cx="130" cy="98" r="4" fill="#7CFFA0" />
          <rect x="96" y="120" width="68" height="26" rx="5" fill="#1C1C1C" />
          <rect x="114" y="144" width="32" height="10" rx="3" fill="#0C0C0C" />
          <path class="d-kafe-proud" d="M130 154 V208" stroke="#5A3820" stroke-width="3.4" stroke-linecap="round" />
          <rect x="80" y="232" width="100" height="10" rx="3" fill="#2A2A2A" />
          <g fill="#1A1A1A"><rect x="88" y="234" width="84" height="2" /><rect x="88" y="238" width="84" height="2" /></g>
          {/* Hrnek z dílny */}
          <path d="M157 196 C174 196 174 222 156 222" stroke="#93B39B" stroke-width="6" fill="none" stroke-linecap="round" />
          <path d="M103 196 L105 228 Q105 232 110 232 L150 232 Q155 232 155 228 L157 196 Z" fill="url(#kf-hrnek)" stroke="#3B2A1B" stroke-opacity="0.35" />
          <ellipse cx="130" cy="196" rx="27" ry="6.5" fill="#5E7C68" />
          <g clip-path="url(#kf-hrnek-vnitrek)">
            <ellipse class="d-kafe-hladina" cx="130" cy="214" rx="27" ry="6.5" fill="#4A2C18" />
          </g>
          <ellipse cx="130" cy="196" rx="27" ry="6.5" fill="none" stroke="#C6DCC4" stroke-width="1.6" />
          <g class="d-kafe-para" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round">
            <path d="M118 186 C112 174 124 168 118 154" />
            <path d="M130 184 C124 170 136 164 130 146" />
            <path d="M142 186 C136 174 148 168 142 154" />
          </g>
        </svg>
        <Zkouska id="matná bílá" class="d-kafe-zkouska" style="left:79.4%;top:76.6%;width:7.6%" />
        <Kami id="kapka" class="d-scena-kami d-kafe-kami" style="left:1%;top:62%;width:21%" />
      </div>
      <p class="d-kafe-text" aria-live="polite">Kafe je samozřejmost.</p>
      <button type="button" class="tlacitko tlacitko-maly d-kafe-tlacitko">Postavit na kafe</button>
    </div>
  </div>
</section>

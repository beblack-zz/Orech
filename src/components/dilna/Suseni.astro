---
/**
 * 三 Sušení — mokrý kus pod fólií, kožený s čerstvým uchem a suchý,
 * bledý; každý o kus menší (kresba/suseni.ts). Na prkně stojí Kachlík,
 * který hlídá, aby se nic nekroutilo. Vedle dno hrnku s podpisem
 * rydlem — u toho visí Cedulka, ta si pamatuje, čí je který.
 *
 * Statické vrstvy prkna s kusy jsou soubory v <image> (pages/kresby/_dilna.ts),
 * ve stránce zůstanou čárky, fólie, obrys po výpalu a popisky. Podpis
 * (jméno je text v písmu webu) zůstává celý.
 */
import Kapitola from "./Kapitola.astro";
import Kami from "../parta2/Kami.astro";
import { kapitoly } from "../../data/dilna";
import { podpisSvg, MISTA_SUSENI } from "./kresba/suseni";
import { mista } from "./misto";
import { odloz } from "../../scripts/parta2/pozdeji";
import { dilna } from "../../pages/kresby/_dilna";

const k = kapitoly.find((x) => x.id === "suseni")!;
const m = mista(1000, 560);
const { suseni } = dilna().kresby;
---
<Kapitola kapitola={k} strana="vpravo" trida="d-kap-suseni">
  <figure class="d-obraz">
    <div class="d-obraz-kresba">
      <div class="d-kresba" set:html={odloz(suseni)} />
      <Kami id="kachlik" class="d-kami-nad" style={m.kami(MISTA_SUSENI.kachlik)} />
    </div>
    <figcaption>Mokrý pod fólií, kožený s čerstvým uchem, suchý. Každý o kus menší.</figcaption>
  </figure>
  <figure class="d-obraz d-podpis">
    <div class="d-podpis-kresba">
      <div class="d-kresba" set:html={odloz(podpisSvg("Jana"))} />
      <Kami id="cedulka" class="d-podpis-kami" />
    </div>
    <figcaption>Podpis rydlem do dna — tužka by v peci shořela. Cedulka si pamatuje, čí je který.</figcaption>
  </figure>
</Kapitola>

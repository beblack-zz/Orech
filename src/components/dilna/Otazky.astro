---
/**
 * Otázky, na které odpovídá parta — stejný rozhovor jako na Úvodu 2.
 * Ráno po výpalu, než se dílna znovu otevře.
 */
import Postavicka from "../characters/Postavicka.astro";
import { otazky } from "../../data/dilna";
import { parta } from "../../data/parta";

const jmeno = (id: string) => parta.find((p) => p.id === id)?.name ?? id;
---
<section class="d-sekce d-otazky" id="otazky" data-hodina="31.6" aria-labelledby="otazky-nadpis">
  <div class="d-otazky-papir papir">
    <p class="stitek"><span lang="ja">質問</span> · otázky</p>
    <h2 id="otazky-nadpis" class="nadpis-2">Zeptej se dílny</h2>
    <div class="d-chat">
      {otazky.map((o) => (
        <div class="d-chat-radek">
          <p class="d-chat-q">{o.q}</p>
          <div class="d-chat-a">
            <span class="d-chat-kami" aria-hidden="true"><Postavicka id={o.kdo} size={52} varianta="kami" /></span>
            <p><b>{jmeno(o.kdo)}</b>{o.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
/**
 * Úvod Dílny: devět ráno, dílna se otevírá. Vlevo papír s tím
 * podstatným (kdy, za kolik, s kým, kdy je kus hotový), vpravo okno do
 * dílny s regálem, na kterém stojí tentýž hrnek ve všech stavech — od
 * hroudy po vypálený kus (kresba/regal.ts). Štítky pod kusy vedou na
 * kapitoly druhé části. Na regálu spí Hlínka (začátek) a na konci stojí
 * Vázička, nejstarší kus v dílně.
 *
 * Regál je ve stránce jen paprsek, prach a jiskra (hýbou se), zbytek je
 * soubor v <image> (pages/kresby/_dilna.ts); dilna.astro ho stahuje hned
 * s hlavičkou, je na první obrazovce.
 */
import Kami from "../parta2/Kami.astro";
import { KUSY, stitek, MISTA_REGAL, REGAL_W, REGAL_H } from "./kresba/regal";
import { mista } from "./misto";
import { kdy, celkem, kapitoly } from "../../data/dilna";
import { dilna } from "../../pages/kresby/_dilna";

const m = mista(REGAL_W, REGAL_H);
const K = dilna().kresby;
const kapitola = (kam: string) => kapitoly.find((k) => `#${k.id}` === kam)?.nazev ?? "";
---
<section class="d-uvod" id="dilna-uvod" data-hodina="9" aria-labelledby="d-nadpis">
  <p class="d-tategaki" lang="ja" aria-hidden="true">工房</p>
  <div class="d-uvod-mriz">
    <div class="d-uvod-karta papir">
      <p class="stitek"><span lang="ja">工房</span> · dílna v Ořechu</p>
      <h1 id="d-nadpis" class="d-nadpis">Jak to v dílně chodí <em>a jak se z hroudy stane hrnek</em></h1>
      <p class="d-perex">
        Dílna je v suterénu zeleného domu v Ořechu. Každé {kdy.dny} od {kdy.hodiny.replace("–", " do ")} hodin si
        tu zamluvíš místo na hodinu — {kdy.cena} za člověka, čím víc lidí v dílně, tím míň. Lektor je v ceně, a když ho
        nepotřebuješ, je to open studio. Kafe je samozřejmost.
      </p>
      <dl class="d-zaklad">
        <div><dt>Kdy</dt><dd>{kdy.dny}, {kdy.hodiny}</dd></div>
        <div><dt>Za kolik</dt><dd>{kdy.cena} {kdy.zaCo} <small>hodina u nás trvá {kdy.minut} minut</small></dd></div>
        <div><dt>S kým</dt><dd>{kdy.skupina} <small>na hodinu jsou v dílně {kdy.mist} místa</small></dd></div>
        <div><dt>Hotový kus</dt><dd>za {celkem}</dd></div>
      </dl>
      <nav class="d-obsah" aria-label="Co je na stránce">
        <a href="#jak-to-chodi"><span lang="ja" aria-hidden="true">一</span><b>Jak to tu chodí</b><small>hodina, lektor, cesta kusu, cena</small></a>
        <a href="#keramika"><span lang="ja" aria-hidden="true">二</span><b>Jak se dělá keramika</b><small>od hlíny po otevření pece</small></a>
      </nav>
    </div>

    <figure class="d-uvod-scena">
      <div class="d-okno">
        <div class="d-regal" set:html={K.regal} />
        {KUSY.map((k) => {
          const s = stitek(k);
          return (
            <a class="d-stitek" href={k.kam} style={m.bod(s.x, s.y)} aria-label={`${k.nazev} — kapitola ${kapitola(k.kam)}`}>
              <span class="d-stitek-provazek" aria-hidden="true"></span>
              <span class="d-stitek-papir">{k.nazev}</span>
            </a>
          );
        })}
        <Kami id="hlinka" class="d-kami-nad" style={m.kami(MISTA_REGAL.hlinka)} />
        <Kami id="vazicka" class="d-kami-nad" style={m.kami(MISTA_REGAL.vazicka)} />
      </div>
      <div class="d-okno-cedule" aria-hidden="true">
        <span class="d-cedule-provaz"></span>
        <span class="d-cedule-deska"><span lang="ja">工房</span></span>
      </div>
      <figcaption class="d-uvod-popis">Tentýž hrnek od hroudy po hotový kus. Cestou mění barvu, lesk — a zmenšuje se.</figcaption>
    </figure>
  </div>

  <a class="d-dolu" href="#jak-to-chodi">
    <span>Jak to tu chodí</span>
    <svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 4 V32 M4 24 L12 34 L20 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
</section>

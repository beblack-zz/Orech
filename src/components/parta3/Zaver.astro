---
/**
 * Závěr /parta-3: svítání. Lampiony zhasly a parta je zpátky dole na louce
 * před dílnou — tam, kde Parta 2 ráno začíná. Stojí tu malé podoby Na
 * schovávanou; kdo na některou klepne, uslyší, co říká po představení.
 */
import Louka from "../parta2/Louka.astro";
import Dilna from "../parta2/Dilna.astro";
import { more } from "./chram";
import { pecinkaSchovka } from "../characters/schovka/pecinka";
import { bublinkaSchovka } from "../characters/schovka/bublinka";
import { stripekSchovka } from "../characters/schovka/stripek";
import { hlinkaSchovka } from "../characters/schovka/hlinka";
import { cedulkaSchovka } from "../characters/schovka/cedulka";
import { kachlikSchovka } from "../characters/schovka/kachlik";
import { samotkaSchovka } from "../characters/schovka/samotka";
import { vazickaSchovka } from "../characters/schovka/vazicka";
import { kapkaSchovka } from "../characters/schovka/kapka";
import { uid } from "../characters/dospele/uid";
import { parta } from "../../data/parta";
import type { PostavaId } from "../../data/parta";

const mala = {
  hlinka: hlinkaSchovka, bublinka: bublinkaSchovka, kapka: kapkaSchovka, vazicka: vazickaSchovka, kachlik: kachlikSchovka,
  cedulka: cedulkaSchovka, samotka: samotkaSchovka, pecinka: pecinkaSchovka, stripek: stripekSchovka,
} as const;
const jmeno = (id: PostavaId) => parta.find((p) => p.id === id)!.name;
/** Jak stojí v trávě: kdo je o kus větší a kdo níž */
const rada: { id: PostavaId; v: number; dole: number }[] = [
  { id: "kachlik", v: 0.92, dole: 6 },
  { id: "vazicka", v: 1.04, dole: 0 },
  { id: "kapka", v: 0.96, dole: 10 },
  { id: "hlinka", v: 0.9, dole: 4 },
  { id: "pecinka", v: 1.14, dole: 0 },
  { id: "stripek", v: 0.9, dole: 12 },
  { id: "cedulka", v: 0.94, dole: 2 },
  { id: "bublinka", v: 0.86, dole: 16 },
  { id: "samotka", v: 1.1, dole: 0 },
];
---
<section class="p3-zaver" id="rano" data-hodina="5.5" aria-labelledby="zaver-nadpis">
  <div class="p3-zaver-oblaka" aria-hidden="true" set:html={more("mo-zaver", 14, { rad: 2 })} />

  <div class="p3-zaver-text papir">
    <p class="stitek">Svítání · <span lang="ja">夜明け</span></p>
    <h2 id="zaver-nadpis" class="nadpis-2">Ráno jsou zpátky dole.</h2>
    <p>
      Až se rozední, lampiony zhasnou a parta sejde po schodech do dílny. Přes den
      zase hlídá hlínu, vodu a oheň, jako by se nic nedělo. Jen Hlínka je ospalejší
      než jindy a Kapka má na geta ještě trochu oblaku.
    </p>
    <div class="p3-zaver-akce">
      <a class="tlacitko" href="/parta-2">Parta přes den</a>
      <a class="tlacitko tlacitko-obrys" href="/rezervace">Přijít do dílny</a>
    </div>
  </div>

  <div class="p3-zaver-scena">
    <Dilna class="p3-zaver-dilna" />
    <Louka class="p3-zaver-louka" seed={4} />
    <div class="p3-zaver-parta" role="group" aria-label="Parta po představení — klepni na kohokoli">
      {rada.map((k, i) => (
        <button type="button" class="p3-mala" data-mala={k.id} style={`--v:${k.v};--dole:${k.dole}px;--sp-z:${(-i * 0.7).toFixed(1)}s`} aria-label={`${jmeno(k.id)} — co říká po představení`}>
          <Fragment set:html={mala[k.id]({ barva: "logo", velikost: 56, id: uid() })} />
        </button>
      ))}
    </div>
  </div>
</section>

---
/**
 * Divadlo — jeviště kagura-den, střed /parta-3.
 *
 * Kagura je tanec pro bohy; tady hrají bohové sami. Na jevišti stojí všechny
 * kusy večera naráz (každá scéna z /marcel smí být na stránce jen jednou,
 * kvůli pevným id), vidět je vždycky jen ten vybraný — ostatní jsou schované
 * a jejich běh spí. Nad jevištěm visí devět lampionů s erby: kdo svítí, ten
 * hraje. Vedle stojí mekuri, stojan s listem, na kterém je jméno toho, kdo
 * je právě na řadě, a program se vším, co kdo umí.
 *
 * Co se děje — opona, klapání dřívek, vystoupení, titulky, hlediště — řídí
 * scripts/parta3/reziser.ts. Bez skriptu zůstane opona rozhrnutá a na jevišti
 * první kus, se kterým si jde hrát rukou.
 */
import VazickaGejsa from "../characters/kami-buh/VazickaGejsa.astro";
import KapkaHrom from "../characters/kami-buh/KapkaHrom.astro";
import StripekZlato from "../characters/kami-buh/StripekZlato.astro";
import PecinkaOhen from "../characters/kami-buh/PecinkaOhen.astro";
import BublinkaStrasidlo from "../characters/kami-buh/BublinkaStrasidlo.astro";
import HlinkaZeme from "../characters/kami-buh/HlinkaZeme.astro";
import CedulkaEma from "../characters/kami-buh/CedulkaEma.astro";
import KachlikRovina from "../characters/kami-buh/KachlikRovina.astro";
import SamotkaNese from "../characters/kami-buh/SamotkaNese.astro";

import { pecinkaSchovka } from "../characters/schovka/pecinka";
import { bublinkaSchovka } from "../characters/schovka/bublinka";
import { stripekSchovka } from "../characters/schovka/stripek";
import { hlinkaSchovka } from "../characters/schovka/hlinka";
import { cedulkaSchovka } from "../characters/schovka/cedulka";
import { kachlikSchovka } from "../characters/schovka/kachlik";
import { samotkaSchovka } from "../characters/schovka/samotka";
import { vazickaSchovka } from "../characters/schovka/vazicka";
import { kapkaSchovka } from "../characters/schovka/kapka";
import { uid } from "../characters/dospele/uid";

import { jeviste, lampion } from "./jeviste";
import { ucinkujici, program } from "../../data/parta3";
import { parta } from "../../data/parta";
import { cesta, kamiInfo } from "../../data/kami";
import type { PostavaId } from "../../data/parta";

const Scena = {
  hlinka: HlinkaZeme, bublinka: BublinkaStrasidlo, kapka: KapkaHrom, vazicka: VazickaGejsa, kachlik: KachlikRovina,
  cedulka: CedulkaEma, samotka: SamotkaNese, pecinka: PecinkaOhen, stripek: StripekZlato,
} as const;
const erb = {
  hlinka: hlinkaSchovka, bublinka: bublinkaSchovka, kapka: kapkaSchovka, vazicka: vazickaSchovka, kachlik: kachlikSchovka,
  cedulka: cedulkaSchovka, samotka: samotkaSchovka, pecinka: pecinkaSchovka, stripek: stripekSchovka,
} as const;

const jmeno = (id: PostavaId) => parta.find((p) => p.id === id)!.name;
const zast = (id: PostavaId) => cesta.find((c) => c.id === id)!;
const CISLA = ["一", "二", "三"];
const prvni = ucinkujici[0];
---
<section class="divadlo" id="divadlo" data-hodina="22.6" aria-labelledby="divadlo-nadpis" data-divadlo>
  <div class="divadlo-hlava">
    <p class="stitek stitek-svetly">Jeviště · <span lang="ja">神楽殿</span></p>
    <h2 id="divadlo-nadpis" class="nadpis-2 divadlo-nadpis">Kagura je tanec pro bohy. <em>Tady tančí bohové sami.</em></h2>
    <p class="divadlo-perex">
      Rozsviť lampion toho, koho chceš vidět. Opona se zatáhne, dřívka zaklapou a jde se na věc.
      Až dohrají, jeviště je tvoje — každá scéna reaguje na myš i na prst.
    </p>
  </div>

  <div class="divadlo-mriz">
    {/* ——— vlevo: mekuri, stojan s listem, kdo je na řadě ——— */}
    <aside class="divadlo-bok">
      <div class="mekuri" aria-hidden="true">
        <div class="mekuri-list">
          <span class="mekuri-cislo" lang="ja">{zast(prvni.id).cislo}</span>
          <span class="mekuri-znak" lang="ja">{zast(prvni.id).znak}</span>
          <span class="mekuri-jmeno">{jmeno(prvni.id)}</span>
          <span class="mekuri-kus">{prvni.kusy[0].nazev}</span>
        </div>
        <div class="mekuri-stojan"></div>
      </div>
    </aside>

    {/* ——— uprostřed: jeviště ——— */}
    <div class="divadlo-stred">
      <div class="jeviste">
        <div class="jeviste-stavba" set:html={jeviste()} />

        <div class="lampiony" role="group" aria-label="Kdo vystoupí">
          {ucinkujici.map((u, i) => (
            <button type="button" class="lampion" data-kdo={u.id} aria-pressed={i === 0 ? "true" : "false"} aria-label={`${jmeno(u.id)} — ${u.obor}`} style={`--i:${i}`}>
              <span class="lampion-houpe">
                <Fragment set:html={lampion(`lp-${u.id}`)} />
                <span class="lampion-erb lampion-erb-velky" set:html={erb[u.id]({ barva: "cerna", velikost: 30, id: uid() })} />
                <span class="lampion-erb lampion-erb-maly" set:html={erb[u.id]({ barva: "cerna", velikost: 18, id: uid() })} />
              </span>
              <span class="lampion-jmeno">{jmeno(u.id)}</span>
            </button>
          ))}
        </div>

        <div class="jeviste-otvor">
          <div class="kusy">
            {ucinkujici.map((u, i) =>
              u.kusy.map((k, j) => {
                const S = Scena[u.id] as any;
                return (
                  <div class="kus" data-kus={`${u.id}/${k.id}`} hidden={!(i === 0 && j === 0)}>
                    <S varianta={k.id} />
                  </div>
                );
              }),
            )}
          </div>
          {/* Štít: dokud hraje vystoupení, chytá myš, ať se scéně neplete do choreografie; klepnutí vystoupení zastaví */}
          <button type="button" class="jeviste-stit" hidden aria-label="Zastavit vystoupení a hrát si sám"></button>
          <div class="opona" aria-hidden="true"><span class="opona-lem"></span></div>
          {/* Zatažená opona je sama tlačítko — ukáže ho až režisér, bez skriptu je opona rozhrnutá */}
          <button type="button" class="opona-hraj" data-hraj aria-label="Rozhrnout oponu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.500 5.500 L18.500 12 L8.500 18.500 Z" fill="currentColor" /></svg>
          </button>
        </div>
        {/* Co leží a padá přes jeviště: ohineri na prknech a papírový sníh — stejné místo jako otvor, ale nic se neořezává, ať papírek přiletí zvenku */}
        <div class="jeviste-pres ohineri" aria-hidden="true"></div>
        <div class="jeviste-pres snih" aria-hidden="true"></div>
      </div>

      <p class="titulky" aria-live="polite"><span class="titulky-text">Opona je zatažená. Vyber lampion, nebo to rovnou pusť.</span></p>
      <div class="prubeh" aria-hidden="true"><span></span></div>

      <div class="ovladani">
        <button type="button" class="ovl-krok" data-krok="-1" aria-label="Předchozí kus">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="ovl-hraj" data-hraj>
          <svg class="ovl-ikona ovl-ikona-hraj" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 L19 12 L8 19 Z" fill="currentColor" /></svg>
          <svg class="ovl-ikona ovl-ikona-stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="6.500" width="11" height="11" rx="2" fill="currentColor" /></svg>
          <span class="ovl-hraj-text">Rozhrnout oponu</span>
        </button>
        <button type="button" class="ovl-krok" data-krok="1" aria-label="Další kus">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
      <p class="ted-hraje"><b data-ted-kdo>{jmeno(prvni.id)}</b> · <span data-ted-kus>{prvni.kusy[0].nazev}</span> · <span data-ted-poradi>1</span> z {program.length}</p>
      <div class="ovladani ovladani-dole">
        <button type="button" class="tlacitko tlacitko-maly tlacitko-svetle" data-vecer aria-pressed="false">Celý večer popořadě</button>
        <button type="button" class="tlacitko tlacitko-maly tlacitko-svetle" data-hod>Hodit ohineri</button>
      </div>
      <p class="divadlo-pocty">Viděno <b data-videno>0</b> z {program.length} kusů · na prknech leží <b data-ohineri>0</b> ohineri</p>
      <p class="divadlo-pozn">Zvuk se zapíná zvonkohrou nahoře v liště. Ohineri jsou mince v papírku — v Japonsku se házejí na jeviště místo potlesku.</p>
    </div>

    {/* ——— vpravo: program ——— */}
    <div class="divadlo-program">
      {ucinkujici.map((u, i) => {
        const z = zast(u.id);
        const k = kamiInfo[u.id];
        return (
          <article class="program papir" data-program={u.id} hidden={i !== 0} aria-labelledby={`program-${u.id}`}>
            <p class="stitek">Program · <span lang="ja">{z.cislo}</span></p>
            <h3 class="program-jmeno" id={`program-${u.id}`}>{jmeno(u.id)} <span class="program-znak" lang="ja" aria-hidden="true">{z.znak}</span></h3>
            <p class="program-obor"><b>{u.obor}</b> · {k.druh}</p>
            <dl class="program-fakta">
              <div><dt>Dole v dílně</dt><dd>{u.dole}</dd></div>
              <div><dt>Tady nahoře</dt><dd>{u.nahore}</dd></div>
            </dl>
            <ol class="program-kusy">
              {u.kusy.map((kus, j) => (
                <li>
                  <button type="button" class="program-kus" data-vyber={`${u.id}/${kus.id}`}>
                    <span class="program-kus-cislo" lang="ja" aria-hidden="true">{CISLA[j]}</span>
                    <span class="program-kus-text">
                      <b>{kus.nazev}</b>
                      <span>{kus.o}</span>
                    </span>
                    <span class="program-kus-razitko" lang="ja" aria-hidden="true">済</span>
                  </button>
                </li>
              ))}
            </ol>
            <blockquote class="program-replika">„{u.replika}“</blockquote>
          </article>
        );
      })}
    </div>
  </div>

  {/* Vyprodáno: až člověk uvidí všechny kusy, vyvěsí se nad jeviště cedule */}
  <p class="vyprodano" hidden><span lang="ja" aria-hidden="true">満員御礼</span> Viděl jsi všechno. Vyprodáno — děkujeme.</p>
</section>

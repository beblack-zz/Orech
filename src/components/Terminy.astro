---
import SectionHead from "./SectionHead.astro";
import { poMesicich, den, mesic, popisKurzu, stavPopis, tlacitkoPopis, lzeRezervovat } from "../data/kurzy";

// Homepage ukazuje jen nejbližší měsíc v jedné bublině. Další měsíce jsou na /kurzy
const mesice = poMesicich().slice(0, 1);
---

<section class="bg-white py-14 relative fade-up">
  <div class="container-x relative">
    {mesice.length === 0 && (
      <>
        <SectionHead title="Aktuální" italic="termíny" metaLink="/kurzy" metaLinkText="Zobrazit vše" />
        <p class="text-stone text-[16px] leading-[1.7] py-4">
          Zrovna teď nemáme vypsaný žádný termín — chystáme další.
          <a href="/kurzy" class="text-terracotta underline underline-offset-2">Napiš nám</a> a dáme ti vědět, jakmile budou venku.
        </p>
      </>
    )}
    <div class="flex flex-col gap-4">
      {mesice.map((m, mi) => (
        <div>
          <SectionHead
            title="Aktuální termíny"
            italic={m.nazev}
            metaLink={mi === 0 ? "/kurzy" : undefined}
            metaLinkText="Zobrazit vše"
          />
          <div>
            {m.kurzy.map((c) => (
              <div class="grid grid-cols-[52px_1fr] md:grid-cols-[72px_1fr_auto_auto] items-center gap-4 md:gap-8 py-6 md:py-7 border-b border-espresso/20 first:border-t first:border-espresso/20">
                <div class="font-serif font-medium text-[28px] md:text-[34px] text-center leading-none" style="font-variation-settings: 'opsz' 72;">
                  {den(c.date)}
                  <span class="block font-mono text-[12px] text-stone mt-1 tracking-wider uppercase font-normal">{mesic(c.date)}</span>
                </div>
                <div>
                  <h3 class="font-serif font-medium text-[20px] md:text-[24px] mb-1.5 leading-none">{c.title}</h3>
                  <p class="text-[14px] md:text-[15px] text-peri-deep leading-[1.6]">{popisKurzu(c)}</p>
                </div>
                <div class={`font-mono text-[12px] hidden md:block ${
                  c.price ? "text-espresso font-medium" :
                  c.state === "urgent" ? "text-sakura font-medium" :
                  c.state === "full" ? "text-stone line-through" : "text-stone"
                }`}>
                  {c.state === "urgent" && <span aria-hidden="true">● </span>}{stavPopis(c)}
                </div>
                {/* Ve fázi „připravujeme“ není co nabídnout — logika zůstává pro chvíli, kdy se zápis otevře */}
                {c.state !== "pripravujeme" && (
                  <a
                    href="/kurzy"
                    class={`px-4 py-2 rounded-full text-[12px] font-medium hidden md:inline-block ${
                      lzeRezervovat(c)
                        ? "bg-espresso text-cream hover:bg-sakura transition-colors"
                        : "bg-transparent text-stone border border-espresso/20"
                    }`}
                  >
                    {tlacitkoPopis(c)}
                  </a>
                )}
                <div class="col-span-2 flex items-center justify-between md:hidden pt-1">
                  <div class={`font-mono text-[12px] ${
                    c.state === "urgent" ? "text-sakura font-medium" :
                    c.state === "full" ? "text-stone line-through" :
                    c.price ? "text-espresso font-medium" :
              c.state === "pripravujeme" ? "text-stone/70 italic" : "text-stone"
                  }`}>
                    {c.state === "urgent" && <span aria-hidden="true">● </span>}{stavPopis(c)}
                  </div>
                  {c.state !== "pripravujeme" && (
                    <a
                      href="/kurzy"
                      class={`px-3 py-1.5 rounded-full text-[12px] font-medium ${
                        lzeRezervovat(c)
                          ? "bg-espresso text-cream"
                          : "bg-transparent text-stone border border-espresso/20"
                      }`}
                    >
                      {tlacitkoPopis(c)}
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

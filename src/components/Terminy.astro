---
import SectionHead from "./SectionHead.astro";
import { kurzy } from "../data/kurzy";
import { pocetKurzu } from "../data/pocty";

// Homepage ukazuje jen nejbližší čtyři, celý seznam je na /kurzy
const courses = kurzy.slice(0, 4);
---

<section class="bg-white py-14 relative fade-up">
  <div class="container-x relative">
    <span
      class="absolute -top-2 right-0 font-serif font-medium text-[140px] md:text-[200px] text-terracotta opacity-[0.07] leading-[0.85] tracking-tighter pointer-events-none select-none"
      aria-hidden="true"
    >{kurzy.length}</span>
    <SectionHead title="Nejbližší" italic="termíny" meta={`Jaro 2026 · ${pocetKurzu(kurzy.length)}`} metaLink="/kurzy" metaLinkText="Zobrazit vše" />
    <div>
      {courses.map((c) => (
        <div class="grid grid-cols-[52px_1fr] md:grid-cols-[60px_1fr_auto_auto_auto] items-center gap-4 md:gap-5 py-4 border-b border-espresso/10 last:border-b-0">
          <div class="font-serif font-medium text-[24px] md:text-[26px] text-center leading-none" style="font-variation-settings: 'opsz' 72;">
            {c.day}
            <span class="block font-mono text-[12px] text-stone mt-1 tracking-wider uppercase font-normal">{c.month}</span>
          </div>
          <div>
            <h4 class="font-serif text-[16px] md:text-[17px] font-medium mb-1 leading-tight">{c.title}</h4>
            <p class="text-[14px] text-stone">{c.meta}</p>
          </div>
          <div class={`font-mono text-[12px] hidden md:block ${
            c.state === "urgent" ? "text-clay font-medium" :
            c.state === "full" ? "text-stone line-through" : "text-stone"
          }`}>
            {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity}
          </div>
          <div class="font-serif text-[16px] font-medium hidden md:block">{c.price}</div>
          {c.state === "full" ? (
            <a href="/kurzy" class="bg-transparent text-stone border border-espresso/20 px-4 py-2 rounded-full text-[12px] font-medium hidden md:inline-block">
              Náhradník
            </a>
          ) : (
            <a href="/kurzy" class="bg-espresso text-cream px-4 py-2 rounded-full text-[12px] font-medium hover:bg-clay transition-colors hidden md:inline-block">
              Rezervovat
            </a>
          )}
          <div class="col-span-2 flex items-center justify-between md:hidden pt-1">
            <div class={`font-mono text-[12px] ${
              c.state === "urgent" ? "text-clay font-medium" :
              c.state === "full" ? "text-stone line-through" : "text-stone"
            }`}>
              {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity} · <span class="text-espresso font-serif">{c.price}</span>
            </div>
            {c.state === "full" ? (
              <a href="/kurzy" class="bg-transparent text-stone border border-espresso/20 px-3 py-1.5 rounded-full text-[12px] font-medium">
                Náhradník
              </a>
            ) : (
              <a href="/kurzy" class="bg-espresso text-cream px-3 py-1.5 rounded-full text-[12px] font-medium">
                Rezervovat
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

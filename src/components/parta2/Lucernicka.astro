---
/**
 * Lucernička na tyčce, jakou nese malé kami v nočním průvodu (Úvod 2,
 * /marcel). Patří do obalu vedle <Kami> — styly `.lucerna` a `.pruvod-kami`
 * jsou v parta2.css: tyčka vyrůstá kami zpoza ramene a lucerna se na ní houpe.
 *
 * `vzor`:
 *  - "papir" (výchozí, /marcel): papírová lucerna s proužky
 *  - "plamen": černý ažurový válec s oranžovými svislými pruhy jako plamen
 *  - "ornament": stejný válec, ale uprostřed prosvítá vzor vlnitých kudrlin
 * (podle solárních lampiónů z fotky: černý ažur, uvnitř žhne teplé světlo, na
 * horní straně háček)
 */
interface Props {
  vzor?: "papir" | "plamen" | "ornament";
}
const { vzor = "papir" } = Astro.props;
const barvy = [34, 37, 40, 43, 46, 49, 52];
---
<svg class="lucerna" viewBox="0 0 60 96" aria-hidden="true">
  <path d="M6 96 C10 60 22 30 44 14" stroke="#5E452E" stroke-width="3" fill="none" stroke-linecap="round" />
  {vzor === "papir" ? (
    <g class="lucerna-telo">
      <path d="M44 14 V22" stroke="#2B2420" stroke-width="1.6" />
      <rect x="36" y="22" width="16" height="4" rx="1.4" fill="#2B2420" />
      <ellipse cx="44" cy="41" rx="14" ry="16" fill="#FFB55A" />
      <ellipse cx="44" cy="39" rx="8" ry="10" fill="#FFE7A8" opacity="0.8" />
      <path d="M31 33 H57 M30 41 H58 M31 49 H57" stroke="#C4432B" stroke-width="1" opacity="0.45" />
      <rect x="36" y="56" width="16" height="4" rx="1.4" fill="#2B2420" />
      <path d="M44 60 V68" stroke="#C4432B" stroke-width="2.4" stroke-linecap="round" />
    </g>
  ) : (
    <g class="lucerna-telo">
      {/* háček na konci tyčky */}
      <path d="M44 14 V19" stroke="#2B2420" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="44" cy="21" r="2.3" fill="none" stroke="#2B2420" stroke-width="1.4" />
      {/* záře kolem */}
      <ellipse cx="44" cy="40" rx="22" ry="21" fill="#FFB040" opacity="0.14" />
      <ellipse cx="44" cy="40" rx="16" ry="15" fill="#FFB040" opacity="0.18" />
      {/* černý válec s horním a spodním víčkem */}
      <path d="M34 25 H54 C59.5 31 59.5 49 54 55 H34 C28.5 49 28.5 31 34 25 Z" fill="#1E1917" stroke="#3B322C" stroke-width="0.8" />
      <rect x="33" y="24" width="22" height="3.6" rx="1.6" fill="#15110F" />
      <rect x="33" y="52.4" width="22" height="3.6" rx="1.6" fill="#15110F" />
      {/* žebra klece nahoře a dole: štěrbiny, kterými zlatě prosvítá */}
      <g stroke="#FFB040" stroke-width="0.9" stroke-linecap="round" opacity="0.7">
        {barvy.map((x) => <path d={`M${x + 0.5} 28.4 V32 M${x + 0.5} 48 V51.6`} />)}
      </g>
      {/* žhnoucí pás uprostřed */}
      <rect x="31.2" y="33" width="25.6" height="14" rx="3" fill="#8A3F12" opacity="0.55" />
      {vzor === "plamen" ? (
        <g>
          {barvy.map((x, i) => (
            <rect x={x - 0.4} y={34.5 + (i % 3 === 1 ? 1.2 : 0)} width="2.2" height={11 - (i % 3 === 1 ? 2.4 : 0)} rx="1.1" fill="#FFB040" />
          ))}
          {barvy.map((x, i) => (
            <rect x={x + 0.1} y={36 + (i % 3 === 1 ? 1.2 : 0)} width="1.1" height={8 - (i % 3 === 1 ? 2.4 : 0)} rx="0.55" fill="#FFE7A8" />
          ))}
        </g>
      ) : (
        <g fill="none" stroke="#FFC25A" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
          <path d="M33 41 C33 36 39 35 39 39 C39 42 35 42 36 39.5" />
          <path d="M55 41 C55 36 49 35 49 39 C49 42 53 42 52 39.5" />
          <path d="M40 45.5 C42 42.5 46 42.5 48 45.5 M44 34.5 V38.5 M41.5 37 C43 36 45 36 46.5 37" />
          <path d="M35 45 C37 44 38 45.5 37 46.5 M53 45 C51 44 50 45.5 51 46.5" stroke-width="0.9" />
        </g>
      )}
    </g>
  )}
</svg>

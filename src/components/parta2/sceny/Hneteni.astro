---
/**
 * 二 Hnětení — minihra. Každé kliknutí hroudu promáčkne, přidá jeden
 * záhyb chryzantémy (kiku-neri) a vytlačí Bublinku o kus blíž k okraji.
 * Po osmém se vzdá a vyletí ven. Logika: scripts/parta2/sceny.ts.
 */
import Kami from "../Kami.astro";
import Postavicka from "../../characters/Postavicka.astro";

/** Osm záhybů do spirály kolem pravého konce hroudy, jako okvětní lístky */
const zahyby = Array.from({ length: 8 }, (_, i) => {
  const a = -2.5 + i * 0.6;
  const cx = 214, cy = 104;
  const bod = (r: number, u: number) => [cx + Math.cos(u) * r, cy + Math.sin(u) * r * 0.72].map((n) => n.toFixed(1)).join(" ");
  return `M${bod(16, a)} Q${bod(52, a + 0.42)} ${bod(84, a + 0.12)}`;
});
---
<div class="scena scena-hneteni">
  <svg class="scena-pozadi" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="hnet-zed" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#E4E6DC" />
        <stop offset="1" stop-color="#CDCFC2" />
      </linearGradient>
      <linearGradient id="hnet-svetlo" x1="1" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFF7DE" stop-opacity="0.75" />
        <stop offset="0.6" stop-color="#FFF7DE" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="600" height="600" fill="url(#hnet-zed)" />
    <rect width="600" height="600" fill="url(#hnet-svetlo)" />
    {/* Kachličky za stolem */}
    <g stroke="#BFC2B4" stroke-width="2" opacity="0.8">
      <path d="M0 250 H600 M0 300 H600 M0 350 H600 M0 400 H600" />
      <path d="M60 250 V420 M140 250 V420 M220 250 V420 M300 250 V420 M380 250 V420 M460 250 V420 M540 250 V420" />
    </g>
    {/* Nářadí na zdi */}
    <path d="M110 90 L110 112" stroke="#6B5D4F" stroke-width="3" />
    <path d="M86 112 C96 170 124 170 134 112" stroke="#8C949B" stroke-width="2" fill="none" />
    <rect x="80" y="108" width="14" height="10" rx="3" fill="#B08660" />
    <rect x="126" y="108" width="14" height="10" rx="3" fill="#B08660" />
    <rect x="430" y="80" width="90" height="120" rx="6" fill="#B08660" />
    <rect x="438" y="88" width="74" height="104" rx="4" fill="#C9A37A" />
    <path d="M446 110 H504 M446 130 H496 M446 150 H500" stroke="#8A6A48" stroke-width="2" opacity="0.6" />
    {/* Hnětací stůl: beton a plátno */}
    <rect x="40" y="430" width="520" height="40" rx="4" fill="#A79F92" />
    <rect x="34" y="418" width="532" height="20" rx="4" fill="#E6DDCB" />
    <path d="M40 424 H560" stroke="#D2C7B1" stroke-width="2" />
    <rect x="70" y="470" width="26" height="130" fill="#8F877B" />
    <rect x="504" y="470" width="26" height="130" fill="#8F877B" />
    <ellipse cx="300" cy="430" rx="190" ry="10" fill="#5A4E42" opacity="0.18" />
  </svg>

  <button type="button" class="hrouda-tlacitko" aria-label="Hněť hlínu" data-hneteni>
    <svg viewBox="0 0 300 200" aria-hidden="true">
      <defs>
        <radialGradient id="hnet-hlina" cx="0.38" cy="0.3" r="0.8">
          <stop offset="0" stop-color="#B59A80" />
          <stop offset="0.6" stop-color="#9A7E65" />
          <stop offset="1" stop-color="#7A604B" />
        </radialGradient>
      </defs>
      <path class="hrouda-telo" d="M30 150 C18 110 40 58 96 46 C150 34 214 40 252 66 C288 92 290 140 262 164 C230 190 150 192 92 186 C56 182 38 172 30 150 Z" fill="url(#hnet-hlina)" stroke="#6E5444" stroke-width="2" />
      <path d="M70 70 C100 56 150 52 190 58" stroke="#C9B49C" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.6" />
      <g stroke="#6E5444" stroke-width="3.2" stroke-linecap="round" fill="none">
        {zahyby.map((d, i) => <path class="kiku" data-kiku={i} d={d} />)}
      </g>
    </svg>
    <span class="hrouda-bublinka" aria-hidden="true">
      <Postavicka id="bublinka" size={60} varianta="kami" />
    </span>
  </button>

  <Kami id="bublinka" class="scena-kami hneteni-venku" style="left:70%;top:41%;width:22%" />
</div>

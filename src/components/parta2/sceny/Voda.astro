---
/**
 * 三 Voda — dřevěná káď na dvoře. Kliknutí do vody pustí kruhy, Kapka
 * sedí na okraji a po kliknutí skočí dovnitř. Na dně se chladí Kachlík.
 * Kruhy kreslí scripts/parta2/sceny.ts do skupiny .vlnky.
 */
import Kami from "../Kami.astro";
import Skryty from "../Skryty.astro";
import { chomac } from "../tvary";
---
<div class="scena scena-voda">
  <svg class="scena-pozadi" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="voda-dvur" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#A9C47A" />
        <stop offset="1" stop-color="#7FA052" />
      </linearGradient>
      <linearGradient id="voda-hladina" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#CFE6F2" />
        <stop offset="0.45" stop-color="#8FC0D8" />
        <stop offset="1" stop-color="#4D8AA6" />
      </linearGradient>
      <linearGradient id="voda-dyhy" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6A4E34" />
        <stop offset="0.3" stop-color="#9A7350" />
        <stop offset="0.6" stop-color="#8A6544" />
        <stop offset="1" stop-color="#5E452E" />
      </linearGradient>
      <clipPath id="voda-orez"><ellipse cx="300" cy="300" rx="208" ry="98" /></clipPath>
    </defs>

    <rect width="600" height="600" fill="url(#voda-dvur)" />
    <g fill="#6E9147" opacity="0.6">
      <path d={chomac(80, 120, 90, 40, 12, 601, 1, 0.7)} />
      <path d={chomac(520, 110, 100, 44, 12, 603, 1, 0.7)} />
    </g>
    {/* Dlažba kolem kádě */}
    <g fill="#CFC5B3" stroke="#B3A890" stroke-width="2">
      <path d="M40 470 L130 455 L150 500 L60 520 Z" /><path d="M160 498 L250 486 L260 532 L170 546 Z" />
      <path d="M340 488 L430 480 L444 526 L350 536 Z" /><path d="M460 456 L548 470 L540 516 L452 506 Z" />
    </g>
    <ellipse cx="300" cy="470" rx="250" ry="40" fill="#3E5A2E" opacity="0.3" />

    {/* Káď: stěna z dužin a dvě obruče */}
    <path d="M80 300 L96 430 C150 486 450 486 504 430 L520 300 Z" fill="url(#voda-dyhy)" />
    <g stroke="#5E452E" stroke-width="2" opacity="0.6">
      <path d="M140 330 L150 462 M200 340 L206 476 M260 344 L262 482 M320 344 L320 482 M380 342 L376 478 M440 334 L432 466" />
    </g>
    <path d="M86 350 C160 404 440 404 514 350" stroke="#3B3A38" stroke-width="10" fill="none" />
    <path d="M92 412 C164 462 436 462 508 412" stroke="#3B3A38" stroke-width="10" fill="none" />
    <path d="M86 346 C160 400 440 400 514 346" stroke="#8C949B" stroke-width="2" fill="none" opacity="0.6" />

    {/* Hladina */}
    <ellipse cx="300" cy="300" rx="220" ry="106" fill="#6A4E34" />
    <ellipse cx="300" cy="300" rx="208" ry="98" fill="url(#voda-hladina)" />
    <g clip-path="url(#voda-orez)">
      <ellipse cx="250" cy="250" rx="120" ry="26" fill="#FFFFFF" opacity="0.28" class="voda-odlesk" />
      <path d="M140 300 C200 292 260 304 320 296" stroke="#FFFFFF" stroke-width="3" opacity="0.35" fill="none" class="voda-odlesk voda-odlesk-2" />
      <path d="M360 340 C400 334 440 340 470 334" stroke="#FFFFFF" stroke-width="2" opacity="0.3" fill="none" class="voda-odlesk" />
      {/* Plovoucí lístek sakury */}
      <g class="voda-platek">
        <path d="M0 0 C-5 -3 -8 -8 -8 -13 C-8 -18 -6 -21 -4 -23 L0 -18 L4 -23 C6 -21 8 -18 8 -13 C8 -8 5 -3 0 0 Z" fill="#E7A9A3" transform="translate(190 330) rotate(-60) scale(1.3)" />
      </g>
    </g>
    <ellipse cx="300" cy="300" rx="220" ry="106" fill="none" stroke="#B08660" stroke-width="8" />
    <ellipse cx="300" cy="296" rx="220" ry="106" fill="none" stroke="#C9A37A" stroke-width="2" opacity="0.7" />
  </svg>

  {/* Kachlík na dně — pod hladinou, ale nad vrstvou, která chytá kliknutí */}
  <Skryty id="kachlik" class="pod-vodou" x={53} y={47} w={10} u={8} />

  <svg class="voda-klik" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice">
    <defs>
      <clipPath id="voda-orez-2"><ellipse cx="300" cy="300" rx="208" ry="98" /></clipPath>
    </defs>
    <g class="vlnky" clip-path="url(#voda-orez-2)"></g>
    <ellipse class="voda-cil" cx="300" cy="300" rx="208" ry="98" fill="transparent" tabindex="0" role="button" aria-label="Pustit kruhy na vodě" />
  </svg>

  <Kami id="kapka" class="scena-kami voda-kapka" style="left:66%;top:20%;width:22%" />
</div>

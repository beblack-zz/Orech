---
/**
 * Hlavička nového vzhledu: plovoucí papírový pruh nad oblohou. V levém
 * konci sedí ensō a opisuje křivku bubliny (HlavickaEnso.astro); jak se
 * čte stránka, vybíhá z něj tah štětce po okraji pruhu (.hlava-tah,
 * scripts/parta2/tah.ts) a cestou zavadí o zvonkohru. Vpravo
 * sbírka schovaných věcí (na Partě omamori s kami, na Kurzech bedýnka
 * s nářadím, na Úvodu 2 sešit razítek, v O nás 2 zlato na kintsugi,
 * na archivní /rezervace-ema přání party na destičkách ema, v Dílně
 * deska se zkouškami glazur, na Domku 2 kroužek s klíči; Rezervace sbírku
 * nemá), přepínač den / noc,
 * který přebarví bublinu do noční modré, a zvonkohra — visí z tlačítka,
 * přečnívá přes spodní okraj pruhu a kliknutím se jí zvuk ztlumí.
 *
 * Sbírky v O nás 2, Dílně, Domku 2 a na /rezervace-ema obsluhuje obecný
 * scripts/parta2/sbirka.ts — proto mají tlačítka data-sbirka-tlacitko
 * a počty data-sbirka-pocet.
 */
import { razitka } from "../../data/uvod2";
import { zlato } from "../../data/onas2";
import { prani } from "../../data/rezervace";
import { zkousky } from "../../data/dilna";
import { klice } from "../../data/domek2";
import HlavickaEnso from "./HlavickaEnso.astro";
import HlavickaNebe from "./HlavickaNebe.astro";
import Zvonkohra from "./Zvonkohra.astro";
import { zvyrazneni } from "../../scripts/parta2/tah-kresba";
import { noveId } from "../navrhy-loga/sdilene";
import ZnackaStetec from "../znacka/ZnackaStetec.astro";
import RezervaceKalendar from "./RezervaceKalendar.astro";

interface Props {
  /** zadny — stránka bez sbírky */
  sber?: "omamori" | "naradi" | "razitka" | "zlato" | "ema" | "zkousky" | "klice" | "zadny";
}
const { sber = "omamori" } = Astro.props;
/** `skrtnuto` je pracovní značka — položka je na odpis, ale zatím visí v menu (jako v Header.astro). */
const odkazy: { href: string; label: string; skrtnuto?: boolean }[] = [
  { href: "/uvod-2", label: "Úvod 2", skrtnuto: true },
  { href: "/kurzy-2", label: "Kurzy 2", skrtnuto: true },
  { href: "/dilna", label: "Dílna" },
  { href: "/rezervace", label: "Rezervace" },
  { href: "/obchod-2", label: "Obchod 2" },
  { href: "/parta-2", label: "Parta 2" },
  { href: "/o-nas-2", label: "O nás 2" },
  { href: "/domek-2", label: "Domek 2" },
  { href: "/marcel", label: "Marcel", skrtnuto: true },
];
/** Spáry misky v ikoně zlata — kolik jich je, tolik šupinek se hledá */
const spary = [
  "M9 14 L12 19 L10 23", "M15 14 L16 18", "M21 14 L20 19 L23 24", "M27 14 L26 17 L29 21",
  "M33 15 L31 20", "M12 27 L16 29", "M20 24 L22 30", "M27 26 L25 31", "M30 23 L33 26",
];
const tady = Astro.url.pathname.replace(/\/$/, "") || "/";
/** Aktuální stránka v menu je namalovaná tahem štětce (kresba v tah-kresba.ts) */
const zv = zvyrazneni();
const zvId = noveId("hlava-stranka");
---
<header class="hlava" transition:name="hlava">
  {/* Obláčky a hvězdy — jen v noční hlavičce */}
  <HlavickaNebe />
  {/* Tah štětce po okraji bubliny — kreslí ho skript podle šířky pruhu */}
  <svg class="hlava-tah" aria-hidden="true" focusable="false"></svg>

  <a href="/" class="hlava-znacka" aria-label="JIRO saku — úvod">
    <HlavickaEnso />
    <ZnackaStetec vyska={19} />
  </a>

  <nav class="hlava-nav" aria-label="Hlavní navigace">
    {odkazy.map((o) => (
      <a href={o.href} class={o.skrtnuto ? "skrtnuto" : undefined} aria-current={tady === o.href ? "page" : undefined}>
        {/* Šmouha suchým štětcem v barvách loga — namaluje se při příchodu na stránku */}
        {tady === o.href && (
          <svg class="hlava-stranka" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs>
              {/* Soumrak z loga (rumělka do noci), o kus sytější, ať na něm krémové písmo drží kontrast */}
              <linearGradient id={`${zvId}-tus`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="0">
                <stop offset="0" stop-color="#C4432B" />
                <stop offset="0.35" stop-color="#A0527A" />
                <stop offset="0.68" stop-color="#5E4E86" />
                <stop offset="1" stop-color="#2A2C5E" />
              </linearGradient>
              <mask id={`${zvId}-m`} maskUnits="userSpaceOnUse" x="-10" y="-5" width="120" height="50">
                <path class="hlava-stranka-odhal" d={zv.osa} pathLength="1" fill="none" stroke="#fff" stroke-width="44" />
              </mask>
            </defs>
            <g mask={`url(#${zvId}-m)`} fill={`url(#${zvId}-tus)`}>
              {zv.vlakna.map((d) => <path d={d} />)}
            </g>
          </svg>
        )}
        {o.label}
      </a>
    ))}
  </nav>

  <div class="hlava-akce">
    {sber === "zadny" ? null : sber === "zlato" ? (
    <button type="button" class="sbirka-tlacitko zlato-tlacitko" data-sbirka-tlacitko aria-haspopup="dialog" aria-label="Zlato na kintsugi">
      <svg viewBox="0 0 42 36" aria-hidden="true">
        <ellipse cx="21" cy="33" rx="11" ry="2.2" fill="#2B2420" opacity="0.18" />
        <path d="M4 13 C5 25 12 31 21 31 C30 31 37 25 38 13 Z" class="zlato-miska" />
        <ellipse cx="21" cy="13" rx="17" ry="3.6" fill="#2B2420" opacity="0.35" />
        <ellipse cx="21" cy="12.6" rx="15.5" ry="2.6" fill="#6B5D4F" opacity="0.55" />
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          {spary.map((d, i) => <path class="zlato-spara" data-spara={i} d={d} />)}
        </g>
      </svg>
      <span class="omamori-pocet"><b data-sbirka-pocet>0</b>/{zlato.length}</span>
    </button>
    ) : sber === "klice" ? (
    <button type="button" class="sbirka-tlacitko klice-tlacitko" data-sbirka-tlacitko aria-haspopup="dialog" aria-label="Klíčovnice">
      {/* Kroužek s klíči: každý nalezený klíč na něm přibude se svou barevnou čepičkou */}
      <svg viewBox="0 0 40 40" aria-hidden="true">
        {klice.map((k, i) => (
          <g data-krouzek-klic={k.id} transform={`rotate(${25 + i * 22} 16 13)`}>
            <rect x="22" y="11" width="6" height="4.4" rx="1.6" fill={k.cepicka} />
            <path d="M28 13.2 H36 M33 13.2 V15.4 M35 13.2 V15" stroke="#8D959B" stroke-width="1.6" stroke-linecap="round" />
          </g>
        ))}
        <circle cx="16" cy="13" r="6.5" class="klice-krouzek" />
      </svg>
      <span class="omamori-pocet"><b data-sbirka-pocet>0</b>/{klice.length}</span>
    </button>
    ) : sber === "zkousky" ? (
    <button type="button" class="sbirka-tlacitko zkousky-tlacitko" data-sbirka-tlacitko aria-haspopup="dialog" aria-label="Deska zkoušek glazur">
      <svg viewBox="0 0 44 38" aria-hidden="true">
        <circle cx="22" cy="3.2" r="1.6" fill="#5C5047" />
        <path d="M22 3.2 L8 8 M22 3.2 L36 8" stroke="#5C5047" stroke-width="1" />
        <rect x="3" y="7" width="38" height="29" rx="3" class="zkousky-deska" />
        {zkousky.map((z, i) => (
          <g transform={`translate(${7.5 + (i % 3) * 11.5} ${10 + Math.floor(i / 3) * 13.2})`}>
            <rect width="7.5" height="10.6" rx="1" fill="#E6D6BE" />
            <path d="M0 1 Q0 0 1 0 H6.5 Q7.5 0 7.5 1 V6.6 C5 7.6 2.6 6 0 7.2 Z" class="zkousky-dlazdice" data-zkouska={z.id} />
            <circle cx="3.75" cy="2.2" r="0.8" fill="#5C4A3C" opacity="0.7" />
          </g>
        ))}
      </svg>
      <span class="omamori-pocet"><b data-sbirka-pocet>0</b>/{zkousky.length}</span>
    </button>
    ) : sber === "ema" ? (
    <button type="button" class="sbirka-tlacitko ema-tlacitko" data-sbirka-tlacitko aria-haspopup="dialog" aria-label="Přání party">
      <svg viewBox="0 0 40 44" aria-hidden="true">
        <path d="M20 2 Q15 8 20 13" stroke="#C4432B" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <path d="M20 2 Q15 8 20 13" stroke="#FBF7EE" stroke-width="1.8" fill="none" stroke-dasharray="2 2" />
        <path d="M6 20 L20 11 L34 20 L34 39 Q34 41 32 41 L8 41 Q6 41 6 39 Z" class="ema-drevo" />
        <path d="M4 21 L20 10.5 L36 21" stroke="#8A6A48" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="20" y="34" text-anchor="middle" font-size="12" font-family="Yuji Syuku, Yu Mincho, serif" fill="#3A2E28">願</text>
      </svg>
      <span class="omamori-pocet"><b data-sbirka-pocet>0</b>/{prani.length}</span>
    </button>
    ) : sber === "razitka" ? (
    <button type="button" class="razitka-tlacitko" aria-haspopup="dialog" aria-label="Sešit razítek">
      <svg viewBox="0 0 44 40" aria-hidden="true">
        <rect x="6" y="5" width="32" height="31" rx="3" class="razitka-desky" />
        <rect x="6" y="5" width="5" height="31" rx="1.5" fill="#2B2420" opacity="0.3" />
        <rect x="16" y="10" width="17" height="21" rx="1.5" fill="#FBF6EA" />
        <circle cx="24.5" cy="20.5" r="6" fill="none" stroke="#C4432B" stroke-width="1.4" />
        <text x="24.5" y="23.4" text-anchor="middle" font-size="8" fill="#C4432B" font-family="Yuji Syuku, Yu Mincho, serif">印</text>
      </svg>
      <span class="omamori-pocet razitka-pocet"><b>0</b>/{razitka.length}</span>
    </button>
    ) : sber === "naradi" ? (
    <button type="button" class="naradi-tlacitko" aria-haspopup="dialog" aria-label="Bedýnka: nalezené nářadí">
      <svg viewBox="0 0 48 40" aria-hidden="true">
        <path d="M16 12 V7 Q16 4 19 4 H29 Q32 4 32 7 V12" stroke="#5C5047" stroke-width="2.6" fill="none" stroke-linecap="round" />
        <rect x="4" y="12" width="40" height="24" rx="3" class="naradi-bedna" />
        <path d="M4 20 H44" stroke="#2B2420" stroke-width="1.4" opacity="0.4" />
        <rect x="20" y="17" width="8" height="6" rx="1.5" fill="#D6A23A" />
      </svg>
      <span class="omamori-pocet naradi-pocet"><b>0</b>/6</span>
    </button>
    ) : (
    <button type="button" class="omamori-tlacitko" aria-haspopup="dialog" aria-label="Omamori: nalezení kami">
      <svg viewBox="0 0 40 54" aria-hidden="true">
        <path d="M14 8 C10 2 16 0 20 5 C24 0 30 2 26 8" stroke="#D6A23A" stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M7 16 Q7 9 13 9 L27 9 Q33 9 33 16 L33 45 Q33 51 27 51 L13 51 Q7 51 7 45 Z" class="omamori-latka" />
        <path d="M7 16 Q20 22 33 16" stroke="#D6A23A" stroke-width="1.6" fill="none" />
        <rect x="14" y="22" width="12" height="22" rx="1.5" fill="#FBF6EA" />
        <text x="20" y="38" text-anchor="middle" font-size="11" font-family="Yuji Syuku, Yu Mincho, serif" fill="#2B2420">守</text>
        <g fill="#D6A23A" opacity="0.8"><circle cx="10.5" cy="26" r="1.2" /><circle cx="29.5" cy="30" r="1.2" /><circle cx="10.5" cy="40" r="1.2" /><circle cx="29.5" cy="44" r="1.2" /></g>
      </svg>
      <span class="omamori-pocet"><b>0</b>/9</span>
    </button>
    )}

    {/* Den / noc: přebarví bublinu do noční modré (scripts/parta2/hlavicka.ts).
        Ve dne slunce s paprsky, v noci srpek měsíce s hvězdičkou — při přepnutí
        se jedno protočí do druhého */}
    <button type="button" class="hlava-tema" aria-pressed="false" aria-label="Noční hlavička" title="Noční hlavička">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <mask id={`${zvId}-srpek`} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
          <rect width="24" height="24" fill="#fff" />
          <circle cx="15.6" cy="8.6" r="6.3" fill="#000" />
        </mask>
        <g class="hlava-tema-slunce">
          <circle cx="12" cy="12" r="4.6" fill="currentColor" />
          <g class="hlava-tema-paprsky" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            {[0, 45, 90, 135, 180, 225, 270, 315].map((u) => (
              <line x1="12" y1="2.6" x2="12" y2="4.6" transform={`rotate(${u} 12 12)`} />
            ))}
          </g>
        </g>
        <g class="hlava-tema-mesic">
          <circle cx="11" cy="13" r="7.6" mask={`url(#${zvId}-srpek)`} />
          <path d="M18.6 2.6 Q19 4.6 21 5 Q19 5.4 18.6 7.4 Q18.2 5.4 16.2 5 Q18.2 4.6 18.6 2.6 Z" />
        </g>
      </svg>
    </button>

    {/* Při přechodu mezi stránkami se tlačítko přenese i se zvonkohrou, která se houpe dál (scripts/parta2/prechody.ts) */}
    <button type="button" class="zvuk-tlacitko" aria-pressed="true" aria-label="Ztlumit zvuk" title="Ztlumit zvuk" transition:persist="zvonkohra">
      <Zvonkohra />
    </button>

    <button type="button" class="hlava-menu-tlacitko" aria-expanded="false" aria-controls="hlava-menu" aria-label="Otevřít menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8 H20 M4 16 H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>
{/* Noční hlavička se musí nastavit dřív, než se pruh poprvé vykreslí — jinak problikne papír */}
<script is:inline>
  try {
    if (localStorage.getItem("hlava-tema") === '"noc"') document.querySelector(".hlava")?.classList.add("je-noc");
  } catch (e) {}
</script>

<nav id="hlava-menu" class="hlava-menu" aria-label="Menu" hidden>
  {odkazy.map((o) => (
    <a href={o.href} class={o.skrtnuto ? "skrtnuto" : undefined} aria-current={tady === o.href ? "page" : undefined}>{o.label}</a>
  ))}
</nav>

{tady !== "/rezervace" && <RezervaceKalendar />}

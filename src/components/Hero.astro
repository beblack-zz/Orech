---
import Vazicka from "./characters/Vazicka.astro";
---

<section class="relative py-12 md:py-16">
  <div class="container-x md:grid md:grid-cols-[1.15fr_1fr] md:gap-8 md:items-center relative">
    <div class="fade-up relative">
      <h1 class="hero-title text-espresso text-[42px] md:text-[58px] lg:text-[68px] mb-5 md:mb-6">
        Uč se keramiku<br />tam, kde má hlína <span class="serif-italic-terracotta">čas.</span>
      </h1>
      <p class="text-[15px] md:text-[16px] text-stone leading-[1.7] max-w-lg mb-8">
        Malý ateliér v Ořechu — kurzy pro začátečníky i pokročilé, open studio pro volnou tvorbu a keramika, kterou si odneseš domů.
      </p>
      <div class="flex flex-col lg:flex-row items-start lg:items-center gap-3 lg:gap-0 mt-6 lg:mt-10">
        <Vazicka size={250} class="w-[96px] lg:w-[250px] h-auto pointer-events-none flex-shrink-0 lg:-mr-[100px] relative z-[2]" />
        <div class="flex flex-wrap gap-2.5 items-center relative z-[1]">
          <a
            href="/kurzy"
            class="inline-flex items-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-clay transition-colors"
          >
            Vybrat kurz <span aria-hidden="true">→</span>
          </a>
          <a
            href="/open-studio"
            class="inline-flex items-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso hover:text-cream transition-colors"
          >
            Zjistit open studio
          </a>
        </div>
      </div>
    </div>

    <div class="relative aspect-square max-w-[520px] mx-auto w-full mt-10 md:mt-0 fade-up flex items-center justify-center">
      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <circle cx="200" cy="200" r="188" fill="none" stroke="#6366F1" stroke-width="1.5" stroke-dasharray="7 6" class="dash-ring" />
        <circle cx="200" cy="200" r="155" fill="none" stroke="#6366F1" stroke-width="8" />
        <circle cx="200" cy="200" r="115" fill="none" stroke="#6366F1" stroke-width="8" />
        <path fill="#C87E4E" class="clay-blob">
          <animate
            attributeName="d"
            dur="12s"
            repeatCount="indefinite"
            values="
              M200,120 C248,118 284,152 280,200 C276,248 244,280 200,280 C156,280 120,248 120,200 C120,152 152,122 200,120 Z;
              M210,118 C260,130 290,165 278,210 C266,255 235,285 190,278 C145,271 115,235 122,190 C129,145 160,106 210,118 Z;
              M195,115 C245,110 292,155 285,205 C278,255 240,290 195,285 C150,280 112,245 118,195 C124,145 145,120 195,115 Z;
              M205,122 C255,135 282,170 270,215 C258,260 225,282 185,275 C145,268 118,230 128,185 C138,140 155,109 205,122 Z;
              M200,120 C248,118 284,152 280,200 C276,248 244,280 200,280 C156,280 120,248 120,200 C120,152 152,122 200,120 Z
            "
            calcMode="spline"
            keySplines="0.4 0 0.2 1; 0.4 0 0.2 1; 0.4 0 0.2 1; 0.4 0 0.2 1"
          />
        </path>
      </svg>
      <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 font-mono text-[12px] text-peri tracking-wider whitespace-nowrap">Přijď si sednout ke kruhu</span>
    </div>
  </div>
</section>

<style>
  @keyframes ring-cw { to { transform: rotate(360deg); } }
  .dash-ring {
    transform-origin: 200px 200px;
    animation: ring-cw 100s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .dash-ring { animation: none; }
  }
</style>


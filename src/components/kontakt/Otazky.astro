---
/**
 * Na co se lidi ptají — stojan ema 絵馬掛け na louce pod první obrazovkou
 * Kontaktu (dřív mřížka visaček, components/kontakt/Otazky.astro v 5ba243d).
 *
 * Jeden velký předmět jako u svatyně: pod měděnou střechou se štítem
 * a lakovanou deskou 扁額 visí na šňůře kōhaku deset destiček ema. Devět
 * má na líci namalovaného toho z party, kdo odpovídá, a otázku; na rubu je
 * odpověď jeho rukou a jeho pečeť. Desátá je prázdná — z ní se píše dopis.
 * Za nimi je stěna starých destiček cizích lidí, u paty jen Bublinka zpoza sloupu.
 * Kresbu stojanu, malby destiček i rozvržení pro tři šířky okna počítá
 * components/kontakt/kresba/ema.ts (`rozvrh`), takže HTML a kresba sedí
 * na pixel; tady se z rozvrhu skládají procenta do inline proměnných.
 *
 * Bez JavaScriptu je všechno čitelné: <details> se otevře nativně a rub se
 * ukáže jako karta (kontakt-ema.css). Sundávání destiček, otáčení, vítr,
 * zvonec a skoky party obstarává scripts/kontakt/ema.ts (kontakt-ema-hra.css),
 * šňůru přes louku scripts/kontakt/snura.ts podle kotev `data-snura-kotva`.
 * Louku pod stojanem kreslí scripts/kontakt/louka.ts podle data-trava
 * (hrana trávy kousek nad spodkem stojanu = paty sloupů).
 * Otázky a odpovědi jsou v data/dilna.ts (otazky).
 */
import { otazky } from "../../data/dilna";
import { parta, type PostavaId } from "../../data/parta";
import { kontakt, type Sezona } from "../../data/uvod2";
import { REZIMY, DESKA, PATA, HANKO, rozvrh, zasoba, stojan, popredi, sloupek, lic, rub, prazdna, pismoOdpovedi, type Rezim, type Rozvrh } from "./kresba/ema";

interface Props {
  sezona: Sezona;
}
const { sezona } = Astro.props;
const jmeno = (id: string) => parta.find((p) => p.id === id)?.name ?? id;
const polozky: { q: string; a: string; kdo: PostavaId }[] = otazky;

const R = Object.fromEntries(REZIMY.map((rz) => [rz, rozvrh(rz)])) as Record<Rezim, Rozvrh>;
const c = (n: number) => Math.round(n * 1000) / 1000;
const proc = (n: number) => `${c(n)}%`;
/** Inline proměnné pro všechny tři režimy (přípona -s/-m/-u), hodnoty z rozvrhu */
const styl = (fn: (r: Rozvrh) => Record<string, string | number>) =>
  REZIMY.map((rz) => Object.entries(fn(R[rz])).map(([k, v]) => `--${k}-${R[rz].p}:${v}`).join(";")).join(";");
const sx = (r: Rozvrh, x: number) => proc((x / r.W) * 100);
const sy = (r: Rozvrh, y: number) => proc((y / r.H) * 100);
const cq = (r: Rozvrh, v: number) => c((v / r.W) * 100);

/* stojan: poměr stran a kolik přečnívá parta a tráva pod zem (okraj v % šířky) */
const stylStojanu = styl((r) => ({
  pomer: `${r.W} / ${r.H}`,
  pod: proc(((Math.max(...r.kami.map((k) => k.y)) - r.H + 22 * Math.max(0.6, r.q.m)) / r.W) * 100),
}));
/* nadpis: box washi, pole plakety vůči němu a písmo v cqw */
const stylHlavy = styl((r) => ({
  x: sx(r, r.washi.x),
  y: sy(r, r.washi.y),
  w: sx(r, r.washi.w),
  h: sy(r, r.washi.h),
  sx: proc(((r.pole.x - r.washi.x) / r.washi.w) * 100),
  sy: proc(((r.pole.y - r.washi.y) / r.washi.h) * 100),
  sw: proc((r.pole.w / r.washi.w) * 100),
  sh: proc((r.pole.h / r.washi.h) * 100),
  h2: `${cq(r, r.q.pisma.h2)}cqw`,
  perex: `${cq(r, r.q.pisma.perex)}cqw`,
  stk: `${cq(r, r.q.pisma.kanji)}cqw`,
  stp: `${cq(r, r.q.pisma.stitek)}cqw`,
  hp: `${cq(r, r.q.pisma.odsazeni)}cqw`,
}));
const stylDesky = (i: number) =>
  styl((r) => {
    const d = r.desky[i];
    return { x: sx(r, d.x), y: sy(r, d.y), w: sx(r, d.w), r: `${d.r}deg`, xn: c((d.x / r.W) * 100), wn: c((d.w / r.W) * 100) };
  });
/* Kapka odpovídá dvakrát — druhá destička má jinou malbu (kafe) */
const druha = polozky.map((o, i) => polozky.slice(0, i).some((p) => p.kdo === o.kdo));
const kamiIdx = (id: PostavaId) => R.siroka.kami.findIndex((k) => k.id === id);
const stylKami = (id: PostavaId) =>
  `${styl((r) => {
    const k = r.kami[r.kami.findIndex((x) => x.id === id)];
    return { x: sx(r, k.x), y: sy(r, k.y), v: sx(r, k.v) };
  })};--pata:${PATA[id]}`;
const poradiParty = R.siroka.kami.map((k) => k.id);
const stylZvonce = styl((r) => ({ x: sx(r, r.zvonec.x), y: sy(r, r.zvonec.y), w: sx(r, r.zvonec.w), h: sy(r, r.zvonec.h) }));
const pocetZaves = Math.min(...REZIMY.map((rz) => R[rz].zavesy.length), 8);
const stylZavesu = (i: number) => styl((r) => ({ x: sx(r, r.zavesy[i][0]), y: sy(r, r.zavesy[i][1]) }));
const stylKotvy = (k: "vstup" | "vystup") => styl((r) => ({ x: sx(r, r.kotvy[k][0]), y: sy(r, r.kotvy[k][1]), t: cq(r, r.q.w) }));
const kamiSvg = (id: PostavaId) => {
  const k = R.siroka.kami[kamiIdx(id)];
  const use = `<use href="#ko-k-${id}"${k.zrcadlo ? ' transform="matrix(-1 0 0 1 180 0)"' : ""}/>`;
  return k.naklon ? `<g transform="rotate(${k.naklon} 90 ${c(PATA[id] * 180)})">${use}</g>` : use;
};
const vb = (r: Rozvrh) => `0 0 ${r.W} ${r.H}`;
const vbDesky = `0 0 ${DESKA.W} ${DESKA.H}`;
---
<section class="ko-ema-sekce" id="otazky" aria-labelledby="ko-ot-nadpis">
  <div class="ko-ema-stojan" data-trava="8" style={stylStojanu}>
    <div class="ko-ema-kresba" aria-hidden="true">
      <svg class="ko-ema-zasoba" width="0" height="0" focusable="false" set:html={`<defs>${zasoba()}</defs>`} />
      {REZIMY.map((rz) => (
        <svg class={`ko-ema-v ko-ema-v-${rz} ko-venku`} data-sezona={sezona} viewBox={vb(R[rz])} focusable="false" set:html={stojan(R[rz])} />
      ))}
    </div>

    <header class="ko-ema-hlava" style={stylHlavy}>
      <p class="stitek"><span lang="ja">質問</span> · otázky</p>
      <h2 id="ko-ot-nadpis">Na co se lidi ptají</h2>
      <p class="ko-ema-perex">Odpovídá parta z dílny — každý na to, čemu rozumí nejlíp.</p>
    </header>

    <ol class="ko-ema-seznam">
      {polozky.map((o, i) => (
        <li class="ko-ema" data-i={i} data-kdo={o.kdo} style={stylDesky(i)}>
          <details class="ko-ema-deska">
            <summary class="ko-ema-lic">
              <svg class="ko-ema-malba" aria-hidden="true" viewBox={vbDesky} focusable="false" set:html={lic(o.kdo, druha[i])} />
              <span class="ko-ema-otazka">{o.q}</span>
            </summary>
            <div class="ko-ema-rub">
              <svg class="ko-ema-drevo" aria-hidden="true" viewBox={vbDesky} focusable="false" set:html={rub()} />
              <p class="ko-ema-odpoved" style={`--pismo:${pismoOdpovedi(o.a)}`}><b class="ko-ema-jmeno">{jmeno(o.kdo)}</b> {o.a}</p>
              <span class="ko-ema-hanko" lang="ja" aria-hidden="true">{HANKO[o.kdo]}</span>
            </div>
          </details>
        </li>
      ))}
      <li class="ko-ema ko-ema-prazdna" data-i={polozky.length} data-kdo="bublinka" style={stylDesky(polozky.length)}>
        <a class="ko-ema-deska ko-ema-psat" href={`mailto:${kontakt.email}`}>
          <span class="ko-ema-lic">
            <svg class="ko-ema-malba" aria-hidden="true" viewBox={vbDesky} focusable="false" set:html={prazdna()} />
            <span class="ko-ema-otazka">A na co se chceš zeptat ty?</span>
          </span>
        </a>
      </li>
    </ol>

    <div class="ko-ema-parta">
      {poradiParty.map((id) => (
        <button type="button" class="ko-ema-kami" data-kdo={id} aria-label={`${jmeno(id)} poskočí`} style={stylKami(id)}>
          <svg viewBox="0 0 180 180" aria-hidden="true" focusable="false" set:html={kamiSvg(id)} />
        </button>
      ))}
    </div>

    <button type="button" class="ko-ema-zvonec" aria-label="Zazvonit na zvonec" style={stylZvonce}></button>
    {Array.from({ length: pocetZaves }, (_, i) => <span class="ko-ema-zaves" style={stylZavesu(i)}></span>)}
    <span class="ko-ema-kotva" data-snura-kotva="vstup" data-smer={R.siroka.kotvy.smerVstup} style={stylKotvy("vstup")}></span>
    <span class="ko-ema-kotva" data-snura-kotva="vystup" data-smer={R.siroka.kotvy.smerVystup} style={stylKotvy("vystup")}></span>

    <div class="ko-ema-sloupek" aria-hidden="true">
      {REZIMY.map((rz) => (
        <svg class={`ko-ema-v ko-ema-v-${rz}`} viewBox={vb(R[rz])} focusable="false" set:html={sloupek(R[rz])} />
      ))}
    </div>
    <div class="ko-ema-popredi" aria-hidden="true">
      {REZIMY.map((rz) => (
        <svg class={`ko-ema-v ko-ema-v-${rz} ko-venku`} data-sezona={sezona} viewBox={vb(R[rz])} focusable="false" set:html={popredi(R[rz])} />
      ))}
    </div>
  </div>
</section>

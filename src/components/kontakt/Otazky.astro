---
/**
 * Zeptej se dílny — otázky, na které odpovídá parta (dřív na Dílně, od
 * 16. 10. 2026 na Kontaktu). Otázka je černá bublina vpravo, odpověď
 * krémová bublina s kami, který ji říká. Otázky a odpovědi jsou
 * v data/dilna.ts (otazky), protože čtou ceny a časy z jednoho místa.
 */
import Postavicka from "../characters/Postavicka.astro";
import { otazky } from "../../data/dilna";
import { parta } from "../../data/parta";

const jmeno = (id: string) => parta.find((p) => p.id === id)?.name ?? id;
---
<section class="ko-otazky" id="otazky" data-hodina="12.6" aria-labelledby="otazky-nadpis">
  <div class="ko-otazky-papir papir">
    <p class="stitek"><span lang="ja">質問</span> · otázky</p>
    <h2 id="otazky-nadpis" class="nadpis-2">Zeptej se dílny</h2>
    <div class="ko-chat">
      {otazky.map((o) => (
        <div class="ko-chat-radek">
          <p class="ko-chat-q">{o.q}</p>
          <div class="ko-chat-a">
            <span class="ko-chat-kami" aria-hidden="true"><Postavicka id={o.kdo} size={52} varianta="kami" /></span>
            <p><b>{jmeno(o.kdo)}</b>{o.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

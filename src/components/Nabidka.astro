---
import SectionHead from "./SectionHead.astro";
import NabidkaRadek from "./NabidkaRadek.astro";

const offers = [
  {
    idx: "hodiny či dny",
    name: "Workshopy",
    desc: "Jednorázové zážitkové kurzy. Ideální jako dárek nebo příležitost pro Vaše soukromé akce — teambuildingy, narozeniny, rozlučky se svobodou, zážitkový víkend či den…",
    link: "/kurzy",
    linkText: "Vybrat termín",
    featured: false,
  },
  {
    idx: "1–10 lekcí",
    name: "Kurzy",
    desc: "Vícedenní cykly pro začátečníky i pokročilé. Kruh, technika, glazování.",
    link: "/kurzy",
    linkText: "Prohlédnout kurzy",
    featured: false,
  },
  {
    idx: "na hodiny",
    name: "Open studio",
    desc: "Máte čas pro sebe a chtěli byste ho strávit kreativně? Dílna slouží i jako otevřený prostor, kde si své tvoření řídíte sami.",
    link: "/open-studio",
    linkText: "Zjistit více",
    featured: true,
    badge: "Nejoblíbenější",
  },
  {
    idx: "keramika s sebou",
    name: "Obchod",
    desc: "Výrobky od nás i českých a zahraničních keramiků. Malé série a originální kousky.",
    link: "/obchod",
    linkText: "Do obchodu",
    featured: false,
  },
];

/*
 * Kurzy a Open studio jsou to, co v dílně běží — patří k tomu, co u nás
 * najdete. V „Co připravujeme“ zůstává to, co se teprve chystá.
 */
const vDilne = ["Kurzy", "Open studio"];
const najdete = offers.filter((o) => vDilne.includes(o.name));
const pripravujeme = offers.filter((o) => !vDilne.includes(o.name));

/*
 * Zářijový den otevřených dveří. Všechny termíny jsou za námi, proto
 * stojí v sekci „Co již proběhlo“ a mají přeškrtnutá data. Blok jde přes
 * celou šířku a má větší písmo — je to událost, ne položka katalogu.
 */
const den = {
  idx: "pátky v září",
  name: "Den otevřených dveří",
  desc: "Přijďte se podívat, jak funguje dílna zevnitř a jak to u nás vypadá. Vidět můžete točení na kruhu, nahlédnete do pece a osaháte si hlínu, i kdybyste ji v ruce nikdy neměli. Ptát se můžete na cokoliv.",
  terminy: [
    { datum: "4. 9.", cas: "15:00–19:00", probehlo: true },
    { datum: "11. 9.", cas: "9:00–14:00", probehlo: true },
    { datum: "18. 9.", cas: "9:00–14:00", probehlo: true },
    { datum: "25. 9.", cas: "15:00–19:00", probehlo: true },
  ],
};
---

<section class="py-14 relative fade-up">
  <div class="container-x">
    <SectionHead title="Co u nás" italic="najdete" />
    <div class="border-t border-espresso/20">
      {najdete.map((o) => <NabidkaRadek {...o} />)}
    </div>

    <div class="mt-14">
      <SectionHead title="Co" italic="připravujeme" meta="Katalog" />
    </div>
    <div class="border-t border-espresso/20">
      {pripravujeme.map((o) => <NabidkaRadek {...o} />)}
    </div>

    <div class="mt-14">
      <SectionHead title="Co již" italic="proběhlo" />
    </div>
    <div>
      {/*
        Výjimka z pravidla „seznamy bez rámečku“: řádek drží tvar jen ve
        skupině, kde se má podle čeho zarovnat. Tahle akce je v sekci sama,
        takže by jako holý řádek vypadala jako zapomenutá. Bublina jí dává
        hranici; že už proběhla, říká bílá plocha místo růžové a přeškrtnuté
        termíny, ne výraznost.
      */}
      <div class="bg-white rounded-2xl border border-espresso/10 p-6 md:p-8 grid md:grid-cols-[2fr_3fr_auto] gap-x-8 lg:gap-x-12 gap-y-5 items-center">
        <div>
          <h3 class="font-serif font-light text-[26px] md:text-[32px] leading-none">{den.name}</h3>
          <p class="mono-meta mt-2.5">{den.idx}</p>
        </div>

        <p class="text-[16px] md:text-[17px] text-stone leading-[1.75] max-w-[52ch]">{den.desc}</p>
        {/*
          Dva sloupce zarovnané doprava: u data lícují měsíce, u času pomlčky
          (konce jsou všechny pětiznakové). Bublina tu zůstává i v editorialní
          sazbě — tohle je tabulka, ne věta, a tabulce tichý podklad drží sloupce
          pohromadě. Pravidlo „karta patří věci“ mluví o položkách, ne o datech.
        */}
        <ul class="md:ml-auto shrink-0 self-start bg-cream rounded-xl px-6 py-4 font-mono text-[13px] tabular-nums grid grid-cols-[auto_auto]">
          {den.terminy.map((t, i) => (
            <li class={`col-span-2 grid grid-cols-subgrid relative ${t.probehlo ? "after:absolute after:inset-x-0 after:top-1/2 after:border-t after:border-espresso/50" : ""}`}>
              <span class={`text-right text-espresso font-medium py-2 pr-7 ${i > 0 ? "border-t border-espresso/10" : ""} ${t.probehlo ? "opacity-50" : ""}`}>
                {t.datum.replace(" ", " ")}
              </span>
              <span class={`text-right text-stone py-2 ${i > 0 ? "border-t border-espresso/10" : ""} ${t.probehlo ? "opacity-50" : ""}`}>
                {t.cas.replace("–", " – ")}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

---
import SectionHead from "./SectionHead.astro";

const offers = [
  {
    idx: "3 hodiny",
    name: "Workshopy",
    desc: "Jednorázové zážitkové kurzy. Ideální na dárek nebo teambuilding.",
    link: "/kurzy",
    linkText: "Vybrat termín",
    featured: false,
  },
  {
    idx: "4–8 lekcí",
    name: "Kurzy",
    desc: "Vícedenní cykly pro začátečníky i pokročilé. Kruh, technika, glazování.",
    link: "/kurzy",
    linkText: "Prohlédnout kurzy",
    featured: false,
  },
  {
    idx: "na hodiny",
    name: "Open studio",
    desc: "Rezervuj si čas u kruhu bez instruktora. Členství i jednorázový vstup.",
    link: "/open-studio",
    linkText: "Zjistit více",
    featured: true,
    badge: "Nejoblíbenější",
  },
  {
    idx: "malé série",
    name: "Obchod",
    desc: "Keramika od nás i našich lektorů. Malé série, žádné dva stejné.",
    link: "/obchod",
    linkText: "Do obchodu",
    featured: false,
  },
];

/*
 * Široký blok nad čtveřicí. Není to pátá položka katalogu, ale událost,
 * proto jde přes celou šířku a jako jediný má plnou barvu — mezi bílými
 * kartami se tím oddělí dřív, než se začne číst.
 *
 * Vystřižený papír z Dizajnu 2.0: rovné hrany místo zaoblených, měkký
 * stín a lehké natočení. Každý termín je vlastní lístek, žádný nesedí
 * rovně — jinak by ta metafora nefungovala a byla by to jen mřížka.
 */
const den = {
  name: "Dny otevřených dveří",
  desc: "Přijď se podívat, jak dílna funguje zevnitř. Uvidíš točení na kruhu, nahlédneš do pece a osaháš si hlínu, i kdybys ji v ruce nikdy neměl. Ptát se můžeš na cokoliv.",
};

const dny = [
  { datum: "4. 9.", cas: "15–19 hodin", sklon: "-rotate-[1.7deg]" },
  { datum: "11. 9.", cas: "9–14 hodin", sklon: "rotate-[1.2deg]" },
  { datum: "18. 9.", cas: "9–14 hodin", sklon: "rotate-[0.9deg]" },
  { datum: "25. 9.", cas: "15–19 hodin", sklon: "-rotate-[1.1deg]" },
];
---

<section class="py-14 relative fade-up">
  <div class="container-x">
    <SectionHead title="Co u nás" italic="najdeš" meta="Katalog" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="sm:col-span-2 lg:col-span-4 bg-clay text-cream p-6 md:p-8 lg:p-10 -rotate-[0.5deg] shadow-[0_10px_22px_-10px_rgba(58,46,40,0.4)] grid gap-7 md:grid-cols-[1fr_auto] md:gap-10 md:items-center">
        <div>
          <h3 class="font-serif text-[26px] md:text-[32px] font-medium leading-tight mb-2" style="font-variation-settings: 'opsz' 72;">
            {den.name}
          </h3>
          <p class="text-[15px] leading-[1.6] text-cream/90 max-w-[62ch]">{den.desc}</p>
        </div>
        <div class="grid grid-cols-2 gap-3 md:gap-3.5 shrink-0">
          {dny.map((d) => (
            <div class={`bg-cream px-4 py-3 shadow-[0_4px_10px_-4px_rgba(58,46,40,0.34)] ${d.sklon}`}>
              <span class="block font-serif font-medium text-clay text-[30px] md:text-[36px] leading-none tabular-nums whitespace-nowrap" style="font-variation-settings: 'opsz' 72;">
                {d.datum}
              </span>
              <span class="block font-mono text-[11px] text-stone tracking-wider uppercase mt-2 whitespace-nowrap">
                {d.cas}
              </span>
            </div>
          ))}
        </div>
      </div>

      {offers.map((o) => (
        <div class={`bg-white rounded-xl p-5 border ${o.featured ? "border-espresso" : "border-espresso/10"} relative`}>
          {o.badge && (
            <span class="absolute -top-2 left-3.5 bg-peri text-cream font-mono text-[12px] font-medium px-2.5 py-1 rounded-full tracking-wider">
              {o.badge}
            </span>
          )}
          <div class="font-mono text-[12px] text-stone tracking-wider mb-3.5">{o.idx}</div>
          <h3 class="font-serif text-[20px] font-medium mb-1.5" style="font-variation-settings: 'opsz' 48;">{o.name}</h3>
          <p class="text-[14px] leading-[1.55] text-stone mb-4 min-h-[54px]">{o.desc}</p>
          <a href={o.link} class="text-[14px] font-medium">
            {o.linkText} <span class="text-clay">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

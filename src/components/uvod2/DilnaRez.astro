            <ellipse cx="330" cy="790" rx="26" ry="6" /><ellipse cx="640" cy="560" rx="10" ry="4" /><ellipse cx="560" cy="792" rx="18" ry="5" />
          </g>
          {/* Prasklá trubka pod stropem a kaluž */}
          <path d="M170 474 H760" stroke="#8C949B" stroke-width="10" />
          <path d="M170 474 H760" stroke="#B9C0C6" stroke-width="3" />
          <path d="M612 468 L618 480 L624 470" stroke="#2B2420" stroke-width="2" fill="none" />
          <circle class="rok-kapka" cx="618" cy="490" r="4" fill="#8FB3C9" />
          <circle class="rok-kapka rok-kapka-2" cx="618" cy="490" r="3.4" fill="#8FB3C9" />
          <ellipse cx="660" cy="836" rx="250" ry="17" fill="#8FB3C9" opacity="0.8" />
          <ellipse cx="620" cy="833" rx="140" ry="8" fill="#C9DDE8" opacity="0.6" />
          <ellipse class="rok-vlnka" cx="618" cy="836" rx="40" ry="6" fill="none" stroke="#FFFFFF" stroke-width="1.5" />
        </g>
        <g data-od="3" data-do="4">
          {/* Suť ze zbourané zdi, kýbl s barvou a štafle */}
          <g fill="#A89A86">
            <rect x="300" y="842" width="22" height="12" rx="2" /><rect x="318" y="846" width="20" height="10" rx="2" transform="rotate(12 328 851)" />
            <rect x="334" y="840" width="24" height="12" rx="2" transform="rotate(-8 346 846)" /><rect x="312" y="832" width="18" height="10" rx="2" transform="rotate(6 321 837)" />
          </g>
          <path d="M1000 822 L1004 858 L1036 858 L1040 822 Z" fill="#F4F1EA" stroke="#B9B4A8" />
          <path d="M1004 824 C1012 832 1018 822 1026 830" stroke="#5B7FD1" stroke-width="3" fill="none" />
          <path d="M1046 858 L1066 800 M1062 858 L1066 800" stroke="#C9A37A" stroke-width="3" />
          <rect x="1058" y="792" width="20" height="10" rx="3" fill="#5B7FD1" />
          <path d="M1250 860 L1286 560 M1300 860 L1330 560" stroke="#B08660" stroke-width="5" />
          {Array.from({ length: 8 }, (_, i) => <path d={`M${1253 + i * 4.4} ${830 - i * 36} H${1302 + i * 3.6}`} stroke="#B08660" stroke-width="4" />)}
        </g>
        <g data-od="6" data-do="7">
          {/* Mobil na stativu — začíná Instagram */}
          <path d="M1000 858 L1012 790 L1024 858 M1012 790 L1012 858" stroke="#2B2420" stroke-width="2.5" fill="none" />
          <rect x="998" y="752" width="28" height="44" rx="4" fill="#2B2420" />
          <rect x="1001" y="756" width="22" height="34" rx="2" fill="#7DA7C9" />
          <circle class="rok-nahrava" cx="1018" cy="760" r="2.4" fill="#E2452E" />
        </g>
        <g data-od="7" data-do="8">
          {/* Místo pro novou pec */}
          <path d="M958 820 L1062 820 L1070 858 L950 858 Z" fill="none" stroke="#E8B440" stroke-width="3" stroke-dasharray="10 6" />
          <text x="1010" y="846" text-anchor="middle" font-size="18" fill="#B98A1C" font-family="Caveat, cursive" font-weight="600">PEC</text>
        </g>
        <g data-od="9" data-do="10">
          {/* Šlápoty ze dne otevřených dveří */}
          {slapoty.map((s) => (
            <g transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)}) rotate(${s.u.toFixed(1)})`} fill="#7E6A58" opacity="0.4">
              <ellipse cx="0" cy="0" rx="6" ry="3.4" /><ellipse cx="-9" cy="0.4" rx="3" ry="2.8" />
            </g>
          ))}
        </g>
      </>
    )}

    {/* Popředí: trs trávy před řezem */}
    <g fill="#4C7634">
      <path d="M120 1000 Q126 960 118 930 Q134 962 136 1000 Z" /><path d="M1480 1000 Q1488 962 1478 934 Q1496 966 1498 1000 Z" />
      <path d="M760 1000 Q764 974 756 956 Q772 978 772 1000 Z" />
    </g>
  </svg>

  {/* ——— Částice ročního období ——— */}
  <div class="castice" aria-hidden="true">
    {listy.map((l, i) => (
      <span
        class={`castice-kus ${i % 3 === 0 ? "castice-velky" : ""}`}
        style={`left:${(l.x * 0.9 + 4).toFixed(1)}%;top:${(-8 - l.y * 0.3).toFixed(1)}%;--d:${(9 + l.s * 9).toFixed(1)}s;--z:${(-l.t * 18).toFixed(1)}s;--dx:${((l.s - 0.4) * 160).toFixed(0)}px;--r:${(220 + l.t * 400).toFixed(0)}deg`}
      ></span>
    ))}
  </div>

  {/* ——— Tlačítka v kresbě ——— */}
  {rezim === "prohlidka" && (
    <div class="rez-mista">
      {/* Zvýraznění pro „1 pec · 2 stoly · 3 kruhy“ v úvodní kartě — jen kreslí, neklikají */}
      <span class="rez-misto rez-ukaz" data-ukaz-v="pec" style={misto(950, 672, 1084, 864)} aria-hidden="true"></span>
      <span class="rez-misto rez-ukaz" data-ukaz-v="stoly" style={misto(604, 684, 858, 866)} aria-hidden="true"></span>
      <span class="rez-misto rez-ukaz" data-ukaz-v="stoly" style={misto(860, 750, 946, 866)} aria-hidden="true"></span>
      {KRUHY.map((c) => (
        <span class="rez-misto rez-ukaz" data-ukaz-v="kruhy" style={misto(c - 50, 738, c + 50, 864)} aria-hidden="true"></span>
      ))}
      {KRUHY.map((c, i) => (
        <button type="button" class="rez-misto" data-akce="kruh" data-kruh={i} data-stanice="kruhy" style={misto(c - 48, 740, c + 48, 862)} aria-label={`Roztočit ${i + 1}. kruh`}></button>
      ))}
      <button type="button" class="rez-misto" data-akce="hrouda" data-stanice="stoly" style={misto(692, 700, 778, 748)} aria-label="Prohníst hroudu na stole"></button>
      <button type="button" class="rez-misto" data-akce="pec" data-stanice="pec" style={misto(950, 672, 1084, 862)} aria-label="Pec"></button>
      {kusy.map((k, i) => (
        <button type="button" class="rez-misto" data-akce="kus" data-kus={i} data-stanice="police" style={misto(...(kusMista[i].box as [number, number, number, number]))} aria-label={`Vzít z police: ${k.name}`}></button>
      ))}
      <button type="button" class="rez-misto" data-akce="poukaz" data-stanice="nastenka" style={misto(1203, 562, 1251, 600)} aria-label="Otočit poukaz na nástěnce"></button>
      <button type="button" class="rez-misto" data-akce="workshop" data-stanice="nastenka" style={misto(1250, 562, 1278, 604)} aria-label="Lístek na nástěnce: workshopy"></button>
      <button type="button" class="rez-misto" data-akce="kafe" data-stanice="kuchynka" style={misto(1292, 640, 1334, 694)} aria-label="Postavit na kafe"></button>
      {kusy.map((k, i) => (
        <p class="kus-cedulka" data-cedulka={i} style={`left:${(((kusMista[i].x - 40) / W) * 100).toFixed(3)}%;top:${(((kusMista[i].box[1] - 34) / H) * 100).toFixed(3)}%`} aria-hidden="true">
          <b>{k.name}</b><span>{k.price}</span>
        </p>
      ))}
    </div>
  )}

  {/* ——— Klikací místa na stránce Dílna ——— */}
  {dilna && (
    <div class="rez-mista">
      {KRUHY.map((c, i) => (
        <button type="button" class="rez-misto" data-akce="kruh" data-kruh={i} data-cinnost="tocit" style={misto(c - 48, 740, c + 48, 862)} aria-label={`Roztočit ${i + 1}. kruh`}></button>
      ))}
      <button type="button" class="rez-misto" data-akce="hrouda" data-cinnost="placat" style={misto(692, 700, 778, 748)} aria-label="Plácnout do hroudy na stole"></button>
      <button type="button" class="rez-misto" data-akce="kbeliky" data-cinnost="glazovat" style={misto(1188, 736, 1290, 804)} aria-label="Zamíchat glazuru v kbelících"></button>
      <button type="button" class="rez-misto" data-akce="pec" data-cinnost="pec" style={misto(950, 672, 1084, 862)} aria-label="Nakouknout do pece"></button>
      <button type="button" class="rez-misto" data-akce="kafe" data-cinnost="kafe" style={misto(1292, 640, 1334, 694)} aria-label="Postavit na kafe"></button>
      <Zkouska id="celadon" class="rez-zkouska" style={misto(557, 716, 579, 752)} />
    </div>
  )}

  {/* ——— Parta ——— */}
  <div class="rez-parta">
    {parta.map((k) => (
      <Kami id={k.id} class={`rez-kami rez-kami-${k.id}`} style={postava(k.x, k.pata, k.w)} />
    ))}
    {!rok && (
      <>
        <Kami id="bublinka" class="rez-kami rez-bublinka" style={postava(744, 716, 40)} />
        <Kami id="samotka" class="rez-kami rez-samotka" style={postava(1008, 716, 44)} />
      </>
    )}
    {rok && (
      <>
        <span class="rok-kami" data-od="2" data-do="5"><Kami id="kapka" class="rez-kami" style={postava(690, 842, 42)} /></span>
        <span class="rok-kami" data-od="5"><Kami id="kapka" class="rez-kami" style={postava(1399, 695, 34)} /></span>
        <span class="rok-kami" data-od="8"><Kami id="pecinka" class="rez-kami" style={postava(1112, 868, 60)} /></span>
        <span class="rok-kami" data-od="8"><Kami id="hlinka" class="rez-kami" style={postava(801, 828, 52)} /></span>
      </>
    )}
  </div>
</div>

---
/**
 * Dílna v řezu — domeček bez přední stěny. Jedna pec, dva stoly, tři
 * kruhy, výloha, kuchyňka, nástěnka a police, nad tím krov a střecha,
 * venku sakura a ořech. Kreslí se ve dvou režimech:
 *
 *   prohlidka — dílna, jak je teď. Kruhy, hrouda, pec, kusy na polici,
 *               poukaz a kávovar jsou tlačítka (scripts/uvod2/prohlidka.ts)
 *               a parta bydlí každý u svého.
 *   rok       — tatáž dílna, ale každá věc má data-od (a případně data-do):
 *               měsíc roku 2026, kdy do dílny přibyla (nebo zmizela).
 *               Navíc kaluž po havárii, vrata garáže, lešení s barvou,
 *               páska „PEC“ na podlaze a šlápoty ze dne otevřených dveří.
 *               Měsíce přepíná scripts/uvod2/rok.ts.
 *   dilna     — dílna jako v prohlídce, k tomu kbelíky s glazurou pod
 *               nástěnkou, místo pro kus, který si člověk udělal na
 *               stránce Dílna (dopisuje scripts/dilna/uvod.ts), a zkouška
 *               glazury schovaná na parapetu výlohy. Klikací místa jsou
 *               jiná — vedou k tomu, co se v dílně dělá.
 *
 * Souřadnice jsou ve viewBoxu 1600 × 1000 a HTML vrstvy nad kresbou
 * (tlačítka, parta) se počítají ze stejných čísel — proto ty helpery
 * dole. Barvy stromů a země jedou z proměnných ročního období.
 */
import Kami from "../parta2/Kami.astro";
import Nadoba from "./Nadoba.astro";
import { chomac, body } from "../parta2/tvary";
import { produkty, tvorba } from "../../data/obchod";
import { kurzy } from "../../data/kurzy";
import { denOtevrenychDveri } from "../../data/uvod2";
import type { PostavaId } from "../../data/parta";
import { syrova } from "../../data/dilna";
import Zkouska from "../dilna/Zkouska.astro";

interface Props {
  rezim: "prohlidka" | "rok" | "dilna";
}
const { rezim } = Astro.props;
const rok = rezim === "rok";
const dilna = rezim === "dilna";
const p = rok ? "rr" : dilna ? "rd" : "rp";

/** Atributy pro režim „rok“: od kterého měsíce věc v dílně je (a do kterého) */
const od = (m: number, doM?: number) => (rok ? { "data-od": m, ...(doM ? { "data-do": doM } : {}) } : {});

/* ——— HTML vrstvy: procenta z viewBoxu ——— */
const W = 1600;
const H = 1000;
const misto = (x0: number, y0: number, x1: number, y1: number) =>
  `left:${((x0 / W) * 100).toFixed(3)}%;top:${((y0 / H) * 100).toFixed(3)}%;width:${(((x1 - x0) / W) * 100).toFixed(3)}%;height:${(((y1 - y0) / H) * 100).toFixed(3)}%`;
/** Kami stojí patou na `pata`; kresby postaviček mají pod nohama asi osminu výšky vzduchu */
const postava = (x: number, pata: number, w: number) =>
  `left:${(((x - w / 2) / W) * 100).toFixed(3)}%;bottom:${(((H - pata - w * 0.12) / H) * 100).toFixed(3)}%;width:${((w / W) * 100).toFixed(3)}%`;

/* ——— Kruhy ——— */
const KRUHY = [330, 437, 544];
const hlinaFaze = (c: number) => [
  `M${c - 20} 807 C${c - 22} 792 ${c - 12} 782 ${c} 782 C${c + 12} 782 ${c + 22} 792 ${c + 20} 807 Z`,
  `M${c - 15} 807 C${c - 16} 790 ${c - 14} 772 ${c - 13} 760 L${c + 13} 760 C${c + 14} 772 ${c + 16} 790 ${c + 15} 807 Z`,
  `M${c - 12} 807 C${c - 23} 790 ${c - 21} 768 ${c - 9} 757 C${c - 6} 753 ${c - 7} 747 ${c - 8} 740 L${c + 8} 740 C${c + 7} 747 ${c + 6} 753 ${c + 9} 757 C${c + 21} 768 ${c + 23} 790 ${c + 12} 807 Z`,
  `M${c - 27} 786 C${c - 25} 800 ${c - 14} 807 ${c} 807 C${c + 14} 807 ${c + 25} 800 ${c + 27} 786 Z`,
];
/** Okraj nahoře u každé fáze: [y, rx, ry] — hrouda žádný nemá */
const hlinaOkraj: ([number, number, number] | null)[] = [null, [760, 13, 3], [740, 8, 2], [786, 27, 5]];
/** Každý kruh začíná jinde, ať nejsou tři stejné hroudy vedle sebe */
const startFaze = [0, 1, 2];

/* ——— Police: první čtyři kusy z obchodu a pod nimi naše tvorba ——— */
const kusy = produkty.slice(0, 4);
const kusMista = [
  { x: 1118, y: 560, s: 0.62, box: [1096, 528, 1142, 564] },
  { x: 1162, y: 560, s: 0.58, box: [1144, 516, 1180, 564] },
  { x: 1116, y: 630, s: 0.74, box: [1096, 598, 1138, 634] },
  { x: 1158, y: 630, s: 0.62, box: [1139, 594, 1180, 634] },
];
const nase = tvorba.slice(0, 3);

/* ——— Kbelíky s glazurou (jen v režimu „dilna“) ——— */
const KBELIKY = [
  { x: 1206, glazura: "celadon" },
  { x: 1238, glazura: "tenmoku" },
  { x: 1270, glazura: "shino" },
];

/* ——— Parta: kdo kde bydlí (x, pata, šířka) ——— */
const parta: { id: PostavaId; x: number; pata: number; w: number; cls?: string }[] = rok
  ? []
  : [
      { id: "vazicka", x: 470, pata: 758, w: 50 },
      { id: "hlinka", x: 801, pata: 828, w: 52 },
      { id: "pecinka", x: 1112, pata: 868, w: 60 },
      { id: "stripek", x: 1148, pata: 774, w: 30 },
      { id: "cedulka", x: 1258, pata: 668, w: 32 },
      { id: "kapka", x: 1399, pata: 695, w: 34 },
      { id: "kachlik", x: 906, pata: 201, w: 46 },
    ];

/* ——— Kalendář na zdi: měsíc nejbližšího termínu, kroužky na dnech s kurzem ——— */
const MESICE = ["Leden", "Únor", "Březen", "Duben", "Květen", "Červen", "Červenec", "Srpen", "Září", "Říjen", "Listopad", "Prosinec"];
const prvni = kurzy[0]?.date ?? new Date();
const kalRok = prvni.getFullYear();
const kalMes = prvni.getMonth();
const posun = (new Date(kalRok, kalMes, 1).getDay() + 6) % 7;
const dnuVMesici = new Date(kalRok, kalMes + 1, 0).getDate();
const dnyKurzu = new Set(kurzy.filter((k) => k.date.getFullYear() === kalRok && k.date.getMonth() === kalMes).map((k) => k.date.getDate()));
const kalBunky = Array.from({ length: dnuVMesici }, (_, i) => {
  const n = posun + i;
  return { den: i + 1, x: 852 + (n % 7) * 8.4, y: 590 + Math.floor(n / 7) * 8.2, kurz: dnyKurzu.has(i + 1) };
});

/* ——— Drobnosti ——— */
const kvetiny = body(34, 977, 1600, 100).map((b) => ({ x: b.x, y: 896 + b.y * 0.9, druh: b.s < 0.45 ? "mak" : b.s < 0.7 ? "chrpa" : "kopretina", v: 0.7 + b.t * 0.6 }));
const slapoty = Array.from({ length: 16 }, (_, i) => {
  const t = i / 15;
  return { x: 240 + t * 760 + (i % 2) * 6, y: 846 - Math.sin(t * Math.PI) * 30 + (i % 2) * 8, u: -8 + t * 20 };
});
const listy = body(10, 433, 100, 100);
/** „Den otevřených dveří“ na plakátku na dva řádky — na jeden se nevejde */
const denSlova = denOtevrenychDveri.nazev.split(" ");
const denNazev = [denSlova.slice(0, -1).join(" "), denSlova[denSlova.length - 1]];
---
<div class={`rez rez-${rezim}`} data-rez={rezim}>
  <svg class="rez-kresba" viewBox="0 0 1600 1000" aria-hidden="true">
    <defs>
      <linearGradient id={`${p}-trava`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color:var(--zem-1)" />
        <stop offset="1" style="stop-color:var(--zem-2)" />
      </linearGradient>
      <linearGradient id={`${p}-zed`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#F3ECDF" />
        <stop offset="1" stop-color="#E6DCCB" />
      </linearGradient>
      <linearGradient id={`${p}-podlaha`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#A3AA9E" />
        <stop offset="1" stop-color="#C6CBC0" />
      </linearGradient>
      <linearGradient id={`${p}-ocel`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#7E868C" />
        <stop offset="0.3" stop-color="#E8ECEE" />
        <stop offset="0.55" stop-color="#B4BBC0" />
        <stop offset="1" stop-color="#6A7278" />
      </linearGradient>
      <linearGradient id={`${p}-hlava`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#7E858C" />
        <stop offset="0.38" stop-color="#D3D8DC" />
        <stop offset="0.62" stop-color="#A3AAB0" />
        <stop offset="1" stop-color="#6B7278" />
      </linearGradient>
      <linearGradient id={`${p}-hlina`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#5E4334" />
        <stop offset="0.3" stop-color="#9C7860" />
        <stop offset="0.44" stop-color="#C9A184" />
        <stop offset="0.6" stop-color="#9C7860" />
        <stop offset="1" stop-color="#4E3729" />
      </linearGradient>
      <linearGradient id={`${p}-dvere`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFF6DD" />
        <stop offset="1" stop-color="#F2D29C" />
      </linearGradient>
      <linearGradient id={`${p}-paprsek`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFF4D6" stop-opacity="0.55" />
        <stop offset="1" stop-color="#FFF4D6" stop-opacity="0" />
      </linearGradient>
      <radialGradient id={`${p}-zar`} cx="0.5" cy="0.6" r="0.6">
        <stop offset="0" stop-color="#FFF2C0" />
        <stop offset="0.4" stop-color="#FFB050" stop-opacity="0.85" />
        <stop offset="1" stop-color="#E0501E" stop-opacity="0" />
      </radialGradient>
      <pattern id={`${p}-rez`} width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="10" height="10" fill="#8E7E6D" />
        <rect width="3" height="10" fill="#7A6A5A" />
      </pattern>
      <pattern id={`${p}-pruhy`} width="20" height="120" patternUnits="userSpaceOnUse">
        <rect x="0" width="4" height="120" fill="#FFFFFF" opacity="0.2" />
        <rect x="11" width="2" height="120" fill="#2E2018" opacity="0.18" />
      </pattern>
      {!rok && KRUHY.map((c, i) => hlinaFaze(c).map((d, f) => <clipPath id={`${p}-k${i}-f${f}`}><path d={d} /></clipPath>))}
    </defs>

    {/* ——— Kopce za domem ——— */}
    <path d="M0 760 C140 720 300 736 420 716 C640 690 900 728 1180 704 C1360 690 1500 712 1600 700 L1600 880 L0 880 Z" style="fill:var(--kopec-daleko)" opacity="0.85" />
    <path d="M0 812 C200 788 380 800 600 790 C860 780 1100 806 1340 792 C1460 786 1540 794 1600 790 L1600 880 L0 880 Z" style="fill:var(--kopec-blizko)" opacity="0.7" />

    {/* ——— Ořech za domem ——— */}
    <g class="rez-orech">
      <path d="M1512 880 C1520 800 1514 700 1526 600 C1530 560 1532 540 1530 520 L1574 520 C1572 548 1574 570 1578 610 C1590 700 1584 800 1596 880 Z" fill="#6E5E50" />
      <g stroke="#6E5E50" stroke-linecap="round" fill="none">
        <path d="M1536 560 C1500 520 1470 500 1430 488" stroke-width="16" />
        <path d="M1560 540 C1580 500 1590 470 1600 452" stroke-width="14" />
        <path d="M1548 530 C1546 480 1552 440 1544 400" stroke-width="12" />
      </g>
      <path d="M1524 760 Q1552 772 1582 760" stroke="#E8D7AE" stroke-width="7" fill="none" />
      <g class="koruna-orech">
        <path class="ore-1" d={chomac(1520, 420, 170, 130, 18, 811)} />
        <path class="ore-2" d={chomac(1500, 396, 130, 98, 15, 812)} />
        <path class="ore-2" d={chomac(1580, 440, 90, 70, 12, 813)} />
        <path class="ore-3" d={chomac(1474, 372, 70, 50, 11, 814)} />
      </g>
      <g class="snih" fill="#FBFDFF">
        <path d="M1430 486 C1470 496 1500 516 1534 556 C1500 524 1468 506 1428 494 Z" />
        <path d="M1542 402 C1550 440 1548 480 1550 528 L1544 528 C1542 480 1544 440 1536 404 Z" />
      </g>
    </g>

    {/* ——— Sakura vlevo ——— */}
    <g class="rez-sakura">
      <path d="M44 880 C50 800 46 730 58 660 C62 636 64 620 66 600 L82 600 C80 626 80 646 78 672 C74 740 80 810 92 880 Z" fill="#5A4636" />
      <g stroke="#5A4636" stroke-linecap="round" fill="none">
        <path d="M66 660 C44 630 28 610 6 596" stroke-width="9" />
        <path d="M72 640 C96 612 118 596 150 584" stroke-width="8" />
        <path d="M70 612 C66 580 72 556 62 528" stroke-width="6" />
      </g>
      <g class="koruna">
        <path class="sak-1" d={chomac(64, 546, 96, 72, 14, 821)} />
        <path class="sak-2" d={chomac(46, 528, 70, 52, 12, 822)} />
        <path class="sak-2" d={chomac(104, 516, 52, 40, 10, 823)} />
        <path class="sak-3" d={chomac(36, 508, 38, 28, 9, 824)} />
      </g>
      <g class="snih" fill="#FBFDFF">
        <path d="M4 594 C24 604 44 622 64 650 C46 630 28 614 4 602 Z" />
        <path d="M70 636 C96 608 118 594 148 580 C120 598 98 614 74 642 Z" />
      </g>
    </g>

    {/* ——— Zem ——— */}
    <path d="M0 862 C220 852 420 866 800 860 C1100 856 1360 866 1600 858 L1600 1000 L0 1000 Z" fill={`url(#${p}-trava)`} />
    <path class="snih" d="M0 860 C220 850 420 864 800 858 C1100 854 1360 864 1600 856 L1600 1000 L0 1000 Z" fill="#F4F8FB" />
    <g class="rez-kvetiny">
      {kvetiny.map((k) => (
        <g transform={`translate(${k.x} ${k.y.toFixed(1)}) scale(${k.v.toFixed(2)})`}>
          <path d="M0 0 L0 14" stroke="#4F7A36" stroke-width="2" />
          {k.druh === "mak" && <circle cx="0" cy="-2" r="5" fill="#D9452E" />}
          {k.druh === "chrpa" && <circle cx="0" cy="-2" r="4" fill="#5B7FD1" />}
          {k.druh === "kopretina" && <g><ellipse cx="0" cy="-2" rx="6" ry="3" fill="#FBF7EC" /><circle cx="0" cy="-2" r="2" fill="#E8B440" /></g>}
        </g>
      ))}
    </g>

    {/* ——— Krov a střecha ——— */}
    <path d="M150 446 L800 204 L1450 446 Z M800 300 m-28 0 a28 28 0 1 0 56 0 a28 28 0 1 0 -56 0 Z" fill="#D8CBB4" fill-rule="evenodd" />
    <circle cx="800" cy="300" r="28" fill="none" stroke="#8A6A48" stroke-width="6" />
    <path d="M800 272 V328 M772 300 H828" stroke="#8A6A48" stroke-width="3" />
    <g stroke="#8A6A48" stroke-linecap="round">
      <path d="M800 212 V432" stroke-width="12" />
      <path d="M800 420 L560 336 M800 420 L1040 336" stroke-width="9" />
      <path d="M470 330 L470 440 M1130 330 L1130 440" stroke-width="7" opacity="0.8" />
    </g>
    <g fill="#6E5236">
      {[300, 420, 540, 660, 940, 1060, 1180, 1300].map((x) => {
        const y = x < 800 ? 446 - ((x - 150) / 650) * 242 : 204 + ((x - 800) / 650) * 242;
        return <rect x={x - 7} y={y - 4} width="14" height="14" rx="2" />;
      })}
    </g>
    {/* Komínek od pece */}
    <g {...od(8)}>
      <rect x="1000" y="214" width="14" height="216" fill="#9AA3A8" />
      <path d="M1003 214 V430" stroke="#D9E0E3" stroke-width="3" opacity="0.7" />
      <rect x="994" y="206" width="26" height="9" rx="2" fill="#7E878C" />
      <circle class="kour kour-1" cx="1007" cy="196" r="7" fill="#EFEAE2" />
      <circle class="kour kour-2" cx="1007" cy="196" r="6" fill="#EFEAE2" />
      <circle class="kour kour-3" cx="1007" cy="196" r="5" fill="#EFEAE2" />
    </g>
    {/* Střešní desky v řezu, tašky po obvodu */}
    <path d="M86 448 L800 166 L1514 448 L1456 448 L800 204 L144 448 Z" fill={`url(#${p}-rez)`} />
    <path d="M86 446 L800 164 L1514 446" stroke="#B4523A" stroke-width="16" stroke-linejoin="round" fill="none" />
    <path d="M86 446 L800 164 L1514 446" stroke="#8E3D2A" stroke-width="16" stroke-dasharray="3 15" fill="none" />
    <path d="M92 438 L800 158 L1508 438" stroke="#D27458" stroke-width="2.5" fill="none" opacity="0.7" />
    <path class="snih" d="M84 438 L800 152 L1516 438" stroke="#FBFDFF" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <ellipse cx="800" cy="166" rx="16" ry="9" fill="#8E3D2A" />

    {/* ——— Zadní stěna s otvory pro výlohu ——— */}
    <g class="rez-venku">
      <path d="M282 704 C360 690 450 698 592 686 L592 752 L282 752 Z" style="fill:var(--kopec-daleko)" opacity="0.9" />
      <path d="M282 724 C380 716 480 722 592 712 L592 752 L282 752 Z" fill={`url(#${p}-trava)`} />
      <path class="snih" d="M282 724 C380 716 480 722 592 712 L592 752 L282 752 Z" fill="#F4F8FB" />
      <g>
        <path d="M528 752 L530 700" stroke="#5A4636" stroke-width="5" />
        <path class="sak-1 koruna" d={chomac(530, 686, 30, 24, 10, 831)} />
        <path class="sak-3 koruna" d={chomac(522, 680, 16, 12, 8, 832)} />
      </g>
    </g>
    <path d="M170 446 H1430 V800 H170 Z M282 510 V752 H592 V510 Z" fill={`url(#${p}-zed)`} fill-rule="evenodd" />
    {rok && (
      <g data-od="2" data-do="3">
        <path d="M170 446 H1430 V800 H170 Z M282 510 V752 H592 V510 Z" fill="#9C978D" fill-rule="evenodd" opacity="0.7" />
        <g fill="#6E6A62" opacity="0.3">
          <ellipse cx="700" cy="780" rx="160" ry="30" /><ellipse cx="1000" cy="770" rx="90" ry="24" /><ellipse cx="420" cy="460" rx="70" ry="10" />
        </g>
        <path d="M640 460 L652 500 L644 530 L660 570 M1180 470 L1172 520 L1186 548" stroke="#6E6A62" stroke-width="2" fill="none" />
      </g>
    )}
    {/* Tmavší pruh za kuchyňkou */}
    <rect x="1288" y="612" width="142" height="188" fill="#9E8A78" {...od(5)} />

    {/* ——— Dveře s norenem ——— */}
    <rect x="182" y="566" width="80" height="234" fill="#6B5540" />
    <rect x="190" y="574" width="64" height="226" fill={`url(#${p}-dvere)`} />
    <path d="M190 760 C210 752 236 754 254 760 L254 800 L190 800 Z" fill={`url(#${p}-trava)`} opacity="0.6" />
    <g class="rez-noren" {...od(9)}>
      <rect x="184" y="575" width="76" height="5" rx="2" fill="#8A6A48" />
      <path d="M190 580 H220 V646 Q205 650 190 646 Z" fill="#283670" />
      <path d="M224 580 H254 V646 Q239 650 224 646 Z" fill="#283670" />
      <circle cx="222" cy="602" r="11" fill="none" stroke="#F6F1E6" stroke-width="1.6" />
      <g fill="#F6F1E6">
        {[0, 72, 144, 216, 288].map((u) => <ellipse cx="222" cy="597" rx="2.6" ry="5" transform={`rotate(${u} 222 602)`} />)}
      </g>
      <path d="M222 580 V650" stroke="#1C2650" stroke-width="3" />
    </g>
    <path d="M190 800 L254 800 L300 858 L150 858 Z" fill="#FFF0C8" opacity="0.35" />

    {/* ——— Výloha ——— */}
    <g {...od(3)}>
      <rect x="276" y="504" width="322" height="254" fill="none" stroke="#6B5540" stroke-width="12" />
      <path d="M385 510 V752 M489 510 V752" stroke="#6B5540" stroke-width="7" />
      <g fill="#FFFFFF" opacity="0.18">
        <path d="M300 510 L330 510 L292 590 L282 590 Z" /><path d="M402 510 L418 510 L392 560 L386 560 Z" />
      </g>
      <rect x="268" y="752" width="338" height="12" rx="2" fill="#D9CFBE" />
      <path d="M282 764 L592 764 L700 858 L180 858 Z" fill={`url(#${p}-paprsek)`} />
    </g>

    {/* ——— Kalendář: měsíc nejbližšího termínu ——— */}
    <g class="rez-kalendar" {...od(10)}>
      <rect x="842" y="556" width="68" height="78" rx="2" fill="#FFFDF6" stroke="#C9B48A" stroke-width="1" />
      <rect x="842" y="556" width="68" height="16" rx="2" fill="#C4432B" />
      <circle cx="876" cy="552" r="2.4" fill="#5C5047" />
      <text x="876" y="568" text-anchor="middle" font-size="10" fill="#FFF6EA" font-family="Fraunces Variable, Fraunces, Georgia, serif" font-weight="600">{MESICE[kalMes]} {kalRok}</text>
      {kalBunky.map((b) => (
        <g>

      {/* Stojan: indigová keramická váza s bílým pruhem */}
      <path d="M24 152 C18 182 22 214 30 232 L90 232 C98 214 102 182 96 152 Z" fill="#2E4A78" />
      <path d="M22 168 C50 174 72 174 98 168 L98 180 C72 186 50 186 22 180 Z" fill="#E9E0CB" opacity="0.9" />
      <path d="M30 156 C34 190 32 214 36 230" stroke="#4C6A9C" stroke-width="6" fill="none" opacity="0.55" stroke-linecap="round" />
      <ellipse cx="60" cy="152" rx="37" ry="7" fill="#22375C" />
    </>
  )}

  {co === "soroban" && (
    <>
      <ellipse cx="110" cy="70" rx="104" ry="4" fill="#2B2420" opacity="0.2" />
      <rect x="6" y="6" width="208" height="60" rx="5" fill="#5A3A24" />
      <rect x="12" y="12" width="196" height="48" rx="2" fill="#7A5236" />
      <rect x="12" y="25" width="196" height="4" fill="#5A3A24" />
      {tycky.map((x, i) => (
        <>
          <rect x={x - 0.8} y="12" width="1.6" height="48" fill="#C9B48A" />
          {/* Horní kulička: dole u přepážky = pětka */}
          <ellipse cx={x} cy={ukaz[i] >= 5 ? 21 : 16.5} rx="6.2" ry="3.4" fill="#2E2018" />
          {/* Spodní čtyři: nahoře u přepážky se počítají */}
          {[0, 1, 2, 3].map((k) => {
            const nahore = k < ukaz[i] % 5;
            const y = nahore ? 33.5 + k * 6.6 : 37 + k * 6.6 + 3.6;
            return <ellipse cx={x} cy={f(y)} rx="6.2" ry="3.2" fill="#3A2A1E" />;
          })}
        </>
      ))}
      <path d="M14 14 H206" stroke="#FFFFFF" stroke-width="1.2" opacity="0.15" />
    </>
  )}

  {co === "zvonek" && (
    <>
      <ellipse cx="40" cy="60" rx="34" ry="3.6" fill="#2B2420" opacity="0.22" />
      <rect x="10" y="48" width="60" height="10" rx="3" fill="#2B2420" />
      <path d="M12 48 C12 24 26 14 40 14 C54 14 68 24 68 48 Z" fill="#C2BDB2" />
      <path d="M18 44 C18 28 28 20 38 19" stroke="#F4F1EA" stroke-width="4" fill="none" opacity="0.65" stroke-linecap="round" />
      <path d="M54 22 C62 28 66 36 66 46" stroke="#8E897F" stroke-width="4" fill="none" opacity="0.5" stroke-linecap="round" />
      <rect x="37" y="6" width="6" height="9" rx="1.5" fill="#8E897F" />
      <ellipse cx="40" cy="6" rx="7" ry="3.4" fill="#2B2420" />
    </>
  )}

  {co === "lucerna" && (
    <>
      <path d="M45 0 V20" stroke="#2B2420" stroke-width="2" />
      <rect x="28" y="18" width="34" height="9" rx="2.5" fill="#2B2420" />
      <ellipse cx="45" cy="78" rx="38" ry="52" fill="#C4432B" />
      <path d="M10 66 C34 72 56 72 80 66 M8 84 C34 90 56 90 82 84 M12 102 C34 108 56 108 78 102 M16 50 C34 55 56 55 74 50 M22 118 C36 122 54 122 68 118" stroke="#8E2C1A" stroke-width="1.4" fill="none" opacity="0.55" />
      <ellipse cx="32" cy="64" rx="10" ry="26" fill="#FFFFFF" opacity="0.12" />
      <text x="45" y="94" text-anchor="middle" font-size="40" fill="#F6EEDC" font-family="'Yuji Syuku', 'Yu Mincho', serif">器</text>
      <rect x="28" y="126" width="34" height="9" rx="2.5" fill="#2B2420" />
      <path d="M45 135 V150" stroke="#2B2420" stroke-width="2" />
      <path d="M40 150 L50 150 L53 168 L37 168 Z" fill="#2B2420" />
    </>
  )}

  {co === "kosik" && (
    <>
      <ellipse cx="85" cy="104" rx="76" ry="5" fill="#2B2420" opacity="0.2" />
      {/* Zmačkaný papír z košíku */}
      <path d="M40 42 C34 26 50 18 62 24 C70 14 88 16 92 28 C102 20 118 24 118 36 C130 34 138 46 130 54 L44 56 C34 54 32 46 40 42 Z" fill="#ECE5D3" />
      <path d="M58 30 L70 40 M84 26 L90 40 M104 32 L110 44" stroke="#C9BEA6" stroke-width="1.6" fill="none" />
      <path d="M22 44 L148 44 L136 102 L34 102 Z" fill="#C9A15E" />
      {vypleteni.map((i) => (
        <path d={`M${30 + i * 14} 46 L${38 + i * 11.6} 100`} stroke="#A97F3E" stroke-width="3" opacity="0.6" />
      ))}
      {[0, 1, 2, 3].map((r) => (
        <path d={`M${24 + r * 3} ${56 + r * 12} L${146 - r * 3} ${56 + r * 12}`} stroke="#DDBB78" stroke-width="5" opacity="0.75" />
      ))}
      <rect x="18" y="38" width="134" height="9" rx="4" fill="#B48A4A" />
    </>
  )}
</svg>

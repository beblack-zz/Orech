---
/**
 * Keramický tanuki ze Shigaraki, jak stojí před obchody v Japonsku:
 * slaměný klobouk, velké oči, úsměv, lahvička, knížka, břicho, měšec
 * a ocásek — osm přání pro dobrý obchod (八相縁喜 hassō engi).
 * Na /obchod-2 hlídá večer u dveří (Zavira.astro).
 */
interface Props {
  class?: string;
  /** Velký tanuki u dveří večer — o kousek víc detailu */
  velky?: boolean;
}
const { class: cls = "", velky = false } = Astro.props;
const lem = "#5E452E";
---
<svg class={`tanuki ${cls}`} viewBox="0 0 120 150" aria-hidden="true">
  <ellipse cx="60" cy="144" rx="38" ry="5" fill="#2B2420" opacity="0.2" />
  {/* Ocásek za tělem */}
  <path d="M86 128 C108 126 114 108 104 96 C100 110 92 116 80 118 Z" fill="#7A5A3C" stroke={lem} stroke-width="1.4" />
  {/* Tělo a břicho */}
  <path d="M26 132 C18 108 22 82 38 70 L82 70 C98 82 102 108 94 132 Q60 144 26 132 Z" fill="#8E6A4C" stroke="#5E452E" stroke-width="1.4" />
  <ellipse cx="60" cy="108" rx="26" ry="24" fill="#E6D2AE" stroke={lem} stroke-width="1.2" />
  {velky && <path d="M44 98 Q60 92 76 98" stroke="#C9B48A" stroke-width="1.2" fill="none" opacity="0.6" />}
  {/* Nožky */}
  <ellipse cx="40" cy="134" rx="11" ry="6" fill="#6B4E34" />
  <ellipse cx="80" cy="134" rx="11" ry="6" fill="#6B4E34" />
  {/* Měšec u nohou */}
  <path d="M52 128 C50 140 70 140 68 128 C66 124 54 124 52 128 Z" fill="#B5862A" stroke={lem} stroke-width="1.2" />
  <path d="M55 127 Q60 124 65 127" stroke={lem} stroke-width="1.4" fill="none" />
  {/* Knížka v levé ruce (pro diváka vpravo) */}
  <g transform="rotate(12 92 92)">
    <rect x="84" y="78" width="18" height="24" rx="2" fill="#F4EBDA" stroke={lem} stroke-width="1.2" />
    <path d="M88 84 H98 M88 89 H98 M88 94 H95" stroke={lem} stroke-width="1" />
    <text x="93" y="100" text-anchor="middle" font-size="4.5" fill={lem} font-family="Yuji Syuku, Yu Mincho, serif">通</text>
  </g>
  <ellipse cx="88" cy="92" rx="7" ry="9" fill="#7A5A3C" />
  {/* Lahvička v pravé ruce, na provázku */}
  <path d="M30 84 Q22 88 22 96" stroke="#5E452E" stroke-width="1.2" fill="none" />
  <g>
    <path d="M18 96 C14 104 14 116 24 120 C34 116 34 104 30 96 C29 92 30 90 28 88 L20 88 C18 90 19 92 18 96 Z" fill="#E9E2D2" stroke={lem} stroke-width="1.2" />
    <ellipse cx="24" cy="88" rx="4.4" ry="1.6" fill={lem} />
    <text x="24" y="111" text-anchor="middle" font-size="6.5" fill={lem} font-family="Yuji Syuku, Yu Mincho, serif">酒</text>
  </g>
  <ellipse cx="32" cy="90" rx="7" ry="9" fill="#7A5A3C" />
  {/* Hlava */}
  <ellipse cx="60" cy="56" rx="30" ry="27" fill="#8E6A4C" stroke="#5E452E" stroke-width="1.4" />
  <ellipse cx="34" cy="38" rx="7" ry="8" fill="#6B4E34" />
  <ellipse cx="86" cy="38" rx="7" ry="8" fill="#6B4E34" />
  {/* Maska kolem očí — tanuki ji má jako zloděj z kreslených seriálů */}
  <path d="M34 54 C38 44 52 44 58 52 L62 52 C68 44 82 44 86 54 C80 62 68 62 60 58 C52 62 40 62 34 54 Z" fill="#3A2E28" />
  <circle cx="47" cy="53" r="4.6" fill="#FBF6EA" />
  <circle cx="73" cy="53" r="4.6" fill="#FBF6EA" />
  <circle cx="48" cy="53.5" r="2.2" fill="#2B2420" />
  <circle cx="74" cy="53.5" r="2.2" fill="#2B2420" />
  <ellipse cx="60" cy="68" rx="15" ry="11" fill="#EDDDC0" />
  <ellipse cx="60" cy="63" rx="4" ry="3" fill="#2B2420" />
  <path d="M52 69 Q60 77 68 69" stroke="#2B2420" stroke-width="1.8" fill="none" stroke-linecap="round" />
  {/* Slaměný klobouk */}
  <g>
    <path d="M14 34 C24 14 96 14 106 34 C96 38 24 38 14 34 Z" fill="#C9A460" stroke={lem} stroke-width="1.4" />
    <path d="M36 26 C46 8 74 8 84 26" fill="#D6B474" stroke={lem} stroke-width="1.2" />
    <path d="M28 31 Q60 25 92 31 M40 21 Q60 15 80 21" stroke={lem} stroke-width="0.8" fill="none" opacity="0.55" />
  </g>
</svg>

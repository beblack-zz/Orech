---
/**
 * Kus zabalený v novinách (kresba je v ZabalenoKresba.astro) jako obrázek
 * /kresby/obchod-balik-<tvar>-<seme>.svg. Od 8. 11. 2026: vložených bylo
 * na Obchodu přes třicet a měly dohromady přes 6 000 prvků — jako obrázek
 * si ho prohlížeč nakreslí jednou a nechá napořád. Soubory staví
 * pages/kresby/_kresby.ts pro každý kus z data/kramek.ts (seme = pořadí
 * kusu v krámku). Kdyby takový balík mezi soubory nebyl, vloží se kresba.
 */
import ZabalenoKresba from "./ZabalenoKresba.astro";
import { adresaBaliku } from "../../pages/kresby/_kresby";
import type { Tvar } from "../../data/obchod";

interface Props {
  tvar: Tvar;
  seme: number;
  slama?: boolean;
  class?: string;
  predpona?: string;
  /** Hned na první obrazovce (krámek) — nečekat, až se k němu doscrolluje */
  hned?: boolean;
}
const { tvar, seme, slama = true, class: cls = "", predpona, hned = false } = Astro.props;
/* Obrázky jsou jen bez slámy — se slámou zůstává kresba */
const src = slama ? undefined : await adresaBaliku(tvar, seme);
---
{src ? (
  <img class={`zabaleno ${cls}`} src={src} width="200" height="200" alt="" aria-hidden="true" loading={hned ? "eager" : "lazy"} decoding="async" draggable="false" />
) : (
  <ZabalenoKresba tvar={tvar} seme={seme} slama={slama} class={cls} predpona={predpona} />
)}

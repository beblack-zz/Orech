---
/**
 * Šátek furoshiki místo košíku — po zavírací hodině na pultu pod
 * lampou. Co si člověk v krámku vybere, složí se na šátek rozprostřený
 * na pultu; vedle leží účtenka (お会計) se seznamem, cenou, dopravou
 * a jménem. „Zavázat a poslat nám“ šátek zaváže a pošle objednávku
 * na /api/objednavka (dílně i zákazníkovi přijde mail); když server
 * neodpoví, ukáže se adresa a připravený e-mail. Na čele pultu tři kroky „jak nakoupit“.
 *
 * Obsah šátku si pamatuje prohlížeč (scripts/obchod2/satek.ts). Seznam
 * zboží pro skript je v JSON níže, obrázky kusů v <template>: fotka,
 * nebo balík v novinách, dokud kus fotku nemá (s vlastní předponou id
 * o2i-zab, ať si klon na účtence nepůjčí ořez a stín z krámku).
 *
 * Šátek je skutečná látka ve 3D (scripts/obchod2/satek3d/, WebGL2 na
 * <canvas>): prázdný leží složený do trojúhelníku, s prvním kusem se
 * rozloží, kusy na něj dopadají jako balíky v novinách s visačkou (fotka
 * z `naVisacku`, číslo jako na účtence) a myší jde látku chytit a zvednout;
 * „Zavázat“ je otsukai-tsutsumi s uzlem ma-musubi. SVG kresba pod plátnem
 * zůstává jako náhrada, kde WebGL2 není (a než se látka stáhne — stahuje
 * se, až se šátek blíží), a drží místo v rozvržení.
 *
 * Plovoucí tlačítko šátku vpravo dole se ukáže, jen když Vázička nenese
 * uzlík sama (je schovaná do čárky) — jinak by se s ní v rohu překrývalo.
 *
 * Pod šátkem je vzorník: pět vzorů furoshiki s významem (data/furoshiki.ts).
 * Vybraný vzor se ukáže na látce i na účtence a odejde s objednávkou.
 */
import { getImage } from "astro:assets";
import Zabaleno from "./Zabaleno.astro";
import Kram from "./Kram.astro";
import { kramek } from "../../data/kramek";
import { obchodTexty } from "../../data/obchod2";
import { kontakt } from "../../data/uvod2";
import { vzory, VYCHOZI_VZOR, vzorPattern } from "../../data/furoshiki";
import type { TvarBaliku } from "../../scripts/obchod2/satek3d/typy";

interface Props {
  /** Kolik je hodin na obloze u šátku — krámek ho má v noci, stránka Futatsu až ráno */
  hodina?: number;
}
const { hodina = 23 } = Astro.props;

const cislo = (s: string) => Number(s.replace(/[^\d]/g, ""));
const nahledy = new Map(
  await Promise.all(
    kramek.filter((k) => k.fotky.length).map(async (k) => [k.id, (await getImage({ src: k.fotky[0].src, width: 160, format: "webp" })).src] as const),
  ),
);
/* Fotka na visačku balíku na 3D šátku — o kus větší, visačka ji nese skoro přes celou šířku */
const naVisacku = new Map(
  await Promise.all(
    kramek.filter((k) => k.fotky.length).map(async (k) => [k.id, (await getImage({ src: k.fotky[0].src, width: 256, format: "webp" })).src] as const),
  ),
);
/** Jak se kus zabalí do novin: podle tvaru z obchod.ts; Futatsu je yunomi bez ouška, z Japonska misky a hrnek ze Shigaraki */
const tvarBaliku = (k: (typeof kramek)[number]): TvarBaliku => {
  if (k.podpis) return "cajovka";
  if (k.tvar) return ({ bowl: "miska", mug: "hrnek", vase: "vaza", plate: "talir" } as const)[k.tvar];
  return /cup/i.test(k.nazev) ? "hrnek" : "miska";
};
const zbozi = kramek.map((k) => ({
  id: k.id,
  nazev: k.druh ? `${k.nazev} (${k.druh.znak})` : k.nazev,
  cena: cislo(k.cena),
  cenaText: k.cena,
  popis: k.odkud === "japonsko" ? `${k.autor} · z Japonska` : `${k.autor} · ${k.glazura}`,
  tvar: tvarBaliku(k),
  foto: naVisacku.get(k.id),
}));

const vychozi = vzory.find((v) => v.id === VYCHOZI_VZOR)!;

const roh = {
  nahore: "200,16 292,108 108,108",
  vpravo: "384,200 292,292 292,108",
  dole: "200,384 108,292 292,292",
  vlevo: "16,200 108,108 108,292",
};
---
<section class="o2-pult-sekce" id="satek" data-hodina={hodina} aria-labelledby="satek-nadpis">
  {/* Lampa nad pultem: šňůra, stínidlo a kužel světla */}
  <div class="o2-pult-lampa" aria-hidden="true">
    <span class="o2-pult-lampa-snura"></span>
    <span class="o2-pult-lampa-stinidlo"></span>
    <span class="o2-pult-lampa-zar"></span>
  </div>

  <header class="o2-pult-hlava papir">
    <p class="stitek"><span lang="ja">風呂敷</span> · jak nakoupit</p>
    <h2 id="satek-nadpis" class="nadpis-2">Zavaž si to do šátku</h2>
    <p class="o2-pult-perex">
      Furoshiki je čtvercový šátek, ve kterém se v Japonsku nosí skoro všechno — oběd, dárky i nákup.
      Tady se do něj skládá, co si v krámku vybereš. Až ho zavážeš, seznam nám odejde
      a my potvrdíme, jestli je všechno ještě k mání.
    </p>
  </header>

  <div class="o2-pult">
    <div class="o2-pult-deska">
      <div class="o2-satek-mriz" data-satek data-email={kontakt.email}>
        <div class="o2-satek-kresba">
          <svg class="o2-satek-svg" viewBox="0 0 400 400" aria-hidden="true">
            <defs>
              {vzory.map((v) => <pattern id={`o2-vzor-${v.id}`} width={v.w} height={v.h} patternUnits="userSpaceOnUse" set:html={vzorPattern(v)} />)}
            </defs>
            <ellipse cx="200" cy="378" rx="150" ry="14" fill="#1A0F08" opacity="0.28" class="o2-satek-stin" />
            <g class="o2-satek-latka">
              <rect x="108" y="108" width="184" height="184" fill={`url(#o2-vzor-${vychozi.id})`} class="o2-satek-lic" />
              <g class="o2-satek-veci"></g>
              {Object.entries(roh).map(([kde, body]) => (
                <g class={`o2-roh o2-roh-${kde}`}>
                  <polygon class="o2-roh-lic o2-satek-lic" points={body} fill={`url(#o2-vzor-${vychozi.id})`} />
                  <polygon class="o2-roh-rub" points={body} fill={vychozi.barva.rub} />
                </g>
              ))}
              <path d="M200 16 L384 200 L200 384 L16 200 Z" fill="none" stroke="#22375C" stroke-width="3" stroke-linejoin="round" class="o2-satek-lem" />
            </g>
            {/* Uzel náhradní kresby ze stejné látky — vzor a lem přepíná satek.ts */}
            <g class="o2-uzel">
              <path class="o2-uzel-latka" d="M200 196 C176 168 150 160 136 170 C150 178 166 190 186 206 Z" fill={`url(#o2-vzor-${vychozi.id})`} stroke={vychozi.barva.lem} stroke-width="2" />
              <path class="o2-uzel-latka" d="M200 196 C224 168 250 160 264 170 C250 178 234 190 214 206 Z" fill={`url(#o2-vzor-${vychozi.id})`} stroke={vychozi.barva.lem} stroke-width="2" />
              <ellipse class="o2-uzel-latka" cx="200" cy="204" rx="20" ry="15" fill={`url(#o2-vzor-${vychozi.id})`} stroke={vychozi.barva.lem} stroke-width="2" />
              <path d="M188 200 Q200 194 212 200" stroke="#EFE4CC" stroke-width="1.4" fill="none" opacity="0.7" />
            </g>
          </svg>
          {/* Látka ve 3D (WebGL2) přes kresbu: balíky v novinách i uzel kreslí satek3d/; nad ní jen „+N“, když se kusy nevejdou */}
          <canvas class="o2-satek-platno" aria-hidden="true" hidden></canvas>
          <div class="o2-satek-vrstva" aria-hidden="true" hidden></div>
          <p class="o2-satek-prazdno">Šátek je zatím prázdný. Vyber si něco v krámku.</p>

          <fieldset class="o2-vzory">
            <legend>Do jakého šátku ti to zavážeme</legend>
            <div class="o2-vzory-volby">
              {vzory.map((v) => (
                <label class="o2-vzor" style={`--rub:${v.barva.rub}`}>
                  <input type="radio" name="vzor" value={v.id} checked={v.id === VYCHOZI_VZOR} data-vyznam={v.vyznam} data-kanji={v.kanji} data-nazev={v.nazev} />
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <defs>
                      <pattern id={`o2-vzorek-${v.id}`} width={v.w} height={v.h} patternUnits="userSpaceOnUse" patternTransform="scale(0.62)" set:html={vzorPattern(v)} />
                    </defs>
                    {/* Složený kousek látky: čtverec s přeloženým cípem, pod ním rub */}
                    <path d="M8 6 H56 V44 L44 58 H8 Z" fill={`url(#o2-vzorek-${v.id})`} />
                    <path d="M56 44 L44 58 L44 44 Z" fill={v.barva.rub} />
                    <path d="M8 6 H56 V44 L44 58 H8 Z" fill="none" stroke={v.barva.lem} stroke-width="2" stroke-linejoin="round" />
                  </svg>
                  <span class="o2-vzor-nazev">{v.nazev}</span>
                </label>
              ))}
            </div>
            <p class="o2-vzor-vyznam" aria-live="polite"><span class="o2-vzor-kanji" lang="ja">{vychozi.kanji}</span> <b>{vychozi.nazev}</b> — <span class="o2-vzor-text">{vychozi.vyznam}</span></p>
          </fieldset>
          <div class="o2-pult-veci" aria-hidden="true">
            <span class="o2-pult-soroban"><Kram co="soroban" /></span>
            <span class="o2-pult-zvonek"><Kram co="zvonek" /></span>
          </div>
        </div>

        <div class="o2-satek-seznam o2-uctenka-pult">
          <p class="o2-uctenka-pult-hlava"><span lang="ja" aria-hidden="true">お会計</span><span>Účtenka</span></p>
          <h3 class="o2-satek-nadpis">V šátku</h3>
          <ul class="o2-satek-polozky" aria-live="polite"></ul>
          <p class="o2-satek-zabal">Zavážeme do šátku <b class="o2-satek-zabal-vzor">{vychozi.nazev}</b> <span lang="ja" class="o2-satek-zabal-kanji">{vychozi.kanji}</span></p>
          <p class="o2-satek-celkem"><span>Celkem</span> <b>0 Kč</b></p>
          <fieldset class="o2-satek-doprava">
            <legend>Jak se k tobě dostane</legend>
            <label class="o2-pilulka"><input type="radio" name="doprava" value="odber" checked /><span>Vyzvednu v dílně</span></label>
            <label class="o2-pilulka"><input type="radio" name="doprava" value="zasilkovna" /><span>Pošlete Zásilkovnou</span></label>
          </fieldset>
          <label class="o2-pole">Jméno <input type="text" name="jmeno" autocomplete="name" maxlength="60" required /></label>
          <label class="o2-pole">E-mail <input type="email" name="email" autocomplete="email" maxlength="120" required /></label>
          <label class="o2-pole">Poznámka <small>nepovinné</small><textarea name="poznamka" rows="2" maxlength="400"></textarea></label>
          {/* Past na roboty: člověk pole nevidí, robot ho vyplní */}
          <label class="pasticka" aria-hidden="true">Web <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
          <div class="o2-satek-akce">
            <a class="tlacitko o2-zavazat" aria-disabled="true" role="button">Zavázat a poslat nám</a>
            <button type="button" class="odkaz-tlacitko o2-rozvazat" hidden>Rozvázat</button>
          </div>
          <p class="o2-satek-zprava" role="status" aria-live="polite" hidden></p>
          <p class="o2-satek-pozn">Seznam odejde nám a kopie tobě na e-mail. Kusy jsou originály — potvrdíme, jestli jsou ještě k mání, a domluvíme platbu.</p>
          <span class="o2-uctenka-pult-razitko" lang="ja" aria-hidden="true">ジロ作</span>
        </div>
      </div>
    </div>

    <ol class="o2-kroky o2-pult-celo">
      {obchodTexty.kroky.map((k, i) => (
        <li>
          <span class="o2-krok-cislo" lang="ja" aria-hidden="true">{["一", "二", "三"][i]}</span>
          <h3>{k.nazev}</h3>
          <p>{k.text}</p>
        </li>
      ))}
    </ol>
  </div>

  <template id="o2-ikony">
    {kramek.map((k, i) =>
      nahledy.has(k.id) ? (
        <svg data-ikona={k.id} viewBox="0 0 80 80">
          <clipPath id={`o2-ikona-orez-${i}`}><rect x="4" y="4" width="72" height="72" rx="12" /></clipPath>
          <rect x="2" y="2" width="76" height="76" rx="14" fill="#F3E3B0" />
          <image href={nahledy.get(k.id)} x="4" y="4" width="72" height="72" preserveAspectRatio="xMidYMid slice" clip-path={`url(#o2-ikona-orez-${i})`} />
        </svg>
      ) : (
        <svg data-ikona={k.id} viewBox="0 0 200 200"><Zabaleno tvar={k.tvar ?? "bowl"} seme={i + 1} slama={false} predpona="o2i-zab" /></svg>
      ),
    )}
  </template>
  <script type="application/json" id="o2-zbozi" set:html={JSON.stringify(zbozi)} />
</section>

<a class="o2-satek-tlacitko" href="#satek" hidden aria-label="Šátek s vybranými kusy">
  <svg viewBox="0 0 48 44" aria-hidden="true">
    <path d="M8 22 C8 36 16 40 24 40 C32 40 40 36 40 22 C40 16 34 14 24 14 C14 14 8 16 8 22 Z" fill="#2E4A78" stroke="#22375C" stroke-width="1.6" />
    <path d="M24 16 C18 8 12 6 8 9 C12 11 16 14 20 18 Z M24 16 C30 8 36 6 40 9 C36 11 32 14 28 18 Z" fill="#3E5C8F" stroke="#22375C" stroke-width="1.4" />
    <ellipse cx="24" cy="18" rx="5" ry="3.6" fill="#2E4A78" stroke="#22375C" stroke-width="1.4" />
    <path d="M14 28 A8 8 0 0 1 22 28 M26 28 A8 8 0 0 1 34 28 M20 34 A8 8 0 0 1 28 34" stroke="#EFE4CC" stroke-width="1.2" fill="none" />
  </svg>
  <span class="o2-satek-pocet" data-satek-pocet>0</span>
</a>

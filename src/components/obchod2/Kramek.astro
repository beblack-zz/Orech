---
/**
 * Krámek — Obchod 2 jako průčelí malého japonského obchodu s nádobím
 * (うつわ屋), kreslené čelně podle nočního plakátu a izometrického
 * krámku: dvě střechy, velký štít, okno patra, plechová stříška s řadou
 * lampionů, svislá svítící cedule, lucerna na tyči, dráty, automat.
 *
 * Od 17. 10. 2026 je krámek jen v noci, kamera stojí na celku a jízdenka
 * dole je pryč (scripts/obchod2/scena.ts — JEN_NOC, JEN_CELEK). Dřív:
 *
 * Scéna je na jednu obrazovku a scroll ji nechává být. Kamera jede po
 * kresbě od zastávky k zastávce podle jízdenky dole (šipky, tah prstem,
 * klávesy ← →) a cestou běží den:
 *
 *   celek      odpoledne, celý dům, vlevo karta s nadpisem
 *   okno       keramika z Japonska v okně patra
 *   přízemí    kusy z dílny ve výlohách (na telefonu výloha, dveře, výloha)
 *   večer      kamera couvne, stmívá se, lampiony se rozsvěcují jeden
 *              po druhém
 *   zavíráme   uklidí se noren a spadne roleta, vlevo karta s kontaktem
 *
 * Kresba je ve vrstvách (components/obchod2/kresba, složené v scena.ts):
 * zadní, vnitřky, ZBOŽÍ (HTML), přední a světla. Noční kopii vrstev
 * udělá skript z denní (kresba/noc.ts) a prolíná ji přes denní. Svět má 3200 × 2000 px a všechno v něm stojí
 * v jeho pixelech; kameru, hodinu a světla řídí scripts/obchod2/scena.ts.
 *
 * Za dveřmi na zadní stěně visí hodiny — v ciferníku mezi šestkou
 * a sedmičkou vykukuje bílý Střípek (hra na hledání kami, parta2/sber.ts).
 */
import Kus from "./Kus.astro";
import Kram from "./Kram.astro";
import Kami from "../parta2/Kami.astro";
import StripekSchovka from "../characters/schovka/Stripek.astro";
import { scena, ZASTAVKY } from "./kresba/scena";
import { SVET, ZBOZI, PRIZEMI, MISTA, OKNO } from "./kresba/zaklad";
import type { Obdelnik } from "./kresba/zaklad";
import * as dumKresba from "./kresba/dum";
import * as prizemiKresba from "./kresba/prizemi";
import * as ceduleKresba from "./kresba/cedule";
import * as okoliKresba from "./kresba/okoli";
import { zJaponska, zDilny } from "../../data/kramek";
import { obchodTexty } from "../../data/obchod2";
import { kontakt, mapa, sezonaMesice } from "../../data/uvod2";
import { pocetKusu } from "../../data/pocty";

const S = scena();
const { w: W, h: H } = SVET;
const box = (r: Obdelnik) => `left:${r.x}px;top:${r.y}px;width:${r.w}px;height:${r.h}px`;

/* Místa, která kreslíři vyvážejí (když část ještě nic nevyváží, hotspot se vynechá) */
type Plakat = Obdelnik & { odkaz: string; popis: string };
const plakaty: Plakat[] = (prizemiKresba as { PLAKATY?: Plakat[] }).PLAKATY ?? [];
const cedule = (ceduleKresba as { CEDULE?: { lampiony?: Obdelnik[] } }).CEDULE;
const okoli = (okoliKresba as { OKOLI?: { automat?: Obdelnik } }).OKOLI;
const dum = (dumKresba as { DUM?: { kocka?: Obdelnik } }).DUM;
const lampiony = cedule?.lampiony ?? [];
const automat = okoli?.automat ?? MISTA.automat;
const kocka = dum?.kocka ?? MISTA.kocka;

/* Kusy na místa: z Japonska do okna patra, z dílny do výloh (zleva doprava, shora dolů).
   Kdyby kusů přibylo víc než míst, zbytek je jen ve vitrínách pod krámkem (Vitrina.astro). */
const mistaDilny = [...ZBOZI.vylohaL, ...ZBOZI.vylohaP];
const vOkne = zJaponska.slice(0, ZBOZI.okno.length).map((kus, i) => ({ kus, i, ram: ZBOZI.okno[i], hrana: OKNO.hranaPolice, zastavka: i < 2 ? "okno" : "okno2" }));
const veVylohach = zDilny.slice(0, mistaDilny.length).map((kus, k) => ({
  kus,
  i: zJaponska.length + k,
  ram: mistaDilny[k],
  hrana: ZBOZI.hranaPolice,
  zastavka: k < ZBOZI.vylohaL.length ? "vylohaL" : "vylohaP",
}));

/* Hodiny se Střípkem: místo na zadní stěně za dveřmi nechává kresba volné */
const hod = PRIZEMI.hodiny;
/* Cedulka stojí na levém kraji pultu */
const cedulka = { x: PRIZEMI.pult.x + 8, y: PRIZEMI.pult.y - 84, w: 74 };
/* Neon na čele pultu vede dolů do obchodu (vitríny pod krámkem) */
const vchod = { x: PRIZEMI.pult.x + PRIZEMI.pult.w / 2, y: PRIZEMI.pult.y + 17 };

const doprava = obchodTexty.kroky;
const zastavky = JSON.stringify(ZASTAVKY);
/* Strom za domem kvete, zelená a žloutne podle měsíce (skript to po načtení srovná s dneškem) */
const sezona = sezonaMesice(new Date().getMonth() + 1);
---
<section class="krm" id="kramek" data-hodina="14" data-zastavky={zastavky} aria-labelledby="krm-nadpis">
  <div class="krm-scena je-den" data-sezona={sezona}>
    {/* Karta s nadpisem — ve dne vlevo od domu, na telefonu dole */}
    <div class="krm-karta krm-uvod papir">
      <p class="stitek"><span lang="ja">うつわ屋</span> · Ořech · {pocetKusu(zJaponska.length + zDilny.length)}</p>
      <h1 id="krm-nadpis" class="krm-nadpis">Obchůdek <em>s keramikou</em></h1>
      <p class="krm-perex">{obchodTexty.perex}</p>
      <p class="krm-ruka">Každý kus jen jednou — co vidíš, to dostaneš.</p>
      <div class="krm-akce">
        <a class="tlacitko" href="#tvorba">Ke zboží <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="krm-svet" style={`width:${W}px;height:${H}px`}>
      {/* Noční kopie (krm-noc) jsou prázdné — skript je naplní přebarvenou denní kresbou (kresba/noc.ts) */}
      <svg class="krm-vrstva krm-den" data-vrstva="zadni" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" set:html={S.zadniDen} />
      <svg class="krm-vrstva krm-noc" data-noc="zadni" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"></svg>
      <svg class="krm-vrstva krm-den" data-vrstva="uvnitr" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" set:html={S.uvnitrDen} />
      <svg class="krm-vrstva krm-noc" data-noc="uvnitr" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"></svg>

      <div class="krm-zbozi">
        <h2 class="sr-only" id="krm-japonsko">Z Japonska — v okně patra</h2>
        {vOkne.map((k) => <Kus {...k} />)}
        <h2 class="sr-only" id="krm-dilna">Z dílny — ve výlohách</h2>
        {veVylohach.map((k) => <Kus {...k} />)}

        {/* Hodiny na zadní stěně. V ciferníku mezi šestkou a sedmičkou vykukuje bílý Střípek — hra na hledání kami (schovej v parta2/sber.ts) */}
        <div class="o2k-hodiny krm-hodiny" style={`left:${hod.x}px;top:${hod.y}px;width:${hod.w}px`}>
          <Kram co="hodiny" />
          <button type="button" class="skryty o2k-stripek" data-skryty="stripek" aria-label="Někdo se tu schovává" style="left:35.4%;top:74.3%;width:12.7%">
            <StripekSchovka barva="pruhledna" poza="vykukuje" size={20} />
          </button>
        </div>

        <Kami id="cedulka" class="krm-cedulka" style={`left:${cedulka.x}px;top:${cedulka.y}px;width:${cedulka.w}px`} />
        <a class="krm-vchod" href="#tvorba" style={`left:${vchod.x}px;top:${vchod.y}px`}>
          <span class="krm-vchod-znak" lang="ja" aria-hidden="true">入口</span>
          <span class="krm-vchod-text">Vstoupit do obchodu <span aria-hidden="true">↓</span></span>
        </a>
      </div>

      <svg class="krm-vrstva krm-den" data-vrstva="predni" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" set:html={S.predniDen} />
      <svg class="krm-vrstva krm-noc" data-noc="predni" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"></svg>
      <svg class="krm-vrstva krm-svetla" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" set:html={S.svetla} />

      <div class="krm-nad">
        {/* Tabule na stojanu: jak se tu nakupuje, křídou */}
        <div class="krm-tabule" style={box(MISTA.tabulePlocha)}>
          <p class="krm-tabule-nadpis">Jak nakoupit</p>
          <ol>
            {doprava.map((k) => <li>{k.nazev}</li>)}
          </ol>
        </div>

        {plakaty.map((p) => <a class="krm-plakat" href={p.odkaz} style={box(p)} aria-label={p.popis}></a>)}

        {lampiony.map((r, i) => <span class="krm-lampion-zona" data-i={i} style={box(r)} aria-hidden="true"></span>)}

        <button type="button" class="krm-automat" style={box(automat)} aria-label="Automat na nápady — vybere ti jeden kus z krámku">
          <span class="krm-automat-plechovka" aria-hidden="true"></span>
        </button>
        <button type="button" class="krm-zona krm-zona-kocka" style={box(kocka)} aria-label="Kočka na balkoně"></button>
        <p class="krm-bublina" role="status" aria-live="polite" hidden></p>
      </div>
    </div>

    {/* Popisky u zastávek kamery */}
    <div class="krm-popisek" data-pro="okno okno2">
      <p class="krm-popisek-hlava"><span lang="ja">航空便</span> Z Japonska <small>{pocetKusu(zJaponska.length)}</small></p>
      <p>Hagi, Banko, Shigaraki a jeden bez glazury — každý od jiné pece. Klikni na kus a otoč si ho. <a class="krm-popisek-odkaz" href="#japonsko">Všechny pod sebou&nbsp;↓</a></p>
    </div>
    <div class="krm-popisek" data-pro="prizemi vylohaL dvere vylohaP">
      <p class="krm-popisek-hlava"><span lang="ja">手作り</span> Z dílny <small>{pocetKusu(zDilny.length)}</small></p>
      <p>Čerstvě z pece, ještě zabalené v novinách. Fotky doplníme — kdo chce kus vidět dřív, klikne a napíše nám. <a class="krm-popisek-odkaz" href="#tvorba">Všechny pod sebou&nbsp;↓</a></p>
    </div>

    {/* Konec dne: krámek zavírá */}
    <div class="krm-karta krm-konec papir" data-pro="noc">
      <p class="stitek"><span lang="ja">準備中</span> · obchod zavírá</p>
      <h2 class="krm-konec-nadpis">Kočka hlídá do rána.</h2>
      <p class="krm-konec-text">Šátek s vybranými kusy ti tu necháme, i když stránku zavřeš. Zavázat a poslat ho můžeš i v noci — ráno odpovíme.</p>
      <div class="krm-akce">
        <a class="tlacitko" href="#satek">Zavázat šátek</a>
        <a class="tlacitko tlacitko-obrys" href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </div>
      <p class="krm-konec-adresa">
        <a href={`tel:${kontakt.telefonOdkaz}`}>{kontakt.telefon}</a> · {kontakt.ulice}, {kontakt.obec} ·
        <a href={mapa} target="_blank" rel="noopener">ukázat na mapě</a>
      </p>
    </div>

  </div>
  {/* Druhá kotva hodiny pro oblohu: na konci sekce je tatáž hodina jako ve scéně (scena.ts ji přepisuje) */}
  <span class="krm-kotva" data-hodina="14" aria-hidden="true"></span>
</section>

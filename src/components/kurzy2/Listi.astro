---
/**
 * Podzim nad Ořechem: přes oblohu občas proletí žlutý ořechový list.
 * Ořešák má lichozpeřené listy — lístky po párech a jeden na konci.
 * Jen CSS animace, kliknutí propouští.
 */
import { body } from "../parta2/tvary";

const listy = body(9, 211);
const barvy = ["#E2B04A", "#D9973A", "#C9A03C", "#B9822E", "#E8C35A"];
---
<div class="listi" aria-hidden="true">
  {listy.map((l, i) => (
    <span
      class="list"
      style={`top:${(-10 - l.y * 0.2).toFixed(1)}%;left:${l.x}%;--doba:${(14 + l.s * 14).toFixed(1)}s;--z:${(-l.t * 28).toFixed(1)}s;--dx:${((l.s - 0.3) * 40).toFixed(0)}vw;--r:${(360 + l.t * 540).toFixed(0)}deg;--v:${(0.7 + l.s * 0.6).toFixed(2)}`}
    >
      <svg viewBox="0 0 60 80">
        <path d="M30 78 L30 8" stroke="#8A6A3A" stroke-width="1.6" />
        {[20, 36, 52].map((y) => (
          <g fill={barvy[(i + y) % barvy.length]}>
            <path d={`M30 ${y} C18 ${y - 6} 8 ${y - 2} 4 ${y + 6} C12 ${y + 10} 24 ${y + 8} 30 ${y + 2} Z`} />
            <path d={`M30 ${y} C42 ${y - 6} 52 ${y - 2} 56 ${y + 6} C48 ${y + 10} 36 ${y + 8} 30 ${y + 2} Z`} />
          </g>
        ))}
        <path d="M30 2 C22 6 22 16 30 20 C38 16 38 6 30 2 Z" fill={barvy[i % barvy.length]} />
      </svg>
    </span>
  ))}
</div>

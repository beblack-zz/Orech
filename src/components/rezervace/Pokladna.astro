---
/**
 * Pokladna: kolik vás pojede a který den.
 *
 * Jízdné se řídí tím, kolik lidí v dílně na odjezdu opravdu je, takže ho
 * ukazuje až tabule u každého odjezdu. Děti se tu neklikají: dětská
 * jízdenka se spočítá na místě, kde se i platí.
 *
 * Den kreslí skript (scripts/rezervace/hlavni.ts), protože záleží na
 * dnešku: vybraný den je lepenková jízdenka jako ze staré pokladny
 * (japonsky kōken) — úterky modré, pátky zlaté, s ochranným podtiskem;
 * průvodčí ji cvakne a vystřihne do ní ořech. Vedle je kalendář po
 * týdnech, kde se ťukne na jiný den (od 8. 11. 2026; předtím byly pod
 * sebou jízdenky všech dní).
 *
 * Pod dnem se dá zaškrtnout permanentka (teikiken — v Japonsku se
 * kupují přesně takhle, na měsíc, tři nebo šest): hodiny, které se pak
 * vyberou na tabuli, se budou tři měsíce každý týden opakovat — vybrané
 * úterý znamená každé úterý; skript to dopisuje do nadpisu. Hodina může
 * být kterákoli, kde je ten den místo; týdny, kdy je plná, se vynechají
 * a neplatí (do 8. 11. 2026 jen první a poslední hodina dne a měla
 * vlastní přepážku).
 *
 * Třetí je přepážka zvláštního vlaku: nejbližší kurz na celý den, který
 * jezdí v sobotu — tmavá karta se zlatou linkou, jménem, dnem a sedadly,
 * vedle ní co se na kurzu dělá a pod tím zaškrtávátko „Nastoupit“. Karta
 * vybere jeho den (tabule ukáže trať), zaškrtnutí rovnou nastoupí
 * (do 8. 11. 2026 tu byly dva vlaky a nastupovalo se jen na tabuli). Mezi dny v kroku 02 soboty nejsou;
 * tmavou jízdenku tam má jen kurz, který by vyjel v úterý nebo v pátek
 * (výluka).
 *
 * Kroky mají čísla jako japonské stanice (OŘ 01, OŘ 02…): značka
 * linky a pořadí zastávky v rámečku její barvy.
 *
 * Cedulka pro toho, kdo se dívá (host, nebo člen se svým odkazem), je
 * nahoře na první obrazovce (Nadrazi.astro). Pod volbou „kolik vás
 * pojede“ je štítek dětské jízdenky — sleva se počítá až na místě.
 */
import { rezervace, permanentka, kurzy, jizdne, cenaZaCloveka } from "../../data/rezervace";

/** Postavičky do volby „kolik vás pojede“ — každá další je o kousek menší */
const lide = Array.from({ length: rezervace.maxOsob }, (_, i) => i + 1);
const barvy = ["#9C7860", "#D79A94", "#93B39B", "#E8B440"];
const kc = (n: number) => n.toLocaleString("cs-CZ");
const DNY = ["neděle", "pondělí", "úterý", "středa", "čtvrtek", "pátek", "sobota"];
const V_DEN = ["v neděli", "v pondělí", "v úterý", "ve středu", "ve čtvrtek", "v pátek", "v sobotu"];
/** Kurzy stojí stejně; kdyby ne, napíše se rozpětí */
const cenyKurzuCisla = [...new Set(kurzy.map((k) => k.cena))].sort((a, b) => a - b);
const cenyKurzu = cenyKurzuCisla.map((c) => c.toLocaleString("cs-CZ")).filter((_, i, a) => i === 0 || i === a.length - 1).join("–");
---
<div class="rz-pokladna papir">
  <p class="stitek">pokladna</p>
  <h2 id="rz-pokladna-nadpis" class="nadpis-2">Kolik vás pojede a kdy</h2>

  <div class="rz-krok">
    <h3 class="rz-otazka"><span class="rz-stanice" aria-hidden="true"><small>OŘ</small>01</span> Kolik vás pojede <small>hodina v dílně má {rezervace.mist} místa a jízdné je skupinové: čím víc lidí na ni v dílně opravdu přijde — vašich i cizích —, tím míň platí každý. Od {cenaZaCloveka(1)}&nbsp;Kč, když jsi tam sám, po {cenaZaCloveka(rezervace.mist)}&nbsp;Kč, když je plno; platí se na místě a kdo nepřijde, nepočítá se.</small></h3>
    <div class="rz-osoby" role="radiogroup" aria-label="Počet lidí">
      {lide.map((n) => (
        <label class="rz-osoba">
          <input type="radio" name="osoby" value={n} checked={n === 1} />
          <span class="rz-osoba-karta">
            <svg viewBox="0 0 80 48" aria-hidden="true">
              {Array.from({ length: n }, (_, k) => {
                const x = 40 + (k - (n - 1) / 2) * 17;
                const s = 1 - k * 0.07;
                return (
                  <g transform={`translate(${x.toFixed(1)} 46) scale(${s.toFixed(2)})`}>
                    <circle cx="0" cy="-30" r="7" fill={barvy[k]} />
                    <path d="M-11 0 C-11 -14 -7 -20 0 -20 C7 -20 11 -14 11 0 Z" fill={barvy[k]} />
                  </g>
                );
              })}
            </svg>
            <b>{n}</b>
            <small>{n === 1 ? "člověk" : "lidi"}</small>
          </span>
        </label>
      ))}
    </div>
    <p class="rz-detska">
      <svg viewBox="0 0 24 28" aria-hidden="true"><circle cx="12" cy="8" r="5" /><path d="M3.5 27 C3.5 18 7 14.5 12 14.5 C17 14.5 20.5 18 20.5 27 Z" /></svg>
      <span><b>Dětská jízdenka</b> do {jizdne.vekDite} let je o&nbsp;{jizdne.slevaDite}&nbsp;Kč levnější <small>odečte se na místě</small></span>
    </p>
  </div>

  <div class="rz-krok">
    <h3 class="rz-otazka"><span class="rz-stanice" aria-hidden="true"><small>OŘ</small>02</span> Den <small>úterky a pátky na měsíc dopředu — jiný vybereš v kalendáři</small></h3>
    <div class="rz-dny" role="group" aria-label="Den, na který se rezervuje"></div>
    {/* Permanentka: vybrané hodiny se budou každý týden opakovat. Den v týdnu, platnost a cenu dopisuje skript. */}
    <label class="rz-pas">
      <input type="checkbox" name="permanentka" />
      <span class="rz-pas-ctverec" aria-hidden="true"></span>
      <span class="rz-pas-text">
        <b>Permanentka <span class="rz-pas-den"></span></b>
        <small>vybrané hodiny budeš mít každý týden {permanentka.mesicu} měsíce — kteroukoli hodinu, kde je místo, za {kc(permanentka.cenaJizdy)}&nbsp;Kč za člověka a týden</small>
        <span class="rz-pas-stav" aria-live="polite"></span>
      </span>
      <span class="rz-pas-doba" aria-hidden="true"><b>{permanentka.mesicu}</b><span>měs.</span></span>
    </label>
  </div>

  <div class="rz-krok rz-zvlastni">
    <h3 class="rz-otazka">
      <span class="rz-zvlastni-znak" aria-hidden="true">{DNY[rezervace.denKurzu]}</span> Zvláštní vlak
      <small>kurz na celý den s lektorem a programem — jezdí {V_DEN[rezervace.denKurzu]}, místa se plní po jednom</small>
    </h3>
    {/* Kartu nejbližšího vlaku a text vedle kreslí skript — který kurz jede kdy, záleží na dnešku */}
    <div class="rz-zvlastni-vlaky" role="group" aria-label="Zvláštní vlak — kurz na celý den"></div>
    <label class="rz-pas rz-pas-kurz" hidden>
      <input type="checkbox" name="kurz" />
      <span class="rz-pas-ctverec" aria-hidden="true"></span>
      <span class="rz-pas-text">
        <b>Nastoupit do vlaku</b>
        <small class="rz-zvlastni-cena">{cenyKurzu}&nbsp;Kč za člověka a celý den</small>
        <span class="rz-zvlastni-stav" aria-live="polite"></span>
      </span>
    </label>
  </div>
</div>

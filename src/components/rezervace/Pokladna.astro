---
/**
 * Pokladna: kolik vás pojede a který den.
 *
 * Jízdné se řídí tím, kolik lidí v dílně na odjezdu opravdu je, takže ho
 * ukazuje až tabule u každého odjezdu. Děti se tu neklikají: dětská
 * jízdenka se spočítá na místě, kde se i platí.
 *
 * Dny kreslí skript (scripts/rezervace/hlavni.ts), protože záleží na
 * dnešku — každý den je lepenková jízdenka jako ze staré pokladny
 * (japonsky kōken): úterky modré, pátky zlaté, s ochranným podtiskem.
 * Vybraný den průvodčí cvakne — do jízdenky se vystřihne ořech.
 *
 * Pod dny je přepážka s permanentkami (teikiken — v Japonsku se
 * kupují přesně takhle, na měsíc, tři nebo šest): ranní a večerní spoj,
 * na každém pár míst. Permanentka je na jeden den v týdnu, a to na ten,
 * který je vybraný o krok výš — vybrané úterý znamená každé úterý; skript
 * to dopisuje do nadpisu. Tatáž místa jsou vidět na tabuli v prvním
 * a posledním řádku; kde se klikne, je jedno.
 *
 * Třetí je přepážka zvláštních vlaků: kurzy na celý den, které jezdí
 * v sobotu. Vypsané bývají nejvýš dva, každý má tmavou kartu se zlatou
 * linkou, jménem, dnem a sedadly. Karta vybere jeho den — tabule vedle
 * ukáže trať a nastupuje se na ní. Mezi dny v kroku 02 soboty nejsou;
 * tmavou jízdenku tam má jen kurz, který by vyjel v úterý nebo v pátek
 * (výluka).
 *
 * Kroky mají čísla jako japonské stanice (OŘ 01, OŘ 02…): značka
 * linky a pořadí zastávky v rámečku její barvy.
 *
 * Cedulka pro toho, kdo se dívá (host, nebo člen se svým odkazem), je
 * nahoře na první obrazovce (Nadrazi.astro). Pod volbou „kolik vás
 * pojede“ je štítek dětské jízdenky — sleva se počítá až na místě.
 */
import { rezervace, permanentka, kurzy, hhmm, jizdne, cenaZaCloveka, cenaPermanentky, jizdPermanentky } from "../../data/rezervace";

/** Postavičky do volby „kolik vás pojede“ — každá další je o kousek menší */
const lide = Array.from({ length: rezervace.maxOsob }, (_, i) => i + 1);
const barvy = ["#9C7860", "#D79A94", "#93B39B", "#E8B440"];
const mistaPermanentky = Array.from({ length: permanentka.mist }, (_, i) => i);
const kc = (n: number) => n.toLocaleString("cs-CZ");
const DNY = ["neděle", "pondělí", "úterý", "středa", "čtvrtek", "pátek", "sobota"];
const V_DEN = ["v neděli", "v pondělí", "v úterý", "ve středu", "ve čtvrtek", "v pátek", "v sobotu"];
/** Kurzy stojí stejně; kdyby ne, napíše se rozpětí */
const cenyKurzuCisla = [...new Set(kurzy.map((k) => k.cena))].sort((a, b) => a - b);
const cenyKurzu = cenyKurzuCisla.map((c) => c.toLocaleString("cs-CZ")).filter((_, i, a) => i === 0 || i === a.length - 1).join("–");
---
<div class="rz-pokladna papir">
  <p class="stitek">pokladna</p>
  <h2 id="rz-pokladna-nadpis" class="nadpis-2">Kolik vás pojede a kdy</h2>

  <div class="rz-krok">
    <h3 class="rz-otazka"><span class="rz-stanice" aria-hidden="true"><small>OŘ</small>01</span> Kolik vás pojede <small>odjezd má {rezervace.mist} místa a jízdné je skupinové: čím víc lidí v dílně na odjezdu opravdu je — vašich i cizích —, tím míň platí každý. Od {cenaZaCloveka(1)}&nbsp;Kč, když jsi tam sám, po {cenaZaCloveka(rezervace.mist)}&nbsp;Kč, když je plno; platí se na místě a kdo nepřijde, nepočítá se.</small></h3>
    <div class="rz-osoby" role="radiogroup" aria-label="Počet lidí">
      {lide.map((n) => (
        <label class="rz-osoba">
          <input type="radio" name="osoby" value={n} checked={n === 1} />
          <span class="rz-osoba-karta">
            <svg viewBox="0 0 80 48" aria-hidden="true">
              {Array.from({ length: n }, (_, k) => {
                const x = 40 + (k - (n - 1) / 2) * 17;
                const s = 1 - k * 0.07;
                return (
                  <g transform={`translate(${x.toFixed(1)} 46) scale(${s.toFixed(2)})`}>
                    <circle cx="0" cy="-30" r="7" fill={barvy[k]} />
                    <path d="M-11 0 C-11 -14 -7 -20 0 -20 C7 -20 11 -14 11 0 Z" fill={barvy[k]} />
                  </g>
                );
              })}
            </svg>
            <b>{n}</b>
            <small>{n === 1 ? "člověk" : "lidi"}</small>
          </span>
        </label>
      ))}
    </div>
    <p class="rz-detska">
      <svg viewBox="0 0 24 28" aria-hidden="true"><circle cx="12" cy="8" r="5" /><path d="M3.5 27 C3.5 18 7 14.5 12 14.5 C17 14.5 20.5 18 20.5 27 Z" /></svg>
      <span><b>Dětská jízdenka</b> do {jizdne.vekDite} let je o&nbsp;{jizdne.slevaDite}&nbsp;Kč levnější <small>odečte se na místě</small></span>
    </p>
  </div>

  <div class="rz-krok">
    <h3 class="rz-otazka"><span class="rz-stanice" aria-hidden="true"><small>OŘ</small>02</span> Den <small>úterky a pátky na měsíc dopředu</small></h3>
    <div class="rz-dny" role="group" aria-label="Dny, na které se dá rezervovat"></div>
  </div>

  <div class="rz-krok rz-pas">
    <h3 class="rz-otazka">
      <span class="rz-pas-znak" aria-hidden="true">{permanentka.mesicu} měsíce</span> Permanentka <span class="rz-pas-den" aria-live="polite"></span>
      <small>na {permanentka.mesicu} měsíce a na jeden den v týdnu — na ten, který máš vybraný. Pokaždé stejný spoj, první nebo poslední toho dne; na každém jsou {permanentka.mist} místa.</small>
    </h3>
    <div class="rz-pasy" role="group" aria-label="Permanentka — na který spoj">
      {permanentka.spoje.map((s) => (
        <button type="button" class="rz-pas-volba" data-pas={s.h} aria-pressed="false" disabled>
          <span class="rz-pas-hlava">{s.nazev} spoj</span>
          <b class="rz-pas-cas">{hhmm(s.h)}–{hhmm(s.h + rezervace.blok)}</b>
          <span class="rz-pas-mista" aria-hidden="true">
            {mistaPermanentky.map(() => <svg class="rz-sedacka pas" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg>)}
          </span>
          <span class="rz-pas-volno"></span>
          <span class="rz-pas-doba" aria-hidden="true"><b>{permanentka.mesicu}</b><span>měs.</span></span>
        </button>
      ))}
    </div>
    <p class="rz-pas-pozn">
      {kc(permanentka.cenaJizdy)}&nbsp;Kč za každý týden — za {permanentka.mesicu} měsíce obvykle {jizdPermanentky} jízd, tedy {kc(cenaPermanentky())}&nbsp;Kč za člověka a jeden spoj.
      <span class="rz-pas-stav" aria-live="polite"></span>
    </p>
  </div>

  <div class="rz-krok rz-zvlastni">
    <h3 class="rz-otazka">
      <span class="rz-zvlastni-znak" aria-hidden="true">{DNY[rezervace.denKurzu]}</span> Zvláštní vlak
      <small>kurz na celý den s lektorem a programem — jezdí {V_DEN[rezervace.denKurzu]} a místa se v něm plní po jednom. Vyber vlak a tabule ukáže jeho trať; nastupuje se tam.</small>
    </h3>
    {/* Karty vlaků kreslí skript — který kurz jede kdy, záleží na dnešku */}
    <div class="rz-zvlastni-vlaky" role="group" aria-label="Zvláštní vlaky — kurzy na celý den"></div>
    <p class="rz-zvlastni-pozn">
      {cenyKurzu}&nbsp;Kč za člověka a celý den.
      <span class="rz-zvlastni-stav" aria-live="polite"></span>
    </p>
  </div>
</div>

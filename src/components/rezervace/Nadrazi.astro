---
/**
 * První obrazovka Rezervace: nádraží na moři za svítání. Karta vlevo
 * říká to podstatné — kdy, za kolik a jak; vlak na pozadí mezitím
 * přijede a zastaví u cedule Ořech (More.astro). Vpravo nahoře visí
 * svislý nápis 胡桃行き („směr Ořech“) — jediné japonské znaky na stránce.
 *
 * Pod perexem je věta o kurzech (jezdí v sobotu) a permanentce. Do 8. 11.
 * 2026 tu byla i klapková cedulka s příští volnou hodinou, věta „Dnes je…“,
 * cedulka příštího zvláštního vlaku a ručně psaná poznámka o japonských dnech.
 *
 * Cedulka s registrací a přihlášením je od 8. 11. 2026 na jízdence pod
 * tlačítkem (Jizdenka.astro), ne tady pod nadpisem.
 *
 * Druhé tlačítko vede k dárkovým jízdenkám za soumraku (Darky.astro).
 * Kachlík ze hry na hledání kami se odsud přestěhoval na odjezdovou tabuli (Odjezdy.astro).
 */
import { rezervace, permanentka, cenaZaCloveka, otevrenoSlovy } from "../../data/rezervace";

const kc = (n: number) => n.toLocaleString("cs-CZ");
/** Kdy jezdí zvláštní vlak — začátek věty o kurzech */
const V_DEN_KURZU = ["V neděli", "V pondělí", "V úterý", "Ve středu", "Ve čtvrtek", "V pátek", "V sobotu"][rezervace.denKurzu];
---
<section class="rz-nadrazi" id="rz-nadrazi" data-hodina="6.6" aria-labelledby="rz-nadpis">
  <p class="rz-tategaki" lang="ja" aria-hidden="true">胡桃行き</p>

  <div class="rz-nadrazi-karta papir">
    <p class="stitek">jízdenka do dílny</p>
    <h1 id="rz-nadpis" class="rz-nadpis">Vyber si hodinu v dílně. <em>Nastup.</em></h1>

    <p class="rz-perex">
      Čas v dílně se tu kupuje jako jízdenka na vlak: vybereš den a hodinu v dílně (90 min) — jsou na ni {rezervace.mist} místa.
      Každé úterý a pátek {otevrenoSlovy}. Jízdné je skupinové a platí se
      na místě: když jsi v dílně sám, {kc(cenaZaCloveka(1))}&nbsp;Kč, když je plno, {kc(cenaZaCloveka(rezervace.mist))}&nbsp;Kč za každého.
    </p>

    <p class="rz-jinak">
      {V_DEN_KURZU} jezdí <b>zvláštní vlak</b> — kurz na celý den, kde se místa plní po jednom.
      A kdo jezdí pravidelně, vezme si <b>permanentku</b> na {permanentka.mesicu} měsíce: jeden den v týdnu, pokaždé stejná hodina — kterákoli, kde je místo.
    </p>
    <div class="rz-cta">
      <a class="tlacitko" href="#rz-pokladna">Vybrat hodinu</a>
      <a class="tlacitko tlacitko-obrys" href="#rz-darky">Darovat jízdenku</a>
    </div>
  </div>

  <a class="rz-dolu" href="#rz-pokladna">
    <span>K pokladně</span>
    <svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 4 V32 M4 24 L12 34 L20 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
</section>

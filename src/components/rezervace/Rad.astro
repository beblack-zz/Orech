---
/**
 * Cedule pod odjezdovou tabulí. Ukazuje vždycky jen jednu věc — tu, kterou
 * má člověk vlevo v pokladně vybranou — a podle ní se i jmenuje a vypadá:
 *
 *   hodina a půl   vybraný je běžný den (úterý, pátek). Papírová cedule
 *                  stanice se zelenou hlavičkou: dva vozy a co se dá dělat.
 *   permanentka    na jízdence je spoj permanentky. Červená průkazka
 *                  s jemným podtiskem a kulatým razítkem platnosti.
 *   zvláštní vlak  vybraný je kurz. Noční modrá se zlatem jako salon vlaku:
 *                  nahoře obraz vlaku na moři za svítání, pod ním přímo ten
 *                  kurz, který ten den jede (každý kurz má vlastní list),
 *                  a trať dne se jmény zastávek.
 *
 * Všechny listy jsou v HTML, vidět je jeden; který, přepíná
 * scripts/rezervace/hlavni.ts podle data-vysvetlivka a s ním i jméno
 * v hlavičce a vzhled celé cedule (data-druh). Bez skriptu zůstane první,
 * hodina a půl. (Bývala tu mřížka jízdního řádu na celý měsíc — odtud
 * jména tříd rz-rad-….)
 *
 * Co se píše, je z dat: kdy a za kolik z rezervace.ts, co se v dílně dělá,
 * co je v ceně a jak je to s lektorem z dilna.ts — ať cedule říká totéž
 * co Dílna.
 *
 * Kresby skládá vlak.ts ze stejných vozů, jaké jezdí po stránce; y = 0 je
 * hladina. U hodiny a půl a permanentky je pod ní pás s tečkami (tečka je
 * místo, které se dá koupit) a pod ním to hlavní: tři volby, které na sebe
 * nenavazují, nebo týdny, na které permanentka platí.
 */
import { rezervace, kurzy, permanentka, odjezdy, hhmm, cenaOdjezdu } from "../../data/rezervace";
import { cinnosti, vCene } from "../../data/dilna";
import { sklonuj } from "../../data/pocty";
import { vlak, zvlastniVlak, oknaSalonu, VUZ, MEZERA, SEDADLA, VYSKA, VYSKA_ZVLASTNIHO } from "./vlak";
import type { Misto } from "./vlak";
import type { KurzVlak } from "../../data/rezervace";
import { paleta } from "../../scripts/parta2/paleta";

const kc = (n: number) => n.toLocaleString("cs-CZ");
const cas = hhmm;

/* ——— Kresby do vysvětlivek ——— */
const KX = -44;
const KW = 1142;
/** Délka dvou vozů — na tu jsou kresby rozvržené */
const L2 = 2 * VUZ + MEZERA;
/** Pás pod hladinou, kde jsou tečky, a výška jejich středu */
const POD = 100;
const Y_T = 58;
/** Pod tečkami: volby hodiny, trať kurzu */
const Y_TRAT = POD + 44;
/** Výřez kresby hodiny a půl: nad hladinou vlak, pod ní tečky a to hlavní */
const VB_HODINA = `${KX} ${-(VYSKA + 8)} ${KW} ${VYSKA + 8 + Y_TRAT + 58}`;
/** Obraz zvláštního vlaku: vlak s kouřem nad hladinou a pod ní kus moře s odrazem */
const MORE = 78;
const VB_OBRAZ = `${KX} ${-(VYSKA_ZVLASTNIHO + 14)} ${KW} ${VYSKA_ZVLASTNIHO + 14 + MORE}`;
/** Stejné barvy jako postavičky ve volbě „kolik vás pojede“ (scripts/rezervace/odjezdy.ts) */
const BARVY_LIDI = ["#9C7860", "#D79A94", "#93B39B", "#E8B440"];
/** Kroužek propiskou kolem toho, co je tvoje — není to elipsa, konec přetáhne začátek */
const PERO = "M24 4 C36 2 45 8 44 16 C43 25 31 30 19 28 C8 26 2 21 4 13 C6 6 15 3 28 5";

const f1 = (n: number) => Math.round(n * 10) / 10;
const napis = (x: number, y: number, text: string, trida: string, kotva = "start") => `<text x="${f1(x)}" y="${y}" class="${trida}" text-anchor="${kotva}">${text}</text>`;
const hladina = `<path d="M${KX} 1.5 H${KX + KW}" class="rz-rad-k-hladina"/>`;
const tvoje = (x: number, y: number) => `<circle cx="${f1(x)}" cy="${y}" r="22" class="rz-rad-k-moje"/><path transform="translate(${f1(x - 48)} ${y - 32}) scale(2)" d="${PERO}" class="rz-rad-k-pero"/>`;
const xVozu = (i: number) => i * (VUZ + MEZERA);
/** Kde je v i-tém voze sedadlo — každý druhý vůz je otočený */
const xSedadla = (i: number, s: number) => (i % 2 ? xVozu(i) + VUZ - SEDADLA[s] : xVozu(i) + SEDADLA[s]);

const naPermanentku = new Set(permanentka.spoje.map((s) => s.h));
const hodinove = odjezdy.filter((h) => !naPermanentku.has(h));
const volby = cinnosti.map((c) => c.nazev.toLowerCase());

/* Odjezd (hodina a půl): dva vozy, dva odjezdy. První si vzala skupina, druhý je volný — pod každým jedna tečka.
   Pod tím, co se dá dělat: tři volby, které na sebe nenavazují */
const vase: Misto[] = SEDADLA.map(() => null);
[2, 3, 1, 4].slice(0, rezervace.maxOsob).forEach((s, k) => (vase[s] = { kdo: "ty", barva: BARVY_LIDI[k % BARVY_LIDI.length] }));
const hVozy = [
  { h: hodinove[0] ?? rezervace.od, mista: vase, moje: true, co: "vaše" },
  { h: hodinove[1] ?? rezervace.od + rezervace.blok, mista: [] as Misto[], moje: false, co: "volno" },
];
const kresbaHodina =
  vlak(hVozy.map((v) => ({ mista: v.mista }))) +
  hladina +
  hVozy
    .map((v, i) => {
      const x0 = xVozu(i);
      const cx = x0 + VUZ / 2;
      return (
        `<path d="M${x0 + 10} 12 V24 H${x0 + VUZ - 10} V12" class="rz-rad-k-spoj"/>` +
        (v.moje ? tvoje(cx, Y_T) : `<circle cx="${cx}" cy="${Y_T}" r="22" class="rz-rad-k-volno"/>`) +
        napis(cx - 66, Y_T, cas(v.h), "rz-rad-k-cas", "end") +
        napis(cx + 66, Y_T, v.co, "rz-rad-k-co")
      );
    })
    .join("") +
  volby
    .map((v, i) => {
      const x = f1((L2 * (i + 0.5)) / volby.length);
      return (i ? napis((L2 * i) / volby.length, Y_TRAT, "nebo", "rz-rad-k-co", "middle") : "") + `<circle cx="${x}" cy="${Y_TRAT}" r="12" class="rz-rad-k-volno"/>` + napis(x, Y_TRAT + 38, v, "rz-rad-k-hod", "middle");
    })
    .join("");

/* Kurz: salon má okno na každé místo, pod okny tmavý pruh se zlatými tečkami; pod tím trať dne */
const ZX = 20;
/* Svítání nad mořem v hodinu odjezdu — barvy z oblohy stránky */
const [RANO_A, RANO_B, RANO_C] = paleta(rezervace.od - 0.4).barvy;
const kresbaKurzu = (K: KurzVlak) => {
  const okna = oknaSalonu(K.mist);
  const zObsazeno = new Set([0, 1, 4].filter((i) => i < okna.length - 1));
  const vlakK = zvlastniVlak({ mista: okna.map((_, i) => (zObsazeno.has(i) ? { kdo: "stin" } : null)), emblem: K.emblem, cedule: K.nazev });
  const nahore = -(VYSKA_ZVLASTNIHO + 14);
  return (
    `<defs><linearGradient id="rz-obraz-nebe-${K.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${RANO_A}"/><stop offset="0.55" stop-color="${RANO_B}"/><stop offset="1" stop-color="${RANO_C}"/></linearGradient>` +
    `<linearGradient id="rz-obraz-more-${K.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8FA6C4"/><stop offset="1" stop-color="#3B4C86"/></linearGradient></defs>` +
    `<rect x="${KX}" y="${nahore}" width="${KW}" height="${-nahore}" fill="url(#rz-obraz-nebe-${K.id})"/>` +
    `<circle cx="${KX + KW * 0.2}" cy="${f1(nahore * 0.62)}" r="34" class="rz-rad-k-slunce"/><circle cx="${KX + KW * 0.2}" cy="${f1(nahore * 0.62)}" r="62" class="rz-rad-k-slunce" opacity="0.35"/>` +
    `<rect x="${KX}" y="0" width="${KW}" height="${MORE}" fill="url(#rz-obraz-more-${K.id})"/>` +
    `<g transform="translate(${ZX} 0)"><g transform="scale(1 -0.5)" opacity="0.24">${vlakK}</g>${vlakK}</g>` +
    `<path d="M${KX + 80} ${f1(MORE * 0.42)} h120 M${KX + 420} ${f1(MORE * 0.7)} h90 M${KX + 760} ${f1(MORE * 0.5)} h140" class="rz-rad-k-vlnka"/>`
  );
};

/* Permanentka: ranní a večerní spoj, pod okny s místy tři tečky; pod tím týdny, na které platí */
const KAZDY = ["každou neděli", "každé pondělí", "každé úterý", "každou středu", "každý čtvrtek", "každý pátek", "každou sobotu"];
const mesice = sklonuj(permanentka.mesicu, "měsíc", "měsíce", "měsíců");
const pasSedadla = [2, 3, 4, 1, 5, 0].slice(0, permanentka.mist).sort((a, b) => a - b);
const pVozy = permanentka.spoje.slice(0, 2).map((s, i) => ({ ...s, obsazeno: Math.min(Math.max(0, permanentka.mist - 1), i + 1) }));
const TYDNU = Math.round((permanentka.mesicu * 52) / 12);
const Y_TYDNY = POD + 46;
const tydny = (() => {
  const mezera = 18;
  const w = (pVozy.length * VUZ + (pVozy.length - 1) * MEZERA - (TYDNU - 1) * mezera) / TYDNU;
  let out = napis(0, POD + 20, `${KAZDY[rezervace.dny[0]]} · ${mesice}`, "rz-rad-k-co");
  for (let k = 0; k < TYDNU; k++) {
    const x = f1(k * (w + mezera));
    out += `<rect x="${x}" y="${Y_TYDNY}" width="${f1(w)}" height="46" rx="7" class="rz-rad-k-tyden"/>`;
    if (k < 3) out += `<path d="M${f1(x + w / 2 - 15)} ${Y_TYDNY + 24} l10 11 l20 -25" class="rz-rad-k-fajfka"/>`;
  }
  return out;
})();
const kresbaPermanentka =
  vlak(pVozy.map((v) => ({ mista: SEDADLA.map((_, s) => (pasSedadla.indexOf(s) >= 0 && pasSedadla.indexOf(s) < v.obsazeno ? ({ kdo: "stin" } as Misto) : null)) }))) +
  hladina +
  pVozy
    .map((v, i) => {
      const x0 = xVozu(i);
      const tecky = pasSedadla
        .map((s, k) => {
          const x = xSedadla(i, s);
          return `<path d="M${x} 6 V40" class="rz-rad-k-spoj"/>` + (k < v.obsazeno ? `<circle cx="${x}" cy="${Y_T}" r="12.5" class="rz-rad-k-pas-obs"/>` : `<circle cx="${x}" cy="${Y_T}" r="15" class="rz-rad-k-pas"/>`);
        })
        .join("");
      return `<rect x="${x0}" y="30" width="${VUZ}" height="56" rx="12" class="rz-rad-k-pas-pruh"/>` + tecky + napis(x0 + 20, Y_T, cas(v.h), "rz-rad-k-cas") + napis(x0 + VUZ - 20, Y_T, v.nazev, "rz-rad-k-co", "end");
    })
    .join("") +
  tydny;

/* ——— Co se píše do vysvětlivek ———
 *
 * Hodina a půl a kurz mají stejné řádky ve stejném pořadí (co děláš,
 * lektor, s kým, kdy, pro koho), ať se při přepnutí čtou stejně. Jen
 * poslední se liší: u hodiny a půl je, co je v ceně, u kurzu jeho zastávky
 * (co je v ceně kurzu, v datech není).
 */
const V_DEN = ["v neděli", "v pondělí", "v úterý", "ve středu", "ve čtvrtek", "v pátek", "v sobotu"];
const V_POCTU: Record<number, string> = { 2: "ve dvou", 3: "ve třech", 4: "ve čtyřech", 5: "v pěti", 6: "v šesti" };
const S_DALSIMI: Record<number, string> = { 1: "s jedním dalším", 2: "se dvěma dalšími", 3: "se třemi dalšími", 4: "se čtyřmi dalšími" };
const spolu = (a: string[], spojka = "a") => (a.length > 1 ? `${a.slice(0, -1).join(", ")} ${spojka} ${a[a.length - 1]}` : (a[0] ?? ""));

const kdyJede = spolu(rezervace.dny.map((d) => V_DEN[d]));
const skupina = V_POCTU[rezervace.maxOsob] ?? `v ${rezervace.maxOsob}`;
const spolusedici = S_DALSIMI[permanentka.mist - 1] ?? `s ${permanentka.mist - 1} dalšími`;

interface Druh {
  id: "hodina" | "kurz" | "pas";
  /** Podle čeho ho skript vybírá: hodina, pas, kurz-<id kurzu> */
  klic: string;
  /** Jak se cedule jmenuje, když je tenhle list vidět, a co stojí v hlavičce vedle */
  titul: string;
  pod: string;
  /** Jméno přímo v listu — má ho jen kurz, ostatní stačí jméno cedule */
  nadpis?: { jmeno: string; k: string };
  /** Trať dne se jmény zastávek (kurz) */
  linka?: { h: number; nazev: string }[];
  kresba: string;
  /** Výřez kresby */
  vb: string;
  znacka: string;
  nazev: string;
  /** Jak se tomu říká na nádraží */
  vlak: string;
  heslo: string;
  fakta: { co: string; html: string }[];
  cena: string;
  zaCo: string;
}

const hodina: Druh = {
  id: "hodina",
  klic: "hodina",
  titul: "Hodina a půl",
  pod: "běžný spoj",
  kresba: kresbaHodina,
  vb: VB_HODINA,
  znacka: "H",
  nazev: "Hodina a půl",
  vlak: "běžný spoj",
  heslo: "Dílna na hodinu a půl. Děláš si, co chceš.",
  fakta: [
    { co: "co děláš", html: `<b>cokoli</b> — ${volby.join(", ")}. Žádný program, tempo je tvoje` },
    { co: "lektor", html: `<b>když chceš</b> — ukáže a poradí. Když ne, je dílna jen tvoje; na kruh bez lektora jen se základy` },
    { co: "s kým", html: `sám, nebo až ${skupina}; odjezd je celý váš a nikdo další nepřistoupí` },
    { co: "kdy", html: `${kdyJede}, odjezdy ${cas(hodinove[0])}–${cas(hodinove[hodinove.length - 1])} po hodině a půl; můžeš si jich vzít víc` },
    { co: "pro koho", html: `pro začátečníka i pro toho, kdo ví, co chce, a chce na to klid` },
    { co: "v ceně", html: vCene.map((v) => v.co.toLowerCase()).join(", ") },
  ],
  cena: kc(cenaOdjezdu),
  zaCo: "za člověka a hodinu a půl",
};

/* Každý kurz má vlastní list — ukáže se ten, který je vybraný */
const listyKurzu: Druh[] = kurzy.map((k) => {
  const program = [...k.program].sort((a, b) => a.h - b.h);
  return {
    id: "kurz",
    klic: `kurz-${k.id}`,
    titul: "Zvláštní vlak",
    pod: "kurz na celý den",
    nadpis: { jmeno: k.nazev, k: `vlak „${k.vlak}“ — ${k.cteni} je japonsky ${k.vyznam}` },
    linka: [...program.map((z) => ({ h: z.h, nazev: z.nazev })), { h: Math.max(...program.map((z) => z.h)) + rezervace.blok, nazev: "Cíl" }],
    kresba: kresbaKurzu(k),
    vb: VB_OBRAZ,
    znacka: "Zv",
    nazev: k.nazev,
    vlak: "zvláštní vlak",
    heslo: k.popis,
    fakta: [
      { co: "lektor", html: `<b>celý den u toho</b> — vede ${k.lektor}` },
      { co: "s kým", html: `se skupinou: vlak má ${sklonuj(k.mist, "místo", "místa", "míst")} a každý si kupuje jen to své` },
      { co: "kdy", html: `${V_DEN[rezervace.denKurzu]}, celý den ${cas(rezervace.od)}–${cas(rezervace.do)}; běžné spoje ten den nejedou` },
      { co: "pro koho", html: k.proKoho },
    ],
    cena: kc(k.cena),
    zaCo: "za člověka a celý den",
  };
});

const pas: Druh = {
  id: "pas",
  klic: "pas",
  titul: "Permanentka",
  pod: "stálé místo",
  kresba: kresbaPermanentka,
  vb: `${KX} ${-(VYSKA + 8)} ${KW} ${VYSKA + 8 + Y_TYDNY + 54}`,
  znacka: "P",
  nazev: "Permanentka",
  vlak: "stálé místo",
  heslo: `Tvoje hodina a půl každý týden, na ${mesice}.`,
  fakta: [
    { co: "co děláš", html: `<b>totéž co na běžném spoji</b> — tvoříš po svém, jen pravidelně` },
    { co: "kdy", html: `první nebo poslední spoj dne (${spolu(permanentka.spoje.map((s) => cas(s.h)), "nebo")}), jeden den v týdnu — třeba ${KAZDY[rezervace.dny[0]]} v ${cas(permanentka.spoje[0].h)}` },
    { co: "platí", html: `${mesice} od první jízdy` },
    { co: "s kým", html: `máš jedno sedadlo; spoj má ${sklonuj(permanentka.mist, "místo", "místa", "míst")}, dílnu tak sdílíš nejvýš ${spolusedici}` },
  ],
  cena: kc(permanentka.cena),
  zaCo: `za člověka na ${mesice}`,
};

const listy = [hodina, pas, ...listyKurzu];
---
<section class="rz-rad" id="rz-rad" aria-labelledby="rz-rad-nadpis">
  {/* data-druh přebarví celou ceduli podle toho, který list je vidět — přepisuje ho skript */}
  <div class="rz-rad-cedule rz-rad-hlavni" data-druh={listy[0].id}>
    <header class="rz-rad-hlava" aria-live="polite">
      <h2 id="rz-rad-nadpis">{listy[0].titul}</h2>
      <p class="rz-rad-smer"><span class="rz-rad-ted">{listy[0].pod}</span></p>
    </header>

    {listy.map((d, i) => (
      <article class={`rz-rad-druh rz-rad-druh-${d.id}`} data-vysvetlivka={d.klic} data-druh={d.id} data-titul={d.titul} data-pod={d.pod} hidden={i > 0}>
        <svg class="rz-rad-kresba" viewBox={d.vb} aria-hidden="true"><g set:html={d.kresba} /></svg>
        <div class="rz-rad-druh-text">
          {d.nadpis && <h3>{d.nadpis.jmeno} <small>{d.nadpis.k}</small></h3>}
          <p class="rz-rad-heslo">{d.heslo}</p>
          {d.linka && (
            <ol class="rz-rad-linka" style={`--n:${d.linka.length}`} aria-label="Trať dne — zastávky po hodině a půl">
              {d.linka.map((z, k) => <li class={k === d.linka!.length - 1 ? "cil" : undefined}><i>{k === d.linka!.length - 1 ? "" : k + 1}</i><span><b>{cas(z.h)}</b> {z.nazev}</span></li>)}
            </ol>
          )}
          <dl class="rz-rad-fakta">
            {d.fakta.map((f) => <div><dt>{f.co}</dt><dd set:html={f.html} /></div>)}
          </dl>
          <p class="rz-rad-jizdne"><span>jízdné</span> <b>{d.cena}&nbsp;Kč</b> {d.zaCo}</p>
          {/* Kulaté razítko platnosti — jen na průkazce */}
          {d.id === "pas" && <span class="rz-rad-platnost" aria-hidden="true"><b>{permanentka.mesicu}</b><span>měs.</span></span>}
        </div>
      </article>
    ))}

    <p class="rz-rad-pata">
      <span>Změna programu vyhrazena.</span>
      <span class="rz-rad-podpis">
        Za správnost: Kachlík, výpravčí
        {/* Razítko výpravčího — Kachlík, jak jinak než přesně do čtverce */}
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <rect x="3" y="3" width="34" height="34" rx="5" fill="none" stroke="currentColor" stroke-width="2.6" />
          <rect x="8" y="8" width="24" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="1.2" />
          <path d="M12.5 16.5 h5 M22.5 16.5 h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="15" cy="20.5" r="1.9" fill="currentColor" />
          <circle cx="25" cy="20.5" r="1.9" fill="currentColor" />
          <path d="M17 26.5 H23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </span>
    </p>
  </div>
</section>

---
/**
 * Odjezdová tabule s hodinami vybraného dne — klapky pata-pata
 * jako na Úvodu 2, jen tady se podle nich opravdu nastupuje. Každý řádek
 * je jeden odjezd — hodina a půl v dílně: odjezd a příjezd, okénko s oblohou té hodiny,
 * kupé se čtyřmi sedačkami a poznámka — volno, obsazeno, odjel, nebo
 * nastupuješ, když je tvoje. Hodina se zamlouvá celá (sám nebo skupina do
 * čtyř lidí), proto je kupé buď celé volné, nebo celé zabrané; u tvé
 * hodiny se rozsvítí tolik sedaček, kolik vás jede.
 *
 * Dvě věci jsou na tabuli jinak, protože se u nich počítají místa:
 *
 *   permanentka  první a poslední spoj dne (data/rezervace.ts) má místo
 *                kupé pár míst pro držitele permanentky na tři měsíce;
 *                klik na řádek je koupě permanentky, ne hodiny — na ten
 *                den v týdnu, který je na tabuli
 *   kurz         v den kurzu (sobota) běžné spoje nejedou: nad řádky vyjede cedule zvláštního
 *                vlaku s místy a nástupem a z řádků se stane jeho
 *                trať — co odjezd, to zastávka programu se svým pořadím
 *
 * Řádky s časy jsou tady, protože odjezdy jsou pořád stejné; obsazenost,
 * den, kurz i permanentky dopisuje skript (scripts/rezervace/odjezdy.ts)
 * a při změně dne tabule překlapne. Okénko s oblohou má barvy z palety
 * oblohy pro půlku té hodiny a slunce tam, kde v tu dobu stojí.
 */
import Flap from "../uvod2/Flap.astro";
import { paleta } from "../../scripts/parta2/paleta";
import { rezervace, kurzy, permanentka, odjezdy, hhmm } from "../../data/rezervace";
import { DELKA_ZVLASTNIHO, VYSKA_ZVLASTNIHO } from "./vlak";

const dvoj = (n: number) => String(n).padStart(2, "0");
const sedacky = Array.from({ length: Math.max(rezervace.mist, permanentka.mist) }, (_, i) => i);
const mistaKurzu = Array.from({ length: Math.max(1, ...kurzy.map((k) => k.mist)) }, (_, i) => i);

/** Kde stojí slunce v danou hodinu — stejný vzorec jako obloha (nebe.ts) */
const slunce = (h: number) => {
  const ts = (h - 5.3) / (20.4 - 5.3);
  const t = Math.min(1, Math.max(0, ts));
  return { x: 10 + 80 * t, y: 88 - Math.sin(Math.PI * t) * 66, videt: ts > 0 && ts < 1 };
};
/* Řádek na každý odjezd; v den kurzu jsou tytéž řádky zastávkami zvláštního vlaku — jede ve stejné časy */
const radky = odjezdy.map((h) => ({
  h,
  cas: `${dvoj(Math.floor(h))}${dvoj(Math.round((h % 1) * 60))}`,
  od: hhmm(h),
  konec: hhmm(h + rezervace.blok),
  nebe: paleta(h + rezervace.blok / 2).barvy,
  slunce: slunce(h + rezervace.blok / 2),
}));
---
<div class="rz-tabule" id="rz-odjezdy" role="region" data-hodina="10" data-rz-nebe aria-labelledby="rz-odjezdy-nadpis">
  <span class="rz-tabule-tyc rz-tabule-tyc-l" aria-hidden="true"></span>
  <span class="rz-tabule-tyc rz-tabule-tyc-p" aria-hidden="true"></span>
  <div class="rz-tabule-deska">
    <div class="rz-tabule-hlava">
      <h2 class="rz-tabule-titul" id="rz-odjezdy-nadpis">
        <span class="rz-stanice rz-stanice-svetla" aria-hidden="true"><small>OŘ</small>03</span>
        Odjezdy
      </h2>
      <p class="rz-tabule-den" aria-hidden="true">
        <Flap text="—" class="rz-tabule-den-nazev" />
        <Flap druh="cislice" text="-" /><Flap druh="cislice" text="-" /><i>.</i><Flap druh="cislice" text="-" /><Flap druh="cislice" text="-" /><i>.</i>
      </p>
      <p class="rz-tabule-hodiny" aria-hidden="true">
        <span>teď</span>
        <Flap druh="cislice" text="-" /><Flap druh="cislice" text="-" /><i>:</i><Flap druh="cislice" text="-" /><Flap druh="cislice" text="-" />
      </p>
    </div>
    <p class="rz-tabule-sekki" aria-live="polite">Nejdřív vyber den.</p>

    {/* Zvláštní vlak: cedule nad řádky, jen v den kurzu. Texty, znak a vláček dopisuje skript. */}
    <div class="rz-zvl" hidden>
      <p class="rz-zvl-led" aria-hidden="true">
        <span class="rz-zvl-led-druh">zvláštní vlak</span>
        {/* v sobotu jede jen on; kdyby kurz vyjel v úterý nebo v pátek, skript sem napíše výluku */}
        <span class="rz-zvl-led-vyluka">dnes jede jen zvláštní vlak</span>
      </p>
      <div class="rz-zvl-telo">
        <svg class="rz-zvl-znak" viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="29" fill="#F3E6C8" stroke="#C4432B" stroke-width="5" />
          <circle cx="32" cy="32" r="22.5" fill="none" stroke="#E0B04A" stroke-width="1.4" />
          <text x="32" y="33" class="rz-zvl-znak-text"></text>
        </svg>
        <div class="rz-zvl-popisy">
          <h3 class="rz-zvl-nazev"></h3>
          <p class="rz-zvl-jmeno"></p>
          <p class="rz-zvl-udaje"></p>
        </div>
        <svg class="rz-zvl-vlacek" viewBox={`-40 ${-VYSKA_ZVLASTNIHO - 8} ${DELKA_ZVLASTNIHO + 80} ${VYSKA_ZVLASTNIHO + 20}`} aria-hidden="true">
          <g class="rz-zvl-vlak"></g>
          <path d={`M-40 1.5 H${DELKA_ZVLASTNIHO + 40}`} stroke="rgba(237, 230, 214, 0.35)" stroke-width="3" />
        </svg>
      </div>
      <p class="rz-zvl-popis"></p>
      <div class="rz-zvl-nastup">
        <span class="rz-zvl-mista" aria-hidden="true">
          {mistaKurzu.map(() => <svg class="rz-sedacka" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg>)}
        </span>
        <span class="rz-zvl-volno" aria-live="polite"></span>
        <button type="button" class="rz-zvl-volba" aria-pressed="false">
          <span class="rz-zvl-volba-text">Nastoupit</span>
          <span class="rz-o-lampa" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <div class="rz-tabule-sloupce" aria-hidden="true">
      <span>odjezd</span>
      <span><span class="jen-hodiny">kupé</span><span class="jen-kurz">zastávka</span></span>
      <span><span class="jen-hodiny">poznámka</span><span class="jen-kurz">program</span></span>
    </div>

    <ol class="rz-tabule-radky" aria-label="Odjezdy vybraného dne — vyber jeden nebo víc">
      {radky.map((r) => (
        <li class="rz-o" data-h={r.h}>
          <button type="button" class="rz-o-volba" aria-pressed="false" disabled>
            <span class="rz-o-cas" aria-hidden="true">
              <Flap druh="cislice" text={r.cas[0]} /><Flap druh="cislice" text={r.cas[1]} /><i>:</i><Flap druh="cislice" text={r.cas[2]} /><Flap druh="cislice" text={r.cas[3]} />
            </span>
            <span class="rz-o-prijezd" aria-hidden="true">→ {r.konec}</span>
            <span
              class="rz-o-okno"
              aria-hidden="true"
              style={`--nebe-a:${r.nebe[0]};--nebe-b:${r.nebe[1]};--nebe-c:${r.nebe[2]}`}
            >
              {r.slunce.videt && <i style={`left:${r.slunce.x.toFixed(1)}%;top:${r.slunce.y.toFixed(1)}%`}></i>}
            </span>
            <span class="rz-o-mista" aria-hidden="true">
              {sedacky.map(() => <svg class="rz-sedacka" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg>)}
            </span>
            {/* V den kurzu místo kupé: zastávka na trati zvláštního vlaku */}
            <span class="rz-o-trasa" aria-hidden="true"><i class="rz-o-bod"></i><span class="rz-o-poradi"></span></span>
            <span class="rz-o-stav" aria-hidden="true"><Flap text="" /><small class="rz-o-co"></small><small class="rz-o-jizdne"></small></span>
            <span class="rz-o-lampa" aria-hidden="true"></span>
            <span class="sr-only rz-o-popis">{r.od} až {r.konec}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="rz-tabule-pata">
      <ul class="rz-legenda" aria-hidden="true">
        <li><svg class="rz-sedacka" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg> volné</li>
        <li><svg class="rz-sedacka obs" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg> obsazené</li>
        <li><svg class="rz-sedacka moje" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg> vy</li>
        <li class="jen-hodiny"><svg class="rz-sedacka pas" viewBox="0 0 16 18"><use href="#rz-sedacka" /></svg> místo na permanentku</li>
      </ul>
      <p class="rz-tabule-rada">
        Klikni na volnou hodinu — klidně na víc. Každá trvá 90 minut a má {rezervace.mist} místa. Vedle je jízdné za člověka, kdybyste nastoupili teď — čím víc lidí v dílně opravdu bude, tím míň platí každý; platí se na místě.
        Obloha nad mořem ukáže, jaké v tu dobu bude v dílně světlo.
      </p>
      <p class="rz-hlaseni" role="status" aria-live="polite"></p>
    </div>
  </div>
  <p class="rz-simulace">Obsazenost i termíny kurzů jsou zatím jen ukázkové — skutečný kalendář přijde později.</p>
</div>

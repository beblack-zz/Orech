---
/**
 * Jízdenka — souhrn rezervace a podpis. Nahoře na jízdence je
 * obrázek jako na pamětních jízdenkách: vláček na moři, který má tolik
 * vozů, kolik odjezdů si člověk vybral, na cedulce každého vozu čas
 * a v oknech tvoje postavičky vedle stínů ostatních cestujících. Obloha
 * obrázku je obloha první vybrané hodiny (scripts/rezervace/jizdenka.ts).
 *
 * Údaje se vyplňují samy. Zamluvit smí jen člen, který přišel přes svůj
 * odkaz: jméno známe, tlačítko Označit a zamluvit — průvodčí cvakne
 * kleštěmi (do jízdenky se vystřihne ořech), dopadne razítko Zamluveno
 * a vláček odjede. Poznámka je vedle, jízdenka by s ní byla přeplněná.
 * Pod tlačítkem je cedulka s registrací a přihlášením bez hesla
 * (scripts/rezervace/prihlaseni.ts): kdo tu je poprvé, vyplní jméno
 * a e-mail a přijde mu mail, kterým registraci potvrdí; kdo už
 * zaregistrovaný je, zadá e-mail a přijde mu jednorázový odkaz. K oběma
 * mailům je kód, který jde opsat sem. Přihlášeného pozdraví jménem
 * a nabídne odhlášení. Bez skriptu je tu jen věta s telefonem. (Do 8. 11.
 * 2026 byla na první obrazovce pod nadpisem.)
 *
 * Ostatním se jízdenka poskládá taky, ať vidí, co by měli a za kolik,
 * ale tlačítko vede k registraci a přihlášení e-mailem nahoře u nádraží
 * (prihlaseni.ts). Mailem se jízdenky neposílají. Nápisy
 * podle toho přepisuje scripts/rezervace/hlavni.ts.
 *
 * Jízdenka má tři podoby a skript mezi nimi přepíná třídou na .rz-listek:
 *
 *   (bez třídy)  hodinová jízdenka, zelený podtisk
 *   .kurz        zvláštní jízdenka na kurz: zlatý podtisk, na obrázku
 *                parní vlak se salonem a pod údaji mapa trasy — program
 *                kurzu jako zastávky na lince
 *   .pas         permanentka: červený podtisk, trasa tam i zpět, místo
 *                dne platnost a pod údaji všechny jízdy, na které platí
 *                (dny kurzů jsou přeškrtnuté — výluka)
 */
import { rozpetiJizdneho } from "../../data/rezervace";
import { kontakt } from "../../data/uvod2";

/* Než skript vyplní jízdenku: jízdné záleží na tom, kolik lidí na odjezdu nakonec sedí */
const jizdne = `${rozpetiJizdneho.od}–${rozpetiJizdneho.do} Kč za člověka podle toho, kolik vás v dílně bude`;

/* Ochranný podtisk (japonsky jimon) z drobných vlnek — jako na jízdenkách JR */
const jimon = (barva: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='22' height='9'><path d='M0 4.5 Q5.5 0.5 11 4.5 T22 4.5' fill='none' stroke='${barva}' stroke-width='0.55' opacity='0.28'/></svg>`,
  )}")`;
const podtisky = `--jimon:${jimon("#3E8C84")};--jimon-kurz:${jimon("#B07A1C")};--jimon-pas:${jimon("#C4432B")}`;
---
<section class="rz-sekce rz-nastup" id="rz-jizdenka" data-hodina="17.6" aria-labelledby="rz-jizdenka-nadpis">
  <div class="rz-nastup-karta papir">
    <p class="stitek">jízdenka</p>
    <h2 id="rz-jizdenka-nadpis" class="nadpis-2"><span class="rz-stanice" aria-hidden="true"><small>OŘ</small>04</span> Napiš se na jízdenku</h2>

    <div class="rz-nastup-mriz">
      <div class="rz-listek" style={podtisky}>
        <div class="rz-listek-obraz" aria-hidden="true">
          <svg class="rz-listek-scena" viewBox="-290 -282 1100 440" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="rz-l-nebe" gradientUnits="userSpaceOnUse" x1="0" y1="-282" x2="0" y2="-14">
                <stop offset="0" style="stop-color:var(--l-nebe-a)" />
                <stop offset="0.62" style="stop-color:var(--l-nebe-b)" />
                <stop offset="1" style="stop-color:var(--l-nebe-c)" />
              </linearGradient>
              <linearGradient id="rz-l-more" gradientUnits="userSpaceOnUse" x1="0" y1="-14" x2="0" y2="158">
                <stop offset="0" style="stop-color:color-mix(in srgb, var(--l-nebe-c) 84%, #1B2350)" />
                <stop offset="0.45" style="stop-color:color-mix(in srgb, var(--l-nebe-b) 80%, #1B2350)" />
                <stop offset="1" style="stop-color:color-mix(in srgb, var(--l-nebe-a) 76%, #0B1030)" />
              </linearGradient>
              <radialGradient id="rz-l-slunce" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0" stop-color="#FFF8E2" />
                <stop offset="0.3" stop-color="#FFF1C8" stop-opacity="0.9" />
                <stop offset="0.55" stop-color="#FFD9A0" stop-opacity="0.35" />
                <stop offset="1" stop-color="#FFC890" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="rz-l-odraz-g" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fff" stop-opacity="0.6" />
                <stop offset="1" stop-color="#fff" stop-opacity="0" />
              </linearGradient>
              <mask id="rz-l-odraz" maskUnits="userSpaceOnUse" x="-6000" y="0" width="16000" height="240">
                <rect x="-6000" y="0" width="16000" height="230" fill="url(#rz-l-odraz-g)" />
              </mask>
            </defs>
            <rect class="rz-l-nebe" x="-6000" y="-3000" width="16000" height="3000" fill="url(#rz-l-nebe)" />
            <circle class="rz-l-slunce" cx="0" cy="-200" r="90" fill="url(#rz-l-slunce)" />
            <rect class="rz-l-more" x="-6000" y="-14" width="16000" height="3000" fill="url(#rz-l-more)" />
            <path d="M-6000 -14 H10000" stroke="#FFF1DE" stroke-width="2" opacity="0.6" />
            <g class="rz-l-odraz" mask="url(#rz-l-odraz)"><use href="#rz-l-vlak" transform="scale(1 -1)" /></g>
            <g class="rz-l-vlnky">
              {[6, 13, 22, 34, 50, 72, 100, 136].map((y, i) => (
                <path d={`M-6000 ${y} H10000`} stroke={i % 3 ? "#FFFFFF" : "#2E3466"} stroke-opacity={i % 3 ? 0.16 : 0.2} stroke-width={1.4 + i * 0.5} stroke-dasharray={`${60 + i * 23} ${18 + i * 7}`} />
              ))}
            </g>
            <g id="rz-l-vlak" class="rz-l-vlak"></g>
          </svg>
          <p class="rz-listek-prazdno">Vyber hodinu a vlak přijede.</p>
        </div>

        <div class="rz-listek-telo">
          <p class="rz-listek-hlava">
            <span class="rz-listek-druh rz-listek-druh-text">Jízdenka do dílny</span>
            <span class="rz-listek-cislo">№ <b>—</b></span>
          </p>
          <p class="rz-listek-trasa">
            <span class="rz-listek-stanice">Ořech</span>
            <span class="rz-listek-sipka" aria-hidden="true"></span>
            <span class="rz-listek-stanice rz-listek-cil rz-listek-cil-text">Dílna</span>
          </p>
          <p class="rz-listek-vlak" hidden></p>
          <dl class="rz-listek-udaje" aria-live="polite">
            <div><dt class="rz-l-den-popis">Den</dt><dd class="rz-l-den">ještě nevybraný</dd></div>
            <div><dt class="rz-l-hodiny-popis">Odjezd</dt><dd class="rz-l-hodiny">ještě nevybraný</dd></div>
            <div><dt>Cestující</dt><dd class="rz-l-lide">1 člověk</dd></div>
            <div><dt>Jízdné</dt><dd class="rz-l-cena">{jizdne}</dd></div>
          </dl>
          {/* Mapa trasy zvláštního vlaku: program kurzu jako zastávky — kreslí skript */}
          <ol class="rz-listek-program" aria-label="Trať zvláštního vlaku — program kurzu" hidden></ol>
          {/* Jízdy permanentky: každý den, kdy platí, jako políčko pro kleště — kreslí skript */}
          <div class="rz-listek-jizdy" hidden>
            <p class="rz-lj-popis"></p>
            <div class="rz-lj-mesice"></div>
          </div>
          <label class="rz-listek-jmeno">
            <span class="rz-listek-jmeno-popis">Jméno</span>
            <input type="text" name="jmeno" maxlength="40" autocomplete="name" spellcheck="false" placeholder="Tvoje jméno" />
          </label>
          <p class="rz-listek-platnost">Zamluvit si ji můžeš, až se u nás zaregistruješ.</p>
          <span class="rz-listek-razitko" aria-hidden="true"><b>Zamluveno</b><small>platí</small></span>
        </div>

        <div class="rz-listek-utrzek" aria-hidden="true">
          <span class="rz-listek-utrzek-text">kontrola</span>
          <span class="rz-listek-dirka"></span>
          <span class="rz-listek-ustrizek"></span>
        </div>
      </div>

      <div class="rz-nastup-pole">
        <label class="rz-pole" hidden>Poznámka <small>nepovinné</small><textarea name="poznamka" rows="3" maxlength="300" placeholder="Třeba že přijdete poprvé."></textarea></label>
        <p class="rz-cena"><span>Celkem</span> <b>0 Kč</b></p>
        <p class="rz-cena-vypocet">{jizdne}; platí se na místě</p>
        <a class="tlacitko rz-odeslat" href="#prihlaseni">Zaregistrovat se</a>
        <p class="rz-pozn">Zamlouvat si můžou ti, kdo jsou u nás zaregistrovaní — stačí jméno a e-mail, heslo nepotřebuješ.</p>
        <p class="rz-chybi" aria-live="polite"></p>
        <p class="rz-hotovo" aria-live="polite"></p>
        {/* Kdo se dívá, registrace a přihlášení. Bez skriptu host s telefonem — skript (prihlaseni.ts) přepíná podle toho, kdo je přihlášený a co se právě děje */}
        <div class="rz-clen" id="prihlaseni" data-co="host" data-telefon={kontakt.telefon} aria-live="polite">
          <div data-clen="host">
            <p class="rz-clen-titul"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7 H20 V10 A2 2 0 0 0 20 14 V17 H4 V14 A2 2 0 0 0 4 10 Z" /><path d="M9 7 V17" stroke-dasharray="1.6 1.8" /></svg> Rezervace s registrací</p>
            <p>Zamlouvat si můžou ti, kdo jsou u nás zaregistrovaní. Registrace potřebuje skript — bez něj nám zavolej a zapíšeme tě. Projít si volné hodiny a ceny můžeš i tak.</p>
            <a class="rz-clen-tel" href={`tel:${kontakt.telefonOdkaz}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 L9.4 3.2 L11 7.6 L8.9 9.2 C9.9 11.4 12.6 14.1 14.8 15.1 L16.4 13 L20.8 14.6 L20.5 17.4 C20.3 19 18.9 20.3 17.2 20.2 C10 19.6 4.4 14 3.8 6.8 C3.7 5.1 5 3.7 6.6 3.5 Z" /></svg>
              {kontakt.telefon}
            </a>
          </div>

          <div data-clen="registrace" hidden>
            <p class="rz-clen-titul"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7 H20 V10 A2 2 0 0 0 20 14 V17 H4 V14 A2 2 0 0 0 4 10 Z" /><path d="M9 7 V17" stroke-dasharray="1.6 1.8" /></svg> Zaregistruj se</p>
            <p>Stačí jméno a e-mail. Pošleme ti odkaz, kterým registraci potvrdíš — heslo nepotřebuješ. Projít si volné hodiny a ceny můžeš i bez toho.</p>
            <form class="rz-clen-form rz-clen-reg" data-rz-registrace novalidate>
              <label class="sr-only" for="rz-reg-jmeno">Jméno</label>
              <input id="rz-reg-jmeno" type="text" name="jmeno" autocomplete="name" maxlength="60" required placeholder="Jméno" spellcheck="false" />
              <label class="sr-only" for="rz-reg-email">E-mail</label>
              <input id="rz-reg-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="tvuj@email.cz" spellcheck="false" />
              <button type="submit">Zaregistrovat</button>
            </form>
            <p class="rz-clen-drobne">Už jsi u nás? <button type="button" class="rz-clen-odkaz" data-rz-mam>Přihlas se e-mailem</button></p>
          </div>

          <div data-clen="prihlasit neplatny" hidden>
            <p class="rz-clen-titul" data-clen="prihlasit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4.2" /><path d="M12.2 12 H21 M17.5 12 V15.5 M20.5 12 V14.5" /></svg> Přihlas se e-mailem</p>
            <p class="rz-clen-titul" data-clen="neplatny"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4.2" /><path d="M12.2 12 H21 M17.5 12 V15.5 M20.5 12 V14.5" /></svg> Tenhle odkaz už neplatí</p>
            <p data-clen="prihlasit">Zadej e-mail, se kterým ses registroval, a pošleme ti odkaz — heslo nepotřebuješ.</p>
            <p data-clen="neplatny">Odkaz z mailu platí jen chvíli a jen jednou. Pošli si nový:</p>
            <form class="rz-clen-form" data-rz-prihlas novalidate>
              <label class="sr-only" for="rz-email">E-mail</label>
              <input id="rz-email" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="tvuj@email.cz" spellcheck="false" />
              <button type="submit">Poslat odkaz</button>
            </form>
            <p class="rz-clen-drobne">Jsi tu poprvé? <button type="button" class="rz-clen-odkaz" data-rz-nova>Zaregistruj se</button></p>
          </div>

          <div data-clen="potvrdit poslano" hidden>
            <p class="rz-clen-titul" data-clen="potvrdit"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3.8 6.6 L12 13 L20.2 6.6" /></svg> Potvrď registraci</p>
            <p class="rz-clen-titul" data-clen="poslano"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3.8 6.6 L12 13 L20.2 6.6" /></svg> Mrkni do pošty</p>
            <p data-clen="potvrdit">Na <b class="rz-clen-adresa"></b> jsme ti poslali mail. Klikni v něm na tlačítko, nebo sem opiš kód — registrace se tím potvrdí a jsi rovnou přihlášený.</p>
            <p data-clen="poslano">Jestli je <b class="rz-clen-adresa"></b> mezi našimi členy, právě ti přišel odkaz. Klikni na něj, nebo sem opiš kód z mailu.</p>
            <form class="rz-clen-form" data-rz-kod novalidate>
              <label class="sr-only" for="rz-kod">Kód z mailu</label>
              <input id="rz-kod" type="text" name="kod" autocomplete="one-time-code" inputmode="numeric" maxlength="7" required placeholder="123 456" class="rz-clen-kod" />
              <button type="submit" data-clen="potvrdit">Potvrdit</button>
              <button type="submit" data-clen="poslano">Přihlásit</button>
            </form>
            <p class="rz-clen-drobne">Nic nepřišlo? Mrkni do spamu, nebo <button type="button" class="rz-clen-odkaz" data-rz-znovu>pošli mail znovu</button> · <button type="button" class="rz-clen-odkaz" data-rz-jiny>jiný e-mail</button></p>
          </div>

          <div data-clen="clen" hidden>
            <p>Ahoj, <b class="rz-clen-jmeno"></b>! Jsi přihlášený — jízdenka platí hned, jak ji označíš.</p>
            <p class="rz-clen-drobne"><button type="button" class="rz-clen-odkaz" data-rz-odhlas>Odhlásit se</button></p>
          </div>

          <p class="rz-clen-chyba" role="alert" hidden></p>
        </div>
      </div>
    </div>
  </div>
</section>

---
/**
 * Noc na konci Rezervace — poslední vlak. Vlak se po moři vrací
 * k nástupišti s rozsvícenými okny (More.astro, more.ts) a pod kartou
 * je pro něj volné místo, ať je vidět celý. Na kartě je telefon, přes
 * který se dává přístup k rezervacím, a kontakt. Člen, který přišel přes
 * svůj odkaz, tu má všechny své zamluvené jízdenky a může je zrušit.
 */
import { kontakt, mapa } from "../../data/uvod2";
import { rezervace } from "../../data/rezervace";
---
<section class="rz-noc" id="rz-noc" data-hodina="22.6" aria-labelledby="rz-noc-nadpis">
  <div class="rz-noc-karta papir">
    <p class="stitek">poslední vlak</p>
    <h2 id="rz-noc-nadpis" class="nadpis-2">Jízdenka počká do rána.</h2>
    <div class="rz-moje" hidden>
      <p class="rz-posledni-nadpis">Tvoje jízdenky</p>
      <ul class="rz-moje-seznam"></ul>
      <p class="rz-moje-nic">Zatím žádnou nemáš.</p>
      <p class="rz-posledni-pozn">Zrušit jde nejpozději {rezervace.zrusitHodinPredem} hodin předem, permanentku jen přes nás.</p>
      <p class="rz-moje-stav" aria-live="polite"></p>
    </div>
    <p class="rz-noc-text">Ještě nemáš přístup? Zavolej, nadiktuj nám e-mail a odkaz ti přijde. Na cokoli dalšího nám klidně napiš.</p>
    <div class="rz-noc-akce">
      <a class="tlacitko" href={`tel:${kontakt.telefonOdkaz}`}>{kontakt.telefon}</a>
      <a class="tlacitko tlacitko-obrys" href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
    </div>
    <p class="rz-noc-adresa">
      {kontakt.ulice} · {kontakt.psc} {kontakt.obec} ·
      <a href={mapa} target="_blank" rel="noopener">ukázat na mapě</a>
    </p>
    <p class="rz-noc-dal">
      <a href="#rz-rad">Kurzy</a> · <a href="/dilna">Dílna</a> · <a href="/">Úvod</a>
    </p>
  </div>
  <p class="rz-noc-popisek" aria-hidden="true">Vlak jezdí jen jedním směrem — do dílny.</p>
</section>

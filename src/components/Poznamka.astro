---
/**
 * Poznámka pro klienta — malá tečka u prvku, po kliknutí se rozbalí text.
 * Na živém webu je neviditelná: zapne ji až návštěva s ?poznamky v adrese
 * (a pak už se dá přepínat plovoucím tlačítkem vlevo dole).
 */
interface Props {
  /** Na kterou stranu se bublina rozbalí, aby neutíkala ze stránky */
  align?: "left" | "right";
  /** Umístění tečky — typicky absolutní pozice vůči rodiči */
  class?: string;
}

const { align = "left", class: className = "" } = Astro.props;
const uid = `pozn-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={["poznamka", className]} data-align={align}>
  <button type="button" class="poznamka-dot" aria-expanded="false" aria-controls={uid}>
    <span class="poznamka-sr">Poznámka k tomuhle prvku</span>
  </button>
  <span class="poznamka-bublina" id={uid} role="note">
    <slot />
  </span>
</span>

---
interface Props {
  title: string;
  italic: string;
  meta: string;
  metaLink?: string;
  metaLinkText?: string;
}
const { title, italic, meta, metaLink, metaLinkText } = Astro.props;
---

<div class="flex items-baseline justify-between border-b border-espresso/12 pb-3.5 mb-7 gap-4">
  <h2 class="font-serif text-[26px] md:text-[34px] font-medium tracking-tight m-0" style="font-variation-settings: 'opsz' 96;">
    {title} <em class="italic font-normal text-terracotta">{italic}</em>
  </h2>
  <div class="flex gap-4 items-center flex-shrink-0">
    <span class="mono-meta hidden sm:inline">{meta}</span>
    {metaLink && (
      <a href={metaLink} class="mono-meta hover:text-terracotta">{metaLinkText} →</a>
    )}
  </div>
</div>

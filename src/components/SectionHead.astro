---
/**
 * Nadpis sekce v editorialní sazbě: hierarchii nese velikost a světlý řez,
 * ne linka pod textem. Čára zmizela schválně — seznam pod nadpisem má svoje
 * vlastní vlasové linky a dvě čáry nad sebou dělaly ze sekce škatuli.
 */
interface Props {
  title: string;
  italic: string;
  /** Nepovinná — bez ní zůstane nadpis sám, žádný prázdný span */
  meta?: string;
  metaLink?: string;
  metaLinkText?: string;
}
const { title, italic, meta, metaLink, metaLinkText } = Astro.props;
---

<div class="flex items-baseline justify-between mb-8 md:mb-10 gap-4">
  <h2
    class="font-serif text-[32px] md:text-[44px] font-light leading-none tracking-[-0.012em] m-0"
    style="font-variation-settings: 'opsz' 96;"
  >
    {title} <em class="italic font-light text-sakura">{italic}</em>
  </h2>
  <div class="flex gap-4 items-center flex-shrink-0">
    {meta && <span class="mono-meta hidden sm:inline">{meta}</span>}
    {metaLink && (
      <a href={metaLink} class="mono-meta hover:text-sakura transition-colors">{metaLinkText} →</a>
    )}
  </div>
</div>

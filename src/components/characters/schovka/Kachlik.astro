---
/**
 * Kachlík na schovávanou — malá zjednodušená kresba pro hry na hledání
 * po webu, ve čtyřech barvách a dvou pózách, stejně jako Pecinka,
 * Bublinka, Střípek, Hlínka a Cedulka vedle. Kresbu skládá ./kachlik.ts
 * (jde ji volat i za běhu ve hře), pohyb je v styles/schovka.css.
 *
 *   <Kachlik barva="zlata" size={32} />
 *   <Kachlik barva="pruhledna" poza="vykukuje" size={40} />
 *
 * Pod 22 px se kreslí podle zvláštní šestnáctkové mřížky — bez vnitřního
 * rámečku, pusy, tvářiček a odlesků v očích, které by se v tak malé
 * velikosti slily; z razítka zbyde čtvereček.
 */
import "../../../styles/schovka.css";
import { kachlikSchovka } from "./kachlik";
import type { SchovkaBarva, SchovkaPoza } from "./pecinka";
import { uid } from "../dospele/uid";

interface Props {
  barva?: SchovkaBarva;
  /** šířka v pixelech; vykukující je nižší */
  size?: number;
  poza?: SchovkaPoza;
  class?: string;
}
const { barva = "logo", size = 32, poza = "stoji", class: cls = "" } = Astro.props;
const svg = kachlikSchovka({ barva, velikost: size, poza, id: uid(), trida: cls });
---
<Fragment set:html={svg} />

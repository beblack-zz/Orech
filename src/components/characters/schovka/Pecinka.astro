---
/**
 * Pecinka na schovávanou — malá zjednodušená kresba pro hry na hledání
 * po webu, ve čtyřech barvách a dvou pózách. Kresbu skládá ./pecinka.ts
 * (jde ji volat i za běhu ve hře), pohyb je v styles/schovka.css.
 *
 *   <Pecinka barva="zlata" size={32} />
 *   <Pecinka barva="pruhledna" poza="vykukuje" size={40} />
 *
 * Pod 22 px se kreslí podle zvláštní šestnáctkové mřížky — bez papírků
 * shide a bez úsměvu, které by se v tak malé velikosti slily.
 */
import "../../../styles/schovka.css";
import { pecinkaSchovka } from "./pecinka";
import type { SchovkaBarva, SchovkaPoza } from "./pecinka";
import { uid } from "../dospele/uid";

interface Props {
  barva?: SchovkaBarva;
  /** šířka v pixelech; vykukující je nižší */
  size?: number;
  poza?: SchovkaPoza;
  class?: string;
}
const { barva = "logo", size = 32, poza = "stoji", class: cls = "" } = Astro.props;
const svg = pecinkaSchovka({ barva, velikost: size, poza, id: uid(), trida: cls });
---
<Fragment set:html={svg} />

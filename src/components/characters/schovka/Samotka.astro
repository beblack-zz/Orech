---
/**
 * Šamotka na schovávanou — malá zjednodušená kresba pro hry na hledání
 * po webu, ve čtyřech barvách a dvou pózách, stejně jako Pecinka,
 * Bublinka, Střípek, Hlínka, Cedulka a Kachlík vedle. Kresbu skládá
 * ./samotka.ts (jde ji volat i za běhu ve hře), pohyb je
 * v styles/schovka.css.
 *
 *   <Samotka barva="zlata" size={32} />
 *   <Samotka barva="pruhledna" poza="vykukuje" size={40} />
 *
 * Je jediná na šířku: i když leží, je kresba nižší než širší. Pod 22 px
 * se kreslí podle zvláštní šestnáctkové mřížky — bez úsměvu, tvářiček,
 * nátěru a jisker, které by se v tak malé velikosti slily.
 */
import "../../../styles/schovka.css";
import { samotkaSchovka } from "./samotka";
import type { SchovkaBarva, SchovkaPoza } from "./pecinka";
import { uid } from "../dospele/uid";

interface Props {
  barva?: SchovkaBarva;
  /** šířka v pixelech; výška se dopočítá (leží, takže je nižší než širší) */
  size?: number;
  poza?: SchovkaPoza;
  class?: string;
}
const { barva = "logo", size = 32, poza = "stoji", class: cls = "" } = Astro.props;
const svg = samotkaSchovka({ barva, velikost: size, poza, id: uid(), trida: cls });
---
<Fragment set:html={svg} />

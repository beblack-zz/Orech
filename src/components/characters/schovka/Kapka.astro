---
/**
 * Kapka na schovávanou — malá zjednodušená kresba pro hry na hledání
 * po webu, ve čtyřech barvách a dvou pózách, stejně jako Pecinka,
 * Bublinka, Střípek, Hlínka, Cedulka, Kachlík, Šamotka a Vázička vedle.
 * Kresbu skládá ./kapka.ts (jde ji volat i za běhu ve hře), pohyb je
 * v styles/schovka.css.
 *
 *   <Kapka barva="zlata" size={32} />
 *   <Kapka barva="pruhledna" poza="vykukuje" size={40} />
 *
 * Pod 22 px se kreslí podle zvláštní šestnáctkové mřížky — se dvěma
 * bubny místo čtyř, z kruhu jen s obloukem mezi nimi a bez pusy, ruček
 * a pásků na geta, které by se v tak malé velikosti slily.
 */
import "../../../styles/schovka.css";
import { kapkaSchovka } from "./kapka";
import type { SchovkaBarva, SchovkaPoza } from "./pecinka";
import { uid } from "../dospele/uid";

interface Props {
  barva?: SchovkaBarva;
  /** šířka v pixelech; vykukující je nižší */
  size?: number;
  poza?: SchovkaPoza;
  class?: string;
}
const { barva = "logo", size = 32, poza = "stoji", class: cls = "" } = Astro.props;
const svg = kapkaSchovka({ barva, velikost: size, poza, id: uid(), trida: cls });
---
<Fragment set:html={svg} />

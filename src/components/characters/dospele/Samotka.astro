---
import { uid } from "./uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
// Postavička se na stránce kreslí víckrát — id uvnitř SVG musí být pokaždé jiná
const u = uid();
---
{/*
  STYL: MĚDIRYTINA
  Žádná plocha není vybarvená — tón dělá jen hustota šrafy. Čelní hrana
  je nejtmavší, deska nejsvětlejší, žár pod policí je řešený paprsky,
  jak to rytci dělají se světlem odjakživa.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={cls} aria-hidden="true">
  <defs>
    <pattern id={`${u}-sraf-1`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <line x1="0" y1="0" x2="0" y2="5" stroke="#3A2E28" stroke-width="0.6"/>
    </pattern>
    <pattern id={`${u}-sraf-2`} width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <line x1="0" y1="0" x2="0" y2="3" stroke="#3A2E28" stroke-width="0.7"/>
    </pattern>
    <pattern id={`${u}-sraf-3`} width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <path d="M0 0 L0 2.6 M0 0 L2.6 0" stroke="#3A2E28" stroke-width="0.75"/>
    </pattern>
  </defs>

  {/* Žár jako paprsky, ne jako přechod */}
  <g stroke="#B84A2B" stroke-width="0.9" opacity="0.55" stroke-linecap="round">
    <path d="M90 128 L90 162"/>
    <path d="M78 128 L70 160"/>
    <path d="M102 128 L110 160"/>
    <path d="M64 128 L48 156"/>
    <path d="M116 128 L132 156"/>
    <path d="M52 126 L30 146"/>
    <path d="M128 126 L150 146"/>
  </g>
  <path d="M34 140 C56 132 124 132 146 140" stroke="#B84A2B" stroke-width="0.9" opacity="0.4" fill="none"/>

  {/* Čelní hrana: nejhustší křížová šrafa */}
  <path d="M28 108 L152 108 L152 122 C152 126 150 128 146 128 L34 128 C30 128 28 126 28 122 Z" fill={`url(#${u}-sraf-3)`}/>
  <path d="M28 108 L152 108 L152 122 C152 126 150 128 146 128 L34 128 C30 128 28 126 28 122 Z" stroke="#3A2E28" stroke-width="1.2" fill="none"/>

  {/* Deska: šrafa řídne směrem ke světlu vlevo nahoře */}
  <path d="M24 84 L156 84 C158 84 160 86 160 88 L160 104 C160 107 158 108 155 108 L25 108 C22 108 20 107 20 104 L20 88 C20 86 22 84 24 84 Z" fill="#F4EBDD"/>
  <path d="M96 84 L156 84 C158 84 160 86 160 88 L160 104 C160 107 158 108 155 108 L96 108 Z" fill={`url(#${u}-sraf-2)`} opacity="0.85"/>
  <path d="M52 84 L100 84 L100 108 L52 108 Z" fill={`url(#${u}-sraf-1)`} opacity="0.7"/>
  <path d="M24 84 L156 84 C158 84 160 86 160 88 L160 104 C160 107 158 108 155 108 L25 108 C22 108 20 107 20 104 L20 88 C20 86 22 84 24 84 Z" stroke="#3A2E28" stroke-width="1.2" fill="none"/>

  {/* Kroužky po hrncích — obtažené, ne vyplněné */}
  <ellipse cx="50" cy="95" rx="14" ry="5.5" stroke="#3A2E28" stroke-width="1" fill="#F4EBDD"/>
  <ellipse cx="50" cy="95" rx="14" ry="5.5" stroke="#3A2E28" stroke-width="1" fill="none"/>
  <ellipse cx="132" cy="97" rx="10" ry="4" stroke="#3A2E28" stroke-width="1" fill="none"/>

  {/* Obrysová rytina je vždycky silnější než tónová šrafa pod ní — jinak by se tvář ztratila */}
  <g class="tvar" fill="none" stroke="#3A2E28" stroke-width="1.8" stroke-linecap="round">
    <path d="M78 96 C81 92 85 92 88 96"/>
    <path d="M96 96 C99 92 103 92 106 96"/>
    <path d="M85 102 C89 105.5 95 105.5 99 102" stroke-width="1.5"/>
  </g>
</svg>

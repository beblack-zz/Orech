---
import { uid } from "./uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
// Postavička se na stránce kreslí víckrát — id uvnitř SVG musí být pokaždé jiná
const u = uid();
---
{/*
  STYL: VYSTŘIŽENÝ PAPÍR
  Několik plochých vrstev nad sebou, každá vrhá měkký stín na tu pod ní —
  hloubka nevzniká stínováním, ale odstupem. Pravý okraj je natržený,
  dírka je skutečná díra a je skrz ni vidět spodní vrstva.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={cls} aria-hidden="true">
  <defs>
    <filter id={`${u}-stin`} x="-30%" y="-30%" width="180%" height="180%">
      <feDropShadow dx="2.5" dy="4" stdDeviation="3" flood-color="#3A2E28" flood-opacity="0.28"/>
    </filter>
    <filter id={`${u}-stin-jemny`} x="-30%" y="-30%" width="180%" height="180%">
      <feDropShadow dx="1.5" dy="2" stdDeviation="1.6" flood-color="#3A2E28" flood-opacity="0.22"/>
    </filter>
  </defs>

  {/* Spodní vrstva — je vidět jen po okrajích a skrz dírku */}
  <path d="M62 50 L124 50 L124 148 L62 148 Z" fill="#C87E4E" filter={`url(#${u}-stin)`}/>

  {/* Provázek jako vystřižený proužek */}
  <path d="M86 18 L92 18 L96 40 L90 42 Z" fill="#6B5D4F" filter={`url(#${u}-stin-jemny)`}/>

  {/* Hlavní list. Pravý okraj je natržený, ne uříznutý. */}
  <path d="M56 44 L112 44 L116 58 L112 72 L117 88 L112 104 L118 120 L113 136 L116 150 L56 150 Z" fill="#F7F0E2" filter={`url(#${u}-stin)`}/>

  {/* Dírka: skrz ni prosvítá spodní vrstva */}
  <circle cx="82" cy="60" r="7" fill="#C87E4E"/>

  {/* Popisové linky jsou taky proužky papíru, ne čáry */}
  <path d="M66 120 L106 120 L106 125 L66 125 Z" fill="#B84A2B" opacity="0.75" filter={`url(#${u}-stin-jemny)`}/>
  <path d="M66 132 L92 132 L92 136 L66 136 Z" fill="#B84A2B" opacity="0.45" filter={`url(#${u}-stin-jemny)`}/>

  {/* Tvář je taky vystřižená a taky vrhá stín — jinak by vypadala nalepená plochá */}
  <g class="tvar" filter={`url(#${u}-stin-jemny)`}>
    <circle cx="76" cy="104" r="4.2" fill="#4A3B33"/>
    <circle cx="96" cy="104" r="4.2" fill="#4A3B33"/>
    <path d="M72 114 C78 121 92 121 98 114 L98 117.5 C92 124.5 78 124.5 72 117.5 Z" fill="#4A3B33"/>
  </g>

</svg>

---
import Kresba from "./Kresba.astro";
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();
---
{/*
  TSUKUMOGAMI — rozbitý hrnek, který dostal duši. Náplast z hravé verze
  nahradilo kintsugi: prasklina zalitá zlatem. Nemá se schovávat, má být
  vidět, a přesně to Střípek celou dobu všem vykládá.
  Zlato je tmavší než jeho hořčice a nese světlou linku navrch, jinak by
  na žluté zaniklo.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-wobble ${cls}`} aria-hidden="true">
  <defs>
    <Kresba id={u} />
    <radialGradient id={`${u}-telo`} cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#F3CD6E" />
      <stop offset="0.55" stop-color="#E8B440" />
      <stop offset="1" stop-color="#CF9A2A" />
    </radialGradient>
  </defs>

  <g filter={`url(#${u}-tah)`}>
    <path d="M81 53 L103 51 L132 80 L136 118 L118 142 L68 146 L46 122 L45 97 Z" fill={`url(#${u}-telo)`} stroke="#B3851F" stroke-width="1.6" stroke-linejoin="round" />
    <ellipse cx="40" cy="104" rx="7" ry="5" fill="#E8B440" stroke="#B3851F" stroke-width="1" />
    <ellipse cx="140" cy="104" rx="7" ry="5" fill="#E8B440" stroke="#B3851F" stroke-width="1" />
    <circle cx="144" cy="98" r="4" fill="#d4a030" />
    <ellipse cx="76" cy="150" rx="10" ry="5" fill="#C9962A" />
    <ellipse cx="106" cy="150" rx="10" ry="5" fill="#C9962A" />
  </g>

  {/* Kintsugi — hlavní prasklina a dvě odbočky */}
  <g stroke-linecap="round" stroke-linejoin="round" fill="none">
    <path d="M92 52 Q87 70 95 88 Q101 106 94 128 Q90 140 92 146" stroke="#8E6414" stroke-width="3.6" />
    <path d="M95 88 L111 80 L120 84" stroke="#8E6414" stroke-width="2.6" />
    <path d="M97 112 L84 120" stroke="#8E6414" stroke-width="2.4" />
    <path d="M92 52 Q87 70 95 88 Q101 106 94 128 Q90 140 92 146" stroke="#F7DE8A" stroke-width="1.1" />
    <path d="M95 88 L111 80 L120 84" stroke="#F7DE8A" stroke-width="0.9" />
    <path d="M97 112 L84 120" stroke="#F7DE8A" stroke-width="0.8" />
  </g>
  <g transform="translate(111 80) scale(0.7)">
    <path class="jiskra jiskra-1" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#FFF3C4" />
  </g>

  <g class="tvar">
    <g filter={`url(#${u}-mlha)`} fill="#C87E4E" opacity="0.4">
      <ellipse cx="66" cy="108" rx="6" ry="4" />
      <ellipse cx="118" cy="106" rx="6" ry="4" />
    </g>
    <ellipse cx="76" cy="96" rx="3.6" ry="4.6" fill="#3A2E28" />
    <ellipse cx="108" cy="94" rx="3.6" ry="4.6" fill="#3A2E28" />
    <circle cx="75" cy="94.2" r="1.4" fill="#FFF8E6" />
    <circle cx="107" cy="92.2" r="1.4" fill="#FFF8E6" />
    <path d="M80 114 Q90 120 100 114" stroke="#3A2E28" stroke-width="1.8" stroke-linecap="round" fill="none" />
  </g>
</svg>

---
import Kresba from "./Kresba.astro";
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();

/*
 * Střep, cizí kusy i spáry jsou z podoby Kami (scripts/stripek-zlato):
 * bílý porcelán slepený zlatem, nahoře kus s vlnkami seigaiha, dole
 * modrotisk v barvách loga. Tam sedí v obláčku, tady stojí na zemi —
 * proto je celý o kus níž, a o něco větší, ať v partě nezapadne.
 */
const STREP = "M58 62 Q92 50 124 56 L130 78 L122 92 L134 112 L120 130 H62 L50 112 L57 96 L48 80 Z";
const KUS_VLNY = "M100 52.6 Q112 53.4 124 56 L130 78 L114 82 L104 70 Z";
const KUS_MODROTISK = "M57 96 L74 106 L80 130 H62 L50 112 Z";
const SPARY = [
  "M100 52.6 L101.4 61 L104 70 L109 76.4 L114 82 L122 80.4 L130 78",
  "M57 96 L65.6 101 L74 106 L76.4 118 L80 130",
  "M114 82 L117.4 97 L112.4 111 L116 121 L119 130",
].join(" ");
const LOUZICKY = [[104, 70, 2.6, 2.1], [114, 82, 2.8, 2.3], [74, 106, 2.5, 2]];
---
{/*
  TSUKUMOGAMI — rozbitý talíř, který dostal duši, jako na podobě Kami:
  bílý porcelán, dva cizí střípky a všechno slepené zlatem (kintsugi).
  Spáry se nemají schovávat, mají být vidět, a přesně to Střípek celou
  dobu všem vykládá. Medituje se zavřenýma očima; ručky i nožky má
  z glazury jako oblázky.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-wobble ${cls}`} aria-hidden="true">
  <defs>
    <Kresba id={u} zrno={false} />
    <radialGradient id={`${u}-glazura`} cx="0.36" cy="0.32" r="0.85">
      <stop offset="0" stop-color="#FFFFFF" />
      <stop offset="0.6" stop-color="#F4F0E8" />
      <stop offset="1" stop-color="#DED6C8" />
    </radialGradient>
    <linearGradient id={`${u}-hrana`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E9DECD" />
      <stop offset="1" stop-color="#C9B9A2" />
    </linearGradient>
    <pattern id={`${u}-seigaiha`} width="8" height="4" patternUnits="userSpaceOnUse">
      <rect width="8" height="4" fill="#FBF8F2" />
      {[[0, 2], [8, 2], [4, 4]].map(([cx, cy]) => (
        <g stroke="#2F4E9C" stroke-width="0.6">
          <circle cx={cx} cy={cy} r="4" fill="#FBF8F2" />
          <circle cx={cx} cy={cy} r="2.8" />
          <circle cx={cx} cy={cy} r="1.6" />
        </g>
      ))}
    </pattern>
    {/* modrotisk v barvách loga: tečky na přechodu z rumělky do noci */}
    <linearGradient id={`${u}-modrotisk`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#C4432B" />
      <stop offset="0.35" stop-color="#C0708A" />
      <stop offset="0.7" stop-color="#7A5E8E" />
      <stop offset="1" stop-color="#4E4A84" />
    </linearGradient>
    <pattern id={`${u}-tecky`} width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="1.25" cy="1.25" r="0.75" fill="#F4F1EA" />
      <circle cx="3.75" cy="3.75" r="0.75" fill="#F4F1EA" />
    </pattern>
    <linearGradient id={`${u}-zlato`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFF0B8" />
      <stop offset="0.34" stop-color="#F2C95E" />
      <stop offset="0.72" stop-color="#C99430" />
      <stop offset="1" stop-color="#8E6414" />
    </linearGradient>
    <clipPath id={`${u}-strep`}><path d={STREP} /></clipPath>
  </defs>

  <g transform="translate(91 154.6) scale(1.12) translate(-91 -141.6)">
    <ellipse cx="91" cy="141.6" rx="27" ry="4" fill="#3A2E28" opacity="0.13" />
    <g filter={`url(#${u}-tah)`}>
      {/* Nožky a ručky: oblázky z glazury */}
      <g fill={`url(#${u}-glazura)`} stroke="#6B5D4F" stroke-width="1.2">
        <ellipse cx="80" cy="137" rx="7" ry="4.2" />
        <ellipse cx="102" cy="137" rx="7" ry="4.2" />
      </g>
      {/* Tloušťka střepu, glazura a dva cizí kusy */}
      <path d={STREP} transform="translate(2.6 4.4)" fill={`url(#${u}-hrana)`} stroke="#6B5D4F" stroke-width="1.4" stroke-linejoin="round" />
      <path d={STREP} fill={`url(#${u}-glazura)`} />
      <g clip-path={`url(#${u}-strep)`}>
        <path d={KUS_VLNY} fill={`url(#${u}-seigaiha)`} />
        <path d={KUS_MODROTISK} fill={`url(#${u}-modrotisk)`} />
        <path d={KUS_MODROTISK} fill={`url(#${u}-tecky)`} />
        {/* kvítek na modrotisku */}
        <g transform="translate(64 116)" fill="#F4F1EA">
          <path d="M0 6 V-1" stroke="#F4F1EA" stroke-width="1" />
          <path d="M-3.2 -1 C-3.4 -4.6 -1.6 -6.6 0 -7.4 C1.6 -6.6 3.4 -4.6 3.2 -1 C2 -0.2 1 0 0 -1.6 C-1 0 -2 -0.2 -3.2 -1 Z" />
          <path d="M0 3 C-2 1.6 -3.8 1.8 -4.6 3 C-3.4 4 -1.6 4 0 3 Z M0 3 C2 1.6 3.8 1.8 4.6 3 C3.4 4 1.6 4 0 3 Z" />
        </g>
        <path d="M63 68 Q67.6 80 66.6 93" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" opacity="0.7" />
        <path d="M59 63.6 Q92 52 123 57.8" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" opacity="0.9" />
      </g>
      <path d={STREP} stroke="#6B5D4F" stroke-width="1.6" stroke-linejoin="round" />
      <g fill={`url(#${u}-glazura)`} stroke="#6B5D4F" stroke-width="1.2">
        <ellipse cx="47" cy="114" rx="6.4" ry="4.8" />
        <ellipse cx="137" cy="113" rx="6.4" ry="4.8" />
      </g>
    </g>

    {/* Kintsugi: spáry a loužičky zlata, kde se potkávají */}
    <g stroke-linecap="round" stroke-linejoin="round">
      <path d={SPARY} stroke="#7A5412" stroke-width="4.2" />
      <path d={SPARY} stroke={`url(#${u}-zlato)`} stroke-width="3" />
      {LOUZICKY.map(([x, y, rx, ry]) => <ellipse cx={x} cy={y} rx={rx} ry={ry} fill="#E3B04A" stroke="#7A5412" stroke-width="0.6" />)}
      <path d={SPARY} stroke="#FFF0B8" stroke-width="0.9" opacity="0.85" />
    </g>
    <g transform="translate(114 82) scale(0.7)">
      <path class="jiskra jiskra-1" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#FFF3C4" />
    </g>

    <g class="tvar">
      <g filter={`url(#${u}-mlha)`} fill="#F2B2A2" opacity="0.75">
        <ellipse cx="80" cy="97" rx="5" ry="3" />
        <ellipse cx="106" cy="96.4" rx="5" ry="3" />
      </g>
      <g stroke="#3A2E28" stroke-linecap="round" stroke-linejoin="round">
        <path d="M79 80.4 Q84 78.4 88.6 79.8 M96.4 79.4 Q101 78 105.8 79.6" stroke-width="1.5" opacity="0.9" />
        <path d="M79.4 88.2 Q84 92 88.6 88.2 M96.6 87.6 Q101.2 91.4 105.8 87.6" stroke-width="2.1" />
        <path d="M79.4 88.2 L78 87.4 M105.8 87.6 L107.2 86.8" stroke-width="1.2" />
        <path d="M89.6 99.6 Q93 101.8 96.4 99.6" stroke-width="1.9" />
      </g>
    </g>
  </g>
</svg>

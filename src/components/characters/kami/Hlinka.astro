---
import Kresba from "./Kresba.astro";
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();

/** Pětilistý kvítek sakury se zoubkem na každém plátku (jako na podobě Kami); r je délka plátku. */
const kvet = (r: number, a = 0) => {
  const f = (n: number) => Math.round(n * 100) / 100;
  let d = "";
  for (let i = 0; i < 5; i++) {
    const w = a + (i * 2 * Math.PI) / 5;
    const c = Math.cos(w), s = Math.sin(w);
    const P = (x: number, y: number) => `${f(x * c - y * s)} ${f(x * s + y * c)}`;
    d += `M${P(0, 0)} C${P(-0.55 * r, -0.2 * r)} ${P(-0.64 * r, -0.86 * r)} ${P(-0.2 * r, -r)} L${P(0, -0.82 * r)} L${P(0.2 * r, -r)} C${P(0.64 * r, -0.86 * r)} ${P(0.55 * r, -0.2 * r)} ${P(0, 0)} Z`;
  }
  return d;
};
const KVET = kvet(5.4);
/** „z“ jako tah, ne písmo — písma webu se do kresby nedostanou. */
const zetko = (s: number) => `M130 62 h${5 * s} l${-5 * s} ${6 * s} h${5 * s}`;
---
{/*
  KAMI ZEMĚ. Hrouda, spánek i „z z z“ zůstávají. Na temeni výhonek —
  jediná zelená v partě, protože hlína je jediná, co je opravdu živá —
  a jako na podobě Kami, kde spí pod sakurou, jí na něm vykvetl vlastní
  květ a na hlavě jí zůstal ležet lístek a jeden utržený kvítek. Kolem
  ní líně plavou dvě světýlka, dokud spí.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-breathe ${cls}`} aria-hidden="true">
  <defs>
    <Kresba id={u} zrno={false} />
    <radialGradient id={`${u}-telo`} cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#8A7A69" />
      <stop offset="0.55" stop-color="#6B5D4F" />
      <stop offset="1" stop-color="#52463B" />
    </radialGradient>
    <radialGradient id={`${u}-kvet`}>
      <stop offset="0" stop-color="#EE94B1" />
      <stop offset="0.5" stop-color="#F7BFD0" />
      <stop offset="1" stop-color="#FBDCE5" />
    </radialGradient>
    <radialGradient id={`${u}-kvet-sv`}>
      <stop offset="0" stop-color="#F4A9C0" />
      <stop offset="0.45" stop-color="#FCDCE5" />
      <stop offset="1" stop-color="#FFF4F6" />
    </radialGradient>
  </defs>

  <g filter={`url(#${u}-tah)`}>
    {/* Výhonek je za tělem, aby vyrůstal z hroudy, ne z ní trčel */}
    <path d="M90 54 C89 44 91 38 95 32" stroke="#6E7A4E" stroke-width="2.2" stroke-linecap="round" />
    <path d="M94 36 C100 28 110 28 114 31 C108 37 100 39 94 36 Z" fill="#8A9466" stroke="#6E7A4E" stroke-width="1" />
    <path d="M92 42 C86 35 78 35 74 38 C79 43 87 45 92 42 Z" fill="#9AA375" stroke="#6E7A4E" stroke-width="1" />
    <path d="M95.5 35.2 Q104 31.6 112 31.2 M90.6 41 Q83 37.6 76.4 38.2" stroke="#C7CC9E" stroke-width="0.7" stroke-linecap="round" opacity="0.8" />

    <circle cx="90" cy="98" r="48" fill={`url(#${u}-telo)`} stroke="#4A3F35" stroke-width="1.6" />
    <circle cx="70" cy="80" r="8" fill="#9A8A78" opacity="0.4" />
    <circle cx="108" cy="112" r="6" fill="#7d6e5f" opacity="0.4" />
    <circle cx="82" cy="120" r="5" fill="#5a4e42" opacity="0.3" />
    <ellipse cx="76" cy="144" rx="11" ry="5" fill="#4F443A" />
    <ellipse cx="104" cy="144" rx="11" ry="5" fill="#4F443A" />
  </g>

  {/* Květ na výhonku */}
  <path d="M95 32 L96.8 29.4" stroke="#8C7A52" stroke-width="1" stroke-linecap="round" />
  <g transform="translate(96.8 29.4) rotate(14)">
    <path d={KVET} fill={`url(#${u}-kvet)`} stroke="#DC8FA9" stroke-width="0.4" stroke-linejoin="round" />
    <circle r="1.6" fill="#F6D77A" />
    <circle r="0.8" fill="#D9648A" />
  </g>
  {/* Co jí zůstalo ležet na hlavě: lístek vlevo a kvítek vpravo, oba z boku zploštělé */}
  <path d="M0 -2.2 C1.4 -1.9 1.7 0.6 0 2.2 C-1.7 0.6 -1.4 -1.9 0 -2.2 Z" transform="translate(67.3 56.6) rotate(-9) scale(2 1.4)" fill="#F9CCD8" stroke="#E29BB3" stroke-width="0.15" />
  <g transform="translate(109.3 54) rotate(34) scale(0.6 0.42)">
    <path d={KVET} fill={`url(#${u}-kvet-sv)`} stroke="#E8AFC1" stroke-width="0.6" stroke-linejoin="round" />
    <circle r="1.4" fill="#D9648A" />
  </g>

  <g class="tvar">
    <g filter={`url(#${u}-mlha)`} fill="#C87E4E" opacity="0.45">
      <ellipse cx="68" cy="104" rx="7" ry="4.5" />
      <ellipse cx="112" cy="104" rx="7" ry="4.5" />
    </g>
    <path d="M72 94 Q78 90 84 94" stroke="#F4EBDD" stroke-width="2.5" stroke-linecap="round" fill="none" />
    <path d="M96 94 Q102 90 108 94" stroke="#F4EBDD" stroke-width="2.5" stroke-linecap="round" fill="none" />
    <path d="M85 108 Q90 112 95 108" stroke="#F4EBDD" stroke-width="1.8" stroke-linecap="round" fill="none" />
    <g stroke="#6B5D4F" stroke-linecap="round" stroke-linejoin="round">
      <path class="zzz zzz-1" d={zetko(1.3)} stroke-width="2" />
      <path class="zzz zzz-2" d={zetko(1.2)} stroke-width="1.9" />
      <path class="zzz zzz-3" d={zetko(1.1)} stroke-width="1.8" />
    </g>
  </g>

  <g fill="#F2DC94">
    <circle class="kami-svetlo" cx="42" cy="118" r="2.2" filter={`url(#${u}-mlha)`} />
    <circle class="kami-svetlo kami-svetlo-2" cx="140" cy="128" r="1.8" filter={`url(#${u}-mlha)`} />
    <circle class="kami-svetlo" cx="42" cy="118" r="1" />
    <circle class="kami-svetlo kami-svetlo-2" cx="140" cy="128" r="0.8" />
  </g>
</svg>

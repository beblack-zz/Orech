---
import Kresba from "./Kresba.astro";
import Shide from "./Shide.astro";
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();
---
{/*
  KAMADO-GAMI — kami ohniště. Jediná z party, kdo je kami doopravdy podle
  tradice, proto jediná nese shimenawu: svatý slaměný provázek s papírky
  shide, kterým se v Japonsku označuje místo, kde kami bydlí.
  Plameny dostaly záři, aby pec svítila zevnitř.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-breathe ${cls}`} aria-hidden="true">
  <defs>
    <Kresba id={u} />
    <radialGradient id={`${u}-telo`} cx="0.34" cy="0.25" r="0.85">
      <stop offset="0" stop-color="#CF6A47" />
      <stop offset="0.55" stop-color="#B84A2B" />
      <stop offset="1" stop-color="#97391F" />
    </radialGradient>
  </defs>

  <g filter={`url(#${u}-tah)`}>
    <rect x="108" y="42" width="14" height="24" rx="5" fill="#A8432A" stroke="#7E2F18" stroke-width="1.3" />
    <rect x="45" y="60" width="90" height="85" rx="20" fill={`url(#${u}-telo)`} stroke="#7E2F18" stroke-width="1.6" />
    <rect x="62" y="100" width="56" height="35" rx="8" fill="#3A2E28" opacity="0.4" />
    <ellipse cx="70" cy="148" rx="10" ry="5" fill="#3A2E28" opacity="0.3" />
    <ellipse cx="110" cy="148" rx="10" ry="5" fill="#3A2E28" opacity="0.3" />
  </g>

  <ellipse class="plamen plamen-1" cx="90" cy="124" rx="22" ry="12" fill="#E8B440" opacity="0.5" filter={`url(#${u}-mlha)`} />
  <ellipse class="plamen plamen-1" cx="80" cy="124" rx="6" ry="9" fill="#F0C55E" />
  <ellipse class="plamen plamen-2" cx="92" cy="122" rx="5" ry="7" fill="#F0C55E" />
  <ellipse class="plamen plamen-3" cx="100" cy="126" rx="4" ry="6" fill="#C87E4E" />

  {/* Shimenawa: slaměný provázek přes rameno pece, dva papírky shide */}
  <g filter={`url(#${u}-tah)`}>
    <path d="M44 70 Q90 80 136 70" stroke="#C9B186" stroke-width="6.5" stroke-linecap="round" />
    <path d="M44 70 Q90 80 136 70" stroke="#EBDDB8" stroke-width="5" stroke-linecap="round" />
    <path d="M44 70 Q90 80 136 70" stroke="#C9B186" stroke-width="5" stroke-dasharray="1.6 4.4" />
  </g>
  <Shide x={66} y={75} />
  <Shide x={110} y={75} zpozdeni />

  <g class="tvar">
    <g filter={`url(#${u}-mlha)`} fill="#E8B440" opacity="0.35">
      <ellipse cx="66" cy="92" rx="6" ry="4" />
      <ellipse cx="114" cy="92" rx="6" ry="4" />
    </g>
    <ellipse cx="76" cy="86" rx="3.3" ry="4.2" fill="#3A2E28" />
    <ellipse cx="104" cy="86" rx="3.3" ry="4.2" fill="#3A2E28" />
    <circle cx="75" cy="84.3" r="1.3" fill="#FFF3D6" />
    <circle cx="103" cy="84.3" r="1.3" fill="#FFF3D6" />
    <path d="M84 96 Q90 101 96 96" stroke="#F4EBDD" stroke-width="2" stroke-linecap="round" fill="none" />
  </g>

  <circle class="kour kour-1" cx="115" cy="38" r="5" fill="#6B5D4F" />
  <circle class="kour kour-2" cx="115" cy="38" r="4" fill="#6B5D4F" />
  <circle class="kour kour-3" cx="115" cy="38" r="3" fill="#6B5D4F" />
</svg>

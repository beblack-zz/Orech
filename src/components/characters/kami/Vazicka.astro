---
import Kresba from "./Kresba.astro";
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();

const kvet = "#B84A2B";
const kvetPata = "#9E4025";
const kvetSpicka = "#CF846F";
const odsun = 1.7;
const obrys = "M71 44 Q75 47 76 54 C66 61 56 78 55 106 C54 130 68 150 82 150 L98 150 C112 150 126 130 125 106 C124 78 114 61 104 54 Q105 47 109 44 Q90 40 71 44 Z";
---
{/*
  TSUKUMOGAMI — předmět, který po sto letech služby dostane duši. Vázička
  je nejstarší kus v dílně, tak je to na ní vidět: glazura popraskala
  jemnou sítí (kannyū, tak stárne každá stará glazura) a hrdlo má
  převázané červenou šňůrkou, jakou se v Japonsku vážou vzácné kusy.
  Oči nechávají zavřené — kdo je tu nejdéle, nemusí nic sledovat.
*/}
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-sway ${cls}`} aria-hidden="true">
  <defs>
    <Kresba id={u} />
    <radialGradient id={`${u}-glazura`} cx="0.36" cy="0.35" r="0.8">
      <stop offset="0" stop-color="#FBF4E8" />
      <stop offset="0.6" stop-color="#EFE3D0" />
      <stop offset="1" stop-color="#DCCBB0" />
    </radialGradient>
    <clipPath id={`${u}-telo`}><path d={obrys} /></clipPath>
    <linearGradient id={`${u}-stin`} gradientUnits="userSpaceOnUse" x1="0" y1="0.5" x2="0" y2="-12.6">
      <stop offset="0" stop-color={kvetPata} />
      <stop offset="0.45" stop-color={kvet} />
      <stop offset="1" stop-color={kvetSpicka} />
    </linearGradient>
    <path id={`${u}-listek`} fill={`url(#${u}-stin)`} d="M0 0 C-2.5 -1.5 -4.1 -3.9 -4.2 -6.6 C-4.3 -9.4 -3.1 -11.5 -1.9 -12.6 L0 -9.5 L1.9 -12.6 C3.1 -11.5 4.3 -9.4 4.2 -6.6 C4.1 -3.9 2.5 -1.5 0 0 Z" />
    <g id={`${u}-kvet`}>
      {[0, 72, 144, 216, 288].map((uhel) => (
        <use href={`#${u}-listek`} transform={`rotate(${uhel}) translate(0 -${odsun})`} />
      ))}
    </g>
  </defs>

  <g transform="translate(90 150) scale(0.82) translate(-90 -150)">
    <g filter={`url(#${u}-tah)`}>
      <path d={obrys} fill={`url(#${u}-glazura)`} stroke="#6B5D4F" stroke-width="1.7" />
      <g clip-path={`url(#${u}-telo)`} stroke="#6B5D4F" stroke-linecap="round" fill="none">
        <path d="M84 55 C62 84 62 122 85 150" stroke-width="5" opacity="0.09" />
        <path d="M69 62 C58 88 58 118 67 143" stroke-width="4.5" opacity="0.08" />
        <path d="M96 55 C118 84 118 122 95 150" stroke-width="5" opacity="0.09" />
        <path d="M111 62 C122 88 122 118 113 143" stroke-width="4.5" opacity="0.08" />
        {/* Kannyū — síť jemných prasklinek v glazuře, hustší ke dnu */}
        <g stroke-width="0.6" opacity="0.32">
          <path d="M58 118 L70 112 L78 122 L92 116 L104 124 L116 116 L126 120" />
          <path d="M60 134 L72 128 L84 138 L98 132 L110 140 L122 132" />
          <path d="M70 112 L66 98 M78 122 L82 136 M92 116 L90 104 M104 124 L100 136 M116 116 L120 102" />
          <path d="M66 98 L58 92 M66 98 L76 96 M120 102 L112 96 M90 104 L98 100" />
          <path d="M72 128 L68 146 M98 132 L94 150 M110 140 L118 148" />
        </g>
      </g>
      {/* Šňůrka kolem hrdla s mašlí a dvěma volnými konci */}
      <path d="M75 55 Q90 60 105 55" stroke="#B84A2B" stroke-width="2.6" stroke-linecap="round" />
      <path d="M96 58 C102 64 104 70 101 76 M98 58 C97 66 93 72 94 79" stroke="#B84A2B" stroke-width="1.5" stroke-linecap="round" />
      <path d="M97 58 C92 52 86 54 90 59 C93 61 95 60 97 58 C102 52 108 54 104 59 C101 61 99 60 97 58 Z" fill="#B84A2B" />
    </g>
    <g class="tvar">
      <g filter={`url(#${u}-mlha)`} fill="#CF846F" opacity="0.4">
        <ellipse cx="77" cy="98" rx="5.5" ry="3.5" />
        <ellipse cx="105" cy="98" rx="5.5" ry="3.5" />
      </g>
      <path d="M80 90 Q83 86 86 90" stroke="#3A2E28" stroke-width="2" stroke-linecap="round" fill="none" />
      <path d="M96 90 Q99 86 102 90" stroke="#3A2E28" stroke-width="2" stroke-linecap="round" fill="none" />
      <path d="M85 102 Q90 107 95 102" stroke="#3A2E28" stroke-width="1.8" stroke-linecap="round" fill="none" />
    </g>
  </g>

  <g transform="rotate(10 89 63)" filter={`url(#${u}-tah)`}>
    <path d="M89 63 C91 54 95 45 103 38" stroke="#6B5D4F" stroke-width="1.3" stroke-linecap="round" fill="none" />
    <path d="M93 50 C91 48 89 46 87 44" stroke="#6B5D4F" stroke-width="1" stroke-linecap="round" fill="none" />
    <path d="M91 57 C93 56 96 55 99 53" stroke="#6B5D4F" stroke-width="0.9" stroke-linecap="round" fill="none" />
    <use href={`#${u}-kvet`} transform="translate(85 42) rotate(-24) scale(0.42)" />
    <use href={`#${u}-kvet`} transform="translate(102 51) rotate(46) scale(0.34)" />
    <use href={`#${u}-kvet`} transform="translate(105 35) rotate(26) scale(0.56)" />
  </g>

  <g transform="translate(59 57)">
    <path class="jiskra jiskra-1" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#E8B440" />
  </g>
  <g transform="translate(55 74) scale(0.62)">
    <path class="jiskra jiskra-3" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#C87E4E" />
  </g>
  <g transform="translate(133 122) scale(0.9)">
    <path class="jiskra jiskra-2" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#E8B440" />
  </g>
  <g transform="translate(122 139) scale(0.6)">
    <path class="jiskra jiskra-4" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#C87E4E" />
  </g>
  <ellipse cx="90" cy="154" rx="19" ry="4" fill="#6B5D4F" opacity="0.2" />
</svg>

---
interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;

/* Plátek z loga — Vázička drží ve váze sakuru, ne obecné puntíky. */
const kvet = "#D79A94";
const kvetPata = "#C4837C";
const kvetSpicka = "#E7BAB3";

/** Postavička bývá na stránce vícekrát — id se nesmějí srazit. */
const id = `vaza-${Math.random().toString(36).slice(2, 8)}`;

/** O kolik plátek odstupuje od středu květu — tím vznikají mezery mezi nimi. */
const odsun = 1.7;
---
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={`char-sway ${cls}`} aria-hidden="true">
  {/*
    Tělo: z úzkého hrdla se rozevře do břicha kolem y=106 a ke dnu se zase
    stáhne. Nejširší místo je schválně pod polovinou výšky — nahoře úzko,
    dole plno, to je na váze poznat na první pohled.
  */}
  {/*
    Samotná váza je zmenšená kolem svého dna, aby nahoře zbylo místo na
    delší větvičku. Dno tak zůstává na stejném místě jako u ostatních
    postaviček a nemusí se přepočítávat stín ani jiskřičky.
  */}
  <g transform="translate(90 150) scale(0.82) translate(-90 -150)">
    {/*
      Hrdlo, obruba i tělo jsou jedna uzavřená silueta. Kdyby to byly dva
      tvary, obrys těla by hrdlo přeťal vodorovnou ryskou.
    */}
    <path d="M71 44 Q75 47 76 54 C66 61 56 78 55 106 C54 130 68 150 82 150 L98 150 C112 150 126 130 125 106 C124 78 114 61 104 54 Q105 47 109 44 Q90 40 71 44 Z" fill="#EFE3D0" stroke="#6B5D4F" stroke-width="1.5"/>
    {/*
      Žebrování jako na točené váze — čtyři svislé pruhy ve stínu vlastní
      barvy, stejný princip jako odlesk u Kapky. Vedou po stranách, aby
      nešly přes obličej, a clipPath je drží uvnitř siluety.
    */}
    <clipPath id={`${id}-telo`}>
      <path d="M71 44 Q75 47 76 54 C66 61 56 78 55 106 C54 130 68 150 82 150 L98 150 C112 150 126 130 125 106 C124 78 114 61 104 54 Q105 47 109 44 Q90 40 71 44 Z" />
    </clipPath>
    <g clip-path={`url(#${id}-telo)`} stroke="#6B5D4F" stroke-linecap="round" fill="none">
      <path d="M84 55 C62 84 62 122 85 150" stroke-width="5" opacity="0.09"/>
      <path d="M69 62 C58 88 58 118 67 143" stroke-width="4.5" opacity="0.08"/>
      <path d="M96 55 C118 84 118 122 95 150" stroke-width="5" opacity="0.09"/>
      <path d="M111 62 C122 88 122 118 113 143" stroke-width="4.5" opacity="0.08"/>
    </g>
    <g class="tvar">
      <path d="M80 90 Q83 86 86 90" stroke="#3A2E28" stroke-width="2" stroke-linecap="round" fill="none"/>
      <path d="M96 90 Q99 86 102 90" stroke="#3A2E28" stroke-width="2" stroke-linecap="round" fill="none"/>
      <path d="M85 102 Q90 107 95 102" stroke="#3A2E28" stroke-width="1.8" stroke-linecap="round" fill="none"/>
    </g>
  </g>
  {/*
    Jedna větvička sakury z hrdla — hlavní stonek a jedna odbočka.
    Květ je tentýž pětilístek jako ve značce, bez středu.
  */}
  <defs>
    <linearGradient id={`${id}-stin`} gradientUnits="userSpaceOnUse" x1="0" y1="0.5" x2="0" y2="-12.6">
      <stop offset="0" stop-color={kvetPata} />
      <stop offset="0.45" stop-color={kvet} />
      <stop offset="1" stop-color={kvetSpicka} />
    </linearGradient>
    <path
      id={`${id}-listek`}
      fill={`url(#${id}-stin)`}
      d="M0 0 C-2.5 -1.5 -4.1 -3.9 -4.2 -6.6 C-4.3 -9.4 -3.1 -11.5 -1.9 -12.6 L0 -9.5 L1.9 -12.6 C3.1 -11.5 4.3 -9.4 4.2 -6.6 C4.1 -3.9 2.5 -1.5 0 0 Z"
    />
    <g id={`${id}-kvet`}>
      {[0, 72, 144, 216, 288].map((u) => (
        <use href={`#${id}-listek`} transform={`rotate(${u}) translate(0 -${odsun})`} />
      ))}
    </g>
  </defs>
  {/* Větvička je nakloněná doprava — otáčí se kolem místa, kde vychází z hrdla. */}
  <g transform="rotate(10 89 63)">
    <path d="M89 63 C91 54 95 45 103 38" stroke="#6B5D4F" stroke-width="1.2" stroke-linecap="round" fill="none"/>
    <path d="M93 50 C91 48 89 46 87 44" stroke="#6B5D4F" stroke-width="1" stroke-linecap="round" fill="none"/>
    <path d="M91 57 C93 56 96 55 99 53" stroke="#6B5D4F" stroke-width="0.9" stroke-linecap="round" fill="none"/>
    <use href={`#${id}-kvet`} transform="translate(85 42) rotate(-24) scale(0.42)" />
    <use href={`#${id}-kvet`} transform="translate(102 51) rotate(46) scale(0.34)" />
    <use href={`#${id}-kvet`} transform="translate(105 35) rotate(26) scale(0.56)" />
  </g>
  {/*
    Jiskřičky po stranách vázy — dvě vlevo nahoře, dvě vpravo dole.
    Úhlopříčka rámuje postavičku a nechává kytky nahoře volné.
    Hvězdička je nakreslená kolem počátku a umístěná až transformem
    skupiny — díky tomu se CSS scale/rotate točí kolem jejího středu
    a nepotřebuje transform-box.
  */}
  <g transform="translate(59 57)">
    <path class="jiskra jiskra-1" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#E8B440"/>
  </g>
  <g transform="translate(55 74) scale(0.62)">
    <path class="jiskra jiskra-3" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#C87E4E"/>
  </g>
  <g transform="translate(133 122) scale(0.9)">
    <path class="jiskra jiskra-2" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#E8B440"/>
  </g>
  <g transform="translate(122 139) scale(0.6)">
    <path class="jiskra jiskra-4" d="M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z" fill="#C87E4E"/>
  </g>
  <ellipse cx="90" cy="154" rx="19" ry="4" fill="#6B5D4F" opacity="0.2"/>
</svg>

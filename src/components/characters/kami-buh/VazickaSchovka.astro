---
/*
  Vázička na schovávanou — vzorník pro /marcel (čtvrtá podoba Vázičky),
  postavený stejně jako PecinkaSchovka.astro, BublinkaSchovka.astro,
  StripekSchovka.astro, HlinkaSchovka.astro a CedulkaSchovka.astro vedle.
  Samotná kresba je v ../schovka (Vazicka.astro a vazicka.ts) a je vždycky
  malá; tady jsou čtyři barvy vedle sebe: na papíře, zmenšené až na 16 px,
  ve tmě a jak vykukují zpoza hrany.

  Kliknutí ukáže, jak ji hra „najde“: vyskočí, cinkne (zvuk webu, zlatá
  zvoní výš) a rozletí se z ní lístky sakury — tuš, sklo, zlato nebo barvy
  značky — a s nimi pár zlatých šupinek ze šňůrky na obi.
*/
import Vazicka from "../schovka/Vazicka.astro";
import { NAZVY } from "../schovka/pecinka";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
---
<div class="vzs" data-vazicka-schovka>
  <p class="vzs-stitek">Na papíře</p>
  <ul class="vzs-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="vzs-kus" data-barva={b} aria-label={`Vázička na schovávanou — ${NAZVY[b]}`}>
          <Vazicka barva={b} size={56} />
        </button>
        <span class="vzs-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="vzs-stitek">Zmenšená · 32 · 24 · 16 px</p>
  <ul class="vzs-radek vzs-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="vzs-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Vazicka barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="vzs-stitek">V noci</p>
  <ul class="vzs-radek vzs-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="vzs-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Vazicka barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="vzs-stitek">Vykukuje zpoza hrany</p>
  <ul class="vzs-radek vzs-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="vzs-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Vazicka barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="vzs-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je která Vázička; při nalezení se z ní rozletí lístky sakury v těch barvách */
  const LISTKY: Record<Barva, { barvy: string[]; pocet: number }> = {
    cerna: { barvy: ["#1E1A18", "#3A302A", "#2B2420"], pocet: 9 },
    pruhledna: { barvy: ["#FFFFFF", "#F6C8D2", "#CFE4F4"], pocet: 9 },
    zlata: { barvy: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], pocet: 10 },
    logo: { barvy: ["#F4B4C2", "#C0708A", "#FBE9B7", "#C4432B", "#7A5E8E"], pocet: 10 },
  };
  /* zlato ze šňůrky na obi: pár šupinek letí s každou, ať je jakékoli barvy */
  const ZLATO = ["#E2B95A", "#FBE9B7", "#C9922E"];
  const SUPINEK = 4;
  /* tři velikosti lístku (vzs-listek-a až c), ať nejsou všechny stejné */
  const TVARY = "abc";
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /** jedna částice: vyletí ze středu pod úhlem u, otáčí se a spadne; tize je, o kolik víc padá, než letí */
  function castice(kus: HTMLElement, trida: string, barva: string, u: number, vel: number, tize = 22) {
    const s = document.createElement("span");
    s.className = `vzs-castice ${trida}`;
    const d = vel * (0.55 + Math.random() * 0.6);
    s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
    s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
    s.style.setProperty("--g", `${tize}px`);
    s.style.setProperty("--r", `${Math.round(Math.random() * 540 - 270)}deg`);
    s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
    s.style.background = barva;
    kus.append(s);
    window.setTimeout(() => s.remove(), 1700);
    return s;
  }

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = LISTKY[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    /* lístky jsou lehké: rozletí se dokola a snášejí se pomaleji a míň strmě než šupinky */
    for (let i = 0; i < c.pocet; i++) {
      const l = castice(kus, `vzs-listek vzs-listek-${TVARY[i % TVARY.length]}`, c.barvy[i % c.barvy.length], (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5, vel, 16);
      l.style.setProperty("--d", `${(1 + Math.random() * 0.5).toFixed(2)}s`);
    }
    for (let i = 0; i < SUPINEK; i++) {
      castice(kus, "vzs-supinka", ZLATO[i % ZLATO.length], ((i + 0.5) / SUPINEK) * Math.PI * 2 + Math.random() * 0.8, vel);
    }
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-vazicka-schovka] .vzs-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Vázičky na schovávanou; lístky vyrábí skript, proto globálně */
  .vzs {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .vzs-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .vzs-stitek:first-child { margin-top: 0; }
  .vzs-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .vzs-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .vzs-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .vzs-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černá schová skoro úplně */
  .vzs-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Vázička schovává a drží se jí ručkama; větvička nad ni trčí první */
  .vzs-hrana li { gap: 0; }
  .vzs-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .vzs-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .vzs-hrana .vzs-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .vzs-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  /* co z ní vyletí: lístky sakury v jejích barvách a zlaté šupinky ze šňůrky na obi */
  .vzs-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 10px;
    margin: -5px 0 0 -3.5px;
    pointer-events: none;
    z-index: 2;
    animation: vzs-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1) forwards;
  }
  @keyframes vzs-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + var(--g, 22px))) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  /* lístek sakury: plátek z květu značky se zářezem na špičce, tvar přes clip-path; tři velikosti */
  .vzs-listek { clip-path: polygon(50% 100%, 21% 88%, 2% 69%, 1% 48%, 9% 19%, 28% 0, 50% 25%, 72% 0, 91% 19%, 99% 48%, 98% 69%, 79% 88%); }
  .vzs-listek-b { width: 9px; height: 13px; margin: -6.5px 0 0 -4.5px; }
  .vzs-listek-c { width: 5px; height: 7.5px; margin: -3.75px 0 0 -2.5px; }
  /* zlatá šupinka: drobný kosočtverec */
  .vzs-supinka { width: 4px; height: 4px; margin: -2px 0 0 -2px; clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
</style>

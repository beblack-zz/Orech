---
/*
  Kachlík na schovávanou — vzorník pro /marcel, postavený stejně jako
  PecinkaSchovka.astro, BublinkaSchovka.astro, StripekSchovka.astro,
  HlinkaSchovka.astro a CedulkaSchovka.astro vedle. Samotná kresba je
  v ../schovka (Kachlik.astro a kachlik.ts) a je vždycky malá; tady jsou
  čtyři barvy vedle sebe: na papíře, zmenšené až na 16 px, ve tmě a jak
  vykukují zpoza hrany.

  Kliknutí ukáže, jak ho hra „najde“: vyskočí, cinkne (zvuk webu, zlatý
  zvoní výš) a rozletí se z něj kachlíčky — tuš, sklo, zlato nebo soumrak.
  Letí rovně, žádný se neotočí. S nimi pár pravých úhlů, které se točí
  jen o čtvrtky, a bublinky, co mu utekly z vodováhy.
*/
import Kachlik from "../schovka/Kachlik.astro";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
/* stejné barvy jako u Pecinky a Bublinky (NAZVY v ../schovka/pecinka), jen v mužském rodě */
const NAZVY = { cerna: "Černý", pruhledna: "Průhledný", zlata: "Zlatý", logo: "Barvy loga" } as const;
---
<div class="kss" data-kachlik-schovka>
  <p class="kss-stitek">Na papíře</p>
  <ul class="kss-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kss-kus" data-barva={b} aria-label={`Kachlík na schovávanou — ${NAZVY[b]}`}>
          <Kachlik barva={b} size={56} />
        </button>
        <span class="kss-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="kss-stitek">Zmenšený · 32 · 24 · 16 px</p>
  <ul class="kss-radek kss-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="kss-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Kachlik barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="kss-stitek">V noci</p>
  <ul class="kss-radek kss-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kss-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Kachlik barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="kss-stitek">Vykukuje zpoza hrany</p>
  <ul class="kss-radek kss-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kss-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Kachlik barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="kss-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je který Kachlík: kachlíčky v těch barvách (ram je linka vnitřního rámečku), pravé úhly a bublinky jako ta ve vodováze */
  const KACHLE: Record<Barva, { kachle: string[]; ram: string; pocet: number; uhly: string[]; bubliny: string[] }> = {
    cerna: { kachle: ["#1E1A18", "#3A302A", "#2B2420"], ram: "rgba(255, 255, 255, 0.5)", pocet: 9, uhly: ["#1E1A18"], bubliny: ["#1E1A18"] },
    pruhledna: { kachle: ["#FFFFFF", "#CFE4F4", "#A9CBE2"], ram: "rgba(43, 36, 32, 0.26)", pocet: 9, uhly: ["#FFFFFF", "#A9CBE2"], bubliny: ["#BCE07A"] },
    zlata: { kachle: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], ram: "rgba(110, 74, 18, 0.5)", pocet: 10, uhly: ["#B8862A", "#F2C95E"], bubliny: ["#FFF2BC"] },
    logo: { kachle: ["#C4432B", "#C0708A", "#7A5E8E", "#3E3C78"], ram: "rgba(251, 233, 183, 0.6)", pocet: 10, uhly: ["#C4432B", "#7A5E8E", "#E2B95A"], bubliny: ["#C4432B"] },
  };
  const UHLU = 4;
  const BUBLIN = 3;
  /* tři velikosti kachlíčku (kss-kachel-a až c), ať nejsou všechny stejné */
  const TVARY = "abc";
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /** jedna částice: vyletí ze středu pod úhlem u a spadne; tize je, o kolik víc padá, než letí. Neotáčí se — o to se stará ten, kdo ji pouští. */
  function castice(kus: HTMLElement, trida: string, barva: string, u: number, vel: number, tize = 22) {
    const s = document.createElement("span");
    s.className = `kss-castice ${trida}`;
    const d = vel * (0.55 + Math.random() * 0.6);
    s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
    s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
    s.style.setProperty("--g", `${tize}px`);
    s.style.setProperty("--r", "0deg");
    s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
    s.style.setProperty("--b", barva);
    kus.append(s);
    window.setTimeout(() => s.remove(), 1700);
    return s;
  }

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = KACHLE[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    /* kachlíčky: rozletí se dokola a spadnou, ale rovně — žádný se cestou nenakloní */
    for (let i = 0; i < c.pocet; i++) {
      const k = castice(kus, `kss-kachel kss-kachel-${TVARY[i % TVARY.length]}`, c.kachle[i % c.kachle.length], (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5, vel * 0.9, 26);
      k.style.setProperty("--b2", c.ram);
    }
    /* pravé úhly: vyletí nahoru a točí se, ovšem jen o celé čtvrtky */
    for (let i = 0; i < UHLU; i++) {
      const p = castice(kus, "kss-uhel", c.uhly[i % c.uhly.length], -Math.PI / 2 + (i - (UHLU - 1) / 2) * 0.75 + Math.random() * 0.4, vel, 12);
      p.style.setProperty("--r", `${(1 + Math.floor(Math.random() * 3)) * (i % 2 ? 90 : -90)}deg`);
    }
    /* bublinky z vodováhy: stoupají jedna za druhou a nepadají */
    for (let i = 0; i < BUBLIN; i++) {
      const b = castice(kus, "kss-bublina", c.bubliny[i % c.bubliny.length], -Math.PI / 2 + (i - 1) * 0.5 + Math.random() * 0.2, vel * 1.1, -8);
      b.style.setProperty("--d", `${(1.05 + i * 0.15).toFixed(2)}s`);
      b.style.animationDelay = `${i * 90}ms`;
    }
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-kachlik-schovka] .kss-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Kachlíka na schovávanou; kachlíčky, pravé úhly a bublinky vyrábí skript, proto globálně */
  .kss {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .kss-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .kss-stitek:first-child { margin-top: 0; }
  .kss-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .kss-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .kss-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .kss-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černý schová skoro úplně */
  .kss-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Kachlík schovává a drží se jí ručkama; vodováha nad ni trčí první */
  .kss-hrana li { gap: 0; }
  .kss-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .kss-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .kss-hrana .kss-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .kss-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  /* co z něj vyletí: kachlíčky v jeho barvách, pravé úhly a bublinky; mimo animaci nejsou vidět, takže bublinky můžou vyletět se zpožděním */
  .kss-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    background: var(--b);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    animation: kss-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1);
  }
  @keyframes kss-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + var(--g, 22px))) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  /* kachlíček: čtverec s vnitřním rámečkem jako on; tři velikosti, nejmenší už rámeček nemá */
  .kss-kachel { border-radius: 1px; box-shadow: inset 0 0 0 1px var(--b), inset 0 0 0 2px var(--b2, transparent); }
  .kss-kachel-b { width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; }
  .kss-kachel-c { width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; box-shadow: none; }
  /* pravý úhel: dvě ramena vystřižená ze čtverce */
  .kss-uhel {
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    clip-path: polygon(0 0, 24% 0, 24% 76%, 100% 76%, 100% 100%, 0 100%);
  }
  /* bublinka z vodováhy: ležatý ovál, stoupá a nepadá */
  .kss-bublina {
    width: 8px;
    height: 5px;
    margin: -2.5px 0 0 -4px;
    border-radius: 50%;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.55);
    animation-timing-function: ease-out;
  }
</style>

---
/*
  Šamotka na schovávanou — vzorník pro /marcel, postavený stejně jako
  PecinkaSchovka.astro, BublinkaSchovka.astro, StripekSchovka.astro,
  HlinkaSchovka.astro, CedulkaSchovka.astro a KachlikSchovka.astro vedle.
  Samotná kresba je v ../schovka (Samotka.astro a samotka.ts) a je vždycky
  malá; tady jsou čtyři barvy vedle sebe: na papíře, zmenšené až na 16 px,
  ve tmě a jak vykukují zpoza hrany.

  Kliknutí ukáže, jak ji hra „najde“: vyskočí, cinkne (zvuk webu, zlatá
  zvoní výš) a rozletí se z ní úlomky šamotu — tuš, sklo, zlato nebo
  soumrak — s nimi jiskry z žáru pod ní a pár misek, které nesla.
*/
import Samotka from "../schovka/Samotka.astro";
import { NAZVY } from "../schovka/pecinka";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
---
<div class="sas" data-samotka-schovka>
  <p class="sas-stitek">Na papíře</p>
  <ul class="sas-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="sas-kus" data-barva={b} aria-label={`Šamotka na schovávanou — ${NAZVY[b]}`}>
          <Samotka barva={b} size={56} />
        </button>
        <span class="sas-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="sas-stitek">Zmenšená · 32 · 24 · 16 px</p>
  <ul class="sas-radek sas-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="sas-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Samotka barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="sas-stitek">V noci</p>
  <ul class="sas-radek sas-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="sas-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Samotka barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="sas-stitek">Vykukuje zpoza hrany</p>
  <ul class="sas-radek sas-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="sas-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Samotka barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="sas-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je která Šamotka: úlomky v těch barvách, jiskry jako v žáru pod ní a miska jako ta na zádech (okraj má jinou barvu) */
  const SAMOT: Record<Barva, { ulomky: string[]; pocet: number; jiskry: string[]; miska: [string, string] }> = {
    cerna: { ulomky: ["#1E1A18", "#3A302A", "#2B2420"], pocet: 9, jiskry: ["#1E1A18", "#3A302A"], miska: ["#1E1A18", "#6B5D4F"] },
    pruhledna: { ulomky: ["#FFFFFF", "#CFE4F4", "#A9CBE2"], pocet: 9, jiskry: ["#FFB45A", "#FF9A4A"], miska: ["#3A2E28", "#9A6236"] },
    zlata: { ulomky: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], pocet: 10, jiskry: ["#FFE08A", "#FFFFFF"], miska: ["#F2CF74", "#A9781E"] },
    logo: { ulomky: ["#C4432B", "#C0708A", "#7A5E8E", "#3E3C78"], pocet: 10, jiskry: ["#C4432B", "#C0708A", "#E2B95A"], miska: ["#2A2C5E", "#E2B95A"] },
  };
  const JISKER = 5;
  const MISEK = 2;
  /* tři velikosti úlomku (sas-ulomek-a až c), ať nejsou všechny stejné */
  const TVARY = "abc";
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /** jedna částice: vyletí ze středu pod úhlem u, otáčí se a spadne; tize je, o kolik víc padá, než letí */
  function castice(kus: HTMLElement, trida: string, barva: string, u: number, vel: number, tize = 22) {
    const s = document.createElement("span");
    s.className = `sas-castice ${trida}`;
    const d = vel * (0.55 + Math.random() * 0.6);
    s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
    s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
    s.style.setProperty("--g", `${tize}px`);
    s.style.setProperty("--r", `${Math.round(Math.random() * 540 - 270)}deg`);
    s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
    s.style.setProperty("--b", barva);
    kus.append(s);
    window.setTimeout(() => s.remove(), 1700);
    return s;
  }

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = SAMOT[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    /* úlomky šamotu jsou těžké: letí kousek a spadnou */
    for (let i = 0; i < c.pocet; i++) {
      castice(kus, `sas-ulomek sas-ulomek-${TVARY[i % TVARY.length]}`, c.ulomky[i % c.ulomky.length], (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5, vel * 0.85, 30);
    }
    /* jiskry z žáru: vyletí nahoru jedna za druhou a nepadají, zhasnou */
    for (let i = 0; i < JISKER; i++) {
      const j = castice(kus, "sas-jiskra", c.jiskry[i % c.jiskry.length], -Math.PI / 2 + (i - (JISKER - 1) / 2) * 0.5 + Math.random() * 0.3, vel * 1.1, -8);
      j.style.setProperty("--r", `${Math.round(Math.random() * 120 - 60)}deg`);
      j.style.setProperty("--d", `${(0.95 + i * 0.1).toFixed(2)}s`);
      j.style.animationDelay = `${i * 70}ms`;
    }
    /* misky, které nesla: vyletí do stran a kutálejí se dolů */
    for (let i = 0; i < MISEK; i++) {
      const m = castice(kus, "sas-miska", c.miska[0], -Math.PI / 2 + (i ? 0.8 : -0.8) + Math.random() * 0.3, vel, 20);
      m.style.setProperty("--b2", c.miska[1]);
    }
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-samotka-schovka] .sas-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Šamotky na schovávanou; úlomky, jiskry a misky vyrábí skript, proto globálně */
  .sas {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .sas-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .sas-stitek:first-child { margin-top: 0; }
  .sas-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .sas-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .sas-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .sas-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černá schová skoro úplně */
  .sas-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Šamotka schovává a drží se jí ručkama; miska na zádech nad ni kouká první */
  .sas-hrana li { gap: 0; }
  .sas-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .sas-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sas-hrana .sas-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .sas-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  /* co z ní vyletí: úlomky v jejích barvách, jiskry a misky; mimo animaci nejsou vidět, takže jiskry můžou vyletět se zpožděním */
  .sas-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 4px;
    margin: -2px 0 0 -4px;
    background: var(--b);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    animation: sas-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1);
  }
  @keyframes sas-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + var(--g, 22px))) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  /* úlomek šamotu: placatá destička jako ona, tři velikosti */
  .sas-ulomek { border-radius: 1.5px; }
  .sas-ulomek-b { width: 10px; height: 5px; margin: -2.5px 0 0 -5px; border-radius: 2px; }
  .sas-ulomek-c { width: 5px; height: 3px; margin: -1.5px 0 0 -2.5px; border-radius: 1px; }
  /* jiskra: čtyřcípá hvězdička, stoupá a nepadá */
  .sas-jiskra {
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    clip-path: polygon(50% 0, 59% 41%, 100% 50%, 59% 59%, 50% 100%, 41% 59%, 0 50%, 41% 41%);
    animation-timing-function: ease-out;
  }
  /* miska: půlka oválu s okrajem v druhé barvě */
  .sas-miska {
    width: 10px;
    height: 6px;
    margin: -3px 0 0 -5px;
    border-top: 1.6px solid var(--b2, var(--b));
    border-radius: 1px 1px 5px 5px / 1px 1px 5px 5px;
  }
</style>

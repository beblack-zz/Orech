---
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();

/*
  Kapka s bubny hromu (KapkaRaijin) v rukopisu risografu, jako
  dospele/Kapka.astro: dvě ploché soutiskové barvy posunuté proti sobě.
  Modrá ale rumělku kryje, aby postava zůstala modrá a druhá barva jen
  vykukovala na okraji. Barvy jsou z loga: noční modrá tiskne
  všechno, rumělka jen ujíždí vedle a barví pár míst. Světlo, tvář a kůže
  bubnů se netisknou, jsou vykryté do papíru.
*/
const MODRA = "#3F4C94";
const RUMELKA = "#C4432B";
const PAPIR = "#F4EBDD";
/* Jak moc ujel druhý průchod tiskem */
const UJETI = "translate(4 -3)";

const f = (n: number) => Math.round(n * 100) / 100;
const STRED = { x: 90, y: 64 };
const POLOMER = 48;
const bod = (uhel: number) => ({
  x: f(STRED.x + POLOMER * Math.cos((uhel * Math.PI) / 180)),
  y: f(STRED.y + POLOMER * Math.sin((uhel * Math.PI) / 180)),
});
const bubny = [-180, -120, -60, 0].map(bod);
const carka = "M0 -8.4 A8.4 8.4 0 0 1 8.11 -2.17 A6 6 0 0 0 0 -2.4 Z";
const telo = "M90 26 Q60 73 56 96 Q52 120 72 134 Q82 140 90 140 Q98 140 108 134 Q128 120 124 96 Q120 73 90 26 Z";
const geta = [71, 91];
const nasob = "mix-blend-mode:multiply";
---
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={cls} aria-hidden="true">
  <defs>
    {/* Kapka v barvách loga: nahoře noc, dole rumělka, jako obloha za soumraku a tah ensó */}
    <linearGradient id={`${u}-soumrak`} gradientUnits="userSpaceOnUse" x1="0" y1="26" x2="0" y2="146">
      <stop offset="0" stop-color="#2A2C5E" /><stop offset="0.3" stop-color="#4E4A84" /><stop offset="0.58" stop-color="#7A5E8E" /><stop offset="0.8" stop-color="#C0708A" /><stop offset="1" stop-color="#C4432B" />
    </linearGradient>
    <path id={`${u}-telo`} d={telo} />
    <clipPath id={`${u}-orez`}><use href={`#${u}-telo`} /></clipPath>
    <pattern id={`${u}-rastr`} width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.9" fill="#1E1A30" />
    </pattern>
    <pattern id={`${u}-rastr-jemny`} width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1" fill="#1E1A30" />
    </pattern>
    <g id={`${u}-tomoe`}>
      {[0, 120, 240].map((uh) => (
        <g transform={`rotate(${uh})`}>
          <path d={carka} />
          <circle cx="0" cy="-5.4" r="3" />
        </g>
      ))}
    </g>
  </defs>

  {/* ——— Druhý průchod: rumělka, ujetá doprava nahoru ——— */}
  <g transform={UJETI} opacity="0.9">
    <circle cx={STRED.x} cy={STRED.y} r={POLOMER} stroke={RUMELKA} stroke-width="2.2" />
    {bubny.map((p) => <circle cx={p.x} cy={p.y} r="15.4" fill={RUMELKA} />)}
    <use href={`#${u}-telo`} fill={RUMELKA} />
  </g>

  {/*
    ——— První průchod: modrá, tiskne všechno ———
    Bez násobení: modrá kryje rumělku, takže ta vykukuje jen tam, kam
    ujela, a celá postava zůstává modrá.
  */}
  <g>
    <circle cx={STRED.x} cy={STRED.y} r={POLOMER} stroke={MODRA} stroke-width="4" />
    {bubny.map((p, i) => (
      <g transform={`translate(${p.x} ${p.y})`}>
        <circle r="15.4" fill={MODRA} />
        {/* Kůže vykrytá do papíru, tomoe znovu modře, rumělka mu ujela */}
        <circle r="12" fill={PAPIR} />
        <g class="tomoe" style={`animation-delay:${-i * 1.7}s`}>
          <use href={`#${u}-tomoe`} transform="translate(1.6 -1.2) scale(1.3)" fill={RUMELKA} opacity="0.75" style={nasob} />
          <use href={`#${u}-tomoe`} transform="scale(1.3)" fill={MODRA} />
        </g>
      </g>
    ))}
    <use href={`#${u}-telo`} fill={`url(#${u}-soumrak)`} />
    <ellipse cx="52" cy="106" rx="7" ry="5" fill={`url(#${u}-soumrak)`} />
    <ellipse cx="128" cy="106" rx="7" ry="5" fill={`url(#${u}-soumrak)`} />
  </g>

  {/* Rastr místo stínu: hustý dole, řídký nad ním */}
  <g clip-path={`url(#${u}-orez)`} opacity="0.45">
    <rect x="40" y="108" width="100" height="40" fill={`url(#${u}-rastr)`} />
    <rect x="40" y="90" width="100" height="18" fill={`url(#${u}-rastr-jemny)`} />
  </g>

  {/* Vykrytý odlesk */}
  <g clip-path={`url(#${u}-orez)`}>
    <ellipse cx="74" cy="84" rx="6.4" ry="15" fill={PAPIR} transform="rotate(-18 74 84)" />
  </g>

  {/* Tvář vykrytá do papíru, rumělkový stín očí ujel stejně jako tvar */}
  <g class="tvar" clip-path={`url(#${u}-orez)`} stroke-linecap="round">
    <g stroke={RUMELKA} stroke-width="3" opacity="0.6" transform="translate(3 -2.5)" style={nasob}>
      <path d="M76 96 Q79 91.6 82 96" />
      <path d="M98 96 Q101 91.6 104 96" />
    </g>
    <g stroke={PAPIR} stroke-width="3">
      <path d="M76 96 Q79 91.6 82 96" />
      <path d="M98 96 Q101 91.6 104 96" />
      <path d="M83 108 Q90 114 97 108" />
    </g>
  </g>

  {/* Geta: deska v rumělce, zuby modře, pásky vykryté */}
  <g style={nasob}>
    {geta.map((x) => (
      <g>
        <path d={`M${x + 2.4} 152.2 H${x + 6} V159.2 H${x + 2.4} Z M${x + 12} 152.2 H${x + 15.6} V159.2 H${x + 12} Z`} fill={MODRA} />
        <rect x={x + 2} y="144.4" width="18" height="6.4" rx="1.4" fill={RUMELKA} opacity="0.85" />
        <rect x={x} y="146" width="18" height="6.4" rx="1.4" fill={MODRA} opacity="0.55" />
      </g>
    ))}
    <ellipse cx="80" cy="142" rx="8" ry="4" fill={MODRA} />
    <ellipse cx="100" cy="142" rx="8" ry="4" fill={MODRA} />
  </g>
  <path d="M73.6 146 Q80 138.6 86.4 146 M93.6 146 Q100 138.6 106.4 146" stroke={PAPIR} stroke-width="1.9" stroke-linecap="round" />

  {/* Kapky deště a stín jako plochy druhé barvy */}
  <path d="M22 132 Q18.6 138 18.6 140.4 Q18.6 143.6 22 143.6 Q25.4 143.6 25.4 140.4 Q25.4 138 22 132 Z" fill={MODRA} opacity="0.8" />
  <path d="M158 138 Q155.4 142.6 155.4 144.4 Q155.4 147 158 147 Q160.6 147 160.6 144.4 Q160.6 142.6 158 138 Z" fill={RUMELKA} opacity="0.7" />
  <ellipse cx="96" cy="161" rx="30" ry="5" fill={RUMELKA} opacity="0.3" style={nasob} />
</svg>

<style>
  .tomoe { animation: tomoe 14s linear infinite; }
  @keyframes tomoe { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .tomoe { animation: none; } }
</style>

---
/*
  Hlínka na schovávanou — vzorník pro /marcel (čtvrtá podoba Hlínky),
  postavený stejně jako PecinkaSchovka.astro, BublinkaSchovka.astro
  a StripekSchovka.astro vedle. Samotná kresba je v ../schovka (Hlinka.astro
  a hlinka.ts) a je vždycky malá; tady jsou čtyři barvy vedle sebe: na
  papíře, zmenšené až na 16 px, ve tmě a jak vykukují zpoza hrany.

  Kliknutí ukáže, jak ji hra „najde“: vyskočí, cinkne (zvuk webu, zlatá
  zvoní výš) a rozletí se z ní hrudky — tuš, sklo, zlato nebo soumrak —
  s nimi pár lístků z výhonku a zetka, která jí někdo vyplašil ze spaní.
*/
import Hlinka from "../schovka/Hlinka.astro";
import { NAZVY } from "../schovka/pecinka";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
---
<div class="hss" data-hlinka-schovka>
  <p class="hss-stitek">Na papíře</p>
  <ul class="hss-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="hss-kus" data-barva={b} aria-label={`Hlínka na schovávanou — ${NAZVY[b]}`}>
          <Hlinka barva={b} size={56} />
        </button>
        <span class="hss-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="hss-stitek">Zmenšená · 32 · 24 · 16 px</p>
  <ul class="hss-radek hss-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="hss-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Hlinka barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="hss-stitek">V noci</p>
  <ul class="hss-radek hss-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="hss-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Hlinka barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="hss-stitek">Vykukuje zpoza hrany</p>
  <ul class="hss-radek hss-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="hss-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Hlinka barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="hss-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je která Hlínka: hrudky v těch barvách, lístky jako její výhonek a zetka jako ta nad hlavou */
  const HLINA: Record<Barva, { hrudky: string[]; pocet: number; listky: string[]; zetka: string[] }> = {
    cerna: { hrudky: ["#1E1A18", "#3A302A", "#2B2420"], pocet: 9, listky: ["#1E1A18", "#3A302A"], zetka: ["#1E1A18"] },
    pruhledna: { hrudky: ["#FFFFFF", "#CFE4F4", "#A9CBE2"], pocet: 9, listky: ["#A8C58A", "#CFE0BC"], zetka: ["#FFFFFF", "#A9CBE2"] },
    zlata: { hrudky: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], pocet: 10, listky: ["#F2CF74", "#FFF6D2"], zetka: ["#B8862A", "#F2C95E"] },
    logo: { hrudky: ["#C4432B", "#C0708A", "#7A5E8E", "#3E3C78"], pocet: 10, listky: ["#FBE9B7", "#E2B95A"], zetka: ["#C4432B", "#C0708A", "#7A5E8E"] },
  };
  const LISTKU = 4;
  const ZETEK = 3;
  /* tři tvary hrudky (hss-hrudka-a až c), ať nejsou všechny stejné */
  const TVARY = "abc";
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /** jedna částice: vyletí ze středu pod úhlem u, otáčí se a spadne; tize je, o kolik víc padá, než letí */
  function castice(kus: HTMLElement, trida: string, barva: string, u: number, vel: number, tize = 22) {
    const s = document.createElement("span");
    s.className = `hss-castice ${trida}`;
    const d = vel * (0.55 + Math.random() * 0.6);
    s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
    s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
    s.style.setProperty("--g", `${tize}px`);
    s.style.setProperty("--r", `${Math.round(Math.random() * 540 - 270)}deg`);
    s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
    s.style.setProperty("--b", barva);
    kus.append(s);
    window.setTimeout(() => s.remove(), 1700);
    return s;
  }

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = HLINA[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    /* hrudky jsou těžké: letí kousek a spadnou */
    for (let i = 0; i < c.pocet; i++) {
      castice(kus, `hss-hrudka hss-hrudka-${TVARY[i % TVARY.length]}`, c.hrudky[i % c.hrudky.length], (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5, vel * 0.85, 30);
    }
    /* lístky jsou lehké: vyletí výš a snášejí se */
    for (let i = 0; i < LISTKU; i++) {
      castice(kus, "hss-listek", c.listky[i % c.listky.length], -Math.PI / 2 + (i - (LISTKU - 1) / 2) * 0.7 + Math.random() * 0.4, vel, 10);
    }
    /* zetka: vyplašená ze spaní uletí nahoru doprava, jedno za druhým, a nepadají */
    for (let i = 0; i < ZETEK; i++) {
      const z = castice(kus, "hss-zet", c.zetka[i % c.zetka.length], -Math.PI / 4 - i * 0.28 + Math.random() * 0.2, vel * 1.1, -8);
      z.textContent = "z";
      z.style.setProperty("--r", `${Math.round(Math.random() * 40 - 20)}deg`);
      z.style.setProperty("--d", `${(1.1 + i * 0.15).toFixed(2)}s`);
      z.style.animationDelay = `${i * 90}ms`;
      z.style.fontSize = `${10 + i * 2}px`;
    }
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-hlinka-schovka] .hss-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Hlínky na schovávanou; hrudky, lístky a zetka vyrábí skript, proto globálně */
  .hss {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .hss-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .hss-stitek:first-child { margin-top: 0; }
  .hss-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .hss-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .hss-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .hss-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černá schová skoro úplně */
  .hss-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Hlínka schovává a drží se jí ručkama; výhonek nad ni trčí první */
  .hss-hrana li { gap: 0; }
  .hss-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .hss-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .hss-hrana .hss-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .hss-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  /* co z ní vyletí: hrudky v jejích barvách, lístky z výhonku a zetka; mimo animaci nejsou vidět, takže zetka můžou vyletět se zpožděním */
  .hss-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    background: var(--b);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    animation: hss-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1);
  }
  @keyframes hss-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + var(--g, 22px))) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  /* hrudky: oblé a nepravidelné, tři tvary a velikosti */
  .hss-hrudka-a { border-radius: 58% 42% 55% 45% / 48% 60% 40% 52%; }
  .hss-hrudka-b { width: 9px; height: 7px; margin: -3.5px 0 0 -4.5px; border-radius: 44% 56% 38% 62% / 60% 44% 56% 40%; }
  .hss-hrudka-c { width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; border-radius: 50% 50% 46% 54% / 56% 48% 52% 44%; }
  /* lístek: dva špičaté rohy a dva oblé */
  .hss-listek { width: 9px; height: 6px; margin: -3px 0 0 -4.5px; border-radius: 0 80% 0 80%; }
  /* zetko je písmeno, ne tvar: barvu má v písmu a nepadá, stoupá */
  .hss-zet {
    width: auto;
    height: auto;
    margin: -0.6em 0 0 -0.3em;
    background: none;
    color: var(--b);
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 700;
    line-height: 1;
    animation-timing-function: ease-out;
  }
</style>

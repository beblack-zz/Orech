---
/*
  Vázička jako gejša — podle Střípka a zlata, Pecinky s ohněm a Bublinky jako
  strašidla. Kresby i běh jsou ve scripts/vazicka-gejsa:

    kvety     01 Kami: stojí před kruhem ze značky a má ve vlasech i ve váze
              květy měsíce; kliknutí ji zatočí dokola a vymění jí je za další
    tycinka   02 Tušový lem: dokud hoří vonná tyčinka, tančí s vějířem a kouř
              se za ním stáčí do tvarů; svítí jen ten kouř
    destnik   02 Tušový lem (druhý návrh): noční déšť, stojí zády na můstku
              pod papírovým deštníkem janome, jehož kruh svítí jako ensó
    lampion   03 Lampion: jde na večer s papírovou lucernou, bez pozadí
              a trochu z boku — kráčí na místě, po cestě ji posouvá stránka
              jako průvod na Domku 2

    let       01 Kami v letu: tatáž Vázička bez kruhu — průvodce v rohu
              každé stránky (scripts/parta2/pruvodce.ts)

  Čtvrtá podoba, Na schovávanou, je VazickaSchovka.astro.

  Vázička je tsukumogami: nejstarší kus v dílně. Jako gejša je pořád váza —
  hrdlo je černá glazura a zároveň účes, tělo bílý porcelán jako líčení,
  kimono a obi jsou namalované na břiše. Tělo je rotační, takže se umí
  otočit: zezadu je vidět mašle obi a holý zátylek.

  Kresba je čistý generátor bez DOM, takže první snímek se vykreslí už při
  sestavení stránky a vloží se sem jako obyčejné SVG — plocha tak není
  prázdná, než se načte skript, a bez skriptu zůstane hezký obrázek. Skript
  ho pak nahradí živými vrstvami. Id ve filtrech jsou pevná (vg1-, vg2-,
  vg3-, vgl-), takže každá podoba smí být na stránce jen jednou.
*/
import { kresby, celeSvg, pretoc } from "../../../scripts/vazicka-gejsa/kresby.js";

interface Props { varianta: "kvety" | "let" | "tycinka" | "destnik" | "lampion"; class?: string; }
const { varianta, class: cls = "" } = Astro.props;
const popisy = {
  kvety: "Vázička jako gejša: bílá váza s černým hrdlem místo účesu, v kimonu s červeným pásem obi, ve vlasech a v hrdle má květy sakury; za ní stojí kruh ensó namalovaný jedním tahem štětce v barvách soumraku",
  let: "Vázička jako gejša, bílá váza s černým hrdlem místo účesu a s květy ve vlasech, létá nad loukou a schovává se za strom, za dům a do trávy",
  tycinka: "Noc v rozpité tuši: Vázička jako gejša tančí s vějířem, dole na papíře hoří vonná tyčinka a její kouř, jediné, co svítí, se za vějířem stáčí do tvarů",
  destnik: "Noční déšť v rozpité tuši: Vázička jako gejša stojí zády na obloukovém můstku pod papírovým deštníkem, jehož světlý kruh svítí do tmy",
  lampion: "Vázička jako gejša jde v dřevácích okobo a nese papírovou lucernu se znakem sakury; rukávy a šňůry ve vlasech se jí houpou do kroku",
};
const V = kresby[varianta];
const prvniSnimek = celeSvg(V, V.klidne.t, pretoc(V, V.klidne.t), {}, { pozadi: null, trida: "vg-staticky" });
---
<div class={`vazicka-gejsa ${cls}`} data-vazicka-gejsa={varianta} tabindex="0" role="img" aria-label={popisy[varianta]} set:html={prvniSnimek}></div>

<script>
  import "../../../scripts/vazicka-gejsa/beh.js";
</script>

<style is:global>
  /* Vrstvy vyrábí skript, proto globálně */
  .vazicka-gejsa {
    position: relative;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .vazicka-gejsa:focus-visible { outline: 2px solid #C4432B; outline-offset: 8px; border-radius: 12px; }
  .vg-staticky, .vg-vrstva {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .vg-defs { position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none; }
</style>

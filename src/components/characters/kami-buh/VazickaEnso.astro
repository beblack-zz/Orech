          </g>
        )}
        {tvar === "kintsugi" && (
          <>
            {/* Kintsugi: oči a úsměv jako zlaté spáry, jedna prasklina utíká po tváři */}
            <g stroke="#8E6A1E" stroke-width="2.8">
              <path d="M80 90 L83 86.6 L86 90 M94 90 L97 86.6 L100 90" />
              <path d="M85 102 L87.6 104.6 L90 103 L92.4 104.6 L95 102" />

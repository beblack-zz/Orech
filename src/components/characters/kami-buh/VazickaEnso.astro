    <path d="M71.4 141.8 C72 137.4 75.4 136.8 77.8 140 M108.6 141.8 C108 137.4 104.6 136.8 102.2 140" stroke="#C4432B" stroke-width="2" stroke-linecap="round" fill="none" />

        )}
        {tvar === "kocici" && (
          <>
            <path d="M80 90 Q83 86 86 90 M94 90 Q97 86 100 90" stroke-width="2" />
            <path d="M85.6 101.6 Q87.8 105.2 90 102.4 Q92.2 105.2 94.4 101.6" stroke-width="1.6" />

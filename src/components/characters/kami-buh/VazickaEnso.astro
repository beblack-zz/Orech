<style>
  /* Kresba nese rozměr, logo leží pod ní vycentrované na hrdlo */
  .vazicka-enso { position: relative; display: block; aspect-ratio: 1; }
  .ve-kresba { position: relative; display: block; width: 100%; height: 100%; }
  .ve-logo { position: absolute; left: calc(50% - var(--logo) / 2); top: calc(34% - var(--logo) / 2); width: var(--logo); line-height: 0; }
  .ve-logo :global(svg) { width: 100%; height: auto; }
  /* Den a noc i bez LogoEnso na stránce */
  .ve-logo.logo-noc { display: none; }
  :global(:root[data-tema="noc"]) .ve-logo.logo-den { display: none; }
  :global(:root[data-tema="noc"]) .ve-logo.logo-noc { display: block; }
</style>

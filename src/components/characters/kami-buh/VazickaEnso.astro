---
import { uid } from "../dospele/uid";
import Enso from "../../navrhy-loga/Enso.astro";

interface Props {
  class?: string;
  size?: number;
  /** Dřevěná geta pod vázou (jdou kombinovat s mašlí). */
  geta?: boolean;
  /** Pás obi a velká mašle za zády v barvách loga. */
  masle?: boolean;
  /** Tvářička: původní, nebo jeden z návrhů z /marcel. */
  tvar?: "original" | "klidna" | "otevrena" | "mrk" | "gejsa" | "no" | "stydliva" | "prisna" | "udivena" | "ospala" | "kocici"
    | "kawaii" | "tus" | "kaomoji" | "daruma" | "kokeshi" | "kabuki" | "kodama" | "otafuku" | "sashiko" | "kintsugi";
}
const { class: cls = "", size = 64, geta = false, masle = false, tvar = "original" } = Astro.props;
const u = uid();

/*
  Vázička jako kami: původní kresba (characters/Vazicka.astro) a za ní
  jako svatozář skutečné logo, ensó v soumraku z navrhy-loga/Enso.astro.
  Logo leží pod kresbou jako samostatné SVG, ve dne světlé, v nočním
  tématu tmavé (třídy logo-den a logo-noc z LogoEnso). Kruh loga má
  poloměr 68 z 200; aby sedl kolem hrdla a květin (střed 90, 66 z 180),
  zabírá logo 84 % šířky postavičky a jeho střed sedí na 34 % výšky.
*/
const obrys = "M71 44 Q75 47 76 54 C66 61 56 78 55 106 C54 130 68 150 82 150 L98 150 C112 150 126 130 125 106 C124 78 114 61 104 54 Q105 47 109 44 Q90 40 71 44 Z";
const listek = "M0 0 C-2.5 -1.5 -4.1 -3.9 -4.2 -6.6 C-4.3 -9.4 -3.1 -11.5 -1.9 -12.6 L0 -9.5 L1.9 -12.6 C3.1 -11.5 4.3 -9.4 4.2 -6.6 C4.1 -3.9 2.5 -1.5 0 0 Z";
const jiskra = "M0,-7 Q1.8,-1.8 7,0 Q1.8,1.8 0,7 Q-1.8,1.8 -7,0 Q-1.8,-1.8 0,-7 Z";
const platky = [0, 72, 144, 216, 288];
const f = (n: number) => Math.round(n * 100) / 100;
const LOGO = 0.84;
const logoPx = Math.round(size * LOGO);

/* Na geta váza stojí o výšku zubů výš */
const zdvih = geta ? "translate(0 -8.4)" : undefined;

/*
  Mašle je oblečení: kolem břicha pás obi se šňůrkou, za zády uvázaná
  velká motýlí mašle (chōchō musubi). Zepředu jsou vidět jen smyčky
  a cípy, které vykukují zpoza těla. Kreslí se levá polovina, pravá je
  zrcadlo souřadnic — ne transformace, aby přechod šel přes obě strany
  jedním směrem, z rumělky do noci.
*/
const zrcadli = (d: string) => {
  let x = true;
  return d.replace(/-?\d+(\.\d+)?/g, (n) => {
    const v = x ? String(f(180 - Number(n))) : n;
    x = !x;
    return v;
  });
};
const masleL = {
  smycka: "M66 127 C58 117 44 110 34 113 C27 115.4 27 124 32 128 C40 133 54 132 66 130 Z",
  vnitrek: "M62 126.6 C55 120.4 46.4 116.6 39.4 118 C35.6 118.8 35.4 122.8 38.4 125 C45 128.4 54 128.8 62 126.6 Z",
  spodni: "M66 131 C58 134 47 139.6 41 146 C38.4 149 41.4 151.6 45 149.8 C52 146 60 139 67 134 Z",
  cip: "M64.6 133 C59 140.6 55 147.4 52.6 153.6 L57.2 151 L60.4 155 C62.4 147.6 65.6 140.4 68.4 134 Z",
  sklady: "M66 128.6 C56 123.6 46 120 37 119.6 M66 129.4 C57 128.4 47 127.6 38.6 126.4 M66 132 C59 136 52 141 46 146.6",
  lesk: "M35.6 114 C43.6 111.2 53.6 114.6 61.6 120.8",
};
const masleP = Object.fromEntries(Object.entries(masleL).map(([k, d]) => [k, zrcadli(d)])) as typeof masleL;
const getaX = [70.6, 91.4];
---
<span class={`vazicka-enso ${cls}`} style={`--logo:${LOGO * 100}%`}>
<span class="ve-logo logo-den"><Enso size={logoPx} soumrak /></span>
<span class="ve-logo logo-noc"><Enso size={logoPx} soumrak tema="tmave" /></span>
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class="ve-kresba" aria-hidden="true">
  <defs>
    <linearGradient id={`${u}-g`} gradientUnits="userSpaceOnUse" x1="0" y1="0.5" x2="0" y2="-12.6">
      <stop offset="0" stop-color="#9E4025" /><stop offset="0.45" stop-color="#B84A2B" /><stop offset="1" stop-color="#CF846F" />
    </linearGradient>
    <path id={`${u}-l`} fill={`url(#${u}-g)`} d={listek} />
    <g id={`${u}-kvet`}>{platky.map((a) => <use href={`#${u}-l`} transform={`rotate(${a}) translate(0 -1.7)`} />)}</g>
    <clipPath id={`${u}-telo`}><path d={obrys} /></clipPath>
    {/* Smyčky jsou ve vnějších souřadnicích, pás uvnitř zmenšené vázy — proto dva přechody */}
    <linearGradient id={`${u}-masle`} gradientUnits="userSpaceOnUse" x1="28" y1="0" x2="152" y2="0">
      <stop offset="0" stop-color="#C4432B" /><stop offset="0.35" stop-color="#C0708A" /><stop offset="0.68" stop-color="#7A5E8E" /><stop offset="1" stop-color="#4E4A84" />
    </linearGradient>
    <linearGradient id={`${u}-obi`} gradientUnits="userSpaceOnUse" x1="44" y1="0" x2="136" y2="0">
      <stop offset="0" stop-color="#C4432B" /><stop offset="0.35" stop-color="#C0708A" /><stop offset="0.68" stop-color="#7A5E8E" /><stop offset="1" stop-color="#4E4A84" />
    </linearGradient>
  </defs>

  {geta && (
    <g stroke="#6B5D4F" stroke-linejoin="round">
      {/* Dvě dřevěná geta: deska, dva zuby a rumělkový pásek */}
      {getaX.map((x) => (
        <g>
          <path d={`M${x + 2.4} 147.8 H${x + 6} V154.8 H${x + 2.4} Z M${x + 12} 147.8 H${x + 15.6} V154.8 H${x + 12} Z`} fill="#8C6444" stroke-width="0.9" />
          <rect x={x} y="141.8" width="18" height="6.4" rx="1.4" fill="#C99A68" stroke-width="1.1" />
          <path d={`M${x + 1.4} 143.6 H${x + 16.6}`} stroke="#E2BE8C" stroke-width="0.9" stroke-linecap="round" />
          <path d={`M${x + 2} 146.4 C${x + 6} 145.8 ${x + 12} 146.8 ${x + 16} 146.2`} stroke="#A97B4E" stroke-width="0.5" fill="none" />
        </g>
      ))}
    </g>
  )}

  <g class="char-sway">
  <g transform={zdvih}>
    {masle && (
      <g stroke="#6B5D4F" stroke-width="1" stroke-linejoin="round" stroke-linecap="round">
        {/* Mašle za zády: cípy, spodní smyčky, horní smyčky s vnitřkem, sklady a lesk látky */}
        {[masleL, masleP].map((m) => (
          <g>
            <path d={m.cip} fill={`url(#${u}-masle)`} />
            <path d={m.spodni} fill={`url(#${u}-masle)`} />
            <path d={m.smycka} fill={`url(#${u}-masle)`} />
            <path d={m.vnitrek} fill="#2B2420" opacity="0.22" stroke="none" />
            <path d={m.sklady} stroke="#2B2420" stroke-width="0.7" opacity="0.3" />
            <path d={m.lesk} stroke="#FFF4E6" stroke-width="1.4" opacity="0.5" />
          </g>
        ))}
      </g>
    )}
    <g transform="translate(90 150) scale(0.82) translate(-90 -150)">
      <path d={obrys} fill="#EFE3D0" stroke="#6B5D4F" stroke-width="1.5" />
      <g clip-path={`url(#${u}-telo)`} stroke="#6B5D4F" stroke-linecap="round">
        <path d="M84 55 C62 84 62 122 85 150" stroke-width="5" opacity="0.09" />
        <path d="M69 62 C58 88 58 118 67 143" stroke-width="4.5" opacity="0.08" />
        <path d="M96 55 C118 84 118 122 95 150" stroke-width="5" opacity="0.09" />
        <path d="M111 62 C122 88 122 118 113 143" stroke-width="4.5" opacity="0.08" />
      </g>
      {masle && (
        <g clip-path={`url(#${u}-telo)`} stroke-linecap="round">
          {/* Pás obi kolem břicha: látka v barvách loga, dva sklady, šňůrka obijime */}
          <path d="M44 117 Q90 126 136 117 L136 133 Q90 142 44 133 Z" fill={`url(#${u}-obi)`} />
          <path d="M44 117.6 Q90 126.6 136 117.6" stroke="#FFF4E6" stroke-width="1.2" opacity="0.4" />
          <path d="M44 121.6 Q90 130.6 136 121.6 M44 129 Q90 138 136 129" stroke="#2B2420" stroke-width="0.8" opacity="0.22" />
          <path d="M44 125.4 Q90 134.4 136 125.4" stroke="#E8B440" stroke-width="2" />
          <path d="M44 126.6 Q90 135.6 136 126.6" stroke="#9E7A2A" stroke-width="0.5" opacity="0.7" />
          <path d="M44 117 Q90 126 136 117 M44 133 Q90 142 136 133" stroke="#6B5D4F" stroke-width="1.3" />
        </g>
      )}
      {/* Tmavé hrdlo: stonek mizí do vázy, ne za ni */}
      <ellipse cx="90" cy="43.6" rx="16" ry="2.2" fill="#6B5D4F" opacity="0.55" />
      <g class="tvar" stroke="#3A2E28" stroke-linecap="round" stroke-linejoin="round">
        {tvar === "original" && (
          <>
            <path d="M80 90 Q83 86 86 90" stroke-width="2" />
            <path d="M96 90 Q99 86 102 90" stroke-width="2" />
            <path d="M85 102 Q90 107 95 102" stroke-width="1.8" />
          </>
        )}
        {tvar === "klidna" && (
          <>
            {/* Zavřená víčka prohnutá dolů, jako spící Buddha */}
            <path d="M79.6 89 Q83 92.4 86.4 89 M95.6 89 Q99 92.4 102.4 89" stroke-width="1.8" />
            <path d="M79.6 89 L78.4 88.2 M102.4 89 L103.6 88.2" stroke-width="1.1" />
            <path d="M88 103.4 Q90 104.8 92 103.4" stroke-width="1.5" />
          </>
        )}
        {tvar === "otevrena" && (
          <>
            <ellipse cx="83" cy="89" rx="2.4" ry="3.1" fill="#3A2E28" stroke="none" />
            <ellipse cx="99" cy="89" rx="2.4" ry="3.1" fill="#3A2E28" stroke="none" />
            <circle cx="83.8" cy="87.9" r="0.9" fill="#FFF8EC" stroke="none" />
            <circle cx="99.8" cy="87.9" r="0.9" fill="#FFF8EC" stroke="none" />
            <path d="M86.6 102 Q90 105.4 93.4 102" stroke-width="1.7" />
          </>
        )}
        {tvar === "mrk" && (
          <>
            <ellipse cx="83" cy="89" rx="2.3" ry="3" fill="#3A2E28" stroke="none" />
            <circle cx="83.8" cy="87.9" r="0.85" fill="#FFF8EC" stroke="none" />
            <path d="M96 90 Q99 86 102 90" stroke-width="2" />
            <path d="M86 102.6 Q90 105.2 94.6 101.4" stroke-width="1.7" />
            <ellipse cx="104" cy="97.6" rx="4" ry="2.4" fill="#E8A79A" opacity="0.45" stroke="none" />
          </>
        )}
        {tvar === "gejsa" && (
          <>
            {/* Oshiroi, vysoké obočí, rumělka v koutcích a malá poupátková ústa */}
            <defs>
              <radialGradient id={`${u}-oshiroi`}>
                <stop offset="0" stop-color="#FFFDF9" /><stop offset="0.62" stop-color="#FDFAF4" /><stop offset="1" stop-color="#FDFAF4" stop-opacity="0" />
              </radialGradient>
            </defs>
            <ellipse cx="90" cy="94" rx="23" ry="21" fill={`url(#${u}-oshiroi)`} stroke="none" />
            <ellipse cx="82.6" cy="87.2" rx="4.4" ry="1.8" fill="#EBA3A3" stroke="none" opacity="0.55" />
            <ellipse cx="97.4" cy="87.2" rx="4.4" ry="1.8" fill="#EBA3A3" stroke="none" opacity="0.55" />
            <path d="M78.4 81.6 Q82.6 79.4 86.6 80.8 M93.4 80.8 Q97.4 79.4 101.6 81.6" stroke-width="1.1" />
            <path d="M79 89.6 Q83 87.8 87 89.2 M93 89.2 Q97 87.8 101 89.6" stroke-width="1.7" />
            <path d="M79 89.6 Q77.2 88.8 76 87.2 M101 89.6 Q102.8 88.8 104 87.2" stroke="#C4432B" stroke-width="1.3" />
            <path d="M88.2 103 Q90 106 91.8 103 Q90 103.9 88.2 103 Z" fill="#C4432B" stroke="#C4432B" stroke-width="0.6" />
            <path d="M89 102.4 Q90 101.6 91 102.4" stroke="#C4432B" stroke-width="0.9" />
            <ellipse cx="78" cy="98.4" rx="3.6" ry="2" fill="#F2C3C3" stroke="none" opacity="0.5" />
            <ellipse cx="102" cy="98.4" rx="3.6" ry="2" fill="#F2C3C3" stroke="none" opacity="0.5" />
          </>
        )}
        {tvar === "no" && (
          <>
            {/* Maska nó ko-omote: obočí hikimayu vysoko, oči štěrbiny, ústa s černěnými zuby */}
            <ellipse cx="82.4" cy="79.6" rx="3" ry="1.5" fill="#3A2E28" stroke="none" opacity="0.45" />
            <ellipse cx="97.6" cy="79.6" rx="3" ry="1.5" fill="#3A2E28" stroke="none" opacity="0.45" />
            <path d="M79.4 89.4 Q83 87.4 86.8 89.2 Q83 90.8 79.4 89.4 Z M93.2 89.2 Q97 87.4 100.6 89.4 Q97 90.8 93.2 89.2 Z" fill="#2B2420" stroke="none" />
            <path d="M86.2 102.6 Q90 100.8 93.8 102.6 Q90 106 86.2 102.6 Z" fill="#C4432B" stroke="none" />
            <path d="M87.4 102.9 Q90 104 92.6 102.9" stroke="#2B2420" stroke-width="1" />
          </>
        )}
        {tvar === "stydliva" && (
          <>
            <path d="M80 90 Q83 86.6 86 90 M96 90 Q99 86.6 102 90" stroke-width="1.9" />
            <ellipse cx="78.6" cy="97.4" rx="5.4" ry="3.2" fill="#E89A92" stroke="none" opacity="0.55" />
            <ellipse cx="101.4" cy="97.4" rx="5.4" ry="3.2" fill="#E89A92" stroke="none" opacity="0.55" />
            <path d="M76.4 98.6 L78 96 M79 98.6 L80.6 96 M99.4 98.6 L101 96 M102 98.6 L103.6 96" stroke="#C4645A" stroke-width="0.8" />
            <path d="M86.6 103 Q88.2 101.4 90 103 Q91.8 104.6 93.4 103" stroke-width="1.5" />
          </>
        )}
        {tvar === "prisna" && (
          <>
            {/* Sensei, když se hrbíš: obočí dolů, víčka napůl, ústa rovně */}
            <path d="M78.4 83 L86.8 85.4 M101.6 83 L93.2 85.4" stroke-width="1.7" />
            <path d="M79.4 88.6 H86.6 M93.4 88.6 H100.6" stroke-width="1.8" />
            <path d="M80.8 88.6 A2.2 2.2 0 0 0 85.2 88.6 Z M94.8 88.6 A2.2 2.2 0 0 0 99.2 88.6 Z" fill="#3A2E28" stroke="none" />
            <path d="M87 103.6 H93" stroke-width="1.7" />
          </>
        )}
        {tvar === "udivena" && (
          <>
            <path d="M78.6 82 Q83 78.6 87.4 81.4 M92.6 81.4 Q97 78.6 101.4 82" stroke-width="1.3" />
            <circle cx="83" cy="89" r="3.3" fill="#FFF8EC" stroke-width="1.3" />
            <circle cx="97" cy="89" r="3.3" fill="#FFF8EC" stroke-width="1.3" />
            <circle cx="83" cy="89.2" r="1.5" fill="#3A2E28" stroke="none" />
            <circle cx="97" cy="89.2" r="1.5" fill="#3A2E28" stroke="none" />
            <ellipse cx="90" cy="104" rx="2.2" ry="2.8" fill="#3A2E28" stroke="none" />
          </>
        )}
        {tvar === "ospala" && (
          <>
            <path d="M79.6 90 Q83 91.6 86.4 90 M93.6 90 Q97 91.6 100.4 90" stroke-width="1.6" />
            <path d="M88.4 103 Q90 105.8 91.6 103 Z" fill="#3A2E28" stroke-width="1.1" />
            <path d="M106 78 H110 L106 82 H110 M112 70.6 H115 L112 73.6 H115" stroke="#8A7C70" stroke-width="1.1" />
          </>
        )}
        {/* ——— Druhá desítka: jiný rukopis, ne jiný výraz ——— */}
        {tvar === "kawaii" && (
          <>
            <ellipse cx="83" cy="89.4" rx="3.3" ry="4.1" fill="#3A2E28" stroke="none" />
            <ellipse cx="97" cy="89.4" rx="3.3" ry="4.1" fill="#3A2E28" stroke="none" />
            <circle cx="84.2" cy="87.8" r="1.35" fill="#FFFFFF" stroke="none" />
            <circle cx="98.2" cy="87.8" r="1.35" fill="#FFFFFF" stroke="none" />
            <circle cx="82" cy="91.4" r="0.65" fill="#FFFFFF" stroke="none" />
            <circle cx="96" cy="91.4" r="0.65" fill="#FFFFFF" stroke="none" />
            <path d="M88 102.6 Q90 106 92 102.6 Z" fill="#B8574A" stroke-width="1.1" />
            <ellipse cx="77.6" cy="97.6" rx="3.8" ry="2.2" fill="#F0A7A0" stroke="none" opacity="0.55" />
            <ellipse cx="102.4" cy="97.6" rx="3.8" ry="2.2" fill="#F0A7A0" stroke="none" opacity="0.55" />
          </>
        )}
        {tvar === "tus" && (
          <g fill="#1F1A17" stroke="none">
            {/* Tahy štětcem: na začátku přítlak, konec se vytahuje do špičky */}
            <path d="M79 90.4 C81 86.6 85.2 86.8 87.4 89.8 C85.2 88.6 81.6 88.8 79 90.4 Z" />
            <path d="M101 90.4 C99 86.6 94.8 86.8 92.6 89.8 C94.8 88.6 98.4 88.8 101 90.4 Z" />
            <path d="M85.4 102.2 C87.6 105.8 92.6 105.6 94.8 101.6 C92.4 104.2 88.2 104.4 85.4 102.2 Z" />
            <circle cx="85.2" cy="102.3" r="0.9" />
          </g>
        )}
        {tvar === "kaomoji" && (
          <>
            {/* ◕‿◕ — oči jako znaky, ne jako kresba */}
            <circle cx="83" cy="89" r="3.2" fill="#FFF8EC" stroke-width="1.2" />
            <circle cx="97" cy="89" r="3.2" fill="#FFF8EC" stroke-width="1.2" />
            <path d="M83 89 V85.8 A3.2 3.2 0 1 1 79.8 89 Z M97 89 V85.8 A3.2 3.2 0 1 1 93.8 89 Z" fill="#3A2E28" stroke="none" />
            <path d="M86 101.4 Q90 106.2 94 101.4" stroke-width="1.4" />
          </>
        )}
        {tvar === "daruma" && (
          <>
            {/* Daruma: jedno oko domalované, druhé až se splní přání */}
            <path d="M77 84.4 C79.6 80.4 84.6 80.6 87.2 84.2 M103 84.4 C100.4 80.4 95.4 80.6 92.8 84.2" stroke-width="2.8" />
            <circle cx="83" cy="89.6" r="3.6" fill="#FFFDF7" stroke-width="1.2" />
            <circle cx="97" cy="89.6" r="3.6" fill="#FFFDF7" stroke-width="1.2" />
            <circle cx="83" cy="89.6" r="2" fill="#2B2420" stroke="none" />
            <path d="M84 98.4 C86 96.6 88.6 97.4 90 99.2 C91.4 97.4 94 96.6 96 98.4" stroke-width="2" />
            <path d="M88.4 102.6 Q90 104 91.6 102.6" stroke-width="1.3" />
          </>
        )}
        {tvar === "kokeshi" && (
          <>
            {/* Kokeši: tenké štětcové linky, oči jako lístky, rumělková ústa */}
            <path d="M79 84 Q83 82 87 83.6 M93 83.6 Q97 82 101 84" stroke-width="0.9" />
            <path d="M80.2 89.8 Q83 87.6 85.8 89.8 M94.2 89.8 Q97 87.6 99.8 89.8" stroke-width="1.2" />
            <path d="M80.2 89.8 Q83 90.6 85.8 89.8 M94.2 89.8 Q97 90.6 99.8 89.8" stroke-width="0.7" />
            <circle cx="88.8" cy="103" r="0.95" fill="#C4432B" stroke="none" />
            <circle cx="91.2" cy="103" r="0.95" fill="#C4432B" stroke="none" />
            <circle cx="78.4" cy="96.6" r="1.6" fill="#E8899A" stroke="none" opacity="0.8" />
            <circle cx="101.6" cy="96.6" r="1.6" fill="#E8899A" stroke="none" opacity="0.8" />
          </>
        )}
        {tvar === "kabuki" && (
          <>
            {/* Kumadori: rumělkové linky od očí ke spánkům, rty dolů */}
            <path d="M78 88.4 C75.4 85 74 80.6 75 76.6 M86.4 86.6 C84.8 82.4 82 79.6 78.4 78.4 M102 88.4 C104.6 85 106 80.6 105 76.6 M93.6 86.6 C95.2 82.4 98 79.6 101.6 78.4" stroke="#C4432B" stroke-width="1.6" />
            <path d="M79.6 98 C81.6 99.6 83.8 100.4 86 100.4 M100.4 98 C98.4 99.6 96.2 100.4 94 100.4" stroke="#C4432B" stroke-width="1.3" />
            <path d="M78.6 83.2 L87 85.2 M101.4 83.2 L93 85.2" stroke-width="2.2" />
            <path d="M79 89.6 Q83 86.8 87 89.4 Q83 91.4 79 89.6 Z M93 89.4 Q97 86.8 101 89.6 Q97 91.4 93 89.4 Z" fill="#FFFDF7" stroke-width="1.2" />
            <circle cx="83" cy="89.2" r="1.3" fill="#2B2420" stroke="none" />
            <circle cx="97" cy="89.2" r="1.3" fill="#2B2420" stroke="none" />
            <path d="M85.6 104.2 Q90 101 94.4 104.2" stroke="#C4432B" stroke-width="2" />
          </>
        )}
        {tvar === "kodama" && (
          <g fill="#2B2420" stroke="none">

---
import { uid } from "../dospele/uid";

interface Props { class?: string; size?: number; }
const { class: cls = "", size = 64 } = Astro.props;
const u = uid();

/*
  Kapka jako kami: původní kresba (characters/Kapka.astro) na dřevěných
  geta a za ní kruh se čtyřmi bubny, který jí zajíždí do zad, jaký v japonské ikonografii nosí
  bůh hromu Raidžin. Na každém bubnu mitsudomoe, tři čárky, které se
  pomalu točí. Kde hřmí, tam prší — proto zrovna Kapka.

  Kapka tu neposkakuje (bez tříd kapka-telo a kapka-stin), stojí na geta.
*/
const f = (n: number) => Math.round(n * 100) / 100;
const STRED = { x: 90, y: 64 };
const POLOMER = 48;
const bod = (uhel: number, r = POLOMER) => ({
  x: f(STRED.x + r * Math.cos((uhel * Math.PI) / 180)),
  y: f(STRED.y + r * Math.sin((uhel * Math.PI) / 180)),
});
/*
  Kruh je celý, ale střed má u hlavy: spodní část zajíždí za tělo,
  jako by Kapce vyrůstal ze zad.
*/
/* Čtyři bubny po 60°: stejné rozestupy, dva nahoře kolem špičky kapky, dva po stranách */
const bubny = [-180, -120, -60, 0].map((u) => bod(u));
/* Hřebíky po obvodu kůže */
const hrebiky = Array.from({ length: 14 }, (_, i) => {
  const u = (i / 14) * Math.PI * 2;
  return { x: f(Math.cos(u) * 13.7), y: f(Math.sin(u) * 13.7) };
});
/* Jedna čárka tomoe: hlavička a ocas, který se stáčí po obvodu */
/* Oko: magatama, hlavička nahoře a ocásek, který z ní stéká dolů */
const magatama = "M0 -4.2 C3.2 -4.2 4.8 -1.6 4.4 1.4 C4 4.6 0.8 6.8 -1.8 7.8 C-0.4 5.8 -0.8 4.6 -2.3 3.7 C-4.6 2.5 -4.8 -0.8 -3.1 -2.7 C-2.3 -3.7 -1.2 -4.2 0 -4.2 Z";
const carka = "M0 -8.4 A8.4 8.4 0 0 1 8.11 -2.17 A6 6 0 0 0 0 -2.4 Z";
/* Kapka stojí na geta o výšku desky a zubů výš */
const ZDVIH = 12;
const geta = [71, 91];
---
<svg width={size} height={size} viewBox="0 0 180 180" fill="none" class={cls} aria-hidden="true">
  <defs>
    {/* Odstín loga: tah ensó jde z rumělky zleva dole do noci vpravo nahoře */}
    <linearGradient id={`${u}-soumrak`} gradientUnits="userSpaceOnUse" x1="60" y1="150" x2="124" y2="36">
      <stop offset="0" stop-color="#C4432B" /><stop offset="0.28" stop-color="#C0708A" /><stop offset="0.55" stop-color="#7A5E8E" /><stop offset="0.8" stop-color="#4E4A84" /><stop offset="1" stop-color="#2A2C5E" />
    </linearGradient>
  </defs>
  {/* Kruh za zády: obrys, světlé tělo a tenká rýha. Spodek schová tělo */}
  <circle cx={STRED.x} cy={STRED.y} r={POLOMER} stroke="#6B5D4F" stroke-width="5.6" />
  <circle cx={STRED.x} cy={STRED.y} r={POLOMER} stroke="#EDE3CC" stroke-width="3.4" />
  <circle cx={STRED.x} cy={STRED.y} r={POLOMER} stroke="#CDBE9E" stroke-width="0.7" />

  {bubny.map((p, i) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <circle r="15.4" fill="#C99A68" stroke="#6B5D4F" stroke-width="1.5" />
      <circle r="12.6" fill="#F6EBD0" stroke="#A97B4E" stroke-width="0.8" />
      <g fill="#6B5D4F">{hrebiky.map((h) => <circle cx={h.x} cy={h.y} r="0.7" />)}</g>
      <g class="tomoe" style={`animation-delay:${-i * 1.7}s`}>
        <g transform="scale(1.36)" fill="#1F1A17">
          {[0, 120, 240].map((u) => (
            <g transform={`rotate(${u})`}>
              <path d={carka} />
              <circle cx="0" cy="-5.4" r="3" />
            </g>
          ))}
        </g>
      </g>
    </g>
  ))}

  {/* Dvě kapky deště po stranách místo jiskřiček */}
  <path d="M22 132 Q18.6 138 18.6 140.4 Q18.6 143.6 22 143.6 Q25.4 143.6 25.4 140.4 Q25.4 138 22 132 Z" fill="#3F4C94" opacity="0.8" />
  <path d="M158 138 Q155.4 142.6 155.4 144.4 Q155.4 147 158 147 Q160.6 147 160.6 144.4 Q160.6 142.6 158 138 Z" fill="#C4432B" opacity="0.7" />

  <ellipse cx="95" cy="161" rx="28" ry="4.8" fill="#7A5E8E" opacity="0.28" />

  {/* Geta: deska, dva zuby; pásek se kreslí až přes chodidla */}
  <g stroke="#6B5D4F" stroke-linejoin="round">
    {geta.map((x) => (
      <g>
        <path d={`M${x + 2.4} 152.2 H${x + 6} V159.2 H${x + 2.4} Z M${x + 12} 152.2 H${x + 15.6} V159.2 H${x + 12} Z`} fill="#8C6444" stroke-width="0.9" />
        <rect x={x} y="146" width="18" height="6.4" rx="1.4" fill="#C99A68" stroke-width="1.1" />
        <path d={`M${x + 1.4} 147.8 H${x + 16.6}`} stroke="#E2BE8C" stroke-width="0.9" stroke-linecap="round" />
        <path d={`M${x + 2} 150.6 C${x + 6} 150 ${x + 12} 151 ${x + 16} 150.4`} stroke="#A97B4E" stroke-width="0.5" fill="none" />
      </g>
    ))}
  </g>

  {/* Kapka, původní kresba, zvednutá na geta */}
  <g transform={`translate(0 -${ZDVIH})`}>
    {/* Stín jako ujetý druhý průchod u risografu, v odstínu loga */}
    <path d="M90 38 Q60 85 56 108 Q52 132 72 146 Q82 152 90 152 Q98 152 108 146 Q128 132 124 108 Q120 85 90 38 Z" fill={`url(#${u}-soumrak)`} opacity="0.9" transform="translate(5 -4)" />
    <path d="M90 38 Q60 85 56 108 Q52 132 72 146 Q82 152 90 152 Q98 152 108 146 Q128 132 124 108 Q120 85 90 38 Z" fill="#7FB4D8" />
    <ellipse cx="76" cy="100" rx="8" ry="14" fill="#E4F3FB" opacity="0.55" transform="rotate(-15 76 100)" />
    <g class="tvar">
      {/*
        Oči jako magatama: kulatá hlavička s leskem a ocásek, který
        stéká ven do stran jako kapka. Stejný tvar jako čárky tomoe na
        bubnech, takže tvář a bubny jsou z jednoho rodu. Pusa je dvojitá vlnka.
      */}
      <g fill="#2C557A">
        <g transform="translate(79.4 106.4) scale(-0.95 0.95)">
          <path d={magatama} />
          <circle cx="-0.8" cy="-1.4" r="1.15" fill="#F2FAFF" />
        </g>
        <g transform="translate(100.6 106.4) scale(0.95)">
          <path d={magatama} />
          <circle cx="-0.8" cy="-1.4" r="1.15" fill="#F2FAFF" />
        </g>
      </g>
      <path d="M83 120 Q86.5 124.6 90 121.6 Q93.5 124.6 97 120" stroke="#2C557A" stroke-width="2" stroke-linecap="round" fill="none" />
      <circle cx="72" cy="116" r="5" fill="#E89AA4" opacity="0.45" />
      <circle cx="108" cy="116" r="5" fill="#E89AA4" opacity="0.45" />
    </g>
    <ellipse cx="52" cy="118" rx="7" ry="5" fill="#7FB4D8" />
    <ellipse cx="128" cy="118" rx="7" ry="5" fill="#7FB4D8" />
    <ellipse cx="80" cy="154" rx="8" ry="4" fill="#5A91BC" />
    <ellipse cx="100" cy="154" rx="8" ry="4" fill="#5A91BC" />
    {/* Pásky hanao přes chodidla */}
    <path d="M73.6 158 Q80 150.6 86.4 158 M93.6 158 Q100 150.6 106.4 158" stroke="#C4432B" stroke-width="1.9" stroke-linecap="round" fill="none" />
  </g>
</svg>

<style>
  /* Tomoe se pomalu točí, každý buben jinak posunutý */
  .tomoe { animation: tomoe 14s linear infinite; }
  @keyframes tomoe { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .tomoe { animation: none; } }
</style>

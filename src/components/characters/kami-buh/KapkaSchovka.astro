---
/*
  Kapka na schovávanou — vzorník pro /marcel (čtvrtá podoba Kapky),
  postavený stejně jako PecinkaSchovka.astro, BublinkaSchovka.astro,
  StripekSchovka.astro, HlinkaSchovka.astro, CedulkaSchovka.astro,
  KachlikSchovka.astro, SamotkaSchovka.astro a VazickaSchovka.astro vedle.
  Samotná kresba je v ../schovka (Kapka.astro a kapka.ts) a je vždycky
  malá; tady jsou čtyři barvy vedle sebe: na papíře, zmenšené až na 16 px,
  ve tmě a jak vykukují zpoza hrany.

  Kliknutí ukáže, jak ji hra „najde“: vyskočí, cinkne (zvuk webu, zlatá
  zvoní výš) a vystříknou z ní kapky — tuš, voda, zlato nebo soumrak —
  a nad ní jednou problikne malý blesk.
*/
import Kapka from "../schovka/Kapka.astro";
import { NAZVY } from "../schovka/pecinka";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
---
<div class="kps" data-kapka-schovka>
  <p class="kps-stitek">Na papíře</p>
  <ul class="kps-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kps-kus" data-barva={b} aria-label={`Kapka na schovávanou — ${NAZVY[b]}`}>
          <Kapka barva={b} size={56} />
        </button>
        <span class="kps-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="kps-stitek">Zmenšená · 32 · 24 · 16 px</p>
  <ul class="kps-radek kps-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="kps-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Kapka barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="kps-stitek">V noci</p>
  <ul class="kps-radek kps-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kps-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Kapka barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="kps-stitek">Vykukuje zpoza hrany</p>
  <ul class="kps-radek kps-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="kps-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Kapka barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="kps-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je která Kapka: kapky v těch barvách (lesk je odlesk na každé z nich) a blesk, který nad ní problikne */
  const VODA: Record<Barva, { kapky: string[]; lesk: string; pocet: number; blesk: string }> = {
    cerna: { kapky: ["#1E1A18", "#3A302A", "#2B2420"], lesk: "rgba(255, 255, 255, 0.45)", pocet: 10, blesk: "#1E1A18" },
    pruhledna: { kapky: ["#FFFFFF", "#CFE4F4", "#9CC8E6", "#A9CBE2"], lesk: "#FFFFFF", pocet: 10, blesk: "#FFFFFF" },
    zlata: { kapky: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], lesk: "#FFFBEA", pocet: 11, blesk: "#FFF2BC" },
    logo: { kapky: ["#C4432B", "#C0708A", "#7A5E8E", "#3E3C78"], lesk: "rgba(251, 233, 183, 0.8)", pocet: 11, blesk: "#E2B95A" },
  };
  /* tři velikosti kapky (kps-kapka-a až c), ať nejsou všechny stejné */
  const TVARY = "abc";
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  /** jedna částice: vyletí ze středu pod úhlem u, natočí se a spadne; tize je, o kolik víc padá, než letí */
  function castice(kus: HTMLElement, trida: string, barva: string, u: number, vel: number, tize = 22) {
    const s = document.createElement("span");
    s.className = `kps-castice ${trida}`;
    const d = vel * (0.55 + Math.random() * 0.6);
    s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
    s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
    s.style.setProperty("--g", `${tize}px`);
    /* kapka se netočí dokola jako střep: jen se nakloní po směru letu, špičkou dozadu */
    s.style.setProperty("--r", `${Math.round(-Math.cos(u) * 38 + Math.random() * 16 - 8)}deg`);
    s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
    s.style.setProperty("--b", barva);
    kus.append(s);
    window.setTimeout(() => s.remove(), 1700);
    return s;
  }

  /** blesk nikam neletí: dvakrát problikne šikmo nad ní a je pryč */
  function blesk(kus: HTMLElement, barva: string, vel: number) {
    const s = document.createElement("span");
    s.className = "kps-blesk";
    s.style.setProperty("--b", barva);
    s.style.setProperty("--x", Math.random() < 0.5 ? "10%" : "90%");
    s.style.setProperty("--m", Math.min(1, Math.max(0.55, vel / 56)).toFixed(2));
    kus.append(s);
    window.setTimeout(() => s.remove(), 700);
  }

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = VODA[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    /* kapky jsou těžké: vystříknou dokola a hned padají */
    for (let i = 0; i < c.pocet; i++) {
      const k = castice(kus, `kps-kapka kps-kapka-${TVARY[i % TVARY.length]}`, c.kapky[i % c.kapky.length], (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5, vel, 30);
      k.style.setProperty("--l", c.lesk);
    }
    blesk(kus, c.blesk, vel);
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-kapka-schovka] .kps-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Kapky na schovávanou; kapky a blesk vyrábí skript, proto globálně */
  .kps {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .kps-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .kps-stitek:first-child { margin-top: 0; }
  .kps-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .kps-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .kps-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .kps-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černá schová skoro úplně */
  .kps-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Kapka schovává a drží se jí ručkama; kruh s bubny nad ni trčí celý */
  .kps-hrana li { gap: 0; }
  .kps-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .kps-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .kps-hrana .kps-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .kps-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  /* co z ní vystříkne: kapky v jejích barvách, každá s odleskem vlevo dole */
  .kps-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 10px;
    margin: -5px 0 0 -3.5px;
    background: radial-gradient(circle at 34% 66%, var(--l, #fff) 0 13%, transparent 17%), var(--b);
    pointer-events: none;
    z-index: 2;
    animation: kps-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1) forwards;
  }
  @keyframes kps-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + var(--g, 22px))) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  /* kapka: špička nahoře, bříško dole, tvar přes clip-path; tři velikosti */
  .kps-kapka { clip-path: polygon(50% 0, 63% 22%, 79% 44%, 93% 62%, 97% 78%, 87% 92%, 69% 99%, 50% 100%, 31% 99%, 13% 92%, 3% 78%, 7% 62%, 21% 44%, 37% 22%); }
  .kps-kapka-b { width: 9px; height: 13px; margin: -6.5px 0 0 -4.5px; }
  .kps-kapka-c { width: 5px; height: 7px; margin: -3.5px 0 0 -2.5px; }
  /* blesk: klikatý klínek šikmo nad ní, problikne dvakrát a zhasne (mimo animaci není vidět) */
  .kps-blesk {
    position: absolute;
    left: var(--x, 90%);
    top: 0;
    width: 10px;
    height: 17px;
    margin: -10px 0 0 -5px;
    background: var(--b);
    clip-path: polygon(58% 0, 10% 56%, 44% 56%, 26% 100%, 90% 38%, 56% 38%, 84% 0);
    opacity: 0;
    transform: scale(var(--m, 1));
    transform-origin: 50% 100%;
    pointer-events: none;
    z-index: 2;
    animation: kps-blesk 0.48s step-end;
  }
  @keyframes kps-blesk {
    0%, 38% { opacity: 1; }
    24%, 64% { opacity: 0; }
  }
</style>

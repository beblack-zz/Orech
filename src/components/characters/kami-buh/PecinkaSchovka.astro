---
/*
  Pecinka na schovávanou — vzorník pro /marcel (čtvrtá podoba Pecinky).
  Samotná kresba je v ../schovka (Pecinka.astro a pecinka.ts) a je vždycky
  malá; tady jsou čtyři barvy vedle sebe: na papíře, zmenšené až na 16 px,
  ve tmě a jak vykukují zpoza hrany.

  Kliknutí ukáže, jak ji hra „najde“: vyskočí, cinkne (zvuk webu, zlatá
  zvoní výš) a rozletí se z ní, z čeho je — kapky tuše, střípky skla,
  zlaté šupinky nebo plátky sakury.
*/
import Pecinka from "../schovka/Pecinka.astro";
import { NAZVY } from "../schovka/pecinka";

const BARVY = ["cerna", "pruhledna", "zlata", "logo"] as const;
---
<div class="pss" data-pecinka-schovka>
  <p class="pss-stitek">Na papíře</p>
  <ul class="pss-radek">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="pss-kus" data-barva={b} aria-label={`Pecinka na schovávanou — ${NAZVY[b]}`}>
          <Pecinka barva={b} size={56} />
        </button>
        <span class="pss-nazev">{NAZVY[b]}</span>
      </li>
    ))}
  </ul>

  <p class="pss-stitek">Zmenšená · 32 · 24 · 16 px</p>
  <ul class="pss-radek pss-male">
    {BARVY.map((b) => (
      <li>
        {[32, 24, 16].map((v) => (
          <button type="button" class="pss-kus" data-barva={b} aria-label={`${NAZVY[b]}, ${v} px`}>
            <Pecinka barva={b} size={v} />
          </button>
        ))}
      </li>
    ))}
  </ul>

  <p class="pss-stitek">V noci</p>
  <ul class="pss-radek pss-noc">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="pss-kus" data-barva={b} aria-label={`${NAZVY[b]} v noci`}>
          <Pecinka barva={b} size={36} />
        </button>
      </li>
    ))}
  </ul>

  <p class="pss-stitek">Vykukuje zpoza hrany</p>
  <ul class="pss-radek pss-hrana">
    {BARVY.map((b) => (
      <li>
        <button type="button" class="pss-kus" data-barva={b} aria-label={`${NAZVY[b]} vykukuje`}>
          <Pecinka barva={b} size={40} poza="vykukuje" />
        </button>
        <span class="pss-deska" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import * as zvuk from "../../../scripts/parta2/zvuk";

  type Barva = "cerna" | "pruhledna" | "zlata" | "logo";
  /* z čeho je která Pecinka, to se z ní při nalezení rozletí */
  const CASTICE: Record<Barva, { barvy: string[]; tvar: string; pocet: number }> = {
    cerna: { barvy: ["#1E1A18", "#3A302A", "#2B2420"], tvar: "kapka", pocet: 12 },
    pruhledna: { barvy: ["#FFFFFF", "#CFE4F4", "#A9CBE2"], tvar: "strep", pocet: 12 },
    zlata: { barvy: ["#F2C95E", "#FFF2BC", "#C9922E", "#FFFFFF"], tvar: "supinka", pocet: 16 },
    logo: { barvy: ["#C4432B", "#C0708A", "#7A5E8E", "#FBE9B7"], tvar: "platek", pocet: 14 },
  };
  const klid = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  function najdi(kus: HTMLElement) {
    const barva = kus.dataset.barva as Barva;
    kus.classList.remove("schovka-nalezena");
    void kus.offsetWidth;
    kus.classList.add("schovka-nalezena");
    window.setTimeout(() => kus.classList.remove("schovka-nalezena"), 700);
    if (barva === "zlata") zvuk.zlato();
    else zvuk.nalezeno();
    if (klid()) return;
    const c = CASTICE[barva];
    const vel = kus.getBoundingClientRect().width || 40;
    for (let i = 0; i < c.pocet; i++) {
      const s = document.createElement("span");
      s.className = `pss-castice pss-${c.tvar}`;
      const u = (i / c.pocet) * Math.PI * 2 + Math.random() * 0.5;
      const d = vel * (0.55 + Math.random() * 0.6);
      s.style.setProperty("--dx", `${(Math.cos(u) * d).toFixed(1)}px`);
      s.style.setProperty("--dy", `${(Math.sin(u) * d * 0.8 - vel * 0.3).toFixed(1)}px`);
      s.style.setProperty("--r", `${Math.round(Math.random() * 540 - 270)}deg`);
      s.style.setProperty("--d", `${(0.7 + Math.random() * 0.4).toFixed(2)}s`);
      s.style.background = c.barvy[i % c.barvy.length];
      kus.append(s);
      window.setTimeout(() => s.remove(), 1300);
    }
  }

  /* jeden posluchač na celý dokument: přežije i přechod mezi stránkami */
  document.addEventListener("click", (e) => {
    const kus = (e.target as Element | null)?.closest?.<HTMLElement>("[data-pecinka-schovka] .pss-kus");
    if (kus) najdi(kus);
  });
</script>

<style is:global>
  /* Vzorník Pecinky na schovávanou; částice vyrábí skript, proto globálně */
  .pss {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: clamp(14px, 3.2vw, 28px);
    border-radius: 18px;
    background: var(--papir-2, #efe5d1);
    box-shadow: inset 0 0 0 1px rgba(43, 36, 32, 0.07);
    text-align: center;
  }
  .pss-stitek {
    margin: 8px 0 4px;
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--inkoust-3, #8a7a69);
    text-align: left;
  }
  .pss-stitek:first-child { margin-top: 0; }
  .pss-radek {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
  }
  .pss-radek li { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .pss-male li { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 4px clamp(3px, 0.8vw, 7px); }
  .pss-nazev {
    font-family: var(--f-display);
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--inkoust-2, #5e4f44);
  }
  /* noc: tmavý pruh s pár hvězdami, tady se černá schová skoro úplně */
  .pss-noc {
    padding: 12px 6px;
    border-radius: 12px;
    background:
      radial-gradient(1px 1px at 12% 28%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 37% 70%, #ede6cf 99%, transparent),
      radial-gradient(1.2px 1.2px at 63% 22%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 88% 64%, #ede6cf 99%, transparent),
      radial-gradient(1px 1px at 76% 86%, rgba(237, 230, 207, 0.6) 99%, transparent),
      linear-gradient(#141734, #262a5c);
  }
  /* hrana: deska, za kterou se Pecinka schovává a drží se jí ručkama */
  .pss-hrana li { gap: 0; }
  .pss-deska {
    display: block;
    width: min(76px, 92%);
    height: 16px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(var(--papir-3, #e2d4b9), #d5c4a4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 rgba(43, 36, 32, 0.06);
  }
  .pss-kus {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    line-height: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .pss-hrana .pss-kus { padding: 2px 2px 0; margin-bottom: -1px; }
  .pss-kus:focus-visible { outline: 2px solid var(--rumelka, #c4432b); outline-offset: 3px; }
  .pss-castice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    pointer-events: none;
    z-index: 2;
    animation: pss-let var(--d, 0.8s) cubic-bezier(0.15, 0.7, 0.35, 1) forwards;
  }
  @keyframes pss-let {
    0% { transform: translate(0, 0) rotate(0deg) scale(0.6); opacity: 1; }
    55% { opacity: 1; }
    100% { transform: translate(var(--dx), calc(var(--dy) + 22px)) rotate(var(--r)) scale(0.9); opacity: 0; }
  }
  .pss-kapka { border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; }
  .pss-strep { clip-path: polygon(50% 0, 100% 70%, 20% 100%); }
  .pss-supinka { width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; }
  .pss-platek { width: 7px; height: 9px; margin: -4.5px 0 0 -3.5px; border-radius: 70% 0 70% 0; }
</style>

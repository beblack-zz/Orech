  <rect x="45" y="60" width="90" height="85" rx="20" fill="#B84A2B"/>
  <rect x="62" y="100" width="56" height="35" rx="8" fill="#3A2E28" opacity="0.25"/>
  <ellipse class="plamen plamen-1" cx="80" cy="124" rx="6" ry="9" fill="#E8B440"/>
  <ellipse class="plamen plamen-2" cx="92" cy="122" rx="5" ry="7" fill="#E8B440"/>
  <ellipse class="plamen plamen-3" cx="100" cy="126" rx="4" ry="6" fill="#C87E4E"/>
  <g class="tvar">
    <path d="M72 80 Q75 76 78 80" stroke="#F4EBDD" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M100 80 Q103 76 106 80" stroke="#F4EBDD" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M82 92 Q90 98 98 92" stroke="#F4EBDD" stroke-width="2" stroke-linecap="round" fill="none"/>

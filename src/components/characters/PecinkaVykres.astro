---
/**
 * Pecinka jako technický výkres — čelní pohled na pec.
 * Milimetrová mřížka, šrafovaná stěna, kóty. Barvy z palety webu:
 * čáry espresso, kóty a odkazy terracotta.
 */
interface Props { class?: string; size?: number; }
const { class: cls = "", size = 230 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 180 180"
  fill="none"
  class={cls}
  aria-hidden="true"
>
  <defs>
    <pattern id="pv-mrizka" width="8" height="8" patternUnits="userSpaceOnUse">
      <path d="M8 0 H0 V8" fill="none" stroke="#6B5D4F" stroke-width="0.4" opacity="0.28"/>
    </pattern>
    <pattern id="pv-srafa" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0 V5" stroke="#3A2E28" stroke-width="0.7" opacity="0.55"/>
    </pattern>
  </defs>

  <!-- podkladová mřížka jen pod výkresem, ne přes celý rám -->
  <rect x="32" y="18" width="116" height="140" fill="url(#pv-mrizka)"/>

  <g stroke="#3A2E28" fill="none">
    <!-- plášť pece se šrafovanou stěnou: na výšku, ne do šířky -->
    <path
      d="M60 46 h48 a14 14 0 0 1 14 14 v64 a14 14 0 0 1 -14 14 h-48 a14 14 0 0 1 -14 -14 v-64 a14 14 0 0 1 14 -14 z
         M60 56 h48 a4 4 0 0 1 4 4 v64 a4 4 0 0 1 -4 4 h-48 a4 4 0 0 1 -4 -4 v-64 a4 4 0 0 1 4 -4 z"
      fill="url(#pv-srafa)"
      fill-rule="evenodd"
      stroke-width="1.4"
    />
    <!-- komín -->
    <path d="M99 46 V24 h13 v22" stroke-width="1.4"/>
    <!-- dvířka -->
    <rect x="70" y="76" width="28" height="30" stroke-width="1.1"/>
    <!-- osa souměrnosti -->
    <path d="M84 36 V148" stroke-width="0.6" stroke-dasharray="6 3 1.5 3" opacity="0.6"/>
  </g>

  <!-- odkazová čára na dvířka -->
  <path d="M98 84 L124 74" stroke="#3A2E28" stroke-width="0.8"/>

  <!-- kóty -->
  <g stroke="#C87E4E" stroke-width="0.9">
    <path d="M46 152 H122"/>
    <path d="M46 148 v8 M122 148 v8"/>
    <path d="M46 152 l6 -2.5 v5 z M122 152 l-6 -2.5 v5 z" fill="#C87E4E" stroke="none"/>
    <path d="M46 46 V38 M58 38 H46" stroke-width="0.7"/>
  </g>
  <g fill="#C87E4E" font-family="IBM Plex Mono, monospace" font-size="7" letter-spacing="0.8">
    <text x="84" y="162" text-anchor="middle">⌀48</text>
  </g>
  <text
    x="60" y="35"
    font-family="IBM Plex Mono, monospace" font-size="6.5" letter-spacing="0.8"
    fill="#6B5D4F"
  >R10</text>
</svg>

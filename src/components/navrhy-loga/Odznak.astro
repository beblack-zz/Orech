---
/**
 * Návrh 05 — Odznak. Kulatá pečeť jako ze staré manufaktury: jméno
 * a místo obíhají dokola jako kruh, uprostřed váza a rozkvetlá větev.
 *
 * Do malých velikostí (`maly`) se odznak ořízne jen na vnitřní pole —
 * nápis by se v pár pixelech stejně slil.
 */
import { BARVY, PLATEK, UHLY_KVETU, ODSUN, kvetDefs, noveId, type LogoProps } from "./sdilene";

const {
  size = 160,
  tema = "svetle",
  mono = BARVY.espresso,
  anim = false,
  nazev = "zadny",
  maly = false,
  class: trida = "",
} = Astro.props as LogoProps;

const id = noveId("od");
const jeMono = tema === "mono";
const tmave = tema === "tmave";
const ink = jeMono ? mono : tmave ? BARVY.krem : BARVY.espresso;
const kvetBarva = tmave ? BARVY.sakuraSvetla : BARVY.sakura;
const akcent = jeMono ? mono : kvetBarva;
const pole = jeMono || tmave ? "none" : "#EDD5CE";
const vazaBarva = jeMono ? mono : tmave ? BARVY.krem : BARVY.espresso;
const dekor = jeMono ? null : tmave ? BARVY.sakura : BARVY.krem;

/** Horní nápis jde po oblouku přes vrch, dolní pod spodkem — oba se čtou zleva. */
const horni = "M 21 100 A 79 79 0 0 1 179 100";
const dolni = "M 12 100 A 88 88 0 0 0 188 100";

const vaza =
  "M 91 95 L 109 95 Q 110.5 97 108 99 L 106 100 L 106 106 C 106 110 124 112 124 126 C 124 140 118 148 114 152 L 86 152 C 82 148 76 140 76 126 C 76 112 94 110 94 106 L 94 100 L 92 99 Q 89.5 97 91 95 Z";

const vetve = [
  { d: "M100 96 C 101 84 106 75 115 67 C 120 63 126 60 131 58", w: 2.4, z: 0.5 },
  { d: "M104.6 80 C 100 72 94 67 86 64 C 83 63 80 63 78 63", w: 1.7, z: 0.85 },
  { d: "M115 67 C 117 60 116 54 113 48", w: 1.3, z: 1.0 },
  { d: "M86 64 C 84 59 83 55 83 50", w: 1.1, z: 1.1 },
];
const kvety = [
  { x: 131, y: 57, s: 0.82, r: 10, z: 1.35 },
  { x: 113, y: 46.5, s: 0.62, r: -20, z: 1.5 },
  { x: 78, y: 62.5, s: 0.78, r: 30, z: 1.45 },
  { x: 83, y: 49, s: 0.5, r: 0, z: 1.6 },
  { x: 109.5, y: 82.5, s: 0.5, r: 45, z: 1.55 },
];
const platky = [
  { x: 143, y: 86, r: 140, s: 0.95, z: 2 },
  { x: 63, y: 92, r: 220, s: 0.85, z: 4.6 },
];
---

<span class={`lg lg-${nazev} od ${anim ? "anim" : ""} ${trida}`} data-logo style={`--s:${size}px`}>
  <svg
    width={size}
    height={size}
    viewBox={maly ? "27 27 146 146" : "0 0 200 200"}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="JIRO saku"
  >
    <defs>
      <Fragment set:html={kvetDefs(id, { barva: kvetBarva, mono: jeMono ? mono : null, sirkaObrysu: 0.5 })} />
      <path id={`${id}-horni`} d={horni} />
      <path id={`${id}-dolni`} d={dolni} />
    </defs>

    {!maly && (
      <g class="od-uvod-kruh">
        <g class="od-kruh">
          <circle cx="100" cy="100" r="97" stroke={ink} stroke-width="2.2" />
          <circle cx="100" cy="100" r="93.4" stroke={ink} stroke-width="1.3" stroke-dasharray="0.01 3.4" stroke-linecap="round" />
          <circle cx="100" cy="100" r="73.6" stroke={ink} stroke-width="1.4" />
          <text fill={ink} font-family="'Cormorant Garamond', Georgia, serif" font-weight="600" font-size="17" letter-spacing="6"><textPath href={`#${id}-horni`} startOffset="50%" text-anchor="middle">JIRO SAKU</textPath></text>
          <text fill={ink} font-family="'JetBrains Mono', ui-monospace, monospace" font-weight="500" font-size="8.4" letter-spacing="2.6"><textPath href={`#${id}-dolni`} startOffset="50%" text-anchor="middle">KERAMICKÁ DÍLNA · OŘECH</textPath></text>
          <g transform="translate(15.5 100) rotate(90) scale(0.44)">
            <use href={`#${id}-kvet`} />
          </g>
          <g transform="translate(184.5 100) rotate(-90) scale(0.44)">
            <use href={`#${id}-kvet`} />
          </g>
        </g>
      </g>
    )}

    <circle cx="100" cy="100" r="70" fill={pole} stroke={ink} stroke-width={maly ? 2.6 : 0.8} />
    {/* Soustředné kruhy v poli — hlava hrnčířského kruhu, skoro neviditelná */}
    {!maly && !jeMono && [58, 46, 34].map((r) => <circle cx="100" cy="100" r={r} stroke={ink} stroke-opacity="0.1" stroke-width="0.8" />)}
    {!maly && <ellipse cx="100" cy="153.2" rx="26" ry="2.4" fill={ink} opacity="0.14" />}
    <path d="M70 153 L130 153" stroke={ink} stroke-width={maly ? 2 : 1.1} stroke-linecap="round" />

    <g class="od-vaza">
      <path d={vaza} fill={vazaBarva} />
      {dekor && !maly && (
        <>
          <path d="M80.5 119 C 78.5 129 80 140 85 147" stroke={dekor} stroke-opacity="0.35" stroke-width="1.3" stroke-linecap="round" />
          <path d="M95.2 103.5 L104.8 103.5" stroke={dekor} stroke-opacity="0.5" stroke-width="0.9" />
          <g transform="translate(100 131) scale(0.4)" fill={dekor}>
            {UHLY_KVETU.map((u) => (
              <path d={PLATEK} transform={`rotate(${u}) translate(0 -${ODSUN})`} />
            ))}
          </g>
        </>
      )}
    </g>

    <g stroke={ink} stroke-linecap="round">
      {vetve.map((v) => (
        <path class="od-vetev" d={v.d} stroke-width={maly ? v.w * 1.5 : v.w} pathLength="1" style={`--z:${v.z}s`} />
      ))}
    </g>

    {kvety.map((k) => (
      <g transform={`translate(${k.x} ${k.y}) rotate(${k.r}) scale(${maly ? k.s * 1.12 : k.s})`}>
        <g class="od-kvet" style={`--z:${k.z}s`}>
          <use href={`#${id}-kvet`} />
          {!jeMono && <circle r="1.35" fill={BARVY.mustard} />}
        </g>
      </g>
    ))}

    {!maly &&
      platky.map((p) => (
        <g transform={`translate(${p.x} ${p.y})`}>
          <g class="od-platek" style={`--z:${p.z}s`}>
            <use href={`#${id}-platek`} transform={`rotate(${p.r}) scale(${p.s}) translate(0 6.3)`} />
          </g>
        </g>
      ))}

    {!maly && (
      <text x="100" y="165" text-anchor="middle" fill={ink} opacity="0.7" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="5.6" letter-spacing="2.2">OD 2026</text>
    )}
  </svg>

  {nazev !== "zadny" && maly && (
    <span class="lg-nazev" style={`color:${ink}`}>
      <span class="od-jiro">JIRO</span> <em style={`color:${akcent}`}>saku</em>
    </span>
  )}
</span>

<style>
  .od-jiro {
    letter-spacing: 0.1em;
  }
  em {
    font-style: italic;
    font-weight: 400;
  }

  .anim .od-uvod-kruh {
    transform-origin: 100px 100px;
    animation: od-uvod 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .anim .od-kruh {
    transform-origin: 100px 100px;
    animation: od-toc 90s linear 1.3s infinite;
  }
  .anim .od-vaza {
    transform-origin: 100px 152px;
    animation: od-vaza 0.7s cubic-bezier(0.3, 1.4, 0.5, 1) 0.3s both;
  }
  .anim .od-vetev {
    stroke-dasharray: 1 1;
    animation: od-kresli 0.7s ease-out both;
    animation-delay: var(--z);
  }
  .anim .od-kvet {
    transform-origin: 0 0;
    animation: od-kvet 0.55s cubic-bezier(0.3, 1.6, 0.5, 1) both;
    animation-delay: var(--z);
  }
  .anim .od-platek {
    transform-origin: 0 0;
    animation: od-pad 6s ease-in-out infinite;
    animation-delay: var(--z);
  }

  @keyframes od-uvod {
    from {
      transform: rotate(-140deg) scale(0.9);
      opacity: 0;
    }
    to {
      transform: rotate(0) scale(1);
      opacity: 1;
    }
  }
  /* Nápis obíhá dokola jako kruh, který běží */
  @keyframes od-toc {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes od-vaza {
    from {
      transform: translateY(14px) scaleY(0.6);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes od-kresli {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes od-kvet {
    from {
      transform: scale(0) rotate(-60deg);
    }
    to {
      transform: scale(1) rotate(0);
    }
  }
  @keyframes od-pad {
    0% {
      transform: translate(-6px, -28px) rotate(-40deg);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      transform: translate(0, 0) rotate(0);
      opacity: 1;
    }
    100% {
      transform: translate(2px, 5px) rotate(10deg);
      opacity: 0;
    }
  }
</style>

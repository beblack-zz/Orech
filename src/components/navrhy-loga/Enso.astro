---
/**
 * Návrh 01 — Ensō. Hrnčířský kruh jedním tahem štětce, v mezeře sakura.
 *
 * Tah je vyplněný tvar s proměnnou šířkou: na začátku štětec dosedne
 * (kapka), pak drží sílu a ke konci se vytahuje do suchého štětce —
 * proto má ocas podélné struhy, kudy už tuš nedošla. Uvnitř druhý,
 * rychlejší tah: rýha hlavy kruhu, která dává tušit, že se točí.
 */
import {
  BARVY,
  UHLY_KVETU,
  ODSUN,
  kvetDefs,
  noveId,
  rad,
  type LogoProps,
} from "./sdilene";
/* Tvar tahu, kapky, rýhy a místo květu jsou v ./enso-tvar.ts — kreslí z nich i skrytý tisk na dárkových jízdenkách */
import { ZACATEK_SOUMRAK, ROZSAH_SOUMRAK, W, hlavni, kapka, odhal, struhy, ryha, ryhaOdhal, kvet, volny } from "./enso-tvar";

const {
  size = 160,
  tema = "svetle",
  mono = BARVY.espresso,
  anim = false,
  nazev = "zadny",
  maly = false,
  soumrak = false,
  class: trida = "",
} = Astro.props as LogoProps;

const id = noveId("enso");
const jeMono = tema === "mono";
const tus = jeMono ? mono : tema === "tmave" ? BARVY.krem : BARVY.tus;
const kvetBarva = tema === "tmave" ? BARVY.sakuraSvetla : BARVY.sakura;
const textBarva = jeMono ? mono : tema === "tmave" ? BARVY.krem : BARVY.espresso;
const akcent = jeMono ? mono : kvetBarva;


/*
 * Soumrak: barvy z oblohy webu mezi 18:30 a 21:00 (scripts/parta2/paleta.ts).
 * Silný začátek tahu je ještě den (rumělka), tenký ocas už noc. Na tmavém
 * podkladu jdou barvy o kus světleji, jinak by noční konec v pozadí zmizel.
 */
const SOUMRAK: [number, string][] =
  tema === "tmave"
    ? [[0, "#E0603C"], [0.3, "#E08AA0"], [0.58, "#B49AD0"], [0.82, "#9A92D8"], [1, "#8C8ACC"]]
    : [[0, "#C4432B"], [0.28, "#C0708A"], [0.55, "#7A5E8E"], [0.8, "#4E4A84"], [1, "#2A2C5E"]];
const soumrakBarva = (t: number) => {
  const x = Math.min(1, Math.max(0, t));
  let i = 0;
  while (i < SOUMRAK.length - 2 && SOUMRAK[i + 1][0] <= x) i++;
  const [a, ca] = SOUMRAK[i];
  const [b, cb] = SOUMRAK[i + 1];
  const k = (x - a) / (b - a);
  const h = (c: string) => [1, 3, 5].map((j) => parseInt(c.slice(j, j + 2), 16));
  const A = h(ca);
  const B = h(cb);
  return `#${A.map((v, j) => Math.round(v + (B[j] - v) * k).toString(16).padStart(2, "0")).join("")}`;
};
/* SVG neumí kruhový přechod — tah se proto vybarví stovkou úzkých výsečí kolem středu */
const VYSECI = maly ? 48 : 120;
const vysece = soumrak
  ? Array.from({ length: VYSECI }, (_, i) => {
      const a0 = (i / VYSECI) * 360;
      const a1 = ((i + 1.15) / VYSECI) * 360;
      const t = ((((a0 + a1) / 2 - ZACATEK_SOUMRAK) % 360) + 360) % 360 / ROZSAH_SOUMRAK;
      const p = (u: number) => `${(100 + 130 * Math.cos(rad(u))).toFixed(2)} ${(100 + 130 * Math.sin(rad(u))).toFixed(2)}`;
      return { d: `M100 100 L${p(a0)} A130 130 0 0 1 ${p(a1)} Z`, barva: soumrakBarva(t > 1 ? (t < 1.08 ? 1 : 0) : t) };
    })
  : [];

---

<span class={`lg lg-${nazev} enso ${anim ? "anim" : ""} ${trida}`} data-logo style={`--s:${size}px`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 200 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="JIRO saku"
  >
    <defs>
      <Fragment set:html={soumrak ? kvetDefs(id, { barva: "#FBE9B7", obrys: "#E2B95A" }) : kvetDefs(id, { barva: kvetBarva, mono: jeMono ? mono : null })} />
      {/* Záře kolem květu — jako měsíc nad Ořechem na Partě 2 */}
      {soumrak && (
        <filter id={`${id}-zare`} x="-90%" y="-90%" width="280%" height="280%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceAlpha" stdDeviation="3.2" result="b1" />
          <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="b2" />
          <feFlood flood-color="#FFE7A3" flood-opacity="0.95" />
          <feComposite in2="b1" operator="in" result="z1" />
          <feFlood flood-color="#FFF6DA" flood-opacity="0.75" />
          <feComposite in2="b2" operator="in" result="z2" />
          <feMerge><feMergeNode in="z2" /><feMergeNode in="z1" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      )}
      {!maly && (
        <filter id={`${id}-hrana`} filterUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
          <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="7" result="hrube" />
          <feDisplacementMap in="SourceGraphic" in2="hrube" scale="3.4" xChannelSelector="R" yChannelSelector="G" result="a" />
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="1" seed="3" result="jemne" />
          <feDisplacementMap in="a" in2="jemne" scale="1.3" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      )}
      {!maly && !jeMono && (
        <filter id={`${id}-vpij`} filterUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
          <feGaussianBlur stdDeviation="1.8" />
        </filter>
      )}
      <mask id={`${id}-maska`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
        <path class="enso-odhal" d={odhal} pathLength="1" stroke="#fff" stroke-width={W * 1.9} />
        <path class="enso-odhal-ryha" d={ryhaOdhal} pathLength="1" stroke="#fff" stroke-width="13" />
        {!maly &&
          struhy.map((s) => (
            <path d={s.d} stroke="#000" stroke-width={s.w} stroke-dasharray={s.dash} stroke-linecap="round" />
          ))}
      </mask>
    </defs>

    {soumrak && (
      <>
        <mask id={`${id}-tvar`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
          <g mask={`url(#${id}-maska)`} fill="#fff">
            <g filter={maly ? undefined : `url(#${id}-hrana)`}>
              <path d={hlavni} />
              <ellipse
                cx={kapka.x}
                cy={kapka.y}
                rx={(W * 0.6).toFixed(2)}
                ry={(W * 0.53).toFixed(2)}
                transform={`rotate(${kapka.uhel} ${kapka.x} ${kapka.y})`}
              />
              <path d={ryha} />
            </g>
          </g>
        </mask>
        {!maly && (
          <g mask={`url(#${id}-maska)`} fill={tema === "tmave" ? "#8C8ACC" : "#4E4A84"} filter={`url(#${id}-vpij)`} opacity="0.16">
            <path d={hlavni} />
            <path d={ryha} />
          </g>
        )}
        <g mask={`url(#${id}-tvar)`}>
          {vysece.map((v) => <path d={v.d} fill={v.barva} />)}
        </g>
      </>
    )}

    {!soumrak && (
    <g mask={`url(#${id}-maska)`} fill={tus}>
      {/* Tuš se vpíjí do papíru — rozpitý stín pod tahem */}
      {!maly && !jeMono && (
        <g filter={`url(#${id}-vpij)`} opacity="0.16">
          <path d={hlavni} />
          <path d={ryha} />
        </g>
      )}
      <g filter={maly ? undefined : `url(#${id}-hrana)`}>
        <path d={hlavni} />
        <ellipse
          cx={kapka.x}
          cy={kapka.y}
          rx={(W * 0.6).toFixed(2)}
          ry={(W * 0.53).toFixed(2)}
          transform={`rotate(${kapka.uhel} ${kapka.x} ${kapka.y})`}
        />
        <path d={ryha} />
      </g>
    </g>
    )}

    {!maly && (
      <g transform={`translate(${volny.x.toFixed(2)} ${volny.y.toFixed(2)})`} filter={soumrak ? `url(#${id}-zare)` : undefined}>
        <g
          class="enso-volny"
          style={`--dx:${(kvet.x - volny.x).toFixed(1)}px; --dy:${(kvet.y - volny.y).toFixed(1)}px`}
        >
          <use href={`#${id}-platek`} transform="rotate(205) scale(1.05) translate(0 6.3)" />
        </g>
      </g>
    )}

    <g transform={`translate(${kvet.x.toFixed(2)} ${kvet.y.toFixed(2)}) rotate(14) scale(1.3)`} filter={soumrak ? `url(#${id}-zare)` : undefined} class={soumrak ? "enso-mesic" : undefined}>
      {UHLY_KVETU.map((u, i) => (
        <g class="enso-platek" style={`--i:${i}`}>
          <use href={`#${id}-platek`} transform={`rotate(${u}) translate(0 -${ODSUN})`} />
        </g>
      ))}
    </g>
  </svg>

  {nazev !== "zadny" && (
    <span class="lg-nazev" style={`color:${textBarva}`}>
      <span class="enso-jiro">JIRO</span> <em style={`color:${akcent}`}>saku</em>
    </span>
  )}
</span>

<style>
  .enso-jiro {
    letter-spacing: 0.14em;
  }
  em {
    font-style: italic;
    font-weight: 400;
  }

  .enso-mesic {
    animation: enso-svit 5s ease-in-out infinite;
  }
  @keyframes enso-svit {
    50% {
      opacity: 0.86;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enso-mesic {
      animation: none;
    }
  }

  .anim .enso-odhal {
    stroke-dasharray: 1 1;
    animation: enso-kresli 1.5s cubic-bezier(0.62, 0.04, 0.3, 1) 0.15s both;
  }
  .anim .enso-odhal-ryha {
    stroke-dasharray: 1 1;
    animation: enso-kresli 0.75s cubic-bezier(0.5, 0, 0.3, 1) 1.05s both;
  }
  .anim .enso-platek {
    transform-origin: 0 0;
    animation: enso-platek 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) both;
    animation-delay: calc(1.45s + var(--i) * 0.09s);
  }
  .anim .enso-volny {
    transform-origin: 0 0;
    animation: enso-pad 2.4s cubic-bezier(0.4, 0, 0.4, 1) 2.2s both;
  }

  @keyframes enso-kresli {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes enso-platek {
    from {
      transform: scale(0) rotate(-50deg);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    to {
      transform: scale(1) rotate(0);
      opacity: 1;
    }
  }
  /* Plátek se utrhne z květu a sklouzne dovnitř kruhu, kde zůstane ležet */
  @keyframes enso-pad {
    0% {
      transform: translate(var(--dx), var(--dy)) rotate(-80deg);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    45% {
      transform: translate(calc(var(--dx) * 0.3), calc(var(--dy) * 0.5)) rotate(12deg);
    }
    72% {
      transform: translate(calc(var(--dx) * 0.2), calc(var(--dy) * 0.15)) rotate(-10deg);
    }
    100% {
      transform: translate(0, 0) rotate(0);
      opacity: 1;
    }
  }
</style>

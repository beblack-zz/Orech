---
import LogoEnso from "./LogoEnso.astro";
import RezervovatTlacitko from "./RezervovatTlacitko.astro";
import PrepinacTematu from "./PrepinacTematu.astro";

/**
 * `accent` označuje položku, která má v menu schválně vyčnívat.
 * Pravidlo, na kterém to stojí: barva nese identitu (co ta položka je),
 * tvar nese stav (kde právě jsi). Proto má Parta modrou s tečkou a
 * aktivní stránka podtržení — jinak by se obarvená položka četla jako
 * „tady jsi“ a lidi by na ni přestali klikat.
 */
/** `skrtnuto` je pracovní značka — položka je na odpis, ale zatím visí v menu. */
type Odkaz = { href: string; label: string; accent?: boolean; skrtnuto?: boolean };

const links: Odkaz[] = [
  { href: "/uvod-2", label: "Úvod 2", skrtnuto: true },
  { href: "/kurzy-2", label: "Kurzy 2", skrtnuto: true },
  { href: "/deti", label: "Pro děti", skrtnuto: true },
  { href: "/dilna", label: "Dílna" },
  { href: "/rezervace", label: "Rezervace" },
  { href: "/obchod-2", label: "Obchod 2" },
  { href: "/parta-2", label: "Parta 2" },
  { href: "/o-nas-2", label: "O nás 2" },
  { href: "/marcel", label: "Marcel", skrtnuto: true },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const jeTu = (href: string) => path === href;

// Aktivní = podtržení, ne barva
const stav = "font-medium underline decoration-2 underline-offset-[6px] decoration-stone";

// Škrt i druhá tečka u Party jdou v sakuře ze značky
const skrt = "line-through decoration-2 decoration-sakura";
---

<header class="border-b border-espresso/10">
  <div class="container-x flex items-center justify-between py-4">
    <div class="flex items-center gap-3">
      <a href="/" class="inline-block hover:opacity-75 transition-opacity">
        <LogoEnso size={70} />
      </a>
      {/* Řádky napevno — Chrome a Firefox by jinak zalamovaly každý jinde */}
      <span class="mono-meta hidden min-[1500px]:inline-block pr-6 whitespace-nowrap">Dílna ·<br />Luční 235<br />Ořech ·</span>
    </div>

    <div class="flex items-center gap-2 xl:gap-4">
    <nav class="hidden min-[1400px]:flex items-center gap-3">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={jeTu(l.href) ? "page" : undefined}
          class={`nav-odkaz text-[14px] whitespace-nowrap transition-colors ${
            l.accent ? "parta-odkaz text-peri-hlina" : ""
          } hover:text-sakura ${jeTu(l.href) ? stav : ""} ${l.skrtnuto ? skrt : ""}`}
        >
          {l.accent && (
            <span class="inline-flex items-baseline gap-[3px] mr-1.5" aria-hidden="true">
              <span class="tecka inline-block w-[6px] h-[6px] rounded-full bg-peri-hlina"></span>
              <span class="tecka tecka-2 inline-block w-[6px] h-[6px] rounded-full bg-sakura"></span>
            </span>
          )}
          {l.label}
        </a>
      ))}
    </nav>

    <PrepinacTematu />

    <button
      id="menu-toggle"
      class="min-[1400px]:hidden text-espresso p-2"
      aria-label="Otevřít menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="3" y1="7" x2="19" y2="7" />
        <line x1="3" y1="15" x2="19" y2="15" />
      </svg>
    </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="hidden min-[1400px]:hidden bg-cream border-b border-espresso/10"
>
  <nav class="container-x flex flex-col gap-3 py-4">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={jeTu(l.href) ? "page" : undefined}
        class={`nav-odkaz text-[14px] py-1 hover:text-sakura transition-colors ${l.accent ? "parta-odkaz text-peri-hlina" : ""} ${jeTu(l.href) ? stav : ""} ${l.skrtnuto ? skrt : ""}`}
      >
        {l.accent && (
          <span class="inline-flex items-baseline gap-[3px] mr-1.5" aria-hidden="true">
            <span class="tecka inline-block w-[6px] h-[6px] rounded-full bg-peri-hlina"></span>
            <span class="tecka tecka-2 inline-block w-[6px] h-[6px] rounded-full bg-sakura"></span>
          </span>
        )}
        {l.label}
      </a>
    ))}
  </nav>
</div>

{/*
  Rezervovat visí vpravo dole na každé stránce, i na mobilu — proto už není
  v hlavičce ani v mobilním menu.
*/}
<RezervovatTlacitko />

<script>
  // Musí se navázat znovu po každé navigaci — ClientRouter vymění DOM,
  // ale modulový skript prohlížeč podruhé nespustí.
  const bindMenu = () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = "1";

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Zavřít menu" : "Otevřít menu");
    };

    toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false));
    }
  };

  bindMenu();
  document.addEventListener("astro:page-load", bindMenu);
</script>

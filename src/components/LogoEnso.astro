---
/**
 * Značka webu: ensō v soumraku (tah štětce z rumělky do fialové noci,
 * květ svítí jako měsíc) a pod ním název štětcem. Kresby jsou v
 * navrhy-loga/Enso.astro a znacka/ZnackaStetec.astro, tady je jen obal
 * pro hlavičku a patičku starého webu.
 *
 * `size` je šířka kresby v pixelech; název se dopočítá, aby poměr držel.
 * Na světlém podkladu jsou kresby dvě — denní a světlejší pro noční téma
 * (data-tema="noc"), přepíná je CSS. Patička je tmavá vždycky.
 */
import Enso from "./navrhy-loga/Enso.astro";
import ZnackaStetec from "./znacka/ZnackaStetec.astro";

interface Props {
  size?: number;
  class?: string;
  /** Tmavý podklad (patička) — světlejší soumrak a krémový název. */
  invertovany?: boolean;
}
const { size = 70, class: trida = "", invertovany = false } = Astro.props;
/* Verzálka názvu — o pětinu větší než dřívější písmo ve 24 % šířky kresby */
const verzalkaPx = Math.round(size * 0.216);
const maly = size < 56;
---
<span class={`inline-flex flex-col items-center gap-1 leading-none ${trida}`}>
  {invertovany ? (
    <Enso size={size} soumrak tema="tmave" maly={maly} />
  ) : (
    <>
      <span class="logo-den"><Enso size={size} soumrak maly={maly} /></span>
      <span class="logo-noc"><Enso size={size} soumrak tema="tmave" maly={maly} /></span>
    </>
  )}
  <span class={invertovany ? "text-cream" : "text-espresso"}>
    <ZnackaStetec vyska={verzalkaPx} tema={invertovany ? "tmave" : "auto"} />
  </span>
</span>

<style is:global>
  .logo-noc { display: none; }
  :root[data-tema="noc"] .logo-den { display: none; }
  :root[data-tema="noc"] .logo-noc { display: block; }
  .logo-den, .logo-noc { line-height: 0; }
</style>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import oNas from "../images/o-nas-kuchynka.webp";
import fotoJirik from "../images/o-nas-jirik.webp";
import fotoRenca from "../images/o-nas-renca.webp";
import Kapka from "../components/characters/Kapka.astro";
import Pecinka from "../components/characters/Pecinka.astro";
import Bublina from "../components/characters/Bublina.astro";
import Delic from "../components/Delic.astro";

const team = [
  {
    name: "JIRO",
    role: "Zakladatel · Lektor",
    photo: fotoJirik,
    alt: "Jiřík točí hrnek na hrnčířském kruhu",
    position: "object-top",
    bio: "Keramika má v jeho srdci vypálený hodně velký prostor. Skoro každá volná chvíle patří práci okolo dílny, čtení článků a knih o keramice a nakoukávání hrnčířských videí. Jeho výtvarná duše je v dílně k ruce všem nadšencům pro hlínu, když zrovna neroztáčí kruh…",
  },
  {
    name: "Renata",
    role: "Zakladatelka · Lektorka",
    photo: fotoRenca,
    alt: "Renča u cihlové pece na pálení keramiky",
    position: "object-center",
    bio: "Lásku ke keramice si nese od prvních kroužků na základní škole. A jak plynul čas, láska ke keramice a Jiříkovo místo v srdci daly vzniknout malé dílně v Ořechu. Je k ruce obsahu webových stránek, příběhům a feedu na Instagramu a komunikaci se vznikající hliněnou partou…",
  },
];

/**
 * Milníky se dopisují ručně — je to historie, ne data.
 * Poslední řádek drž vždycky u aktuálního měsíce, ať timeline nekončí
 * někde vzadu a nevypadá to, že dílna mezitím zavřela.
 */
const milestones = [
  { year: "2026", month: "Únor", text: "rekonstrukce garáže po vodovodní havárii" },
  { year: "2026", month: "Březen", text: "vyléváme podlahu, malujeme stěny, bouráme zeď a stavíme výlohu" },
  { year: "2026", month: "Duben", text: "stěhujeme do dílny kruhy, montujeme stoly z kanceláře" },
  { year: "2026", month: "Květen", text: "přivádíme vodovodní a odpadní trubky a sestavujeme skříňky" },
  { year: "2026", month: "Červen", text: "všechno se nám táhne, a tak na prosby rozjíždíme Instagram a sdílíme alespoň pokroky v dílně" },
  { year: "2026", month: "Červenec", text: "necháváme udělat revizi elektřiny, instalujeme zásuvky a děláme místo pro novou pec" },
  { year: "2026", month: "Srpen", text: "nakupujeme hlínu, testujeme glazury, vypalujeme první várku výtvorů" },
  { year: "2026", month: "Září", text: "nestíháme rozjet kurzy s novým školním rokem, ale vítáme nové tváře na dnech otevřených dveří" },
];
---

<Layout title="O nás — JIRO saku" description="Malá keramická dílna v Ořechu. Dva lektoři, tři kruhy a spousta lidí, co se u nás naučili milovat hlínu.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_1fr] md:gap-12 md:items-center">
        <div>
          <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
            O <span class="serif-italic-terracotta">dílně.</span>
          </h1>
          <p class="font-serif italic text-[20px] md:text-[24px] text-espresso leading-[1.35] font-normal mb-4">
            Začínáme v roce 2026 s jednou pecí, dvěma stoly, třemi kruhy a spoustou nadšení. Malá dílna v Ořechu, kde má hlína čas a každá chyba svůj tvar.
          </p>
          <p class="text-stone text-[16px] leading-[1.75] mb-3.5">
            Náš přístup je jednoduchý — méně dokonalosti, víc radosti. Nemusíš umět nic, nemusíš plánovat, co vyrobíš. Sedneš si ke kruhu, začneš točit a dál to už půjde samo.
          </p>
          <p class="text-stone text-[16px] leading-[1.75]">
            Kurzy vedou dva lektoři, každý s vlastním rukopisem. Pro děti, dospělé, začátečníky, i pro pokročilé, kteří si chtějí přijít jen sednout a rozjímat u hlíny.
          </p>
          <div class="flex items-center gap-4 mt-6">
            <Pecinka size={230} class="pointer-events-none flex-shrink-0" />
            <div>
              <p class="font-hand text-[28px] text-clay leading-none">— Jiřík & Renča</p>
              <p class="font-mono text-[12px] text-stone mt-1.5 tracking-wider uppercase">Zakladatelé · Lektoři</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl aspect-[3/4] overflow-hidden mt-8 md:mt-0 w-full max-w-[370px] mx-auto md:mx-0 md:max-w-none md:w-[78%] md:justify-self-end">
          <Image
            src={oNas}
            alt="Kuchyňka v dílně JIRO saku s keramikou na polici"
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 33vw, 370px"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <Delic />

  <section class="bg-white py-14 fade-up">
    <div class="container-x">
      <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-6">Náš tým</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[760px]">
        {team.map((t) => (
          <div>
            <div class="bg-[#D9C3A3] rounded-xl aspect-square overflow-hidden mb-4">
              <Image
                src={t.photo}
                alt={t.alt}
                widths={[400, 600, 900]}
                sizes="(min-width: 640px) 370px, calc(100vw - 48px)"
                format="webp"
                class:list={["w-full h-full object-cover", t.position]}
              />
            </div>
            <h3 class="font-serif text-[18px] font-medium mb-0.5">{t.name}</h3>
            <p class="font-mono text-[12px] text-stone tracking-wider uppercase mb-2">{t.role}</p>
            <p class="text-stone text-[15px] leading-[1.7]">{t.bio}</p>
          </div>
        ))}
      </div>

      <Bublina
        name="Kapka"
        text="Já jsem tady spíš omylem. Ale nikomu to neříkej."
        class="mt-10 justify-center"
      >
        <Kapka />
      </Bublina>
    </div>
  </section>

  <div class="bg-white">
    <Delic />
  </div>

  <section class="py-14 fade-up">
    <div class="container-x">
      <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-6">Tak jde čas…</h2>
      <div class="max-w-[600px] lg:max-w-none">
        <span class="font-serif text-[32px] font-medium block mb-3 text-terracotta" style="font-variation-settings: 'opsz' 72;">2026</span>
        {milestones.map((m) => (
          <div class="flex gap-4 py-3 border-b border-espresso/8 last:border-b-0">
            <span class="font-mono text-[12px] text-terracotta uppercase tracking-wider w-[70px] flex-shrink-0 pt-0.5">{m.month}</span>
            <p class="text-stone text-[16px] leading-[1.6] lg:whitespace-nowrap">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Delic />

  <section class="bg-cream-warm py-14 fade-up">
    <div class="container-x text-center max-w-[560px] mx-auto">
      <p class="font-serif italic text-[22px] text-espresso mb-2">Všichni jste vítáni</p>
      <p class="text-stone text-[16px] leading-[1.75] mb-6">
        Luční 235, Ořech.<br />
        <span class="whitespace-nowrap">Dílna je otevřená v&nbsp;úterý a&nbsp;v&nbsp;pátek 9:00–18:30.</span><br />
        Stavíme i&nbsp;na&nbsp;kafe.
      </p>
      <div class="flex items-center justify-center gap-0">
        <a
          href="mailto:ahoj@jirosaku.cz"
          class="relative z-[1] inline-flex items-center gap-2 bg-stone text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso transition-colors"
        >
          Napsat nám <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import openStudio from "../images/open-studio.png";
import Kapka from "../components/characters/Kapka.astro";
import Hlinka from "../components/characters/Hlinka.astro";
import Bublina from "../components/characters/Bublina.astro";

const pricing = [
  { name: "Jednorázový vstup", price: "350 Kč / 3 hod", desc: "Přijď, kdy chceš. Hlína a nástroje v ceně, glazování +120 Kč." },
  { name: "Balíček 5 vstupů", price: "1 500 Kč", desc: "Platnost 3 měsíce. Vychází na 300 Kč za návštěvu.", badge: "Nejoblíbenější" },
  { name: "Měsíční členství", price: "2 200 Kč / měs", desc: "Neomezený přístup v otevíracích hodinách. Hlína, glazury, výpal — vše v ceně." },
];

const rules = [
  "Rezervuj si slot předem — kapacita je 6 lidí na směnu",
  "Základní znalost kruhu je podmínka (absolvovaný kurz u nás nebo jinde)",
  "Úklid po sobě — hlína ze stolu, nástroje na místo",
  "Hotové kousky označ štítkem a nech na polici k sušení",
];
---

<Layout title="Open studio — Ořechová hlína" description="Otevřená dílna pro keramiky. Rezervuj si čas u kruhu bez instruktora.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_1fr] md:gap-12 md:items-center">
        <div class="max-w-[540px] mb-10 md:mb-0">
          <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
            Ruce v hlíně,<br />hlava v <span class="serif-italic-terracotta">klidu.</span>
          </h1>
          <p class="text-stone text-[16px] leading-[1.75] mb-3">
            Open studio je prostor pro ty, kdo už základy zvládají a chtějí si jen přijít točit. Bez instruktora, bez osnov — jen ty, kruh a hlína.
          </p>
          <p class="text-stone text-[16px] leading-[1.75]">
            Máme tři kruhy, jednu pec, dva stoly a všechno nářadí. Stačí si rezervovat slot a přijít.
          </p>
        </div>
        <div class="rounded-xl aspect-[4/3] overflow-hidden">
          <Image
            src={openStudio}
            alt="Open studio — kruhy a pracovní stoly"
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 42vw, 90vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <span class="mono-meta block text-right mt-6">Pro pokročilé · 6 míst</span>
    </div>
  </section>

  <section class="py-20 md:py-28 fade-up">
    <div class="container-x text-center">
      <h3 class="font-mono text-[12px] tracking-[0.15em] text-stone uppercase mb-3">Ceník</h3>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-0 mb-14">
        <p class="font-serif text-[28px] md:text-[36px] text-espresso font-medium" style="font-variation-settings: 'opsz' 48;">
          Vyber si, jak chceš tvořit.
        </p>
        <Kapka size={240} class="w-[96px] lg:w-[240px] h-auto pointer-events-none flex-shrink-0 lg:-ml-[80px] relative z-[2]" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-6 max-w-[960px] mx-auto items-stretch">
        {pricing.map((p) => (
          <div class={`pricing-card group relative rounded-2xl text-center flex flex-col ${p.badge ? "pricing-card--featured bg-espresso text-cream sm:-my-3 sm:py-10 p-7" : "bg-white p-7"}`}>
            {p.badge && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-peri text-cream font-mono text-[12px] font-semibold px-3.5 py-1 rounded-full tracking-wider whitespace-nowrap">
                {p.badge}
              </span>
            )}
            <h4 class="font-serif text-[17px] font-medium mb-4 pt-2" style="font-variation-settings: 'opsz' 48;">{p.name}</h4>
            <p class={`font-serif text-[32px] md:text-[36px] font-medium mb-4 leading-none ${p.badge ? "text-terracotta" : "text-terracotta"}`}>{p.price}</p>
            <div class={`w-8 h-px mx-auto mb-4 ${p.badge ? "bg-cream/25" : "bg-espresso/10"}`}></div>
            <p class={`text-[15px] leading-[1.7] ${p.badge ? "text-cream/85" : "text-stone"}`}>{p.desc}</p>
          </div>
        ))}
      </div>

      <Bublina
        name="Hlínka"
        text="Zatím jsem jenom hrouda."
        class="mt-14 justify-center"
      >
        <Hlinka />
      </Bublina>
    </div>
  </section>

  <section class="py-14 fade-up">
    <div class="container-x">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-14">
        <div>
          <h3 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-4">Otevírací hodiny</h3>
          <div class="border-t border-espresso/10 pt-4 space-y-2">
            <div class="flex justify-between text-[16px]">
              <span>Pondělí – Pátek</span>
              <span class="font-mono text-[14px] text-stone">09:00 – 18:00</span>
            </div>
            <div class="flex justify-between text-[16px]">
              <span>Sobota</span>
              <span class="font-mono text-[14px] text-stone">10:00 – 14:00</span>
            </div>
            <div class="flex justify-between text-[16px]">
              <span>Neděle</span>
              <span class="font-mono text-[14px] text-stone">zavřeno</span>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-4">Pravidla studia</h3>
          <ul class="space-y-2">
            {rules.map((r) => (
              <li class="text-[15px] text-stone leading-[1.6] flex gap-2">
                <span class="text-terracotta mt-0.5 flex-shrink-0">·</span>
                {r}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="bg-cream-warm rounded-xl p-8 text-center max-w-[480px] mx-auto">
        <p class="font-serif italic text-[18px] text-espresso mb-4">Chceš si rezervovat slot?</p>
        <div class="flex items-center justify-center gap-0">
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="mailto:ahoj@orechovahlina.cz"
              class="inline-flex items-center justify-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-clay transition-colors"
            >
              ahoj@orechovahlina.cz
            </a>
            <a
              href="tel:+420777000000"
              class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso hover:text-cream transition-colors"
            >
              +420 777 000 000
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

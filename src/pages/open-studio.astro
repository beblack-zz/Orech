---
import Layout from "../layouts/Layout.astro";

const pricing = [
  { name: "Jednorázový vstup", price: "350 Kč / 3 hod", desc: "Přijď, kdy chceš. Hlína a nástroje v ceně, glazování +120 Kč." },
  { name: "Balíček 5 vstupů", price: "1 500 Kč", desc: "Platnost 3 měsíce. Vychází na 300 Kč za návštěvu.", badge: "Nejoblíbenější" },
  { name: "Měsíční členství", price: "2 200 Kč / měs", desc: "Neomezený přístup v otevíracích hodinách. Hlína, glazury, výpal — vše v ceně." },
];

const rules = [
  "Rezervuj si slot předem — kapacita je 6 lidí na směnu",
  "Základní znalost kruhu je podmínka (absolvovaný kurz u nás nebo jinde)",
  "Úklid po sobě — hlína ze stolu, nástroje na místo",
  "Hotové kousky označ štítkem a nech na polici k sušení",
];
---

<Layout title="Open studio — Ořechová hlína" description="Otevřená dílna pro keramiky. Rezervuj si čas u kruhu bez instruktora.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_1fr] md:gap-12 md:items-center">
        <div class="max-w-[540px] mb-10 md:mb-0">
          <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
            Ruce v hlíně,<br />hlava v <span class="serif-italic-terracotta">klidu.</span>
          </h1>
          <p class="text-stone text-[14px] leading-[1.75] mb-3">
            Open studio je prostor pro ty, kdo už základy zvládají a chtějí si jen přijít točit. Bez instruktora, bez osnov — jen ty, kruh a hlína.
          </p>
          <p class="text-stone text-[14px] leading-[1.75]">
            Máme tři kruhy, jednu pec, dva stoly a všechno nářadí. Stačí si rezervovat slot a přijít.
          </p>
        </div>
        <div class="rounded-xl aspect-[4/3] overflow-hidden">
          <img src="/open-studio.png" alt="Open studio — kruhy a pracovní stoly" class="w-full h-full object-cover" />
        </div>
      </div>
      <span class="mono-meta absolute bottom-0 right-0 md:right-8 lg:right-12">Pro pokročilé · 6 míst</span>
    </div>
  </section>

  <section class="bg-white py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[11px] tracking-wider text-stone uppercase mb-6">Ceník</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {pricing.map((p) => (
          <div class={`rounded-xl p-5 border relative ${p.badge ? "border-espresso bg-cream" : "border-espresso/10 bg-white"}`}>
            {p.badge && (
              <span class="absolute -top-2 left-3.5 bg-mustard text-espresso font-mono text-[10px] font-medium px-2.5 py-1 rounded-full tracking-wider">
                {p.badge}
              </span>
            )}
            <h4 class="font-serif text-[18px] font-medium mb-1" style="font-variation-settings: 'opsz' 48;">{p.name}</h4>
            <p class="font-serif text-[22px] text-terracotta font-medium mb-2">{p.price}</p>
            <p class="text-[12px] text-stone leading-[1.6]">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[11px] tracking-wider text-stone uppercase mb-6">Otevírací hodiny</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-14">
        <div>
          <div class="border-t border-espresso/10 pt-4 space-y-2">
            <div class="flex justify-between text-[14px]">
              <span>Pondělí – Pátek</span>
              <span class="font-mono text-[12px] text-stone">09:00 – 18:00</span>
            </div>
            <div class="flex justify-between text-[14px]">
              <span>Sobota</span>
              <span class="font-mono text-[12px] text-stone">10:00 – 14:00</span>
            </div>
            <div class="flex justify-between text-[14px]">
              <span>Neděle</span>
              <span class="font-mono text-[12px] text-stone">zavřeno</span>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-mono text-[11px] tracking-wider text-stone uppercase mb-4">Pravidla studia</h3>
          <ul class="space-y-2">
            {rules.map((r) => (
              <li class="text-[13px] text-stone leading-[1.6] flex gap-2">
                <span class="text-terracotta mt-0.5 flex-shrink-0">·</span>
                {r}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="bg-cream-warm rounded-xl p-8 text-center max-w-[480px] mx-auto">
        <p class="font-serif italic text-[18px] text-espresso mb-4">Chceš si rezervovat slot?</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="mailto:ahoj@orechahlina.cz"
            class="inline-flex items-center justify-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[13px] font-medium hover:bg-clay transition-colors"
          >
            Napsat e-mail
          </a>
          <a
            href="tel:+420777000000"
            class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[13px] font-medium hover:bg-espresso hover:text-cream transition-colors"
          >
            Zavolat
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

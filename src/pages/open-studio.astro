---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import openStudio from "../images/open-studio.png";
import Kapka from "../components/characters/Kapka.astro";
import Bublina from "../components/characters/Bublina.astro";

const pricing = [
  /*
   * Jednorázový vstup má dvě ceny podle toho, u čeho člověk sedí — kruh
   * je dražší než stůl. Každá cena má vlastní řádek: ve dvou cenách
   * v jednom řádku se dalo snadno přehlédnout, která platí pro mě.
   */
  {
    name: "Modelování",
    price: "300 Kč",
    desc: "Stůl, hlína a nástroje. Cena je za 90 minut, glazování v ceně.",
  },
  {
    name: "Točení na kruhu",
    price: "400 Kč",
    desc: "Kruh jen pro tebe. Cena je za 90 minut, glazování v ceně.",
  },
  {
    name: "Měsíční členství",
    price: "1 900 Kč / měs",
    /* Členství se neplatí za sezení, ale za měsíc — proto stojí zvlášť. */
    mesicni: true,
    desc: "Neomezený přístup v otevíracích hodinách open studia. Hlína, glazury, výpal — vše v ceně.",
  },
];

const rules = [
  "Rezervuj si slot předem — kapacita je 6 lidí na směnu",
  "Základní znalost kruhu je podmínka (absolvovaný kurz u nás nebo jinde)",
  "Úklid po sobě — hlína ze stolu, nástroje na místo",
  "Hotové kousky označ štítkem a nech na polici k sušení",
];
---

<Layout title="Open studio — JIRO saku" description="Otevřená dílna pro keramiky. Rezervuj si čas u kruhu bez instruktora.">
  <section class="py-10 md:py-12 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_0.85fr] md:gap-12 md:items-center mb-4">
        <div class="max-w-[600px] mb-10 md:mb-0">
          <h1 class="hero-title text-espresso text-[38px] md:text-[48px] lg:text-[56px] mb-6">
            Ruce v hlíně,<br />hlava v <span class="serif-italic-sakura">klidu.</span>
          </h1>
          <p class="text-stone text-[16px] leading-[1.75] mb-3">
            Open studio je prostor pro ty, kdo už základy zvládají a chtějí si jen přijít točit. Bez instruktora, bez osnov — jen ty, kruh a hlína.
          </p>
          <p class="text-stone text-[16px] leading-[1.75]">
            Máme tři kruhy, jednu pec, dva stoly a všechno nářadí. Stačí si rezervovat slot a přijít.
          </p>
        </div>
        {/* Fotka se drží výšky hlavičky, ať ceník kouká nad hranu obrazovky. */}
        <div class="rounded-xl aspect-[4/3] overflow-hidden max-w-[400px] md:ml-auto">
          <Image
            src={openStudio}
            alt="Open studio — kruhy a pracovní stoly"
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 42vw, 90vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <span class="mono-meta block text-right mt-4">Pro pokročilé · 6 míst</span>
    </div>
  </section>

  {/* Ceník navazuje těsně, aby nadpis koukal nad hranu obrazovky i na nižším okně. */}
  <section class="pt-3 md:pt-5 pb-8 md:pb-10 fade-up">
    <div class="container-x text-center relative">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-0 mb-8">
        <h2 class="font-serif font-light text-[32px] md:text-[40px] text-espresso leading-none">
          Vyber si, jak chceš <em class="italic font-light text-sakura">tvořit.</em>
        </h2>
        <Kapka size={240} class="w-[84px] lg:w-[150px] h-auto pointer-events-none flex-shrink-0 lg:-ml-[40px] relative z-[2]" />
      </div>

      {/*
        Ceník je tabulka: co, za co a kolik. Tři karty vedle sebe nutily
        porovnávat ceny přes mezery mezi rámečky — teď jsou pod sebou v jednom
        sloupci a dají se přečíst shora dolů. Růžová plocha zůstává, ale drží
        celou tabulku, ne každou cenu zvlášť: je to jediné zvýraznění na
        stránce, takže zvýraznění nic neředí.
      */}
      <div class="blok-vyzdvizeny rounded-2xl border max-w-[760px] mx-auto px-6 md:px-8 py-2 text-left">
        {pricing.map((p, i) => (
          <div class={`py-6 ${
            /* Členství je jiný druh platby než sezení — oddělí ho silnější linka. */
            i > 0 ? (p.mesicni ? "border-t border-espresso/25" : "border-t border-espresso/12") : ""
          }`}>
            {/*
              Název a cena drží jeden řádek a rozejdou se k okrajům; na úzkém
              displeji se cena zalomí pod název místo toho, aby název mačkala
              do sloupce o pár písmenech.
            */}
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-serif font-medium text-[20px] md:text-[23px] leading-none" style="font-variation-settings: 'opsz' 48;">{p.name}</h3>
              <p class="font-serif text-[24px] md:text-[32px] font-medium text-espresso leading-none whitespace-nowrap">{p.price}</p>
            </div>
            <p class="text-[15px] leading-[1.7] text-espresso/75 max-w-[48ch] mt-2">{p.desc}</p>
          </div>
        ))}
      </div>

      {/*
        Platnost ceníku a individuální domluva. Datum je tu schválně: ceník
        s obdobím se čte jako rozhodnutí na dané období, ne jako provizorium,
        a nechává volnou ruku ceny po zkušenostech upravit. Druhá věta říká
        nahlas to, co v dílně stejně běžně děláme — bez ní vidí návštěvník
        jen zavřené dveře tam, kde mu ceník neodpovídá.
      */}
      <div class="max-w-[760px] mx-auto mt-6 text-center">
        <p class="mono-meta">Ceny platí pro říjen 2026</p>
        <p class="text-[15px] leading-[1.7] text-stone mt-3 max-w-[56ch] mx-auto">
          Chceš v dílně víc času? Vezmi si dva vstupy po sobě nebo členství.
          A kdyby ti nic z toho nesedělo, <a href="mailto:ahoj@jirosaku.cz" class="text-stone underline underline-offset-2 hover:text-sakura transition-colors">napiš nám</a> — domluvíme se.
        </p>
      </div>

    </div>
  </section>

  <section class="py-14 fade-up">
    <div class="container-x">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-14">
        <div>
          <h2 class="font-serif font-light text-[28px] md:text-[32px] leading-none mb-5">
            Otevírací <em class="italic font-light text-sakura">hodiny</em>
          </h2>
          <div class="border-t border-espresso/20 pt-4 space-y-2">
            <div class="flex justify-between text-[16px]">
              <span>Pondělí – Pátek</span>
              <span class="font-mono text-[14px] text-stone">09:00 – 18:00</span>
            </div>
            <div class="flex justify-between text-[16px]">
              <span>Sobota</span>
              <span class="font-mono text-[14px] text-stone">10:00 – 14:00</span>
            </div>
            <div class="flex justify-between text-[16px]">
              <span>Neděle</span>
              <span class="font-mono text-[14px] text-stone">zavřeno</span>
            </div>
          </div>
        </div>
        <div>
          <h2 class="font-serif font-light text-[28px] md:text-[32px] leading-none mb-5">
            Pravidla <em class="italic font-light text-sakura">studia</em>
          </h2>
          <ul class="border-t border-espresso/20 pt-4 space-y-2">
            {rules.map((r) => (
              <li class="text-[15px] text-stone leading-[1.6] flex gap-2">
                <span class="text-stone mt-0.5 flex-shrink-0">·</span>
                {r}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Výzva má stejný tvar jako na Kurzech: vystředěný text bez rámečku. */}
      <div class="text-center max-w-[560px] mx-auto">
        <p class="font-serif italic font-light text-[24px] md:text-[28px] text-espresso mb-6">Chceš si rezervovat slot?</p>
        <div class="flex items-center justify-center gap-0">
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="mailto:ahoj@jirosaku.cz"
              class="inline-flex items-center justify-center gap-2 bg-stone text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso transition-colors"
            >
              ahoj@jirosaku.cz
            </a>
            <a
              href="tel:+420777000000"
              class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso hover:text-cream transition-colors"
            >
              +420 777 000 000
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

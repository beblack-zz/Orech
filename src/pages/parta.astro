---
/**
 * Parta 3 — nebeský chrám. Parta 2 je den v dílně (cesta hlíny od hroudy
 * po výpal); tohle je noc nad ní. Když dílna zhasne, kami vystoupají do
 * chrámu nad oblaky a ukážou se v plné parádě:
 *
 *   úvod      soumrak, ostrov s chrámem nad oblačným mořem (parta3/Uvod.astro)
 *   průvod    sedm podob Lampion jde po papírovém svitku (Pruvod.astro)
 *   obsazení  kdo je kdo: pod střechou chrámového jeviště devět lampionů,
 *             kdo svítí, toho list visí pod nimi — živá podoba Kami, popis
 *             z Party 2 a v textu původní malá kami (Obsazeni.astro)
 *   hledání   na schovávanou: kde se parta přes den schovává, jak ji
 *             najít a co otevře tři, šest a devět nálezů (Hledani.astro)
 *   závěr     svítání, parta je zpátky dole pod ořechem — obrázek z úvodu
 *             Party 2 se zeleným domem z Domku 2 (Zaver.astro)
 *
 * Postavičky jsou přehnané podoby z /marcel (components/characters/kami-buh):
 * Kami jsou živé scény v obsazení, Lampion jde v průvodu, Na schovávanou
 * jsou erby na lampionech a parta v závěru. Každá velká podoba smí být na
 * stránce jen jednou (pevná id v kresbách) — každá tu je právě jednou.
 *
 * Vzhled, obloha, hlavička a patička jsou z Party 2 (styles/parta2.css),
 * vlastní věci stránky v styles/parta3.css.
 */
import "../styles/pisma.css";
import Hlava from "../components/Hlava.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/schovka.css";
/* písmo značky: Cedulka má na lucerně JIRO */
import "../styles/znacka.css";
import "../styles/parta3.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import Uvod from "../components/parta3/Uvod.astro";
import Pruvod from "../components/parta3/Pruvod.astro";
import Obsazeni from "../components/parta3/Obsazeni.astro";
import Hledani from "../components/parta3/Hledani.astro";
import Zaver from "../components/parta3/Zaver.astro";
import { cesta } from "../data/kami";

/*
 * Štětcové písmo na japonské znaky se stahuje jen s těmi, které na stránce
 * opravdu jsou (parametr text=). Poslední řádek jsou znaky uvnitř kreseb
 * z /marcel (štítky, brána, nádržka) — stejná sada jako tam.
 */

---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="KAMI parta — nebeský chrám · JIRO saku" popis="Když dílna zhasne, devět kami z Ořechu vystoupá do chrámu nad oblaky a ukáže se v plné parádě. Rozsviť lampion a podívej se, kdo je kdo a co hlídá přes den." barva="#3A3C7C" />
    <ClientRouter />
  </head>
  <body class="p2 p3" data-stranka="parta-3">
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      <Uvod />
      <Pruvod />
      <Obsazeni />
      <Hledani />
      <Zaver />
    </main>

    <Paticka />

    <script>
      import "../scripts/parta3/hlavni.ts";
    </script>
  </body>
</html>

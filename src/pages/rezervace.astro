---
/**
 * Rezervace v novém vzhledu: čas v dílně se kupuje jako jízdenka na
 * vlak po vodě. Celá stránka stojí na moři pod oblohou (More.astro);
 * na obzoru je stanice Ořech a vlak, který ráno přijede, odjede,
 * když člověk sjede k výběru, a v noci se vrátí rozsvícený.
 *
 *   za svítání  nádraží: o co jde, kdy a za kolik, příští volný odjezd
 *   dopoledne   pokladna: kolik vás pojede a den (lepenkové jízdenky)
 *               a vedle klapková tabule s odjezdy toho dne — obloha
 *               ukazuje světlo hodiny, na kterou člověk ukazuje; pod
 *               tabulí je cedule s vysvětlivkami k tomu, co je
 *               v pokladně vybrané
 *   večer       jízdenka: z vybraných hodin se složí vláček, napíšeš
 *               jméno a průvodčí jízdenku označí — odejde mailem
 *   za soumraku dárkové jízdenky: tři hodiny, permanentka a zvláštní vlak
 *               jako tři svislé nabídky — tentýž luxusní lístek v zelené,
 *               červené a modré desce; jméno a vzkaz se píšou rovnou na
 *               jízdenku, zabalí se a objednávka odejde mailem
 *   v noci      vlak se vrací, jízdenky člena, odkaz k registraci a kontakt
 *
 * Pravidla jsou z data/rezervace.ts: úterý a pátek od 9 do 18, odjezdy
 * po hodině a půl, cena za člověka a odjezd. Odjezd je buď volný, nebo obsazený
 * a zamlouvá se celá — sám nebo skupina do čtyř lidí.
 *
 * Rezervovat rovnou smí jen lidi, které dílna zapsala do tabulky členů
 * v Supabase: přihlásí se e-mailem bez hesla (jednorázový odkaz /k/<odkaz>
 * nebo kód z mailu) a pak jízdenku označí a mají zamluveno. Ostatním odeslání otevře e-mail
 * s vyplněnými údaji a domluví se s dílnou. Server je v src/pages/api
 * a src/lib/rezervace, databáze v supabase/schema.sql. Dokud nejsou
 * klíče k Supabase nastavené (.env.example), je obsazenost simulovaná
 * (scripts/rezervace/simulace.ts) a všechno odchází mailem.
 *
 * Vedle hodin se tu kupují dvě věci, u kterých se počítají místa:
 *
 *   kurz         jezdí v sobotu a zabere celý den — hodinové spoje ten
 *                den nejedou a jede jeden zvláštní vlak: parní lokomotiva se
 *                salonem, v pokladně tmavá jízdenka, na tabuli cedule
 *                s místy a řádky jako zastávky programu, na jízdence
 *                mapa trasy
 *   permanentka  na tři měsíce a jeden den v týdnu (ten, který
 *                je vybraný): první nebo poslední spoj dne, na každém
 *                pár míst; v pokladně má vlastní přepážku a jízdenka
 *                z ní udělá průkazku se všemi jízdami
 *
 * Termíny kurzů i prodané permanentky jsou bez Supabase taky jen ukázkové.
 *
 * Japonské znaky jsou na stránce jen jednou: svislý nápis 胡桃行き
 * („směr Ořech“) na první obrazovce. Všechno ostatní je česky.
 *
 * Předchozí varianta s destičkami ema je odložená na /rezervace-ema.
 */
import Hlava from "../components/Hlava.astro";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/rezervace.css";
import "../styles/rezervace-darky.css";
import { ClientRouter } from "astro:transitions";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import More from "../components/rezervace/More.astro";
import VlakKresby from "../components/rezervace/VlakKresby.astro";
import Nadrazi from "../components/rezervace/Nadrazi.astro";
import Pokladna from "../components/rezervace/Pokladna.astro";
import Odjezdy from "../components/rezervace/Odjezdy.astro";
import Rad from "../components/rezervace/Rad.astro";
import Jizdenka from "../components/rezervace/Jizdenka.astro";
import Darky from "../components/rezervace/Darky.astro";
import Noc from "../components/rezervace/Noc.astro";

import { rezervace, rozpetiJizdneho } from "../data/rezervace";
import { kontakt } from "../data/uvod2";

const cena = `${rozpetiJizdneho.od}–${rozpetiJizdneho.do}`;


---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="Rezervace · JIRO saku" popis={`Rezervuj si čas v keramické dílně v Ořechu. Každé úterý a pátek od ${rezervace.od} do ${rezervace.do} hodin, hodina v dílně trvá 90 minut, ${cena} Kč za člověka podle velikosti skupiny. Jízdenku jde i darovat.`} barva="#6F8FC8" />
    <ClientRouter />
  </head>
  <body class="p2 rz" data-stranka="rezervace">
    <a class="preskocit" href="#rz-pokladna">Přeskočit na výběr hodiny</a>
    <Nebe />
    <More />
    <VlakKresby />
    <Hlavicka sber="zadny" />

    <main data-rezervace>
      <Nadrazi />

      <section class="rz-sekce rz-hala" id="rz-pokladna" aria-labelledby="rz-pokladna-nadpis">
        <noscript>
          <p class="rz-noscript papir">Výběr hodiny potřebuje JavaScript. Napiš nám na <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a> a domluvíme se.</p>
        </noscript>
        <div class="rz-hala-mriz">
          <Pokladna />
          <div class="rz-hala-pravo">
            <Odjezdy />
            <Rad />
          </div>
        </div>
      </section>

      <Jizdenka />
      <Darky />
      <Noc />
    </main>

    {/* Displej nad dveřmi: co bude dál a co máš vybrané */}
    <div class="rz-displej" hidden>
      <p class="rz-displej-text">
        <span class="rz-displej-pristi">příští zastávka <b>jízdenka</b></span>
        <span class="rz-displej-souhrn"></span>
      </p>
      <a class="rz-displej-tlacitko" href="#rz-jizdenka">Pokračovat <span aria-hidden="true">→</span></a>
    </div>

    {/* Tušový flek (s patičkou): sedí na obloze nebo na moři, ne na panelech a ne v noci, kde by nebyl vidět */}
    <Paticka flekMimo=".papir, .rz-tabule, .rz-rad, #rz-noc" />

    <script>
      import "../scripts/rezervace/hlavni.ts";
    </script>
  </body>
</html>

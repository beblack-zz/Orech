---
/**
 * Rezervace v novém vzhledu: hodina v dílně se kupuje jako jízdenka na
 * vlak po vodě. Celá stránka stojí na moři pod oblohou (More.astro);
 * na obzoru je stanice Ořech a vlak, který ráno přijede, odjede,
 * když člověk sjede k výběru, a v noci se vrátí rozsvícený.
 *
 *   za svítání  nádraží: o co jde, kdy a za kolik, příští volný odjezd
 *   dopoledne   pokladna: kolik vás pojede a den (lepenkové jízdenky)
 *               a vedle klapková tabule s odjezdy toho dne — obloha
 *               ukazuje světlo hodiny, na kterou člověk ukazuje; pod
 *               tabulí je jízdní řád: cedule s celým měsícem naráz
 *               a pod ní vysvětlivky
 *   večer       jízdenka: z vybraných hodin se složí vláček, napíšeš
 *               jméno a průvodčí jízdenku označí — odejde mailem
 *   v noci      vlak se vrací, poslední odeslaná jízdenka, kontakt
 *
 * Pravidla jsou z data/rezervace.ts: úterý a pátek po hodinách od 9 do
 * 18, cena za člověka a hodinu. Hodina je buď volná, nebo obsazená
 * a zamlouvá se celá — sám nebo skupina do čtyř lidí. Stránka sama nic
 * neukládá na server: odeslání otevře e-mail s vyplněnými údaji.
 * Obsazenost je zatím simulovaná (scripts/rezervace/simulace.ts).
 *
 * Vedle hodin se tu kupují dvě věci, u kterých se počítají místa:
 *
 *   kurz         zabere celý den — hodinové spoje mají výluku a jede
 *                jeden zvláštní vlak: parní lokomotiva se
 *                salonem, v pokladně tmavá jízdenka, na tabuli cedule
 *                s místy a řádky jako zastávky programu, na jízdence
 *                mapa trasy
 *   permanentka  na tři měsíce a jeden den v týdnu (ten, který
 *                je vybraný): první nebo poslední spoj dne, na každém
 *                pár míst; v pokladně má vlastní přepážku a jízdenka
 *                z ní udělá průkazku se všemi jízdami
 *
 * Termíny kurzů i prodané permanentky jsou taky zatím jen ukázkové.
 *
 * Japonské znaky jsou na stránce jen jednou: svislý nápis 胡桃行き
 * („směr Ořech“) na první obrazovce. Všechno ostatní je česky.
 *
 * Předchozí varianta s destičkami ema je odložená na /rezervace-ema.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/caveat/400.css";
import "@fontsource/caveat/600.css";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/rezervace.css";
import { ClientRouter } from "astro:transitions";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import More from "../components/rezervace/More.astro";
import VlakKresby from "../components/rezervace/VlakKresby.astro";
import Nadrazi from "../components/rezervace/Nadrazi.astro";
import Pokladna from "../components/rezervace/Pokladna.astro";
import Odjezdy from "../components/rezervace/Odjezdy.astro";
import Rad from "../components/rezervace/Rad.astro";
import Jizdenka from "../components/rezervace/Jizdenka.astro";
import Noc from "../components/rezervace/Noc.astro";

import { rezervace } from "../data/rezervace";
import { kontakt } from "../data/uvod2";

const cena = rezervace.cena.toLocaleString("cs-CZ");

/* Štětcové písmo jen pro svislý nápis na první obrazovce (Nadrazi.astro) — jiné japonské znaky tu nejsou */
const pismoZnaku = `https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap&text=${encodeURIComponent("胡桃行き")}`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rezervace · JIRO saku</title>
    <meta name="description" content={`Rezervuj si hodinu v keramické dílně v Ořechu. Každé úterý a pátek od ${rezervace.od} do ${rezervace.do} hodin, ${cena} Kč za člověka a hodinu.`} />
    <meta name="theme-color" content="#6F8FC8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={pismoZnaku} />
    <ClientRouter />
  </head>
  <body class="p2 rz" data-stranka="rezervace">
    <a class="preskocit" href="#rz-pokladna">Přeskočit na výběr odjezdu</a>
    <Nebe />
    <More />
    <VlakKresby />
    <Hlavicka sber="zadny" />

    <main data-rezervace data-cena={rezervace.cena} data-email={kontakt.email}>
      <Nadrazi />

      <section class="rz-sekce rz-hala" id="rz-pokladna" aria-labelledby="rz-pokladna-nadpis">
        <noscript>
          <p class="rz-noscript papir">Výběr odjezdu potřebuje JavaScript. Napiš nám na <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a> a domluvíme se.</p>
        </noscript>
        <div class="rz-hala-mriz">
          <Pokladna />
          <div class="rz-hala-pravo">
            <Odjezdy />
            <Rad />
          </div>
        </div>
      </section>

      <Jizdenka />
      <Noc />
    </main>

    {/* Displej nad dveřmi: co bude dál a co máš vybrané */}
    <div class="rz-displej" hidden>
      <p class="rz-displej-text">
        <span class="rz-displej-pristi">příští zastávka <b>jízdenka</b></span>
        <span class="rz-displej-souhrn"></span>
      </p>
      <a class="rz-displej-tlacitko" href="#rz-jizdenka">Pokračovat <span aria-hidden="true">→</span></a>
    </div>

    <Paticka poznamka="Rezervace je návrh v novém vzhledu webu. Obsazenost odjezdů, termíny kurzů i prodané permanentky jsou zatím jen simulované." />

    <script>
      import "../scripts/rezervace/hlavni.ts";
    </script>
  </body>
</html>

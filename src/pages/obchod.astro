---
import Layout from "../layouts/Layout.astro";
import Vazicka from "../components/characters/Vazicka.astro";
import ProduktKarta from "../components/ProduktKarta.astro";
import { produkty as items, tvorba } from "../data/obchod";
import { pocetKusu } from "../data/pocty";
import Pecinka from "../components/characters/Pecinka.astro";
import Bublina from "../components/characters/Bublina.astro";
import { Image } from "astro:assets";
import Delic from "../components/Delic.astro";
import zdaleka1 from "../images/zdaleka-1.webp";
import zdaleka2 from "../images/zdaleka-2.webp";
import zdaleka3 from "../images/zdaleka-3.webp";
import zdaleka4 from "../images/zdaleka-4.webp";

/** Keramika zdaleka — čtyři místa, `null` je zatím prázdná karta. */
const zdaleka = [
  { src: zdaleka1, alt: "Neglazovaná miska se zdobením mřížky na poličce", name: "Unglazed", author: "Keiichi Miyagawa", price: "1 500 Kč" },
  { src: zdaleka2, alt: "Miska s modrozelenou stékající glazurou na poličce", name: "Hagi", author: "Seigan Yamane", price: "2 500 Kč" },
  { src: zdaleka3, alt: "Světlá miska s šedými točenými pruhy na poličce", name: "Banko", author: "Teruhisa Sato", price: "700 Kč" },
  { src: zdaleka4, alt: "Hrnek ze Shigaraki s hrubou světlou glazurou na poličce", name: "Shigaraki ware cup", author: "No name", price: "800 Kč" },
];

---

<Layout title="Obchod — JIRO saku" description="Ručně dělaná keramika od našich lektorů. Malé série, žádné dva stejné kusy.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_1fr] md:gap-12 md:items-center mb-12">
        <div>
          <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
            Ručně, kus po <span class="serif-italic-sakura">kuse.</span>
          </h1>
          <p class="text-stone text-[16px] leading-[1.75]">
            Všechno je točené na kruhu nebo modelované, ručně glazované a vypálené v peci. Něco vzniklo u nás v dílně, něco je od tvůrců, které máme rádi — někdy až z Japonska.
          </p>
        </div>
        <div class="flex justify-center md:justify-end mt-8 md:mt-0">
          <Bublina
            name="Pecinka"
            text="Za dva týdny to bude tvrdý jako kámen. Slibuju."
            side="right"
          >
            <Pecinka />
          </Bublina>
        </div>
      </div>

      <!-- Stejný tah štětcem jako v Delic.astro, jen bez vlastního kontejneru. -->
      <svg
        viewBox="0 0 900 14"
        preserveAspectRatio="none"
        class="block w-full h-[14px] text-espresso/25 mb-6"
        aria-hidden="true"
      >
        <path
          d="M0 8 C120 3 300 2 470 5 C640 8 790 10 900 6 C790 14 640 13 470 11 C300 9 120 11 0 8 Z"
          fill="currentColor"
        />
      </svg>
      <div class="flex items-center gap-2 mb-6 border-t border-espresso/10 pt-4">
        <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase">Na přání</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {items.map((it) => <ProduktKarta item={it} />)}
      </div>
      <span class="mono-meta block text-right mt-5">Na přání · {pocetKusu(items.length)}</span>
    </div>
  </section>

  <!--
    Druhá mřížka je galerie, ne nabídka: naši vlastní tvorbu oficiálně
    neprodáváme, takže tu nesmí být cena ani nic, co zní jako objednávka.
  -->
  <section class="pb-14 fade-up">
    <div class="container-x">
      <div class="flex items-center gap-2 mb-6 border-t-2 border-espresso pt-4">
        <h2 class="font-mono text-[12px] tracking-wider text-espresso uppercase">Naše tvorba</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {tvorba.map((it) => <ProduktKarta item={it} tmava />)}
      </div>
      <span class="mono-meta block text-right mt-5">Naše tvorba · {pocetKusu(tvorba.length)}</span>
    </div>
  </section>

  <!--
    Zatím jen čtyři prázdná místa — fotky a texty doplníme, až je budeme mít.
  -->
  <section class="pb-14 fade-up">
    <div class="container-x">
      <div class="flex items-center gap-2 mb-6 border-t-2 border-espresso pt-4">
        <h2 class="font-mono text-[12px] tracking-wider text-espresso uppercase">Keramika zdaleka</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {zdaleka.map((foto) => (
          <div class="rounded-xl border bg-white border-espresso/8">
            <div class="aspect-square bg-[#E8D7BF] rounded-t-xl overflow-hidden">
              {foto && (
                <Image
                  src={foto.src}
                  alt={foto.alt}
                  widths={[300, 450, 600, 900]}
                  sizes="(min-width: 768px) 283px, 50vw"
                  format="webp"
                  class="w-full h-full object-cover"
                />
              )}
            </div>
            <div class="p-3 rounded-b-xl min-h-[75px]">
              {foto?.name && <p class="font-serif text-[16px] font-medium m-0 mb-0.5">{foto.name}</p>}
              {foto?.author && <p class="font-mono text-[12px] mb-1 text-stone">{foto.author}</p>}
              {foto?.price && <p class="font-mono text-[14px] text-espresso font-medium">{foto.price}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Delic />

  <section class="bg-cream-warm py-14 fade-up">
    <div class="container-x">
      <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-6">Jak nakoupit</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="border-t border-espresso/10 pt-4">
          <span class="font-mono text-[12px] text-stone tracking-wider">01</span>
          <h3 class="font-serif italic text-[17px] text-sakura mb-1.5 mt-1">Vyber si</h3>
          <p class="text-stone text-[15px] leading-[1.7]">Prohlédni si, co máme. Každý kus je originál — co vidíš, to dostaneš.</p>
        </div>
        <div class="border-t border-espresso/10 pt-4">
          <span class="font-mono text-[12px] text-stone tracking-wider">02</span>
          <h3 class="font-serif italic text-[17px] text-sakura mb-1.5 mt-1">Napiš nám</h3>
          <p class="text-stone text-[15px] leading-[1.7]">Pošli mail s názvem kousku. Potvrdíme dostupnost a domluvíme platbu.</p>
        </div>
        <div class="border-t border-espresso/10 pt-4">
          <span class="font-mono text-[12px] text-stone tracking-wider">03</span>
          <h3 class="font-serif italic text-[17px] text-sakura mb-1.5 mt-1">Vyzvedni nebo pošleme</h3>
          <p class="text-stone text-[15px] leading-[1.7]">Osobní odběr v dílně nebo posíláme Zásilkovnou po celém Česku.</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-0">
        <Vazicka size={240} class="w-[96px] lg:w-[240px] h-auto pointer-events-none flex-shrink-0 lg:-mr-[100px] relative z-[2]" />
        <a
          href="mailto:ahoj@jirosaku.cz"
          class="relative z-[1] inline-flex items-center gap-2 bg-stone text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso transition-colors"
        >
          Objednat <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

---
/**
 * Parta 3 — nebeský chrám. Parta 2 je den v dílně (cesta hlíny od hroudy
 * po výpal); tohle je noc nad ní. Když dílna zhasne, kami vystoupají do
 * chrámu nad oblaky a hrají divadlo:
 *
 *   úvod      soumrak, ostrov s chrámem nad oblačným mořem (parta3/Uvod.astro)
 *   průvod    sedm podob Lampion jde po papírovém svitku (Pruvod.astro)
 *   divadlo   jeviště kagura-den: devět lampionů, opona, mekuri a program;
 *             vybraná postavička odehraje své vystoupení (Divadlo.astro,
 *             scripts/parta3/reziser.ts, choreografie ve scripts/parta3/vystoupeni)
 *   závěr     svítání, parta je zpátky dole na louce (Zaver.astro)
 *
 * Postavičky jsou přehnané podoby z /marcel (components/characters/kami-buh):
 * Kami a Tušový lem hrají na jevišti, Lampion jde v průvodu, Na schovávanou
 * jsou erby na lampionech a parta v závěru. Každá velká podoba smí být na
 * stránce jen jednou (pevná id v kresbách), proto je průvod i jeviště tady
 * a ne na víc místech.
 *
 * Vzhled, obloha, hlavička a patička jsou z Party 2 (styles/parta2.css),
 * vlastní věci stránky v styles/parta3.css.
 */
import "@fontsource-variable/fraunces/full.css";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/caveat/400.css";
import "@fontsource/caveat/600.css";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/schovka.css";
/* písmo značky: Cedulka má na lucerně JIRO */
import "../styles/znacka.css";
import "../styles/parta3.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import Uvod from "../components/parta3/Uvod.astro";
import Pruvod from "../components/parta3/Pruvod.astro";
import Divadlo from "../components/parta3/Divadlo.astro";
import Zaver from "../components/parta3/Zaver.astro";
import { cesta } from "../data/kami";

/*
 * Štětcové písmo na japonské znaky se stahuje jen s těmi, které na stránce
 * opravdu jsou (parametr text=). Poslední řádek jsou znaky uvnitř kreseb
 * z /marcel (štítky, brána, nádržka) — stejná sada jako tam.
 */
const znaky = new Set<string>();
const pridej = (s: string) => {
  for (const ch of s) if (/[　-ヿ一-鿿]/.test(ch)) znaky.add(ch);
};
cesta.forEach((c) => { pridej(c.znak); pridej(c.cislo); });
pridej("高天原神楽殿提灯行列満員御礼夜明け済一二三");
pridej("円相顔筆奉納稲荷五隹止矢");
const pismoZnaku = `https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap&text=${encodeURIComponent([...znaky].join(""))}`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Parta 3 — nebeský chrám · JIRO saku</title>
    <meta name="description" content="Když dílna zhasne, devět kami z Ořechu vystoupá do chrámu nad oblaky a hraje divadlo. Vyber si, kdo vystoupí." />
    <meta name="theme-color" content="#3A3C7C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={pismoZnaku} />
    <ClientRouter />
  </head>
  <body class="p2 p3" data-stranka="parta-3">
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      <Uvod />
      <Pruvod />
      <Divadlo />
      <Zaver />
    </main>

    <Paticka poznamka="Parta 3 je návrh: chrám nad oblaky, kde parta po nocích hraje divadlo. Kresby, pohyb i zvuky vznikají přímo v prohlížeči — žádné fotky, žádné nahrávky." />

    <script>
      import "../scripts/parta3/hlavni.ts";
    </script>
  </body>
</html>

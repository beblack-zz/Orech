---
/**
 * Úvod webu (dřív stránka Domek 2 na /domek-2, ta teď přesměrovává sem) —
 * dům a dílna v Ořechu nakreslené podle skutečných fotek
 * (images/Dilna, fotoorech). Stejný svět i řeč jako Parta 2 (obloha přes den, papír, parta, zvuky),
 * jen domeček s krovem a garáž v řezu nahradil skutečný zelený dům
 * a dílna v jeho suterénu. Jeden den v Luční:
 *
 *   svítání   — krajina z Party 2 se zeleným domem na stráni, text z Úvodu 2
 *   ráno      — ulice: brána odjede za zídku, rampou dolů k oknům dílny
 *   dopoledne — prohlídka dílny skrz okna, u každé zastávky fotka
 *   večer     — lampa svítí, parta jde s lucerničkami, kontakt
 *
 * Rok dílny (z garáže po havárii až do teď) se přestěhoval na O nás 2;
 * kresba a fotka přes sebe se sakurou během roku a Kudy k nám na Kontakt.
 * Kresby jsou generátory v components/domek2/kresba, styly
 * v styles/domek2.css nad parta2.css, dilna-rez.css, dilna-suteren.css
 * a uvod2.css.
 */
import Hlava from "../components/Hlava.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/dilna-rez.css";
import "../styles/dilna-suteren.css";
import "../styles/uvod2.css";
import "../styles/domek2.css";
import "../styles/uvod-zivot.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import Uvod from "../components/domek2/Uvod.astro";
import Ulice from "../components/domek2/Ulice.astro";
import Prohlidka from "../components/domek2/Prohlidka.astro";
import Vecer from "../components/domek2/Vecer.astro";

import { sezonaMesice } from "../data/uvod2";
import { rezervace, jizdne, dnySlovy } from "../data/rezervace";

const odKc = Math.min(...jizdne.skupina).toLocaleString("cs-CZ");

/** Roční období podle data buildu — skript ho v prohlížeči srovná podle dneška */
const sezona = sezonaMesice(new Date().getMonth() + 1);


---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="JIRO saku — keramická dílna v Ořechu u Prahy" popis={`Keramická dílna v zeleném domě v Ořechu u Prahy. Hodina v dílně s lektorem i bez něj od ${odKc} Kč, každé ${dnySlovy} ${rezervace.od}–${rezervace.do}. Sobotní kurzy, dárkové jízdenky a ručně dělaná keramika.`} barva="#6F8FC8" data />
    <ClientRouter />
  </head>
  <body class="p2 u2 dm2" data-stranka="domek-2">
    <a class="preskocit" href="#prohlidka">Přeskočit na prohlídku dílny</a>
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      <Uvod />
      <Ulice sezona={sezona} />
      <Prohlidka sezona={sezona} />
      <Vecer sezona={sezona} />
    </main>

    <Paticka />
    <div class="oznameni" role="status" aria-live="polite"></div>

    <script>
      import "../scripts/domek2/hlavni.ts";
    </script>
  </body>
</html>

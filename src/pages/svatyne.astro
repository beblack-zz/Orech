---
/**
 * Svatyně — třetí komnata hry se schovanými kami. Otevře se tomu, kdo
 * najde všech devět (omamori pod hlavičkou), a uvnitř se jednou vytáhne
 * omikuji s pokladem. V menu není: vede sem dlaždice Poklad v omamori
 * a oslava po devátém nálezu na Partě 2.
 *
 *   brána      noc v lese a malá svatyně Ořechu 胡桃神社, parta rozesetá
 *              po svatyni; zavřeno provazem, dokud chybí kami
 *              (components/svatyne/Brana.astro, kresba v ./kresba.ts)
 *   losování   krabička s jedinou tyčkou 九 a svislý lístek s ústřižkem:
 *              20 % sleva na první návštěvu a heslo do dílny
 *              (components/svatyne/Losovani.astro)
 *
 * Vzhled, obloha, hlavička a patička jsou z Party 2 (styles/parta2.css),
 * vlastní věci stránky v styles/svatyne.css, logika ve scripts/svatyne.
 */
import Hlava from "../components/Hlava.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/schovka.css";
import "../styles/svatyne.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import Brana from "../components/svatyne/Brana.astro";
import Losovani from "../components/svatyne/Losovani.astro";


---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="Svatyně · JIRO saku" popis="Za devět nalezených kami se otevře svatyně a v ní omikuji s pokladem." barva="#1B1D45" noindex />
    <ClientRouter />
  </head>
  <body class="p2 sv" data-stranka="svatyne">
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      <Brana />
      <Losovani />
    </main>

    <Paticka />

    <script>
      import "../scripts/svatyne/hlavni.ts";
    </script>
  </body>
</html>

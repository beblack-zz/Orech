---
/**
 * Futatsu — stránka podpisového hrnku z dílny (yunomi bez ouška, shino,
 * dva seříznuté výstupky). Jeden večer a noc u jednoho kusu: obloha jde
 * od soumraku přes noc do rána, data-hodina smí přes půlnoc jako na Dílně
 * (25,5 = půl druhé ráno).
 *
 *   20:24  úvod — Futatsu na lakované desce pod lampou, vezmi ho do ruky
 *   20:54  noren 拝見 — prohlídka, jako se po čaji prohlíží náčiní
 *   21:18  一 Podpis 銘 — dva výstupky a řap meče, kde podpis nikdo nevidí
 *   22:24  二 Výkres 図面 — modrotisk na rýsovacím prkně pod lampou
 *   01:30  三 Oheň 火 — co s ním udělala pec (Ohen.astro)
 *   04:36  四 Čas — krakelé tmavne čajem (Cas.astro)
 *   06:12  五 Origami 折紙 — osvědčení: parametry, péče, skutečná velikost
 *   07:12  závěr — do šátku (Zaver.astro)
 *   07:36  šátek
 *
 * Kapitoly začínají stejně (ft-kap: obří znak štětcem za obsahem, číslo,
 * název, podtitul rukou) a končí radou od někoho z party. V obchodě na
 * stránku vede třetí část krámku (components/obchod2/Podpis.astro).
 *
 * Kresby: components/obchod2/futatsu (výkres kresba.ts, hrnek podobizna.ts,
 * scény uvod.ts, mei.ts, prkno.ts, origami.ts, noc ohen.ts…). Chování
 * scripts/obchod2/futatsu.ts, styly styles/futatsu.css a futatsu-noc.css.
 * Předpony id v kresbách, ať se nic nepotká: ftu úvod, ftm řap meče, ftv lupa,
 * ftp prkno a lampa, ftw origami, dv/dvp/dvs výkres; hrnek fpu, odraz fpo,
 * výstupek fpm; noční kapitoly fto, ftc, ftz, fph, fpz.
 */
import Hlava from "../../components/Hlava.astro";
import "@fontsource-variable/jetbrains-mono";
import "../../styles/postavicky.css";
import "../../styles/parta2.css";
import "../../styles/obchod2.css";
import "../../styles/kramek.css";
import "../../styles/futatsu.css";
import { ClientRouter } from "astro:transitions";

import Nebe from "../../components/parta2/Nebe.astro";
import Hlavicka from "../../components/parta2/Hlavicka.astro";
import Paticka from "../../components/parta2/Paticka.astro";
import Satek from "../../components/obchod2/Satek.astro";
import Uvod from "../../components/obchod2/futatsu/Uvod.astro";
import Mei from "../../components/obchod2/futatsu/Mei.astro";
import Vykres from "../../components/obchod2/futatsu/Vykres.astro";
import Ohen from "../../components/obchod2/futatsu/Ohen.astro";
import Cas from "../../components/obchod2/futatsu/Cas.astro";
import Origami from "../../components/obchod2/futatsu/Origami.astro";
import Zaver from "../../components/obchod2/futatsu/Zaver.astro";
import { podpisove, kramek } from "../../data/kramek";
import * as K from "../../components/obchod2/futatsu/kresba";

const kus = podpisove.find((k) => k.podpis === "/obchod/futatsu")!;
const st = { a: 62 };


---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="Futatsu — hrnek bez ouška z dílny · JIRO saku" popis={`Futatsu: japonský hrnek na čaj bez ouška, glazura shino, dva seříznuté výstupky s holou hlínou. Točený v Ořechu, ${kus.cena}.`} barva="#3A3C7C" />
    <ClientRouter />
  </head>
  <body class="p2 o2" data-stranka="futatsu">
    <a class="preskocit" href="#ft-uvod">Přeskočit na Futatsu</a>
    <Nebe />
    <Hlavicka sber="zadny" />

    <main class="ft">
      <Uvod />

      <section class="ft-predel" id="prohlidka" data-hodina="20.9" aria-labelledby="prohlidka-nadpis">
        <div class="ft-noren">
          <span class="ft-noren-tyc" aria-hidden="true"></span>
          <div class="ft-noren-latka">
            <p class="ft-noren-znak" lang="ja" aria-hidden="true">拝見</p>
            <p class="ft-noren-stitek">Prohlídka · <span lang="ja">拝見</span> haiken</p>
            <h2 class="ft-noren-nazev" id="prohlidka-nadpis">Jedna noc s jedním hrnkem</h2>
            <p class="ft-noren-perex">
              Po čaji si hosté v Japonsku berou náčiní do dlaní a prohlížejí ho zblízka — okraj, boky, dno.
              Říká se tomu haiken. S Futatsu to uděláme stejně: pět zastavení přes jednu noc, od podpisu po osvědčení.
            </p>
            <span class="ft-noren-rozstrih" aria-hidden="true"><i></i><i></i></span>
          </div>
        </div>
      </section>

      <Mei />
      <Vykres />
      <Ohen />
      <Cas />
      <Origami />
      <Zaver />

      <Satek hodina={31.6} />
    </main>

    <Paticka flekMimo=".ft-scena, .ft-prkno, .ft-noren, .ft-washi, .ftn-scena" />
    <div class="oznameni" role="status" aria-live="polite"></div>

    <script>
      import "../../scripts/obchod2/futatsu.ts";
    </script>
  </body>
</html>

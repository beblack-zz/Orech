---
import Layout from "../layouts/Layout.astro";
import Postavicka from "../components/characters/Postavicka.astro";
import { parta } from "../data/parta";

/**
 * `token` je název proměnné z @theme — díky němu jde barvu za běhu
 * přepsat na <html> a celý web se překreslí, včetně těchhle vzorků.
 */
const colors = [
  { name: "Espresso", token: "espresso", hex: "#3A2E28", light: true },
  { name: "Cream", token: "cream", hex: "#F4EBDD", light: false },
  { name: "Cream Warm", token: "cream-warm", hex: "#EFE3D0", light: false },
  { name: "Terracotta", token: "terracotta", hex: "#C87E4E", light: true },
  { name: "Stone", token: "stone", hex: "#6B5D4F", light: true },
  { name: "Clay", token: "clay", hex: "#B84A2B", light: true },
  { name: "Peri", token: "peri", hex: "#6366F1", light: true },
  { name: "Mustard", token: "mustard", hex: "#E8B440", light: false },
  { name: "White", token: "white", hex: "#FFFFFF", light: false },
];

const fonts = [
  { name: "Fraunces", family: "var(--font-serif)", role: "Nadpisy", sample: "JIRO saku", style: "italic", weight: 500, opsz: "96" },
  { name: "Inter", family: "var(--font-sans)", role: "Text", sample: "Kurzy keramiky pro začátečníky i pokročilé", style: "normal", weight: 400, opsz: null },
  { name: "Caveat", family: "var(--font-hand)", role: "Akcent", sample: "— ručně psaný podpis", style: "normal", weight: 400, opsz: null },
  { name: "JetBrains Mono", family: "var(--font-mono)", role: "Meta", sample: "EST. 2026 · OŘECH", style: "normal", weight: 400, opsz: null },
];
---

<Layout title="Dizajn — JIRO saku" description="Vizuální identita a mood board dílny JIRO saku.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="max-w-[720px] mb-12">
        <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
          Mood <span class="serif-italic-terracotta">board.</span>
        </h1>
        <p class="text-stone text-[16px] leading-[1.75]">
          Teplé tóny, přírodní materiály, klid dílny. Vizuální jazyk Ořechové hlíny vychází z hlíny, dřeva a světla, co do ní padá odpoledne.
        </p>
      </div>

      <!-- Paleta barev -->
      <div class="mb-16">
        <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-5">Paleta barev</h2>
        <p class="font-mono text-[12px] tracking-wider text-stone uppercase mb-2">Původní</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-9 gap-3 mb-8">
          {colors.map((c) => (
            <div>
              <div
                class="flex aspect-square rounded-lg border border-espresso/8 items-end p-2.5"
                style={`background:${c.hex};`}
              >
                <span
                  class="font-mono text-[12px] tracking-wider opacity-70"
                  style={`color:${c.light ? '#F4EBDD' : '#3A2E28'};`}
                >
                  {c.hex}
                </span>
              </div>
              <p class="text-[14px] text-stone mt-1.5 text-center">{c.name}</p>
            </div>
          ))}
        </div>

        <div class="flex items-center gap-2 mb-2">
          <p class="font-mono text-[12px] tracking-wider text-stone uppercase">Zkusit jinou</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-9 gap-3" data-paleta>
          {colors.map((c) => (
            <div>
              <div
                class="relative flex aspect-square rounded-lg border border-espresso/8 items-end p-2.5 transition-transform hover:scale-[1.03] has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-peri"
                style={`background:var(--color-${c.token});`}
                data-vzorek
              >
                <span
                  class="font-mono text-[12px] tracking-wider opacity-70 pointer-events-none"
                  style={`color:${c.light ? '#F4EBDD' : '#3A2E28'};`}
                  data-hex
                >
                  {c.hex}
                </span>
                {/*
                  Průhledný input přes celý vzorek — klik tak vždycky spadne
                  rovnou na něj. Přes <label> to občas neotevřelo dialog.
                */}
                <input
                  type="color"
                  aria-label={`Změnit barvu ${c.name}`}
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  value={c.hex}
                  data-token={c.token}
                  data-vychozi={c.hex}
                />
              </div>
              <p class="text-[14px] text-stone mt-1.5 text-center">{c.name}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4">
          <p class="font-mono text-[12px] text-stone tracking-wider">
            Klikni na vzorek a vyber libovolnou jinou barvu — stránka se překreslí.
          </p>
          <button
            type="button"
            data-paleta-reset
            class="font-mono text-[12px] tracking-wider text-terracotta underline underline-offset-2 hover:text-clay transition-colors"
          >
            Vrátit původní
          </button>
        </div>
      </div>

      <!-- Typografie -->
      <div class="mb-16">
        <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-5">Typografie</h2>
        <div class="space-y-0 border-t border-espresso/10">
          {fonts.map((f) => (
            <div class="grid grid-cols-[100px_1fr] sm:grid-cols-[120px_1fr] items-baseline gap-4 py-5 border-b border-espresso/8">
              <span class="font-mono text-[12px] tracking-wider text-stone uppercase">{f.role}</span>
              <div>
                <p
                  class:list={[
                    "text-[24px] sm:text-[32px] leading-[1.2] tracking-tight",
                    f.name === "Caveat" && "text-terracotta",
                    f.name === "JetBrains Mono" && "text-[14px] sm:text-[16px] tracking-wider uppercase text-stone",
                  ]}
                  style={`font-family:${f.family}; font-style:${f.style}; font-weight:${f.weight};${f.opsz ? ` font-variation-settings:'opsz' ${f.opsz};` : ''}`}
                >
                  {f.sample}
                </p>
                <p class="font-mono text-[12px] text-stone mt-1">{f.name}{f.style === "italic" ? " Italic" : ""} · {f.weight}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mood -->
      <div class="mb-16">
        <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-5">Nálada</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="bg-espresso rounded-lg aspect-[3/4] flex flex-col items-center justify-center p-6 text-center">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mb-4 opacity-60">
              <circle cx="24" cy="24" r="20" stroke="#F4EBDD" stroke-width="1" />
              <circle cx="24" cy="24" r="8" fill="#C87E4E" opacity="0.7" />
            </svg>
            <span class="font-serif italic text-cream text-[18px]">Teplo</span>
            <span class="font-mono text-[12px] text-cream/75 mt-1 tracking-wider">ZEMITÉ TÓNY</span>
          </div>
          <div class="bg-terracotta rounded-lg aspect-[3/4] flex flex-col items-center justify-center p-6 text-center">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mb-4 opacity-60">
              <path d="M24 6 Q24 24 24 42" stroke="#F4EBDD" stroke-width="1" />
              <path d="M12 12 Q24 24 36 36" stroke="#F4EBDD" stroke-width="1" />
              <path d="M6 24 Q24 24 42 24" stroke="#F4EBDD" stroke-width="1" />
            </svg>
            <span class="font-serif italic text-cream text-[18px]">Řemeslo</span>
            <span class="font-mono text-[12px] text-cream/75 mt-1 tracking-wider">RUČNÍ PRÁCE</span>
          </div>
          <div class="bg-stone rounded-lg aspect-[3/4] flex flex-col items-center justify-center p-6 text-center">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mb-4 opacity-60">
              <rect x="10" y="10" width="28" height="28" rx="4" stroke="#F4EBDD" stroke-width="1" />
              <line x1="10" y1="24" x2="38" y2="24" stroke="#F4EBDD" stroke-width="0.5" opacity="0.5" />
              <line x1="24" y1="10" x2="24" y2="38" stroke="#F4EBDD" stroke-width="0.5" opacity="0.5" />
            </svg>
            <span class="font-serif italic text-cream text-[18px]">Jednoduchost</span>
            <span class="font-mono text-[12px] text-cream/75 mt-1 tracking-wider">ČISTÝ DESIGN</span>
          </div>
          <div class="bg-cream-warm rounded-lg aspect-[3/4] flex flex-col items-center justify-center p-6 text-center border border-espresso/8">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="mb-4 opacity-40">
              <ellipse cx="24" cy="40" rx="18" ry="4" fill="#3A2E28" opacity="0.15" />
              <path d="M14 18 Q14 10 24 10 Q34 10 34 18 Q36 30 32 38 Q28 42 24 42 Q20 42 16 38 Q12 30 14 18 Z" fill="none" stroke="#3A2E28" stroke-width="1" />
            </svg>
            <span class="font-serif italic text-espresso text-[18px]">Hlína</span>
            <span class="font-mono text-[12px] text-stone mt-1 tracking-wider">MATERIÁL</span>
          </div>
        </div>
      </div>

      <!-- Postavičky -->
      <div class="mb-16">
        <div class="flex items-baseline justify-between gap-4 mb-5">
          <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase">Postavičky</h2>
          <a href="/parta" class="mono-meta hover:text-terracotta">Seznam se s partou →</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
          {parta.map((p) => (
            <a href={`/parta#${p.id}`} class="flex flex-col items-center gap-3 group">
              <div class="transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:scale-[1.03]">
                <Postavicka id={p.id} size={140} />
              </div>
              <div class="text-center">
                <span class="block text-[15px] font-medium text-espresso group-hover:text-terracotta transition-colors">{p.name}</span>
                <span class="text-[12px] text-stone">{p.tagline}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Principy -->
      <div>
        <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-5">Principy</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <div class="border-t border-espresso/10 pt-4">
            <p class="font-serif italic text-[18px] text-espresso mb-1.5">Méně dokonalosti</p>
            <p class="text-stone text-[15px] leading-[1.7]">Ručně dělaná keramika není o&nbsp;přesnosti. Stejně tak design — drobné nerovnosti dodávají charakter.</p>
          </div>
          <div class="border-t border-espresso/10 pt-4">
            <p class="font-serif italic text-[18px] text-espresso mb-1.5">Teplé a zemité</p>
            <p class="text-stone text-[15px] leading-[1.7]">Barvy vycházejí z&nbsp;přírodních materiálů — hlíny, dřeva, glazury. Žádné křiklavé tóny.</p>
          </div>
          <div class="border-t border-espresso/10 pt-4">
            <p class="font-serif italic text-[18px] text-espresso mb-1.5">Prostor k dýchání</p>
            <p class="text-stone text-[15px] leading-[1.7]">Hodně bílého místa, klidná typografie. Web má působit jako odpolední ticho v&nbsp;dílně.</p>
          </div>
        </div>
      </div>
      <span class="mono-meta block text-right mt-8">Vizuální identita</span>
    </div>
  </section>

<script>
  /**
   * Vzorky paletky přepisují proměnné z @theme přímo na <html>. Tailwind
   * z nich čte všechny utility (bg-espresso, text-stone, …), takže změna
   * jedné hodnoty překreslí celou stránku, ne jen ten čtvereček.
   *
   * Výběr se ukládá do localStorage a Layout ho po každém přechodu mezi
   * stránkami nanese znovu — klientský router jinak inline styl z <html>
   * smaže a barvy by se po návratu na /dizajn tvářily jako rozbité.
   */
  const KLIC = "paleta";

  const nactiUlozene = (): Record<string, string> => {
    try {
      return JSON.parse(localStorage.getItem(KLIC) || "{}");
    } catch (err) {
      return {};
    }
  };

  const ulozStav = (stav: Record<string, string>) => {
    try {
      localStorage.setItem(KLIC, JSON.stringify(stav));
    } catch (err) {}
  };

  /** Světlá, nebo tmavá? Podle toho se obarví popisek s hexem. */
  const jeSvetla = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const kanal = (v: number) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    };
    const jas =
      0.2126 * kanal((n >> 16) & 255) +
      0.7152 * kanal((n >> 8) & 255) +
      0.0722 * kanal(n & 255);
    return jas > 0.4;
  };

  const zapoj = () => {
    const paleta = document.querySelector<HTMLElement>("[data-paleta]");
    // Router vrací pokaždé čerstvé DOM; tenhle příznak hlídá dvojí navěšení.
    if (!paleta || paleta.dataset.zapojeno) return;
    paleta.dataset.zapojeno = "1";

    const vstupy = paleta.querySelectorAll<HTMLInputElement>("input[type=color]");

    const naneseni = (vstup: HTMLInputElement, zapsat = true) => {
      const { token } = vstup.dataset;
      if (!token) return;
      const hex = vstup.value.toUpperCase();
      document.documentElement.style.setProperty(`--color-${token}`, hex);

      const popisek = vstup
        .closest("[data-vzorek]")
        ?.querySelector<HTMLElement>("[data-hex]");
      if (popisek) {
        popisek.textContent = hex;
        popisek.style.color = jeSvetla(hex) ? "#3A2E28" : "#F4EBDD";
      }

      if (zapsat) {
        const stav = nactiUlozene();
        stav[token] = hex;
        ulozStav(stav);
      }
    };

    // Vzorky ukazují, co je opravdu nastavené — i po návratu z jiné stránky.
    const ulozene = nactiUlozene();
    for (const vstup of vstupy) {
      const token = vstup.dataset.token ?? "";
      if (ulozene[token]) {
        vstup.value = ulozene[token];
        naneseni(vstup, false);
      }
    }

    // `input` chodí průběžně při tažení, `change` až po potvrzení dialogu.
    // Systémový barvoměnič ve Windows umí poslat jen to druhé.
    for (const vstup of vstupy) {
      vstup.addEventListener("input", () => naneseni(vstup));
      vstup.addEventListener("change", () => naneseni(vstup));
    }

    document
      .querySelector<HTMLButtonElement>("[data-paleta-reset]")
      ?.addEventListener("click", () => {
        try {
          localStorage.removeItem(KLIC);
        } catch (err) {}
        for (const vstup of vstupy) {
          vstup.value = vstup.dataset.vychozi ?? vstup.value;
          naneseni(vstup, false);
        }
        // Až po obnově popisků — naneseni cestou zase sáhne na inline styl.
        document.documentElement.removeAttribute("style");
      });
  };

  zapoj();
  document.addEventListener("astro:page-load", zapoj);
</script>
</Layout>

---
/**
 * Marcel — pracovní stránka: postavičky jako kami a návrhy jejich tváří,
 * v novém vzhledu (obloha, hlavička a papír z Party 2, styles/marcel.css).
 * Každá postavička leží na vlastním papíře, obloha za nimi jde od rána do noci.
 *
 * Vázička jako gejša (VazickaGejsa.astro) má stejné podoby jako Střípek,
 * Pecinka a Bublinka pod ní: Kami (stojí před kruhem ze značky a má ve
 * vlasech i ve váze květy měsíce; kliknutí ji zatočí a vymění jí je za
 * další), Tušový lem — zatím ve dvou návrzích, než se vybere: 02a dokud hoří
 * tyčinka (tančí s vějířem a kouř se skládá do tvarů) a 02b hadí oko (v dešti
 * na můstku pod deštníkem janome, zezadu) —, Lampion a Na schovávanou
 * (VazickaSchovka.astro). Původní kresba s kruhem (VazickaEnso.astro) zůstává
 * dole u návrhů tváří.
 *
 * Kapka a hrom (KapkaHrom.astro) má stejné čtyři podoby jako Střípek,
 * Pecinka a Bublinka pod ní: Kami (na bouřkovém mráčku, za zády kruh sedmi
 * bubnů hromu; do dolních bije paličkami, do ostatních stuhou a z mráčku
 * po každé ráně víc prší), Tušový lem (buben je měsíc: zády k nám bije na
 * lešení do velkého bubnu, jehož kůže je úplněk), Lampion — jde na geta
 * s kulatou lucernou — a Na schovávanou (KapkaSchovka.astro). Původní
 * kresba (KapkaRaijin.astro) a podoba se stuhou (KapkaBubny.astro)
 * zůstávají jako komponenty, ale na stránce už nejsou.
 *
 * Střípek a zlato (StripekZlato.astro) má čtyři podoby jako Pecinka
 * a Bublinka pod ním: Kami (medituje na obláčku, za zády svatozář z okraje
 * rozbitého talíře slepeného zlatem), Tušový lem (prasklá noc: tma praská
 * a on trhliny zalévá štětcem svítivou žlutou, až se rozední), Lampion — letí na
 * obláčku s lucernou slepenou zlatem — a Na schovávanou
 * (StripekSchovka.astro). Původní kresba (StripekKintsugi.astro) zůstává
 * jako komponenta, ale na stránce už není.
 *
 * Pecinka s ohněm (PecinkaOhen.astro) má čtyři podoby ve dvou řadách a pod
 * každou jméno: Kami (plamenná svatozář) a Tušový lem (raku v noční tuši),
 * pod nimi Lampion — bez pozadí jde s čóčinem jako průvod na Domku 2 —
 * a Na schovávanou: malá Pecinka pro hry na hledání ve čtyřech barvách
 * (PecinkaSchovka.astro). Prskavka na vějíři v komponentě zůstává, ale na
 * stránce není.
 *
 * Bublinka jako strašidlo (BublinkaStrasidlo.astro) má stejné čtyři podoby
 * jako Pecinka: Kami (studený oheň kolem kotouče z nočního laku, v něm za
 * ní rohatý duch), Tušový lem (hřbitov hrnců, vede dušičky se zvonkem),
 * Lampion — letí s lucernou, ve které svítí bludička — a Na schovávanou
 * (BublinkaSchovka.astro). Nosí černý slaměný klobouk.
 *
 * Cedulka jako ema (CedulkaEma.astro) má stejné čtyři podoby: Kami (visí
 * před lakovaným kotoučem, na rubu má koně), Tušový lem (noční dílna,
 * kde při měsíci ryje jména do den misek a ta jména svítí), Lampion —
 * jde v dřevěných botičkách z rohu na roh a nese lucernu s nápisem JIRO —
 * a Na schovávanou (CedulkaSchovka.astro). Svatyně Inari s lišáckými
 * destičkami v komponentě zůstává, ale na stránce už není.
 *
 * Kachlík a rovina (KachlikRovina.astro) stejně: nahoře bez pozadí
 * šestiruký se čtvercovou svatozáří, pod ním zen zahrada a kachlová kamna.
 * Pod nimi je Na schovávanou (KachlikSchovka.astro): malý Kachlík pro hry
 * na hledání ve čtyřech barvách, s vodováhou na hlavě.
 *
 * Hlínka, kami země (HlinkaZeme.astro), má stejné podoby jako Pecinka,
 * Bublinka a Střípek: Kami (spí pod posvátnou sakurou, koruna je
 * svatozář; kreslená čistě jako ta s lampionem), Tušový lem (mokré ruce: spí na hrnčířském kruhu a ruce
 * z noci ji vytáčejí do tvarů), Lampion — jde ze spaní a lampion jí vyrostl
 * z výhonku — a Na schovávanou (HlinkaSchovka.astro). Původní sakura,
 * drak nad Fudži a suikinkutsu v komponentě zůstávají, ale na stránce
 * už nejsou.
 *
 * Šamotka nese (SamotkaNese.astro) taky: nahoře bez pozadí jako kamidana,
 * polička pro kami se svatyní a zvoncem, pod ní řez pecí s celým výpalem
 * a zimní noc v kulatém okně, kde se na ni slétají vrabci a přijde kočka.
 * Pod nimi je Na schovávanou (SamotkaSchovka.astro): malá Šamotka
 * s cizí miskou na zádech a žárem pod sebou.
 */
import "../styles/pisma.css";
import Hlava from "../components/Hlava.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/marcel.css";
/* písmo značky: Cedulka má na lucerně JIRO */
import "../styles/znacka.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import VazickaEnso from "../components/characters/kami-buh/VazickaEnso.astro";
import VazickaGejsa from "../components/characters/kami-buh/VazickaGejsa.astro";
import VazickaSchovka from "../components/characters/kami-buh/VazickaSchovka.astro";
import KapkaHrom from "../components/characters/kami-buh/KapkaHrom.astro";
import KapkaSchovka from "../components/characters/kami-buh/KapkaSchovka.astro";
import StripekZlato from "../components/characters/kami-buh/StripekZlato.astro";
import StripekSchovka from "../components/characters/kami-buh/StripekSchovka.astro";
import PecinkaOhen from "../components/characters/kami-buh/PecinkaOhen.astro";
import PecinkaSchovka from "../components/characters/kami-buh/PecinkaSchovka.astro";
import BublinkaStrasidlo from "../components/characters/kami-buh/BublinkaStrasidlo.astro";
import BublinkaSchovka from "../components/characters/kami-buh/BublinkaSchovka.astro";
import CedulkaEma from "../components/characters/kami-buh/CedulkaEma.astro";
import CedulkaSchovka from "../components/characters/kami-buh/CedulkaSchovka.astro";
import KachlikRovina from "../components/characters/kami-buh/KachlikRovina.astro";
import KachlikSchovka from "../components/characters/kami-buh/KachlikSchovka.astro";
import HlinkaZeme from "../components/characters/kami-buh/HlinkaZeme.astro";
import HlinkaSchovka from "../components/characters/kami-buh/HlinkaSchovka.astro";
import SamotkaNese from "../components/characters/kami-buh/SamotkaNese.astro";
import SamotkaSchovka from "../components/characters/kami-buh/SamotkaSchovka.astro";
import Postavicka from "../components/characters/Postavicka.astro";
import Kami from "../components/parta2/Kami.astro";
import Louka from "../components/parta2/Louka.astro";
import Lucernicka from "../components/parta2/Lucernicka.astro";
import IgPrispevek from "../components/marcel/IgPrispevek.astro";
import { parta } from "../data/parta";
import type { PostavaId } from "../data/parta";

/** Pořadí v průvodu s lucerničkami — stejné jako na Úvodu 2 */
const pruvodLucernicek: PostavaId[] = ["kachlik", "vazicka", "kapka", "pecinka", "hlinka", "stripek", "cedulka", "bublinka", "samotka"];

const tvare = [
  { id: "original", cislo: "Teď", nazev: "Původní", popis: "Zavřená očka do úsměvu." },
  { id: "klidna", cislo: "01", nazev: "Klidná", popis: "Víčka prohnutá dolů, jako spící Buddha. Malá ústa." },
  { id: "otevrena", cislo: "02", nazev: "Otevřená", popis: "Dvě tečky s leskem, jak kreslí Ghibli malé duchy." },
  { id: "mrk", cislo: "03", nazev: "Mrk", popis: "Jedno oko zavřené, úsměv do strany. Ví víc, než říká." },
  { id: "gejsa", cislo: "04", nazev: "Gejša", popis: "Bílé oshiroi, vysoké obočí, rumělka v koutcích, ústa jako poupě a kanzashi u hrdla." },
  { id: "no", cislo: "05", nazev: "Maska nó", popis: "Obočí vysoko na čele, oči štěrbiny, rty s černěnými zuby." },
  { id: "stydliva", cislo: "06", nazev: "Stydlivá", popis: "Velký ruměnec s čárkami a rozpačitá vlnka." },
  { id: "prisna", cislo: "07", nazev: "Přísná", popis: "Obočí dolů, víčka napůl. Takhle kouká, když se hrbíš." },
  { id: "udivena", cislo: "08", nazev: "Udivená", popis: "Kulaté oči, zvednuté obočí a ústa do o." },
  { id: "ospala", cislo: "09", nazev: "Ospalá", popis: "Víčka těžká, pusa pootevřená, z hrdla stoupá zzz." },
  { id: "kocici", cislo: "10", nazev: "Kočičí", popis: "Spokojená očka a pusinka ω." },
] as const;

const rukopisy = [
  { id: "kawaii", cislo: "11", nazev: "Kawaii", popis: "Velké lesklé oči se dvěma odlesky, ruměnec, pusinka jako D." },
  { id: "tus", cislo: "12", nazev: "Tuš", popis: "Tři tahy štětcem s přítlakem a vytaženou špičkou." },
  { id: "kaomoji", cislo: "13", nazev: "Kaomodži", popis: "◕‿◕ — oči jako znaky z japonských smajlíků." },
  { id: "daruma", cislo: "14", nazev: "Daruma", popis: "Husté obočí, knír a jedno oko domalované. Druhé, až se splní přání." },
  { id: "kokeshi", cislo: "15", nazev: "Kokeši", popis: "Tenké linky jako na dřevěné panence, oči lístky, ústa dvě rumělkové tečky." },
  { id: "kabuki", cislo: "16", nazev: "Kabuki", popis: "Líčení kumadori: rumělkové linky ke spánkům, rty dolů." },
  { id: "kodama", cislo: "17", nazev: "Kodama", popis: "Tři tmavé díry jako lesní duchové z Princezny Mononoke." },
  { id: "otafuku", cislo: "18", nazev: "Otafuku", popis: "Maska štěstí: tečky obočí vysoko, buclaté tváře, drobná ústa." },
  { id: "sashiko", cislo: "19", nazev: "Sašiko", popis: "Obličej vyšitý indigovou nití, na tvářích rumělkové křížky." },
  { id: "kintsugi", cislo: "20", nazev: "Kintsugi", popis: "Oči a úsměv jako zlaté spáry, jedna prasklina utíká po tváři." },
] as const;

/** Vzorník technik (ze stránky /parta). Každá postavička drží jednu — až padne volba, sjednotí se. */
const styly: Record<PostavaId, string> = {
  hlinka: "Linoryt",
  kapka: "Risograf",
  pecinka: "Výkres",
  stripek: "Tušový tah",
  vazicka: "Art deco",
  bublinka: "Glazura",
  kachlik: "Bauhaus",
  cedulka: "Vystřižený papír",
  samotka: "Mědirytina",
};


---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="Marcel — JIRO saku" popis="Pracovní stránka: postavičky z dílny jako kami a návrhy jejich tváří." barva="#4F5E9C" noindex />
    <ClientRouter />
  </head>
  <body class="p2 mc" data-stranka="marcel">
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      {/* Vázička jako gejša: podoby ve dvou řadách jako u Střípka, pod každou číslo a jméno; tušový lem je zatím ve dvou návrzích (02a, 02b) */}
      <section class="mc-sekce" data-hodina="8" aria-labelledby="mc-marcel">
        <div class="papir mc-siroky">
          <h1 id="mc-marcel" class="mc-jen-ctecky">Marcel</h1>
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <VazickaGejsa varianta="kvety" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <VazickaGejsa varianta="tycinka" />
              <figcaption><span class="mc-cislo">02a</span><span class="mc-nazev">Tušový lem · Tyčinka</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <VazickaGejsa varianta="destnik" />
              <figcaption><span class="mc-cislo">02b</span><span class="mc-nazev">Tušový lem · Hadí oko</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <VazickaGejsa varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <VazickaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Kapka a hrom: čtyři podoby ve dvou řadách jako u Střípka, pod každou číslo a jméno (starší návrhy jsou v navrhy/kapka-bubny-hromu.html) */}
      <section class="mc-sekce" data-hodina="11" aria-label="Kapka a hrom">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <KapkaHrom varianta="kruh" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <KapkaHrom varianta="buben" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <KapkaHrom varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <KapkaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Střípek a zlato: čtyři podoby ve dvou řadách jako u Pecinky, pod každou číslo a jméno */}
      <section class="mc-sekce" data-hodina="14" aria-label="Střípek a zlato">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <StripekZlato varianta="prstenec" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <StripekZlato varianta="noc" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <StripekZlato varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <StripekSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Pecinka s ohněm: čtyři podoby ve dvou řadách, pod každou číslo a jméno */}
      <section class="mc-sekce" data-hodina="15.3" aria-label="Pecinka s ohněm">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <PecinkaOhen varianta="v1" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <PecinkaOhen varianta="v2" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <PecinkaOhen varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <PecinkaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Bublinka jako strašidlo: čtyři podoby ve dvou řadách jako u Pecinky, pod každou číslo a jméno */}
      <section class="mc-sekce" data-hodina="15.6" aria-label="Bublinka jako strašidlo">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <BublinkaStrasidlo varianta="ohen" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <BublinkaStrasidlo varianta="hrbitov" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <BublinkaStrasidlo varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <BublinkaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Hlínka, kami země: čtyři podoby ve dvou řadách jako u Pecinky, pod každou číslo a jméno */}
      <section class="mc-sekce" data-hodina="15.75" aria-label="Hlínka, kami země">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <HlinkaZeme varianta="sakura" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <HlinkaZeme varianta="ruce" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <HlinkaZeme varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <HlinkaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Cedulka jako ema: čtyři podoby ve dvou řadách jako u Pecinky, pod každou číslo a jméno */}
      <section class="mc-sekce" data-hodina="15.9" aria-label="Cedulka jako ema">
        <div class="papir mc-siroky">
          <div class="mc-rada mc-rada-ohen">
            <figure class="mc-podoba">
              <CedulkaEma varianta="v1" />
              <figcaption><span class="mc-cislo">01</span><span class="mc-nazev">Kami</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <CedulkaEma varianta="v2" />
              <figcaption><span class="mc-cislo">02</span><span class="mc-nazev">Tušový lem</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <CedulkaEma varianta="lampion" />
              <figcaption><span class="mc-cislo">03</span><span class="mc-nazev">Lampion</span></figcaption>
            </figure>
            <figure class="mc-podoba">
              <CedulkaSchovka />
              <figcaption><span class="mc-cislo">04</span><span class="mc-nazev">Na schovávanou</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* Kachlík a rovina: nahoře bez pozadí, pod ní dvě scény, jen obrázky bez textů; pod nimi Na schovávanou se jménem jako u ostatních */}
      <section class="mc-sekce" data-hodina="16.2" aria-label="Kachlík a rovina">
        <div class="papir mc-siroky mc-kachlik">
          <KachlikRovina varianta="v1" class="mc-kachlik-hlavni" />
          <div class="mc-rada mc-rada-kachlik">
            <KachlikRovina varianta="v2" />
            <KachlikRovina varianta="v3" />
          </div>
          <figure class="mc-podoba mc-podoba-sama">
            <KachlikSchovka />
            <figcaption><span class="mc-nazev">Na schovávanou</span></figcaption>
          </figure>
        </div>
      </section>

      {/* Šamotka nese: nahoře bez pozadí kamidana, pod ní výpal a sníh, jen obrázky bez textů; pod nimi Na schovávanou se jménem jako u ostatních */}
      <section class="mc-sekce" data-hodina="16.46" aria-label="Šamotka nese">
        <div class="papir mc-siroky mc-samotka">
          <SamotkaNese varianta="v1" class="mc-samotka-hlavni" />
          <div class="mc-rada mc-rada-samotka">
            <SamotkaNese varianta="v2" />
            <SamotkaNese varianta="v3" />
          </div>
          <figure class="mc-podoba mc-podoba-sama">
            <SamotkaSchovka />
            <figcaption><span class="mc-nazev">Na schovávanou</span></figcaption>
          </figure>
        </div>
      </section>

      {/* Celá parta ze stránky /parta: řada s tvářemi a vzorník dospělých stylů */}
      <section class="mc-sekce" data-hodina="16.5" aria-label="Parta">
        <div class="papir mc-siroky">
          <p class="stitek">Parta</p>
          <ul class="mc-parta">
            {parta.map((p) => (
              <li>
                <Postavicka id={p.id} size={120} />
                <span class="mc-jmeno">{p.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Tatáž parta jako malá kami s lucerničkami — noční průvod z Úvodu 2 (uvod2/Noc.astro), tady na vlastním kousku noci; klik = replika */}
      <section class="mc-sekce" data-hodina="17.5" aria-label="Průvod s lucerničkami">
        <div class="papir mc-siroky">
          <figure class="mc-podoba">
            <div class="mc-lucernicky" role="group" aria-label="Noční průvod party — klikni na kohokoli">
              {pruvodLucernicek.map((id, i) => (
                <div class="mc-lucernicky-clen" style={`--i:${i}`}>
                  <Lucernicka />
                  <Kami id={id} class="pruvod-kami" />
                </div>
              ))}
              <Louka class="mc-lucernicky-louka" seed={5} />
            </div>
            <figcaption><span class="mc-nazev">Průvod s lucerničkami</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="mc-sekce" data-hodina="18.5" aria-labelledby="mc-dospela">
        <div class="papir mc-siroky">
          <h2 id="mc-dospela" class="nadpis-2">Dospělá verze — <em>devět stylů</em></h2>
          <p class="mc-perex">
            Každá postavička je nakreslená jinou technikou, žádná nemá tvář.
            Není to hotová sada — je to vzorník. Vyber si číslo a celá parta se překreslí do něj.
          </p>
          <ul class="mc-vzornik">
            {parta.map((p, i) => (
              <li>
                <Postavicka id={p.id} size={140} varianta="dospela" />
                <span class="mc-cislo">{String(i + 1).padStart(2, "0")}</span>
                <span class="mc-styl">{styly[p.id]}</span>
                <span class="mc-jmeno">{p.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Deset návrhů tvářičky, vlevo nahoře původní pro srovnání */}
      <section class="mc-sekce" data-hodina="20.5" aria-labelledby="mc-tvare">
        <div class="papir mc-siroky">
          <p class="stitek">Tvářička · <span lang="ja">顔</span></p>
          <h2 id="mc-tvare" class="nadpis-2">Deset návrhů</h2>
          <ul class="mc-mrizka">
            {tvare.map((t) => (
              <li>
                <figure>
                  <VazickaEnso size={200} tvar={t.id} />
                  <figcaption>
                    <span class="mc-cislo">{t.cislo}</span>
                    <span class="mc-nazev">{t.nazev}</span>
                    <span class="mc-popis">{t.popis}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Druhá desítka: stejná Vázička, jiný rukopis tváře */}
      <section class="mc-sekce" data-hodina="22.5" aria-labelledby="mc-rukopisy">
        <div class="papir mc-siroky">
          <p class="stitek">Tvářička · rukopis · <span lang="ja">筆</span></p>
          <h2 id="mc-rukopisy" class="nadpis-2">Deset stylů</h2>
          <ul class="mc-mrizka">
            {rukopisy.map((t) => (
              <li>
                <figure>
                  <VazickaEnso size={180} tvar={t.id} />
                  <figcaption>
                    <span class="mc-cislo">{t.cislo}</span>
                    <span class="mc-nazev">{t.nazev}</span>
                    <span class="mc-popis">{t.popis}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Příspěvek na Instagram — dřív samostatná stránka /ig-prispevek */}
      <section class="mc-sekce" data-hodina="23.2" aria-labelledby="mc-instagram">
        <div class="papir mc-siroky">
          <p class="stitek">Instagram · příspěvek 4 : 5</p>
          <h2 id="mc-instagram" class="nadpis-2">Pecinka na Instagramu</h2>
          <IgPrispevek />
        </div>
      </section>
    </main>

    <Paticka />

    <script>
      import "../scripts/marcel/hlavni.ts";
    </script>
  </body>
</html>

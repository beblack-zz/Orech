---
import Nahled from "../../layouts/Nahled.astro";
---

<Nahled
  title="Ořechová hlína jako výkres"
  fonts="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans+Condensed:wght@300;400;600&display=swap"
>
  <style is:global>
    /*
      Výkres: celá stránka je jeden technický list. Milimetrový podklad,
      rámeček archu, kóty s šipkami a dole rohové razítko s měřítkem
      a číslem listu. Jediná tloušťka čáry na obrys, tenčí na kóty.
      Barva je jenom jedna a je vyhrazená kótám — nikdy dekoraci.
    */
    :root {
      --papir:  #F4F1E9;
      --ink:    #2E3B4E;
      --ink-2:  rgba(46, 59, 78, 0.62);
      --ink-3:  rgba(46, 59, 78, 0.3);
      --mrizka: rgba(46, 59, 78, 0.11);
      --kota:   #C0392B;
      --sirka:  1160px;
      --okraj:  clamp(18px, 4vw, 46px);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--papir);
      background-image:
        linear-gradient(var(--mrizka) 1px, transparent 1px),
        linear-gradient(90deg, var(--mrizka) 1px, transparent 1px);
      background-size: 40px 40px, 40px 40px;
      color: var(--ink);
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-weight: 300;
      font-size: 15px;
      line-height: 1.7;
    }
    .list { max-width: var(--sirka); margin: 0 auto; padding: 0 var(--okraj); }

    /* Rámeček archu — u skutečného výkresu je vždycky */
    .arch { border: 1px solid var(--ink); margin: clamp(10px,2vw,22px); background: rgba(244,241,233,0.82); }

    h1, h2, h3 { margin: 0; font-family: "IBM Plex Sans Condensed", sans-serif; font-weight: 300; text-wrap: balance; line-height: 1.02; }
    p { margin: 0; max-width: 66ch; }
    a { color: inherit; text-decoration: none; }
    :where(a, button):focus-visible { outline: 1px solid var(--kota); outline-offset: 4px; }
    .lbl { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-2); }

    header { border-bottom: 1px solid var(--ink); }
    .hl { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; padding: 16px var(--okraj); }
    .znak { font-family: "IBM Plex Sans Condensed", sans-serif; font-size: 17px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; }
    nav { display: flex; flex-wrap: wrap; gap: 3px 20px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
    nav a:hover { color: var(--ink); }
    nav .skrt { text-decoration: line-through 1px var(--kota); color: var(--ink-3); }

    .hero { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(24px,4vw,52px); align-items: center; padding: clamp(32px,5vw,64px) var(--okraj); border-bottom: 1px solid var(--ink); }
    .hero h1 { font-size: clamp(38px, 6.4vw, 78px); font-weight: 300; }
    .hero h1 b { font-weight: 600; }
    .hero .uvod { margin-top: 24px; color: var(--ink-2); }
    .akce { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .btn { border: 1px solid var(--ink); padding: 10px 20px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
    .btn:hover { background: var(--ink); color: var(--papir); }
    .btn-k { border-color: var(--kota); color: var(--kota); }
    .btn-k:hover { background: var(--kota); border-color: var(--kota); color: var(--papir); }

    .sekce { padding: clamp(30px,4.4vw,58px) var(--okraj); border-bottom: 1px solid var(--ink); }
    .hlava { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 26px; }
    .hlava h2 { font-size: clamp(24px,3.4vw,38px); font-weight: 400; }

    /* Řádky výkresu jsou tabulka, ne karty — výkres karty nezná */
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 13px 14px 13px 0; border-bottom: 1px dashed var(--ink-3); vertical-align: top; }
    thead th { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-2); font-weight: 400; border-bottom: 1px solid var(--ink); padding-bottom: 8px; }
    tbody tr:last-child td { border-bottom: 0; }
    td.pozice { font-variant-numeric: tabular-nums; color: var(--ink-2); width: 44px; }
    td.nazev { font-family: "IBM Plex Sans Condensed", sans-serif; font-size: 18px; }
    td.pozn { color: var(--ink-2); }
    td.stav { text-align: right; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
    tr.vybrano td.nazev::after { content: " ✱"; color: var(--kota); }

    .udalost { display: grid; grid-template-columns: auto 1fr; gap: clamp(20px,4vw,52px); align-items: center; }
    .udalost .kdy { font-family: "IBM Plex Sans Condensed", sans-serif; font-size: clamp(46px,8vw,86px); font-weight: 300; line-height: 0.86; color: var(--kota); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .udalost .kdy small { display: block; font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: 0.2em; color: var(--ink-2); margin-top: 14px; }
    .udalost h2 { font-size: clamp(24px,3.4vw,38px); margin-bottom: 10px; }
    .udalost p { color: var(--ink-2); }

    .odilne { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(24px,4vw,52px); align-items: center; }
    .odilne h2 { font-size: clamp(26px,4vw,44px); margin-bottom: 18px; }
    .odilne p { color: var(--ink-2); }
    .odilne p + p { margin-top: 14px; }

    .parta { display: grid; grid-template-columns: repeat(9,1fr); gap: 14px 10px; align-items: end; }
    .parta figure { margin: 0; text-align: center; }
    .parta figcaption { font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); margin-top: 8px; }
    .parta .cis { display: block; font-size: 9px; color: var(--kota); }

    /* Rohové razítko */
    .razitko { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); }
    .razitko div { padding: 12px 14px; border-right: 1px solid var(--ink); }
    .razitko div:last-child { border-right: 0; }
    .razitko b { display: block; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-2); font-weight: 400; margin-bottom: 4px; }

    @media (max-width: 900px) {
      .hero, .odilne, .udalost { grid-template-columns: 1fr; }
      .parta { grid-template-columns: repeat(5,1fr); }
      .razitko { grid-template-columns: repeat(2,1fr); }
      .razitko div:nth-child(2) { border-right: 0; }
      .razitko div:nth-child(1), .razitko div:nth-child(2) { border-bottom: 1px solid var(--ink); }
    }
    @media (max-width: 560px) {
      td.pozn { display: none; }
      .parta { grid-template-columns: repeat(3,1fr); }
    }
  </style>

  <div class="arch">
    <header>
      <div class="hl">
        <a href="#" class="znak">Ořechová hlína</a>
        <nav>
          <a href="#">Úvod</a><a href="#">Kurzy</a><a href="#" class="skrt">Pro děti</a>
          <a href="#">Parta</a><a href="#">Open studio</a><a href="#">Obchod</a>
          <a href="#" class="skrt">Dizajn</a><a href="#">O nás</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="hero">
        <div>
          <p class="lbl">List 01 · Keramická dílna · Luční 235, Ořech</p>
          <h1 style="margin-top:20px;">Uč se keramiku tam,<br>kde má hlína <b>čas.</b></h1>
          <p class="uvod">Malá dílna v Ořechu... kurzy pro začátečníky i pokročilé, workshopy, semináře, open studio pro volnou tvorbu a keramika, která vám bude doma dělat radost.</p>
          <div class="akce">
            <a href="#" class="btn">Vybrat kurz</a>
            <a href="#" class="btn">Zjistit open studio</a>
            <a href="#" class="btn btn-k">Rezervovat</a>
          </div>
        </div>

        <!-- Kruh v řezu, okótovaný. Průměr hlavy kruhu je reálný údaj. -->
        <svg viewBox="0 0 400 380" style="width:100%;height:auto;display:block;" role="img" aria-label="Hrnčířský kruh ve výkresu, okótovaný">
          <g stroke="#2E3B4E" fill="none">
            <path d="M200 30 V330" stroke-width="0.7" stroke-dasharray="14 4 3 4" opacity="0.6"/>
            <ellipse cx="200" cy="120" rx="118" ry="30" stroke-width="1.6"/>
            <path d="M82 120 V142 M318 120 V142" stroke-width="1.6"/>
            <path d="M82 142 C82 160 318 160 318 142" stroke-width="1.6"/>
            <path d="M188 150 V250 M212 150 V250" stroke-width="1.4"/>
            <path d="M120 250 H280 L292 288 H108 Z" stroke-width="1.6"/>
            <ellipse cx="200" cy="120" rx="62" ry="15" stroke-width="0.9" opacity="0.55"/>
            <ellipse cx="200" cy="120" rx="26" ry="6" stroke-width="0.9" opacity="0.45"/>
          </g>
          <g stroke="#C0392B" fill="none" stroke-width="0.9">
            <path d="M82 84 H318"/>
            <path d="M82 76 V96 M318 76 V96"/>
            <path d="M82 84 l14 -4 v8 Z" fill="#C0392B"/>
            <path d="M318 84 l-14 -4 v8 Z" fill="#C0392B"/>
            <path d="M348 120 V288"/>
            <path d="M340 120 H356 M340 288 H356"/>
          </g>
          <rect x="168" y="72" width="64" height="22" fill="#F4F1E9"/>
          <text x="200" y="88" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill="#C0392B">⌀ 300</text>
          <text x="366" y="208" font-family="IBM Plex Mono, monospace" font-size="12" fill="#C0392B" transform="rotate(90 366 208)" text-anchor="middle">560</text>
          <text x="200" y="330" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.6" fill="rgba(46,59,78,0.62)">HRNČÍŘSKÝ KRUH — ŘEZ A–A</text>
          <text x="200" y="360" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="2.4" fill="rgba(46,59,78,0.4)">PŘIJĎ SI SEDNOUT KE KRUHU</text>
        </svg>
      </div>

      <section class="sekce">
        <div class="udalost">
          <div class="kdy">10.9.<small>10:00—16:00</small></div>
          <div>
            <p class="lbl">Termín mimo rozpis</p>
            <h2 style="margin-top:8px;">Den otevřených dveří</h2>
            <p>Přijď se podívat, jak dílna funguje zevnitř. Uvidíš točení na kruhu, nahlédneš do pece a osaháš si hlínu, i kdybys ji v ruce nikdy neměl. Ptát se můžeš na cokoliv.</p>
          </div>
        </div>
      </section>

      <section class="sekce">
        <div class="hlava"><h2>Co u nás najdeš</h2><span class="lbl">Katalog · 4 položky</span></div>
        <table>
          <thead><tr><th>Poz.</th><th>Název</th><th>Popis</th><th style="text-align:right;">Rozsah</th></tr></thead>
          <tbody>
            <tr><td class="pozice">01</td><td class="nazev">Workshopy</td><td class="pozn">Jednorázové zážitkové kurzy. Ideální na dárek nebo teambuilding.</td><td class="stav">3 hodiny</td></tr>
            <tr><td class="pozice">02</td><td class="nazev">Kurzy</td><td class="pozn">Vícedenní cykly pro začátečníky i pokročilé. Kruh, technika, glazování.</td><td class="stav">4–10 lekcí</td></tr>
            <tr class="vybrano"><td class="pozice">03</td><td class="nazev">Open studio</td><td class="pozn">Rezervuj si čas u kruhu bez instruktora. Členství i jednorázový vstup.</td><td class="stav">na hodiny</td></tr>
            <tr><td class="pozice">04</td><td class="nazev">Obchod</td><td class="pozn">Keramika od nás i našich lektorů. Malé série, žádné dva stejné.</td><td class="stav">malé série</td></tr>
          </tbody>
        </table>
        <p class="lbl" style="margin-top:14px;">✱ nejoblíbenější</p>
      </section>

      <section class="sekce">
        <div class="hlava"><h2>Nejbližší termíny</h2><span class="lbl">Podzim 2026 · 4 kurzy</span></div>
        <table>
          <thead><tr><th>Datum</th><th>Kurz</th><th>Rozpis</th><th style="text-align:right;">Stav</th></tr></thead>
          <tbody>
            <tr><td class="pozice">04.11.</td><td class="nazev">Kurz kruhu pro začátečníky</td><td class="pozn">4 lekce · středy 18:00 · Jiřík</td><td class="stav">Připravujeme</td></tr>
            <tr><td class="pozice">14.11.</td><td class="nazev">Víkendový workshop — mísy a talíře</td><td class="pozn">2 dny · so–ne 10:00 · Renča</td><td class="stav">Připravujeme</td></tr>
            <tr><td class="pozice">21.11.</td><td class="nazev">Glazování — pokročilý seminář</td><td class="pozn">1 den · sobota 09:00 · Jiřík</td><td class="stav">Připravujeme</td></tr>
            <tr><td class="pozice">28.11.</td><td class="nazev">Kurz kruhu — pokročilí</td><td class="pozn">6 lekcí · soboty 10:00 · Renča</td><td class="stav">Připravujeme</td></tr>
          </tbody>
        </table>
      </section>

      <section class="sekce">
        <div class="odilne">
          <div>
            <p class="lbl">Provozovna</p>
            <h2 style="margin-top:8px;">O dílně</h2>
            <p>Začínáme v roce 2026 s jednou pecí, dvěma stoly, třemi kruhy a spoustou nadšení. Malá dílna v Ořechu, kde má hlína čas a každá chyba svůj tvar.</p>
            <p>Kurzy vedou dva lektoři, každý s vlastním rukopisem. Pro děti, dospělé, začátečníky i pro pokročilé, kteří chtějí posunout, co už umí.</p>
            <p class="lbl" style="margin-top:22px;">1 pec · 2 lektoři · 3 kruhy</p>
          </div>
          <svg viewBox="0 0 360 260" style="width:100%;height:auto;display:block;" role="img" aria-label="Půdorys dílny">
            <g stroke="#2E3B4E" fill="none">
              <rect x="24" y="24" width="312" height="196" stroke-width="1.6"/>
              <circle cx="88" cy="92" r="22" stroke-width="1.2"/><circle cx="150" cy="92" r="22" stroke-width="1.2"/><circle cx="212" cy="92" r="22" stroke-width="1.2"/>
              <rect x="62" y="150" width="122" height="40" stroke-width="1.2"/>
              <rect x="204" y="150" width="112" height="40" stroke-width="1.2"/>
              <rect x="262" y="50" width="60" height="66" stroke-width="1.6"/>
              <path d="M262 116 h60" stroke-width="0.8" stroke-dasharray="4 3"/>
            </g>
            <g fill="rgba(46,59,78,0.62)" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1">
              <text x="88" y="96" text-anchor="middle">K1</text><text x="150" y="96" text-anchor="middle">K2</text><text x="212" y="96" text-anchor="middle">K3</text>
              <text x="123" y="174" text-anchor="middle">STŮL 1</text><text x="260" y="174" text-anchor="middle">STŮL 2</text>
              <text x="292" y="88" text-anchor="middle">PEC</text>
            </g>
            <text x="180" y="248" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="2" fill="rgba(46,59,78,0.4)">PŮDORYS · M 1:50</text>
          </svg>
        </div>
      </section>

      <section class="sekce">
        <div class="hlava"><h2>Parta</h2><span class="lbl">Poz. 01–09</span></div>
        <div class="parta">
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><path d="M18 52 C18 30 28 16 35 14 C42 16 52 30 52 52 Z" stroke-width="1.4"/><ellipse cx="35" cy="52" rx="24" ry="5" stroke-width="1.4"/></svg><span class="cis">01</span><figcaption>Hlínka</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><path d="M35 8 C24 30 19 42 19 49 C19 58 26 63 35 63 C44 63 51 58 51 49 C51 42 46 30 35 8 Z" stroke-width="1.4"/></svg><span class="cis">02</span><figcaption>Kapka</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><rect x="14" y="18" width="42" height="44" stroke-width="1.4"/><rect x="23" y="32" width="24" height="22" stroke-width="1"/><path d="M42 18 V8 h10 v10" stroke-width="1.4"/></svg><span class="cis">03</span><figcaption>Pecinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><path d="M14 26 C16 50 24 62 35 62 C46 62 54 50 56 26 Z" stroke-width="1.4"/><ellipse cx="35" cy="26" rx="21" ry="5" stroke-width="1.4"/><path d="M40 30 L33 44 L41 54 L36 62" stroke="#C0392B" stroke-width="1.4"/></svg><span class="cis">04</span><figcaption>Střípek</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><path d="M29 10 L28 22 C18 32 15 46 18 56 C21 62 27 65 35 65 C43 65 49 62 52 56 C55 46 52 32 42 22 L41 10 Z" stroke-width="1.4"/><path d="M26 10 h18" stroke-width="1.4"/></svg><span class="cis">05</span><figcaption>Vázička</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><circle cx="35" cy="36" r="24" stroke-width="1.4"/><circle cx="35" cy="36" r="24" stroke-width="0.7" stroke-dasharray="3 3" transform="scale(0.6) translate(23 24)"/></svg><span class="cis">06</span><figcaption>Bublinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><rect x="14" y="14" width="42" height="42" stroke-width="1.4"/><rect x="21" y="21" width="28" height="28" stroke-width="0.8"/></svg><span class="cis">07</span><figcaption>Kachlík</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><rect x="21" y="16" width="28" height="46" stroke-width="1.4"/><circle cx="35" cy="24" r="3" stroke-width="1"/><path d="M26 46 h18 M26 53 h11" stroke="#C0392B" stroke-width="1.4"/></svg><span class="cis">08</span><figcaption>Cedulka</figcaption></figure>
          <figure><svg viewBox="0 0 70 70" aria-hidden="true" stroke="#2E3B4E" fill="none"><rect x="6" y="30" width="58" height="16" stroke-width="1.4"/><path d="M14 56 h42" stroke="#C0392B" stroke-width="1.2"/></svg><span class="cis">09</span><figcaption>Šamotka</figcaption></figure>
        </div>
      </section>
    </main>

    <!-- Rohové razítko: u výkresu je to povinná část listu, ne dekorace -->
    <div class="razitko">
      <div><b>Název</b>Ořechová hlína — keramická dílna</div>
      <div><b>Místo</b>Luční 235, Ořech u Prahy</div>
      <div><b>Výpal</b>1000 °C · 2 týdny do vyzvednutí</div>
      <div><b>List</b>01 / 01 · M 1:50 · 2026</div>
    </div>
  </div>
</Nahled>

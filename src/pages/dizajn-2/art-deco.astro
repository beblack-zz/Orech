---
import Nahled from "../../layouts/Nahled.astro";
---

<Nahled
  title="Ořechová hlína v art deco"
  fonts="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Jost:wght@200;300;400;500&display=swap"
>
  <style is:global>
    /*
      Art deco: tmavý plný podklad a do něj tenká zlatá intarzie.
      Všechno je souměrné podle osy — deco asymetrii nezná. Zlato je
      jediná barva a nese linku, ne plochu; kdyby se jím vyplňovalo,
      byla by z toho zlatá stránka, ne intarzie.
    */
    :root {
      --pozadi:  #14181C;
      --pozadi-2:#1B2126;
      --zlato:   #C9A227;
      --zlato-2: rgba(201, 162, 39, 0.42);
      --zlato-3: rgba(201, 162, 39, 0.18);
      --text:    #EFE7D6;
      --text-2:  rgba(239, 231, 214, 0.66);
      --sirka:   1080px;
      --okraj:   clamp(20px, 5vw, 64px);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--pozadi);
      color: var(--text);
      font-family: "Jost", system-ui, sans-serif;
      font-weight: 300;
      font-size: 17px;
      line-height: 1.8;
      text-align: center;
    }
    .list { max-width: var(--sirka); margin: 0 auto; padding: 0 var(--okraj); }
    h1, h2, h3 { margin: 0; font-family: "Cinzel", Georgia, serif; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.14; text-wrap: balance; }
    p { margin: 0 auto; max-width: 56ch; color: var(--text-2); }
    a { color: inherit; text-decoration: none; }
    :where(a, button):focus-visible { outline: 1px solid var(--zlato); outline-offset: 5px; }
    .lbl { font-family: "Jost", sans-serif; font-size: 11px; font-weight: 400; letter-spacing: 0.36em; text-transform: uppercase; color: var(--zlato); }

    /* Zlatá dvojlinka s kosočtvercem uprostřed — základní deco oddělovač */
    .delic { display: flex; align-items: center; justify-content: center; gap: 12px; margin: clamp(26px,4vw,46px) 0; }
    .delic i { display: block; height: 1px; width: min(180px, 26vw); background: var(--zlato-2); }
    .delic b { display: block; width: 7px; height: 7px; background: var(--zlato); transform: rotate(45deg); }

    header { padding: 26px 0 0; }
    .znak { font-family: "Cinzel", serif; font-size: 20px; letter-spacing: 0.42em; text-transform: uppercase; display: inline-block; }
    nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 26px; margin-top: 18px; font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-2); }
    nav a:hover { color: var(--zlato); }
    nav .skrt { text-decoration: line-through 1px var(--zlato); opacity: 0.45; }

    .ram { border: 1px solid var(--zlato-3); padding: clamp(28px,5vw,64px) 0; margin: 22px 0 0; position: relative; }
    .ram::before, .ram::after { content: ""; position: absolute; width: 12px; height: 12px; border: 1px solid var(--zlato-2); transform: rotate(45deg); }
    .ram::before { top: -6px; left: 50%; margin-left: -6px; background: var(--pozadi); }
    .ram::after { bottom: -6px; left: 50%; margin-left: -6px; background: var(--pozadi); }

    .hero h1 { font-size: clamp(30px, 5.4vw, 62px); }
    .hero .uvod { margin-top: 24px; }
    .akce { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 34px; }
    .btn { border: 1px solid var(--zlato); color: var(--zlato); padding: 12px 26px; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; transition: background .2s, color .2s; }
    .btn:hover { background: var(--zlato); color: var(--pozadi); }

    section { padding: clamp(44px,6vw,78px) 0; }
    .hlava h2 { font-size: clamp(24px,3.6vw,40px); }
    .hlava .lbl { display: block; margin-bottom: 12px; }

    .udalost { border-top: 1px solid var(--zlato-3); border-bottom: 1px solid var(--zlato-3); padding: clamp(28px,4vw,48px) 0; }
    .udalost .kdy { font-family: "Cinzel", serif; font-size: clamp(38px,6vw,68px); color: var(--zlato); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
    .udalost h2 { font-size: clamp(22px,3.2vw,34px); margin: 12px 0 14px; }

    /* Nabídka je souměrná mřížka, ne karty — deco nezná zaoblený roh */
    .nabidka { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 30px; }
    .polozka { padding: 26px 18px; border-right: 1px solid var(--zlato-3); display: flex; flex-direction: column; gap: 10px; align-items: center; }
    .polozka:last-child { border-right: 0; }
    .polozka h3 { font-size: 19px; }
    .polozka p { font-size: 15px; line-height: 1.65; }
    .polozka .jdi { margin-top: auto; padding-top: 14px; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--zlato); }
    .polozka-top { background: var(--pozadi-2); }
    .polozka-top h3::after { content: " ◆"; color: var(--zlato); font-size: 11px; vertical-align: middle; }

    .termin { display: grid; grid-template-columns: 1fr; gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--zlato-3); }
    .termin:first-of-type { border-top: 1px solid var(--zlato-3); }
    .termin .kdy { font-family: "Cinzel", serif; font-size: 21px; color: var(--zlato); letter-spacing: 0.1em; }
    .termin h3 { font-size: 20px; }
    .termin .rozpis { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-2); }
    .termin .popis { font-size: 15px; }
    .termin .stav { font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--zlato-2); margin-top: 4px; }

    .odilne p + p { margin-top: 16px; }
    .odilne h2 { font-size: clamp(26px,4.2vw,46px); margin-bottom: 22px; }

    .parta { display: grid; grid-template-columns: repeat(9,1fr); gap: 18px 10px; align-items: end; margin-top: 26px; }
    .parta figure { margin: 0; }
    .parta figcaption { font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-2); margin-top: 10px; }

    footer { padding: 0 0 48px; }
    .tiraz { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--text-2); display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 30px; }

    @media (max-width: 900px) { .nabidka { grid-template-columns: repeat(2,1fr); } .polozka:nth-child(2) { border-right: 0; } .polozka:nth-child(1), .polozka:nth-child(2) { border-bottom: 1px solid var(--zlato-3); } .parta { grid-template-columns: repeat(5,1fr); } }
    @media (max-width: 560px) { .nabidka { grid-template-columns: 1fr; } .polozka { border-right: 0; border-bottom: 1px solid var(--zlato-3); } .parta { grid-template-columns: repeat(3,1fr); } }
  </style>

  <header>
    <div class="list">
      <a href="#" class="znak">Ořechová hlína</a>
      <nav>
        <a href="#">Úvod</a><a href="#">Kurzy</a><a href="#" class="skrt">Pro děti</a>
        <a href="#">Parta</a><a href="#">Open studio</a><a href="#">Obchod</a>
        <a href="#" class="skrt">Dizajn</a><a href="#">O nás</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="list">
      <div class="ram hero">
        <span class="lbl">Keramická dílna · Luční 235, Ořech</span>
        <div class="delic"><i></i><b></b><i></i></div>
        <h1>Uč se keramiku tam,<br>kde má hlína čas.</h1>
        <p class="uvod">Malá dílna v Ořechu — kurzy pro začátečníky i pokročilé, open studio pro volnou tvorbu a keramika, kterou si odneseš domů.</p>
        <div class="akce">
          <a href="#" class="btn">Vybrat kurz</a>
          <a href="#" class="btn">Open studio</a>
          <a href="#" class="btn">Rezervovat</a>
        </div>

        <!-- Vějíř: nejdecovější motiv, tady jako hrnčířský kruh viděný shora -->
        <svg viewBox="0 0 420 300" style="width:100%;max-width:420px;height:auto;display:block;margin:38px auto 0;" role="img" aria-label="Vějíř nad hrnčířským kruhem">
          <g stroke="#C9A227" fill="none">
            <g stroke-width="1">
              <path d="M210 250 V96"/><path d="M210 250 L168 110"/><path d="M210 250 L252 110"/>
              <path d="M210 250 L128 132"/><path d="M210 250 L292 132"/>
              <path d="M210 250 L96 166"/><path d="M210 250 L324 166"/>
              <path d="M210 250 L76 206"/><path d="M210 250 L344 206"/>
            </g>
            <path d="M76 206 C96 132 148 92 210 92 C272 92 324 132 344 206" stroke-width="1.6"/>
            <path d="M92 224 C110 160 154 126 210 126 C266 126 310 160 328 224" stroke-width="0.8" opacity="0.6"/>
            <path d="M40 250 H380" stroke-width="1.6"/>
            <path d="M60 264 H360" stroke-width="0.8" opacity="0.5"/>
          </g>
          <g fill="#C9A227">
            <path d="M210 74 l8 8 -8 8 -8 -8 Z"/>
            <path d="M210 250 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0"/>
          </g>
          <text x="210" y="292" text-anchor="middle" font-family="Jost, sans-serif" font-size="11" letter-spacing="4.4" fill="rgba(239,231,214,0.66)">PŘIJĎ SI SEDNOUT KE KRUHU</text>
        </svg>
      </div>
    </div>

    <section>
      <div class="list">
        <div class="udalost">
          <span class="lbl">10—16 hodin</span>
          <div class="kdy" style="margin-top:8px;">10. IX. 2026</div>
          <h2>Den otevřených dveří</h2>
          <p>Přijď se podívat, jak dílna funguje zevnitř. Uvidíš točení na kruhu, nahlédneš do pece a osaháš si hlínu, i kdybys ji v ruce nikdy neměl. Ptát se můžeš na cokoliv.</p>
        </div>
      </div>
    </section>

    <section style="padding-top:0;">
      <div class="list">
        <div class="hlava"><span class="lbl">Katalog</span><h2>Co u nás najdeš</h2></div>
        <div class="nabidka">
          <div class="polozka"><span class="lbl" style="font-size:10px;">3 hodiny</span><h3>Workshopy</h3><p>Jednorázové zážitkové kurzy. Ideální na dárek nebo teambuilding.</p><a href="#" class="jdi">Vybrat termín</a></div>
          <div class="polozka"><span class="lbl" style="font-size:10px;">4–8 lekcí</span><h3>Kurzy</h3><p>Vícedenní cykly pro začátečníky i pokročilé. Kruh, technika, glazování.</p><a href="#" class="jdi">Prohlédnout</a></div>
          <div class="polozka polozka-top"><span class="lbl" style="font-size:10px;">na hodiny</span><h3>Open studio</h3><p>Rezervuj si čas u kruhu bez instruktora. Členství i jednorázový vstup.</p><a href="#" class="jdi">Zjistit více</a></div>
          <div class="polozka"><span class="lbl" style="font-size:10px;">malé série</span><h3>Obchod</h3><p>Keramika od nás i našich lektorů. Malé série, žádné dva stejné.</p><a href="#" class="jdi">Do obchodu</a></div>
        </div>
        <p class="lbl" style="margin-top:18px;font-size:10px;">◆ nejoblíbenější</p>
      </div>
    </section>

    <section style="padding-top:0;">
      <div class="list">
        <div class="hlava"><span class="lbl">Podzim 2026 · 4 kurzy</span><h2>Nejbližší termíny</h2></div>
        <div style="margin-top:28px;">
          <div class="termin"><div class="kdy">4. listopadu</div><h3>Kurz kruhu pro začátečníky</h3><p class="rozpis">4 lekce · středy 18:00 · Jiřík</p><p class="popis">Naučíš se základy točení na kruhu — centrovat, vytahovat, tvarovat. Čtyři večery, vlastní tempo.</p><span class="stav">Připravujeme</span></div>
          <div class="termin"><div class="kdy">14. listopadu</div><h3>Víkendový workshop — mísy a talíře</h3><p class="rozpis">2 dny · so–ne 10:00 · Renča</p><p class="popis">Dva dny u kruhu zaměřené na ploché tvary. Glazování v ceně, hotové kousky vyzvedneš za 2 týdny.</p><span class="stav">Připravujeme</span></div>
          <div class="termin"><div class="kdy">21. listopadu</div><h3>Glazování — pokročilý seminář</h3><p class="rozpis">1 den · sobota 09:00 · Jiřík</p><p class="popis">Teorie i praxe glazur — oxidace, redukce, vrstvení. Pro ty, kdo už mají za sebou pár výpalů.</p><span class="stav">Připravujeme</span></div>
          <div class="termin"><div class="kdy">28. listopadu</div><h3>Kurz kruhu — pokročilí</h3><p class="rozpis">6 lekcí · soboty 10:00 · Renča</p><p class="popis">Víčka, džbány, sady. Pro ty, kdo zvládají základy a chtějí se posunout dál.</p><span class="stav">Připravujeme</span></div>
        </div>
      </div>
    </section>

    <section>
      <div class="list odilne">
        <div class="delic"><i></i><b></b><i></i></div>
        <h2>O dílně</h2>
        <p>Začínáme v roce 2026 s jednou pecí, dvěma stoly, třemi kruhy a spoustou nadšení. Malá dílna v Ořechu, kde má hlína čas a každá chyba svůj tvar.</p>
        <p>Kurzy vedou dva lektoři, každý s vlastním rukopisem. Pro děti, dospělé, začátečníky i pro pokročilé, kteří chtějí posunout, co už umí.</p>
        <p class="lbl" style="margin-top:26px;">1 pec · 2 lektoři · 3 kruhy</p>
      </div>
    </section>

    <section style="padding-top:0;">
      <div class="list">
        <div class="hlava"><span class="lbl">9 postaviček</span><h2>Parta</h2></div>
        <div class="parta">
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><path d="M18 56 C18 32 27 16 35 14 C43 16 52 32 52 56 Z"/><path d="M11 56 h48"/><path d="M35 56 V22 M35 56 L23 30 M35 56 L47 30"/></svg><figcaption>Hlínka</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><path d="M35 8 C24 32 19 44 19 52 C19 62 26 68 35 68 C44 68 51 62 51 52 C51 44 46 32 35 8 Z"/><path d="M35 68 V26 M35 68 L25 40 M35 68 L45 40"/></svg><figcaption>Kapka</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><rect x="14" y="20" width="42" height="46"/><rect x="23" y="34" width="24" height="22"/><path d="M42 20 V8 h10 v12"/><path d="M14 28 h42"/></svg><figcaption>Pecinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><path d="M14 28 C16 52 24 64 35 64 C46 64 54 52 56 28 Z"/><path d="M12 28 h46"/><path d="M40 32 L33 46 L41 56 L36 64"/></svg><figcaption>Střípek</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><path d="M29 12 L28 24 C18 34 15 48 18 58 C21 64 27 67 35 67 C43 67 49 64 52 58 C55 48 52 34 42 24 L41 12 Z"/><path d="M26 12 h18"/><path d="M18 44 h34 M20 49 h30"/></svg><figcaption>Vázička</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><circle cx="35" cy="38" r="24"/><path d="M35 14 L45 38 L35 62 L25 38 Z"/></svg><figcaption>Bublinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><rect x="14" y="16" width="42" height="42"/><rect x="22" y="24" width="26" height="26"/><path d="M14 16 L56 58 M56 16 L14 58" opacity="0.4"/></svg><figcaption>Kachlík</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><rect x="21" y="18" width="28" height="46"/><circle cx="35" cy="26" r="3"/><path d="M27 48 h16 M29 54 h12"/><path d="M35 18 C30 12 33 8 35 6"/></svg><figcaption>Cedulka</figcaption></figure>
          <figure><svg viewBox="0 0 70 78" aria-hidden="true" stroke="#C9A227" fill="none" stroke-width="1.2"><rect x="6" y="32" width="58" height="16"/><path d="M14 56 h42 M20 62 h30"/></svg><figcaption>Šamotka</figcaption></figure>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="list">
      <div class="delic"><i></i><b></b><i></i></div>
      <h2 style="font-size:clamp(24px,4vw,40px);">Přijď si zkusit,<br>jak se hlína točí.</h2>
      <div class="delic"><i></i><b></b><i></i></div>
      <div class="tiraz">
        <span>Keramická dílna · MMXXVI</span>
        <span>Luční 235, Ořech</span>
        <span>1000 °C · 2 týdny</span>
      </div>
    </div>
  </footer>
</Nahled>

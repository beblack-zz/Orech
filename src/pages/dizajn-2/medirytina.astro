---
import Nahled from "../../layouts/Nahled.astro";
---

<Nahled
  title="Jiro Saku rytinou"
  fonts="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@300;400&display=swap"
>
  <style is:global>
    /*
      Mědirytina: žádná plocha není vybarvená. Tón dělá výhradně hustota
      šrafy, obrys je vždycky silnější než tónová kresba pod ním.
      Stránka je vysázená jako katalogový list — dvě kolony, vlasové
      linky, číslované tabule a popisky kurzívou pod obrázkem.
    */
    :root {
      --papir:  #F2EDE0;
      --ink:    #23201B;
      --ink-2:  rgba(35, 32, 27, 0.7);
      --ink-3:  rgba(35, 32, 27, 0.42);
      --ink-4:  rgba(35, 32, 27, 0.16);
      --sepie:  #6B5540;
      --sirka:  1080px;
      --okraj:  clamp(20px, 5vw, 64px);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--papir); color: var(--ink); font-family: "EB Garamond", Georgia, serif; font-size: 18px; line-height: 1.72; }
    .list { max-width: var(--sirka); margin: 0 auto; padding: 0 var(--okraj); }
    h1, h2, h3 { margin: 0; font-family: "EB Garamond", Georgia, serif; font-weight: 400; line-height: 1.08; text-wrap: balance; }
    p { margin: 0; max-width: 62ch; }
    a { color: inherit; text-decoration: none; }
    :where(a, button):focus-visible { outline: 1px solid var(--sepie); outline-offset: 5px; }
    .kap { font-family: "JetBrains Mono", ui-monospace, monospace; font-weight: 300; font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-3); }
    .kurz { font-style: italic; color: var(--ink-2); }

    header { padding: 30px 0 0; }
    .hl { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 28px; padding-bottom: 14px; border-bottom: 2px solid var(--ink); }
    .znak { font-size: 26px; letter-spacing: 0.16em; text-transform: uppercase; }
    nav { display: flex; flex-wrap: wrap; gap: 3px 22px; font-family: "JetBrains Mono", monospace; font-weight: 300; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
    nav a:hover { color: var(--ink); }
    nav .skrt { text-decoration: line-through 1px var(--sepie); color: var(--ink-3); }
    .podlinka { border-bottom: 1px solid var(--ink); margin-top: 3px; }

    .hero { display: grid; grid-template-columns: 1fr 0.82fr; gap: clamp(26px,4vw,60px); align-items: center; padding: clamp(38px,6vw,76px) 0; }
    .hero h1 { font-size: clamp(40px, 6.4vw, 78px); }
    .hero h1 em { color: var(--sepie); }
    .hero .uvod { margin-top: 24px; color: var(--ink-2); }
    .akce { display: flex; flex-wrap: wrap; gap: 12px 26px; margin-top: 32px; }
    .odkaz { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; border-bottom: 1px solid var(--ink-3); padding-bottom: 6px; }
    .odkaz:hover { border-bottom-color: var(--sepie); color: var(--sepie); }

    figure { margin: 0; }
    figure figcaption { font-family: "EB Garamond", serif; font-style: italic; font-size: 15px; color: var(--ink-2); text-align: center; margin-top: 12px; }
    figure figcaption b { font-family: "JetBrains Mono", monospace; font-style: normal; font-weight: 400; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); display: block; margin-bottom: 4px; }

    section { padding: clamp(40px,5.4vw,72px) 0; border-top: 1px solid var(--ink-4); }
    .hlava { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 26px; margin-bottom: 28px; }
    .hlava h2 { font-size: clamp(28px,4vw,44px); }

    .udalost { display: grid; grid-template-columns: auto 1fr; gap: clamp(22px,4vw,54px); align-items: baseline; }
    .udalost .kdy { font-size: clamp(44px,7vw,80px); line-height: 0.9; color: var(--sepie); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .udalost .kdy small { display: block; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.2em; color: var(--ink-3); margin-top: 12px; }
    .udalost h2 { font-size: clamp(26px,3.6vw,40px); margin-bottom: 10px; }

    /* Katalog je sázený do dvou kolon jako soupis tabulí */
    .soupis { column-count: 2; column-gap: clamp(26px,4vw,56px); column-rule: 1px solid var(--ink-4); }
    .zaznam { break-inside: avoid; padding: 0 0 22px; margin-bottom: 22px; border-bottom: 1px solid var(--ink-4); }
    .zaznam h3 { font-size: 25px; margin-bottom: 3px; }
    .zaznam p { font-size: 16px; color: var(--ink-2); margin-top: 6px; }
    .zaznam .jdi { display: inline-block; margin-top: 10px; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sepie); }
    .zaznam-vyb h3::after { content: " ❋"; font-size: 14px; color: var(--sepie); }

    .termin { display: grid; grid-template-columns: 120px 1fr auto; gap: 12px 28px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--ink-4); }
    .termin:first-of-type { border-top: 1px solid var(--ink-4); }
    .termin .kdy { font-size: 22px; color: var(--sepie); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .termin h3 { font-size: 23px; margin-bottom: 3px; }
    .termin .popis { font-size: 16px; color: var(--ink-2); margin-top: 6px; }
    .termin .stav { font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); white-space: nowrap; }

    .odilne { display: grid; grid-template-columns: 1fr 0.78fr; gap: clamp(26px,4vw,60px); align-items: center; }
    .odilne h2 { font-size: clamp(30px,4.6vw,54px); margin-bottom: 20px; }
    .odilne p { color: var(--ink-2); }
    .odilne p + p { margin-top: 14px; }

    .parta { display: grid; grid-template-columns: repeat(9,1fr); gap: 18px 12px; align-items: end; }
    .parta figcaption { font-size: 13px; margin-top: 8px; }

    footer { padding: 40px 0 48px; border-top: 2px solid var(--ink); }
    .tiraz { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 28px; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); margin-top: 26px; }

    @media (max-width: 950px) { .hero, .odilne, .udalost { grid-template-columns: 1fr; } .soupis { column-count: 1; } .parta { grid-template-columns: repeat(5,1fr); } }
    @media (max-width: 560px) { .termin { grid-template-columns: 1fr; } .parta { grid-template-columns: repeat(3,1fr); } }
  </style>

  <header>
    <div class="list">
      <div class="hl">
        <a href="#" class="znak">Jiro Saku</a>
        <nav>
          <a href="#">Úvod</a><a href="#">Kurzy</a><a href="#" class="skrt">Pro děti</a>
          <a href="#">Parta</a><a href="#">Open studio</a><a href="#">Obchod</a>
          <a href="#" class="skrt">Dizajn</a><a href="#">O nás</a>
        </nav>
      </div>
      <div class="podlinka"></div>
    </div>
  </header>

  <main>
    <div class="list">
      <div class="hero">
        <div>
          <p class="kap">Keramická dílna · Luční 235, Ořech</p>
          <h1 style="margin-top:22px;">Uč se keramiku tam,<br>kde má hlína <em>čas.</em></h1>
          <p class="uvod">Malá dílna v Ořechu — kurzy pro začátečníky i pokročilé, open studio pro volnou tvorbu a keramika, kterou si odneseš domů.</p>
          <div class="akce">
            <a href="#" class="odkaz">Vybrat kurz</a>
            <a href="#" class="odkaz">Open studio</a>
            <a href="#" class="odkaz">Rezervovat</a>
          </div>
        </div>

        <figure>
          <!-- Tón výhradně šrafou. Obrysová čára je vždycky silnější než ta tónová. -->
          <svg viewBox="0 0 380 340" style="width:100%;height:auto;display:block;" role="img" aria-label="Hrnčířský kruh, rytina">
            <defs>
              <pattern id="r1" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><line x1="0" y1="0" x2="0" y2="6" stroke="#23201B" stroke-width="0.55"/></pattern>
              <pattern id="r2" width="3.4" height="3.4" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><line x1="0" y1="0" x2="0" y2="3.4" stroke="#23201B" stroke-width="0.62"/></pattern>
              <pattern id="r3" width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M0 0 L0 2.6 M0 0 L2.6 0" stroke="#23201B" stroke-width="0.6"/></pattern>
            </defs>
            <path d="M148 66 C148 40 160 26 190 26 C220 26 232 40 232 66 L240 132 H140 Z" fill="url(#r1)"/>
            <path d="M190 26 C220 26 232 40 232 66 L240 132 H196 Z" fill="url(#r2)"/>
            <path d="M148 66 C148 40 160 26 190 26 C220 26 232 40 232 66 L240 132 H140 Z" fill="none" stroke="#23201B" stroke-width="1.5"/>
            <ellipse cx="190" cy="150" rx="118" ry="26" fill="none" stroke="#23201B" stroke-width="1.5"/>
            <path d="M72 150 C72 176 308 176 308 150" fill="url(#r3)" opacity="0.85"/>
            <path d="M72 150 V162 C72 182 308 182 308 162 V150" fill="none" stroke="#23201B" stroke-width="1.5"/>
            <ellipse cx="190" cy="150" rx="58" ry="13" fill="none" stroke="#23201B" stroke-width="0.8" opacity="0.6"/>
            <ellipse cx="190" cy="150" rx="24" ry="5" fill="none" stroke="#23201B" stroke-width="0.8" opacity="0.5"/>
            <path d="M178 182 h24 v92 h-24 Z" fill="url(#r2)" stroke="#23201B" stroke-width="1.4"/>
            <path d="M126 274 h128 l14 32 H112 Z" fill="url(#r3)" stroke="#23201B" stroke-width="1.5"/>
          </svg>
          <figcaption><b>Tabule I</b>Hrnčířský kruh — přijď si sednout ke kruhu</figcaption>
        </figure>
      </div>
    </div>

    <section>
      <div class="list">
        <div class="udalost">
          <div class="kdy">10. IX.<small>10—16 hodin</small></div>
          <div>
            <p class="kap">Mimo řádný rozpis</p>
            <h2 style="margin-top:8px;">Den otevřených dveří</h2>
            <p class="kurz" style="margin-top:10px;">Přijď se podívat, jak dílna funguje zevnitř. Uvidíš točení na kruhu, nahlédneš do pece a osaháš si hlínu, i kdybys ji v ruce nikdy neměl. Ptát se můžeš na cokoliv.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="list">
        <div class="hlava"><h2>Co u nás najdeš</h2><span class="kap">Katalog · 4 položky</span></div>
        <div class="soupis">
          <div class="zaznam"><span class="kap">3 hodiny</span><h3>Workshopy</h3><p>Jednorázové zážitkové kurzy. Ideální na dárek nebo teambuilding.</p><a href="#" class="jdi">Vybrat termín</a></div>
          <div class="zaznam"><span class="kap">4–8 lekcí</span><h3>Kurzy</h3><p>Vícedenní cykly pro začátečníky i pokročilé. Kruh, technika, glazování.</p><a href="#" class="jdi">Prohlédnout kurzy</a></div>
          <div class="zaznam zaznam-vyb"><span class="kap">na hodiny</span><h3>Open studio</h3><p>Rezervuj si čas u kruhu bez instruktora. Členství i jednorázový vstup.</p><a href="#" class="jdi">Zjistit více</a></div>
          <div class="zaznam" style="border-bottom:0;"><span class="kap">malé série</span><h3>Obchod</h3><p>Keramika od nás i našich lektorů. Malé série, žádné dva stejné.</p><a href="#" class="jdi">Do obchodu</a></div>
        </div>
        <p class="kap" style="margin-top:10px;">❋ nejoblíbenější</p>
      </div>
    </section>

    <section>
      <div class="list">
        <div class="hlava"><h2>Nejbližší termíny</h2><span class="kap">Podzim 2026 · 4 kurzy</span></div>
        <div class="termin"><div class="kdy">4. listopadu</div><div><h3>Kurz kruhu pro začátečníky</h3><p class="kap">4 lekce · středy 18:00 · Jiřík</p><p class="popis">Naučíš se základy točení na kruhu — centrovat, vytahovat, tvarovat. Čtyři večery, vlastní tempo.</p></div><span class="stav">Připravujeme</span></div>
        <div class="termin"><div class="kdy">14. listopadu</div><div><h3>Víkendový workshop — mísy a talíře</h3><p class="kap">2 dny · so–ne 10:00 · Renča</p><p class="popis">Dva dny u kruhu zaměřené na ploché tvary. Glazování v ceně, hotové kousky vyzvedneš za 2 týdny.</p></div><span class="stav">Připravujeme</span></div>
        <div class="termin"><div class="kdy">21. listopadu</div><div><h3>Glazování — pokročilý seminář</h3><p class="kap">1 den · sobota 09:00 · Jiřík</p><p class="popis">Teorie i praxe glazur — oxidace, redukce, vrstvení. Pro ty, kdo už mají za sebou pár výpalů.</p></div><span class="stav">Připravujeme</span></div>
        <div class="termin"><div class="kdy">28. listopadu</div><div><h3>Kurz kruhu — pokročilí</h3><p class="kap">6 lekcí · soboty 10:00 · Renča</p><p class="popis">Víčka, džbány, sady. Pro ty, kdo zvládají základy a chtějí se posunout dál.</p></div><span class="stav">Připravujeme</span></div>
      </div>
    </section>

    <section>
      <div class="list odilne">
        <div>
          <p class="kap">Provozovna</p>
          <h2 style="margin-top:8px;">O dílně</h2>
          <p>Začínáme v roce 2026 s jednou pecí, dvěma stoly, třemi kruhy a spoustou nadšení. Malá dílna v Ořechu, kde má hlína čas a každá chyba svůj tvar.</p>
          <p>Kurzy vedou dva lektoři, každý s vlastním rukopisem. Pro děti, dospělé, začátečníky i pro pokročilé, kteří chtějí posunout, co už umí.</p>
          <p class="kap" style="margin-top:24px;">1 pec · 2 lektoři · 3 kruhy</p>
        </div>
        <figure>
          <svg viewBox="0 0 340 280" style="width:100%;height:auto;display:block;" role="img" aria-label="Pec v řezu, rytina">
            <path d="M52 40 h236 v196 h-236 Z" fill="url(#r1)" stroke="#23201B" stroke-width="1.6"/>
            <path d="M170 40 h118 v196 h-118 Z" fill="url(#r2)" opacity="0.7"/>
            <path d="M88 96 h164 v112 h-164 Z" fill="url(#r3)" stroke="#23201B" stroke-width="1.4"/>
            <path d="M148 184 C136 160 168 150 172 120 C182 152 208 164 192 184 Z" fill="#F2EDE0" stroke="#23201B" stroke-width="1.2"/>
            <path d="M224 40 V14 h34 v26" fill="none" stroke="#23201B" stroke-width="1.6"/>
            <g stroke="#23201B" stroke-width="0.9" opacity="0.55">
              <path d="M88 124 h164 M88 152 h164 M88 180 h164"/>
            </g>
            <path d="M52 236 h236" stroke="#23201B" stroke-width="1.8"/>
          </svg>
          <figcaption><b>Tabule II</b>Pec — výpal 1000 °C, dva týdny do vyzvednutí</figcaption>
        </figure>
      </div>
    </section>

    <section>
      <div class="list">
        <div class="hlava"><h2>Parta</h2><span class="kap">Tabule III—XI</span></div>
        <div class="parta">
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><path d="M16 54 C16 30 26 16 35 14 C44 16 54 30 54 54 Z" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><path d="M35 14 C44 16 54 30 54 54 H35 Z" fill="url(#r2)" opacity="0.7"/><ellipse cx="35" cy="56" rx="26" ry="5" fill="none" stroke="#23201B" stroke-width="1.2"/></svg><figcaption>Hlínka</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><path d="M35 8 C24 32 19 44 19 52 C19 62 26 68 35 68 C44 68 51 62 51 52 C51 44 46 32 35 8 Z" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><path d="M35 8 C46 32 51 44 51 52 C51 62 44 68 35 68 Z" fill="url(#r2)" opacity="0.7"/></svg><figcaption>Kapka</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><rect x="13" y="16" width="44" height="48" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><rect x="23" y="32" width="24" height="22" fill="url(#r3)" stroke="#23201B" stroke-width="1"/><path d="M42 16 V6 h10 v10" fill="none" stroke="#23201B" stroke-width="1.2"/></svg><figcaption>Pecinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><path d="M13 26 C15 50 24 62 35 62 C46 62 55 50 57 26 Z" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><ellipse cx="35" cy="26" rx="22" ry="5" fill="none" stroke="#23201B" stroke-width="1.2"/><path d="M40 30 L33 44 L41 54 L36 62" fill="none" stroke="#6B5540" stroke-width="1.6"/></svg><figcaption>Střípek</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><path d="M29 10 L28 22 C18 32 15 46 18 56 C21 62 27 65 35 65 C43 65 49 62 52 56 C55 46 52 32 42 22 L41 10 Z" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><path d="M26 10 h18" stroke="#23201B" stroke-width="1.4"/></svg><figcaption>Vázička</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><circle cx="35" cy="36" r="24" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><path d="M35 12 A24 24 0 0 1 59 36 L35 36 Z" fill="#F2EDE0" opacity="0.85"/><circle cx="35" cy="36" r="24" fill="none" stroke="#23201B" stroke-width="1.2"/></svg><figcaption>Bublinka</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><rect x="13" y="13" width="44" height="44" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><rect x="21" y="21" width="28" height="28" fill="none" stroke="#23201B" stroke-width="0.8"/></svg><figcaption>Kachlík</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><rect x="21" y="14" width="28" height="46" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><circle cx="35" cy="22" r="3" fill="#F2EDE0" stroke="#23201B" stroke-width="1"/><path d="M27 44 h16 M28 51 h11" stroke="#6B5540" stroke-width="1.4"/></svg><figcaption>Cedulka</figcaption></figure>
          <figure><svg viewBox="0 0 70 74" aria-hidden="true"><rect x="5" y="28" width="60" height="18" fill="url(#r1)" stroke="#23201B" stroke-width="1.2"/><rect x="5" y="42" width="60" height="8" fill="url(#r3)" stroke="#23201B" stroke-width="1"/></svg><figcaption>Šamotka</figcaption></figure>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="list">
      <h2 style="font-size:clamp(28px,4.4vw,50px);">Přijď si zkusit, jak se hlína točí.</h2>
      <p class="kurz" style="margin-top:12px;">Pecinka topí každý týden a Hlínka na tebe čeká na stole.</p>
      <div class="tiraz">
        <span>Jiro Saku · keramická dílna, od 2026</span>
        <span>Luční 235, Ořech u Prahy</span>
        <span>Tabulí XI · list 1 z 1</span>
      </div>
    </div>
  </footer>
</Nahled>

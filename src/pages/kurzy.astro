---
import Layout from "../layouts/Layout.astro";
import Stripek from "../components/characters/Stripek.astro";
import Bublina from "../components/characters/Bublina.astro";
import Poukaz from "../components/Poukaz.astro";
import { kurzy as courses } from "../data/kurzy";
import { pocetKurzu } from "../data/pocty";


const faq = [
  { q: "Musím umět točit?", a: "Ne. Většina našich studentů začíná úplně od nuly. Lektor tě vším provede." },
  { q: "Co si mám vzít s sebou?", a: "Nic — zástěru, hlínu i nástroje máme tady. Přijď v oblečení, které se může ušpinit." },
  { q: "Kdy bude moje keramika hotová?", a: "Sušení a výpal trvají 2–3 týdny. Dáme ti vědět, až bude k vyzvednutí." },
  { q: "Můžu kurz darovat?", a: "Ano. Prodáváme dárkové poukazy na všechny kurzy i open studio." },
];
---

<Layout title="Kurzy — Ořechová hlína" description="Kurzy keramiky pro začátečníky i pokročilé. Workshopy, vícedenní cykly a rodinné dílny.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="md:grid md:grid-cols-[1.15fr_1fr] md:gap-12 md:items-center mb-12">
        <div>
          <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
            Hlína počká.<br />Ty <span class="serif-italic-terracotta">nemusíš.</span>
          </h1>
          <p class="text-stone text-[16px] leading-[1.75]">
            Kurzy pro úplné začátečníky i pokročilé keramiky. Malé skupiny, max 8 lidí, dva lektoři s vlastním rukopisem. Všechno potřebné máme — stačí přijít.
          </p>
        </div>
        <div></div>
      </div>
      <span class="mono-meta block text-right">Jaro 2026 · {pocetKurzu(courses.length)}</span>
    </div>
  </section>

  <section class="bg-white py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-6">Nejbližší termíny</h3>
      <div>
        {courses.map((c) => (
          <div class="grid grid-cols-[52px_1fr] md:grid-cols-[60px_1fr_auto_auto_auto] items-start gap-4 md:gap-5 py-5 border-b border-espresso/10 last:border-b-0">
            <div class="font-serif font-medium text-[24px] md:text-[26px] text-center leading-none" style="font-variation-settings: 'opsz' 72;">
              {c.day}
              <span class="block font-mono text-[12px] text-stone mt-1 tracking-wider uppercase font-normal">{c.month}</span>
            </div>
            <div>
              <h4 class="font-serif text-[17px] md:text-[19px] font-medium mb-1 leading-tight">{c.title}</h4>
              <p class="text-[14px] text-stone mb-2">{c.meta}</p>
              <p class="text-[15px] text-stone leading-[1.6]">{c.desc}</p>
            </div>
            <div class={`font-mono text-[12px] hidden md:block ${
              c.state === "urgent" ? "text-clay font-medium" :
              c.state === "full" ? "text-stone line-through" : "text-stone"
            }`}>
              {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity}
            </div>
            <div class="font-serif text-[16px] font-medium hidden md:block">{c.price}</div>
            {c.state === "full" ? (
              <span class="bg-transparent text-stone border border-espresso/20 px-4 py-2 rounded-full text-[12px] font-medium hidden md:inline-block cursor-default">
                Náhradník
              </span>
            ) : (
              <a href="#rezervace" class="bg-espresso text-cream px-4 py-2 rounded-full text-[12px] font-medium hover:bg-clay transition-colors hidden md:inline-block">
                Rezervovat
              </a>
            )}
            <div class="col-span-2 flex items-center justify-between md:hidden pt-1">
              <div class={`font-mono text-[12px] ${
                c.state === "urgent" ? "text-clay font-medium" :
                c.state === "full" ? "text-stone line-through" : "text-stone"
              }`}>
                {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity} · <span class="text-espresso font-serif">{c.price}</span>
              </div>
              {c.state === "full" ? (
                <span class="bg-transparent text-stone border border-espresso/20 px-3 py-1.5 rounded-full text-[12px] font-medium cursor-default">
                  Náhradník
                </span>
              ) : (
                <a href="#rezervace" class="bg-espresso text-cream px-3 py-1.5 rounded-full text-[12px] font-medium">
                  Rezervovat
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-6">Časté otázky</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faq.map((f) => (
          <div class="border-t border-espresso/10 pt-4">
            <p class="font-serif italic text-[17px] text-espresso mb-1.5">{f.q}</p>
            <p class="text-stone text-[15px] leading-[1.7]">{f.a}</p>
          </div>
        ))}
      </div>

      <Bublina
        name="Střípek"
        text="Já jsem se rozbil hned na první hodině. A pořád jsem tady."
        class="mt-10 justify-center"
      >
        <Stripek />
      </Bublina>
    </div>
  </section>

  <!-- Dárkový poukaz -->
  <section id="poukaz" class="bg-white py-14 fade-up">
    <div class="container-x">
      <div class="md:grid md:grid-cols-[1fr_1.15fr] md:gap-12 md:items-center">
        <div class="mb-8 md:mb-0">
          <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-4">Dárkový poukaz</h2>
          <p class="font-serif text-[26px] md:text-[32px] font-medium leading-tight text-espresso mb-4" style="font-variation-settings: 'opsz' 72;">
            Daruj někomu <em class="italic font-normal text-terracotta">odpoledne u kruhu.</em>
          </p>
          <p class="text-stone text-[16px] leading-[1.7] mb-6 max-w-[46ch]">
            Poukaz platí na jakýkoli kurz, workshop i open studio — obdarovaný si vybere sám,
            co a kdy ho láká. Platnost 12 měsíců. Vytiskneme ho na papír nebo pošleme v PDF.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="mailto:ahoj@orechovahlina.cz?subject=D%C3%A1rkov%C3%BD%20poukaz"
              class="inline-flex items-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-clay transition-colors"
            >
              Objednat poukaz <span aria-hidden="true">→</span>
            </a>
            <span class="mono-meta">890 · 1 500 · 2 400 · nebo vlastní částka</span>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <Poukaz hodnota="1 500" postava="vazicka" />
        </div>
      </div>
    </div>
  </section>

  <section id="rezervace" class="bg-cream-warm py-14 fade-up">
    <div class="container-x text-center max-w-[560px] mx-auto">
      <p class="font-hand text-[28px] text-terracotta mb-6 relative z-10">Kde každá „chyba" má svůj tvar</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
        <a
          href="mailto:ahoj@orechovahlina.cz"
          class="inline-flex items-center justify-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-clay transition-colors"
        >
          ahoj@orechovahlina.cz
        </a>
        <a
          href="tel:+420777000000"
          class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso hover:text-cream transition-colors"
        >
          +420 777 000 000
        </a>
      </div>
      <p class="text-stone text-[16px] leading-[1.75]">
        Rezervuj si místo — ozvi se mailem nebo zavolej a&nbsp;domluvíme se.
      </p>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";


const courses = [
  {
    day: "14",
    month: "Bře",
    title: "Kurz kruhu pro začátečníky",
    meta: "4 lekce · středy 18:00 · Jiřík",
    capacity: "6 / 8 míst",
    state: "open" as const,
    price: "3 800 Kč",
    desc: "Naučíš se základy točení na kruhu — centrovat, vytahovat, tvarovat. Čtyři večery, vlastní tempo.",
  },
  {
    day: "22",
    month: "Bře",
    title: "Víkendový workshop — mísy & talíře",
    meta: "2 dny · so–ne 10:00 · Renča",
    capacity: "poslední místo",
    state: "urgent" as const,
    price: "2 400 Kč",
    desc: "Dva dny u kruhu zaměřené na ploché tvary. Glazování v ceně, hotové kousky vyzvedneš za 2 týdny.",
  },
  {
    day: "05",
    month: "Dub",
    title: "Glazování — pokročilý seminář",
    meta: "1 den · sobota 09:00 · Jiřík",
    capacity: "obsazeno",
    state: "full" as const,
    price: "1 900 Kč",
    desc: "Teorie i praxe glazur — oxidace, redukce, vrstvení. Pro ty, kdo už mají za sebou pár výpalů.",
  },
  {
    day: "12",
    month: "Dub",
    title: "Rodinná dílna — děti od 6 let",
    meta: "1 den · sobota 14:00 · Jiřík",
    capacity: "4 / 10 míst",
    state: "open" as const,
    price: "890 Kč / rodina",
    desc: "Modelování bez kruhu, vhodné pro děti i rodiče. Každý si odnese vlastní výtvor.",
  },
  {
    day: "19",
    month: "Dub",
    title: "Kurz kruhu — pokročilí",
    meta: "6 lekcí · soboty 10:00 · Renča",
    capacity: "3 / 6 míst",
    state: "open" as const,
    price: "5 200 Kč",
    desc: "Víčka, džbány, sady. Pro ty, kdo zvládají základy a chtějí se posunout dál.",
  },
  {
    day: "26",
    month: "Dub",
    title: "Zážitkový workshop pro páry",
    meta: "1 den · sobota 16:00 · Jiřík",
    capacity: "5 / 6 párů",
    state: "open" as const,
    price: "1 600 Kč / pár",
    desc: "Společné točení, dvě hodiny u kruhu, víno v ceně. Ideální dárek.",
  },
];

const faq = [
  { q: "Musím umět točit?", a: "Ne. Většina našich studentů začíná úplně od nuly. Lektor tě vším provede." },
  { q: "Co si mám vzít s sebou?", a: "Nic — zástěru, hlínu i nástroje máme tady. Přijď v oblečení, které se může ušpinit." },
  { q: "Kdy bude moje keramika hotová?", a: "Sušení a výpal trvají 2–3 týdny. Dáme ti vědět, až bude k vyzvednutí." },
  { q: "Můžu kurz darovat?", a: "Ano. Prodáváme dárkové poukazy na všechny kurzy i open studio." },
];
---

<Layout title="Kurzy — Ořechová hlína" description="Kurzy keramiky pro začátečníky i pokročilé. Workshopy, vícedenní cykly a rodinné dílny.">
  <section class="py-14 fade-up">
    <div class="container-x relative">
      <div class="max-w-[720px] mb-12">
        <h1 class="hero-title text-espresso text-[36px] md:text-[48px] lg:text-[58px] mb-5">
          Hlína počká.<br />Ty <span class="serif-italic-terracotta">nemusíš.</span>
        </h1>
        <p class="text-stone text-[14px] leading-[1.75]">
          Kurzy pro úplné začátečníky i pokročilé keramiky. Malé skupiny, max 8 lidí, dva lektoři s vlastním rukopisem. Všechno potřebné máme — stačí přijít.
        </p>
      </div>
      <span class="mono-meta absolute bottom-0 right-0 md:right-8 lg:right-12">Jaro 2026 · 12 kurzů</span>
    </div>
  </section>

  <section class="bg-white py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[11px] tracking-wider text-stone uppercase mb-6">Nejbližší termíny</h3>
      <div>
        {courses.map((c) => (
          <div class="grid grid-cols-[52px_1fr] md:grid-cols-[60px_1fr_auto_auto_auto] items-start gap-4 md:gap-5 py-5 border-b border-espresso/10 last:border-b-0">
            <div class="font-serif font-medium text-[24px] md:text-[26px] text-center leading-none" style="font-variation-settings: 'opsz' 72;">
              {c.day}
              <span class="block font-mono text-[10px] text-stone mt-1 tracking-wider uppercase font-normal">{c.month}</span>
            </div>
            <div>
              <h4 class="font-serif text-[17px] md:text-[19px] font-medium mb-1 leading-tight">{c.title}</h4>
              <p class="text-[12px] text-stone mb-2">{c.meta}</p>
              <p class="text-[13px] text-stone/80 leading-[1.6]">{c.desc}</p>
            </div>
            <div class={`font-mono text-[11px] hidden md:block ${
              c.state === "urgent" ? "text-clay font-medium" :
              c.state === "full" ? "text-stone line-through" : "text-stone"
            }`}>
              {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity}
            </div>
            <div class="font-serif text-[16px] font-medium hidden md:block">{c.price}</div>
            {c.state === "full" ? (
              <span class="bg-transparent text-stone border border-espresso/20 px-4 py-2 rounded-full text-[11px] font-medium hidden md:inline-block cursor-default">
                Náhradník
              </span>
            ) : (
              <a href="#rezervace" class="bg-espresso text-cream px-4 py-2 rounded-full text-[11px] font-medium hover:bg-clay transition-colors hidden md:inline-block">
                Rezervovat
              </a>
            )}
            <div class="col-span-2 flex items-center justify-between md:hidden pt-1">
              <div class={`font-mono text-[11px] ${
                c.state === "urgent" ? "text-clay font-medium" :
                c.state === "full" ? "text-stone line-through" : "text-stone"
              }`}>
                {c.state === "urgent" && <span aria-hidden="true">● </span>}{c.capacity} · <span class="text-espresso font-serif">{c.price}</span>
              </div>
              {c.state === "full" ? (
                <span class="bg-transparent text-stone border border-espresso/20 px-3 py-1.5 rounded-full text-[11px] font-medium cursor-default">
                  Náhradník
                </span>
              ) : (
                <a href="#rezervace" class="bg-espresso text-cream px-3 py-1.5 rounded-full text-[11px] font-medium">
                  Rezervovat
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 fade-up">
    <div class="container-x">
      <h3 class="font-mono text-[11px] tracking-wider text-stone uppercase mb-6">Časté otázky</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faq.map((f) => (
          <div class="border-t border-espresso/10 pt-4">
            <p class="font-serif italic text-[17px] text-espresso mb-1.5">{f.q}</p>
            <p class="text-stone text-[13px] leading-[1.7]">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="rezervace" class="bg-cream-warm py-14 fade-up">
    <div class="container-x text-center max-w-[480px] mx-auto">
      <p class="font-hand text-[28px] text-terracotta mb-2">Kde každá „chyba" má svůj tvar</p>
      <p class="text-stone text-[14px] leading-[1.75] mb-6">
        Rezervuj si místo — ozvi se mailem nebo zavolej a&nbsp;domluvíme se.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="mailto:ahoj@orechahlina.cz"
          class="inline-flex items-center justify-center gap-2 bg-terracotta text-cream px-6 py-3.5 rounded-full text-[13px] font-medium hover:bg-clay transition-colors"
        >
          Napsat e-mail
        </a>
        <a
          href="tel:+420777000000"
          class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[13px] font-medium hover:bg-espresso hover:text-cream transition-colors"
        >
          +420 777 000 000
        </a>
      </div>
    </div>
  </section>
</Layout>

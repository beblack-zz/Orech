---
import Layout from "../layouts/Layout.astro";
import Stripek from "../components/characters/Stripek.astro";
import Bublinka from "../components/characters/Bublinka.astro";
import Bublina from "../components/characters/Bublina.astro";
import Poukaz from "../components/Poukaz.astro";
import PadajiciPlatky from "../components/PadajiciPlatky.astro";
import Delic from "../components/Delic.astro";
import { kurzy as courses, poMesicich, den, mesic, popisKurzu, stavPopis, tlacitkoPopis, lzeRezervovat, sezona } from "../data/kurzy";


const faq = [
  { q: "Musím umět točit?", a: "Ne. Většina našich studentů začíná úplně od nuly. Lektor tě vším provede." },
  { q: "Co si mám vzít s sebou?", a: "Nic — zástěru, hlínu i nástroje máme tady. Přijď v oblečení, které se může ušpinit." },
  { q: "Kdy bude moje keramika hotová?", a: "Sušení a výpal trvají 2–3 týdny. Dáme ti vědět, až bude k vyzvednutí." },
  { q: "Můžu kurz darovat?", a: "Ano. Prodáváme dárkové poukazy na všechny kurzy i open studio." },
];
---

<Layout title="Kurzy — JIRO saku" description="Kurzy keramiky pro začátečníky i pokročilé. Workshopy, vícedenní cykly a rodinné dílny.">
  <section class="py-14 fade-up relative">
    <PadajiciPlatky />
    <div class="container-x relative">
      {/*
        Hlavička podstránky má stejný tvar jako úvod — velký světlý nadpis
        se zvýrazněným slovem — ale menší stupeň a odstavec vidět hned.
        Kdo je na Kurzech, už se rozhodl, že ho to zajímá; plnou obrazovku
        s nadpisem by musel překonávat, aby se dostal k termínům.
      */}
      <div class="max-w-[600px] mb-14 md:mb-16">
        <h1 class="hero-title text-espresso text-[38px] md:text-[48px] lg:text-[56px] mb-6">
          Hlína počká.<br />Ty <span class="serif-italic-sakura">nemusíš.</span>
        </h1>
        <p class="text-stone text-[16px] md:text-[17px] leading-[1.75]">
          Kurzy pro úplné začátečníky i pokročilé keramiky. Malé skupiny, max 8 lidí, dva lektoři s vlastním rukopisem. Všechno potřebné máme — stačí přijít.
        </p>
      </div>
      <span class="mono-meta block text-right">{sezona()}</span>
    </div>
  </section>

  <Delic />

  <section class="bg-white py-14 fade-up">
    <div class="container-x">
      {courses.length === 0 && (
        <p class="text-stone text-[16px] leading-[1.7] max-w-[52ch]">
          Zrovna teď nemáme vypsaný žádný volný termín. Chystáme další —
          <a href="#rezervace" class="text-terracotta underline underline-offset-2">ozvi se nám</a>
          a zapíšeme tě mezi první, komu dáme vědět.
        </p>
      )}
      <div class="flex flex-col gap-14 md:gap-16">
        {poMesicich(courses).map((m, mi) => (
        <div>
        {/*
          Běžící měsíc je „aktuální“, ty další teprve přijdou — proto „nejbližší“.
          Zvýraznění prvního měsíce nese nadpis, ne barevná plocha: slovo
          v sakuře a silnější linka nad seznamem.
        */}
        <h2 class="font-serif font-light text-[32px] md:text-[40px] leading-none mb-7">
          {mi === 0 ? <em class="italic font-light text-sakura">Aktuální</em> : "Nejbližší"} termíny
          <span class="text-stone/60"> · {m.nazev}</span>
        </h2>
        <div>
        {m.kurzy.map((c) => (
          <div class="grid grid-cols-[52px_1fr] md:grid-cols-[72px_1fr_auto_auto] items-start gap-4 md:gap-8 py-7 md:py-8 border-b border-espresso/20 first:border-t first:border-espresso/20">
            <div class="font-serif font-medium text-[28px] md:text-[34px] text-center leading-none" style="font-variation-settings: 'opsz' 72;">
              {den(c.date)}
              <span class="block font-mono text-[12px] text-stone mt-1 tracking-wider uppercase font-normal">{mesic(c.date)}</span>
            </div>
            <div>
              <h3 class="font-serif font-medium text-[22px] md:text-[26px] mb-1.5 leading-none">{c.title}</h3>
              {/*
                Formát v oceli ze značky — jediná studená barva v paletě, takže
                se mezi teplými hnědými čte jako samostatný údaj. Sama o sobě
                byla dřív málo vidět; funguje až teď, když má datum a název
                silnější řez a je vedle čeho vyniknout.
              */}
              <p class="text-[14px] md:text-[15px] text-peri-deep mb-2.5 leading-[1.6]">{popisKurzu(c)}</p>
              <p class="text-[15px] text-stone leading-[1.6] whitespace-pre-line">{c.desc}</p>
            </div>
            <div class={`font-mono text-[12px] hidden md:block ${
              c.state === "urgent" ? "text-sakura font-medium" :
              c.state === "full" ? "text-stone line-through" :
              c.price ? "text-espresso font-medium" :
              c.state === "pripravujeme" ? "text-stone/70 italic" : "text-stone"
            }`}>
              {c.state === "urgent" && <span aria-hidden="true">● </span>}{stavPopis(c)}
            </div>
            {c.state !== "pripravujeme" && (c.state === "full" ? (
              <span class="bg-transparent text-stone border border-espresso/20 px-4 py-2 rounded-full text-[12px] font-medium hidden md:inline-block cursor-default">
                {tlacitkoPopis(c)}
              </span>
            ) : (
              <a
                href="#rezervace"
                class={`px-4 py-2 rounded-full text-[12px] font-medium hidden md:inline-block ${
                  lzeRezervovat(c)
                    ? "bg-espresso text-cream hover:bg-sakura transition-colors"
                    : "bg-transparent text-stone border border-espresso/20 hover:border-espresso/40 transition-colors"
                }`}
              >
                {tlacitkoPopis(c)}
              </a>
            ))}
            <div class="col-span-2 flex items-center justify-between md:hidden pt-1">
              <div class={`font-mono text-[12px] ${
                c.state === "urgent" ? "text-sakura font-medium" :
                c.state === "full" ? "text-stone line-through" :
                c.price ? "text-espresso font-medium" :
              c.state === "pripravujeme" ? "text-stone/70 italic" : "text-stone"
              }`}>
                {c.state === "urgent" && <span aria-hidden="true">● </span>}{stavPopis(c)}
              </div>
              {c.state !== "pripravujeme" && (c.state === "full" ? (
                <span class="bg-transparent text-stone border border-espresso/20 px-3 py-1.5 rounded-full text-[12px] font-medium cursor-default">
                  {tlacitkoPopis(c)}
                </span>
              ) : (
                <a
                  href="#rezervace"
                  class={`px-3 py-1.5 rounded-full text-[12px] font-medium ${
                    lzeRezervovat(c)
                      ? "bg-espresso text-cream"
                      : "bg-transparent text-stone border border-espresso/20"
                  }`}
                >
                  {tlacitkoPopis(c)}
                </a>
              ))}
            </div>
          </div>
        ))}
        </div>
        </div>
        ))}
      </div>

      {/* Střípek hlídá, aby se chyb nikdo nebál — u termínů kurzů je to první obava. */}
      <Bublina
        name="Střípek"
        text="Já jsem se rozbil hned na první hodině. A pořád jsem tady."
        class="mt-12 justify-center"
      >
        <Stripek />
      </Bublina>
    </div>
  </section>

  <div class="bg-white">
    <Delic />
  </div>

  <section class="py-14 fade-up">
    <div class="container-x">
      <h2 class="font-serif font-light text-[32px] md:text-[40px] leading-none mb-8 md:mb-10">
        Časté <em class="italic font-light text-sakura">otázky</em>
      </h2>

      {/*
        Otázka vlevo, odpověď vpravo — řádek se tak čte jedním tahem a je na
        první pohled vidět, kde jedna dvojice končí. Dvousloupcová mřížka
        vedle sebe to dřív rozsypala: oko muselo skákat do strany i dolů.
      */}
      <div class="border-t border-espresso/20">
        {faq.map((f) => (
          <div class="grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-x-8 lg:gap-x-10 gap-y-1 py-4 md:py-5 border-b border-espresso/20 items-baseline">
            <h3 class="font-serif italic font-light text-[18px] md:text-[21px] text-sakura leading-snug">{f.q}</h3>
            <p class="text-stone text-[15px] md:text-[16px] leading-[1.6]">{f.a}</p>
          </div>
        ))}
      </div>

      {/* U otázek stojí Bublinka — hlídá vzduch v hlíně a bublina je i řeč. */}
      <Bublina
        name="Bublinka"
        text="Já tam nejsem. Fakt. Klidně to dej do pece."
        class="mt-10 justify-center"
      >
        <Bublinka />
      </Bublina>
    </div>
  </section>

  <Delic />

  <!-- Dárkový poukaz -->
  <section id="poukaz" class="bg-white py-14 fade-up">
    <div class="container-x">
      <div class="md:grid md:grid-cols-[1fr_1.15fr] md:gap-12 md:items-center">
        <div class="mb-8 md:mb-0">
          <h2 class="font-mono text-[12px] tracking-wider text-stone uppercase mb-4">Dárkový poukaz</h2>
          <p class="font-serif text-[26px] md:text-[32px] font-medium leading-tight text-espresso mb-4" style="font-variation-settings: 'opsz' 72;">
            Daruj někomu <em class="italic font-normal text-sakura">odpoledne u kruhu.</em>
          </p>
          <p class="text-stone text-[16px] leading-[1.7] mb-6 max-w-[46ch]">
            Poukaz platí na jakýkoli kurz, workshop i open studio — obdarovaný si vybere sám,
            co a kdy ho láká. Platnost 12 měsíců. Vytiskneme ho na papír nebo pošleme v PDF.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="mailto:ahoj@jirosaku.cz?subject=D%C3%A1rkov%C3%BD%20poukaz"
              class="inline-flex items-center gap-2 bg-stone text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso transition-colors"
            >
              Objednat poukaz <span aria-hidden="true">→</span>
            </a>
            <span class="mono-meta">890 · 1 500 · 2 400 · nebo vlastní částka</span>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <Poukaz hodnota="1 500" postava="kachlik" />
        </div>
      </div>
    </div>
  </section>

  <section id="rezervace" class="bg-cream-warm py-14 fade-up">
    <div class="container-x text-center max-w-[560px] mx-auto">
      <p class="font-hand text-[28px] text-terracotta mb-6 relative z-10">Kde každá „chyba“ má svůj tvar</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
        <a
          href="mailto:ahoj@jirosaku.cz"
          class="inline-flex items-center justify-center gap-2 bg-stone text-cream px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso transition-colors"
        >
          ahoj@jirosaku.cz
        </a>
        <a
          href="tel:+420777000000"
          class="inline-flex items-center justify-center bg-transparent text-espresso border border-espresso px-6 py-3.5 rounded-full text-[15px] font-medium hover:bg-espresso hover:text-cream transition-colors"
        >
          +420 777 000 000
        </a>
      </div>
      <p class="text-stone text-[16px] leading-[1.75]">
        Rezervuj si místo — ozvi se mailem nebo zavolej a&nbsp;domluvíme se.
      </p>
    </div>
  </section>
</Layout>

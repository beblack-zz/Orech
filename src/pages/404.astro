---
/**
 * Stránka nenalezena — v novém vzhledu (obloha, hlavička, papír a patička
 * z Party 2, styles/nenalezeno.css). Patří Střípkovi, odborníkovi na rozbité
 * věci.
 *
 * Nahoře se na obloze vznáší číslo chyby z porcelánu slepeného zlatem
 * (components/nenalezeno/Scena.astro): dvě čtyřky a mezi nimi okraj talíře,
 * Střípkova svatozář. Chvíli po příchodu se to rozbije před očima, střepy
 * spadnou na papír s textem, setmí se, a Střípek číslo kus po kusu slepí —
 * s posledním kusem se rozední. Kliknutí ho rozbije znovu.
 *
 * Text je na papíře pod tím: co se stalo, adresa, která se nenašla, tip, kam
 * člověk asi chtěl (scripts/nenalezeno/kam.ts), a odkazy dál. Bez skriptu
 * zůstane číslo jako obrázek a text s odkazy.
 */
import Hlava from "../components/Hlava.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/postavicky.css";
import "../styles/parta2.css";
import "../styles/nenalezeno.css";

import Nebe from "../components/parta2/Nebe.astro";
import Hlavicka from "../components/parta2/Hlavicka.astro";
import Paticka from "../components/parta2/Paticka.astro";
import Scena from "../components/nenalezeno/Scena.astro";

const kam = [
  { href: "/rezervace#rz-rad", label: "Kurzy a termíny" },
  { href: "/dilna", label: "Dílna" },
  { href: "/rezervace", label: "Rezervace" },
  { href: "/obchod", label: "Obchod" },
  { href: "/parta", label: "Parta" },
  { href: "/o-nas", label: "O nás" },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <Hlava titulek="Tahle stránka se rozbila — JIRO saku" popis="Stránka, kterou hledáš, tady není. Střípek ji aspoň slepí zlatem — a ukáže, kudy dál." barva="#4F5E9C" noindex />
    <ClientRouter />
  </head>
  <body class="p2 nn" data-stranka="nenalezeno">
    <a class="preskocit" href="#nn-text">Přeskočit na text a odkazy</a>
    <Nebe />
    <Hlavicka sber="zadny" />

    <main>
      {/* Svítání: v té hodině má obloha stejné mraky jako Střípek obláček. Hodinu pak přepisuje scéna. */}
      <section class="nn-sekce" data-hodina="5.6" aria-labelledby="nn-nadpis">
        <div class="nn-jeviste">
          <Scena />

          <div class="papir nn-papir" id="nn-text">
            <p class="stitek">Chyba 404 · stránka nenalezena</p>
            <h1 id="nn-nadpis" class="nadpis-2 nn-nadpis">Tahle stránka se <em>rozbila.</em></h1>
            <p class="nn-perex">
              Nic hrozného — u nás se rozbíjí často a skoro vždycky z toho nakonec něco je.
              Adresa, kterou hledáš, tady ale opravdu není.
            </p>
            {/* Doplní skript: adresa z řádku prohlížeče a stránka, která je jí nejpodobnější */}
            <p class="nn-adresa" hidden>Hledáno: <code></code></p>
            <p class="nn-tip" hidden>Nehledáš náhodou <a href="/"></a>?</p>

            <p class="nn-replika">— Střípek, odborník na rozbité věci</p>

            <nav class="nn-kam" aria-label="Kam dál">
              {kam.map((k) => <a class="tlacitko tlacitko-obrys tlacitko-maly" href={k.href}>{k.label}</a>)}
            </nav>
            <a class="tlacitko nn-domu" href="/">Zpátky na úvod <span aria-hidden="true">→</span></a>

            <p class="nn-pokyn">
              Klepni do čísla a rozbij ho znovu — Střípek ho slepí.
              <span class="nn-pocet" aria-live="polite" hidden></span>
            </p>
          </div>
        </div>
      </section>
    </main>

    <Paticka />

    <script>
      import "../scripts/nenalezeno/hlavni.ts";
    </script>
  </body>
</html>
